# Node runtime with the Web Streams entry from bun/entry.server.tsx, to separate the
# runtime effect from the renderer effect in the Bun comparison. Override the command
# with `node server-node-native.mjs` for the no-Express variant.
FROM node:24-bookworm-slim AS build
WORKDIR /app
COPY package.json ./
RUN npm install --no-audit --no-fund
COPY . .
RUN cp bun/entry.server.tsx app/entry.server.tsx && npm run build && npm prune --omit=dev

FROM node:24-bookworm-slim
WORKDIR /app
ENV NODE_ENV=production
COPY --from=build /app/package.json /app/server.mjs /app/server-node-native.mjs ./
COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/build ./build
EXPOSE 8080
CMD ["node", "server.mjs"]
