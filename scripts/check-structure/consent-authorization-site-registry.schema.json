{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Consent authorization site registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "sites"],
  "properties": {
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "sites": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["file", "owner", "constructor", "ordinal", "classification", "reason"],
        "properties": {
          "file": {
            "type": "string",
            "minLength": 1
          },
          "owner": {
            "type": "string",
            "minLength": 1
          },
          "constructor": {
            "type": "string",
            "enum": [
              "authorizeConsentForActor",
              "authorizeConsentForSelfRegistration",
              "authorizeConsentForProvisioning"
            ]
          },
          "ordinal": {
            "type": "integer",
            "minimum": 1
          },
          "classification": {
            "type": "string",
            "enum": ["actor", "self-registration", "provisioning"]
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
