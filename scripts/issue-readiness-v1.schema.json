{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:chase-sets:schema:issue-readiness:v1",
  "title": "Chase Sets issue readiness receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "claim",
    "status",
    "subject",
    "facts",
    "checkedRules",
    "reasonCodes",
    "coverage",
    "provenance",
    "semanticPressureTest"
  ],
  "properties": {
    "schemaVersion": { "const": "issue-readiness/v1" },
    "claim": { "const": "structural-only" },
    "status": { "enum": ["ready", "not-ready", "unknown"] },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "number", "nodeId", "updatedAt"],
      "properties": {
        "repository": { "type": "string", "pattern": "^[^/]+/[^/]+$" },
        "number": { "type": "integer", "minimum": 1 },
        "nodeId": { "type": ["string", "null"] },
        "updatedAt": { "type": ["string", "null"], "format": "date-time" }
      }
    },
    "facts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "issueType", "milestone", "labels", "hasParent", "parentNumber", "dependencies"],
      "properties": {
        "state": { "enum": ["open", "closed", null] },
        "issueType": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["nodeId", "name", "isEnabled"],
              "properties": {
                "nodeId": { "type": "string" },
                "name": { "type": "string" },
                "isEnabled": { "type": "boolean" }
              }
            }
          ]
        },
        "milestone": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["number", "title", "state"],
              "properties": {
                "number": { "type": "integer", "minimum": 1 },
                "title": { "type": "string" },
                "state": { "enum": ["open", "closed"] }
              }
            }
          ]
        },
        "labels": {
          "type": "array",
          "items": { "type": "string" }
        },
        "hasParent": { "type": ["boolean", "null"] },
        "parentNumber": { "type": ["integer", "null"], "minimum": 1 },
        "dependencies": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["nodeId", "number", "state", "updatedAt", "issueTypeName"],
            "properties": {
              "nodeId": { "type": "string" },
              "number": { "type": "integer", "minimum": 1 },
              "state": { "enum": ["open", "closed"] },
              "updatedAt": { "type": "string", "format": "date-time" },
              "issueTypeName": { "type": ["string", "null"] }
            }
          }
        }
      }
    },
    "checkedRules": {
      "type": "array",
      "minItems": 11,
      "maxItems": 11,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "status", "reasonCodes"],
        "properties": {
          "id": {
            "enum": [
              "ready-00-placed-classified",
              "ready-00-dependencies-resolved",
              "ready-01-repo-evidence",
              "ready-02-explicit-non-goal",
              "ready-03-acceptance-evidence",
              "ready-04-runnable-verification",
              "ready-05-footprint-operators",
              "ready-06-decisions-resolved",
              "ready-07-terms-declared",
              "ready-08-authority-probe-timed",
              "ready-09-review-packet"
            ]
          },
          "status": { "enum": ["pass", "fail", "unknown"] },
          "reasonCodes": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 },
            "uniqueItems": true
          }
        }
      }
    },
    "reasonCodes": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["authorityComplete", "issue", "labels", "dependencies", "comments", "form"],
      "properties": {
        "authorityComplete": { "type": "boolean" },
        "issue": {
          "type": "object",
          "additionalProperties": false,
          "required": ["initialRead", "finalRead", "revisionStable"],
          "properties": {
            "initialRead": { "type": "boolean" },
            "finalRead": { "type": "boolean" },
            "revisionStable": { "type": "boolean" }
          }
        },
        "labels": { "$ref": "#/$defs/collectionCoverage" },
        "dependencies": { "$ref": "#/$defs/collectionCoverage" },
        "comments": { "$ref": "#/$defs/collectionCoverage" },
        "form": {
          "type": "object",
          "additionalProperties": false,
          "required": ["parsed", "complete"],
          "properties": {
            "parsed": { "type": "boolean" },
            "complete": { "type": "boolean" }
          }
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["checkedAt", "checkerSha", "apiVersion", "collector"],
      "properties": {
        "checkedAt": { "type": "string", "format": "date-time" },
        "checkerSha": { "type": "string", "pattern": "^[a-fA-F0-9]{40}$" },
        "apiVersion": { "const": "2022-11-28" },
        "collector": { "const": "github-rest-plus-graphql" }
      }
    },
    "semanticPressureTest": { "const": "not-evaluated" }
  },
  "$defs": {
    "collectionCoverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pages", "collected", "total", "complete", "reasonCode"],
      "properties": {
        "pages": { "type": "integer", "minimum": 0 },
        "collected": { "type": "integer", "minimum": 0 },
        "total": { "type": ["integer", "null"], "minimum": 0 },
        "complete": { "type": "boolean" },
        "reasonCode": { "type": ["string", "null"] }
      }
    }
  }
}
