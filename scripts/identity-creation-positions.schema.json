{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Identity creation positions",
  "description": "Every tracked CreateAccount, CreateUser, and GrantMembership construction position is classified with an exact occurrence count.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "positions"],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "enum": [1]
    },
    "positions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "command", "occurrences", "disposition", "reason"],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "command": {
            "type": "string",
            "minLength": 1
          },
          "occurrences": {
            "type": "integer",
            "minimum": 1
          },
          "disposition": {
            "type": "string",
            "enum": ["bound", "exempt-permanent", "exempt-temporary", "domain-declaration", "test-fixture"]
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "ownerIssue": {
            "type": "integer",
            "minimum": 1
          },
          "composition": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
