  "components": {
    "securitySchemes": {
      "sessionCookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "chase_sets_session"
      },
      "apiKeyBearer": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "required": ["error"],
        "properties": {
          "error": {
            "type": "object",
            "required": ["code", "message"],
            "properties": {
              "code": { "type": "string" },
              "message": { "type": "string" },
              "details": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "field": { "type": "string" },
                    "code": { "type": "string" },
                    "message": { "type": "string" }
                  }
                }
              }
            }
          }
        }
      },
      "ListResponse": {
        "type": "object",
        "required": ["items", "total", "count"],
        "properties": {
          "items": { "type": "array", "items": {} },
          "total": { "type": "integer" },
          "count": { "type": "integer" }
        }
      },
      "CommandResponse": {
        "type": "object",
        "required": ["id", "version", "status"],
        "properties": {
          "id": { "type": "string" },
          "version": { "type": "integer" },
          "status": { "type": "string" }
        }
      }
    },
    "responses": {
      "Ok": { "description": "Successful response." },
      "List": { "description": "List response.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ListResponse" } } } },
