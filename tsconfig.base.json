{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@chase-sets/catalog-authoring": [
        "./bounded-contexts/catalog/authoring/index.ts"
      ],
      "@chase-sets/catalog-authoring/web": [
        "./bounded-contexts/catalog/authoring/web.ts"
      ],
      "@chase-sets/discovery": [
        "./bounded-contexts/discovery/index.ts"
      ],
      "@chase-sets/discovery/web": [
        "./bounded-contexts/discovery/web.ts"
      ],
      "@chase-sets/fulfillment": [
        "./bounded-contexts/fulfillment/index.ts"
      ],
      "@chase-sets/fulfillment/web": [
        "./bounded-contexts/fulfillment/web.ts"
      ],
      "@chase-sets/marketplace-context": [
        "./bounded-contexts/marketplace/index.ts"
      ],
      "@chase-sets/marketplace-context/web": [
        "./bounded-contexts/marketplace/web.ts"
      ],
      "@chase-sets/identity": [
        "./bounded-contexts/identity/index.ts"
      ],
      "@chase-sets/identity/server": [
        "./bounded-contexts/identity/server.ts"
      ],
      "@chase-sets/identity/web": [
        "./bounded-contexts/identity/web.ts"
      ],
      "@chase-sets/reputation": [
        "./bounded-contexts/reputation/index.ts"
      ],
      "@chase-sets/reputation/web": [
        "./bounded-contexts/reputation/web.ts"
      ],
      "@chase-sets/settlement": [
        "./bounded-contexts/settlement/index.ts"
      ],
      "@chase-sets/settlement/web": [
        "./bounded-contexts/settlement/web.ts"
      ],
      "@chase-sets/inventory": [
        "./bounded-contexts/inventory/index.ts"
      ],
      "@chase-sets/inventory/web": [
        "./bounded-contexts/inventory/web.ts"
      ],
      "@chase-sets/ordering": [
        "./bounded-contexts/ordering/index.ts"
      ],
      "@chase-sets/ordering/web": [
        "./bounded-contexts/ordering/web.ts"
      ],
      "@chase-sets/payments": [
        "./bounded-contexts/payments/index.ts"
      ],
      "@chase-sets/payments/web": [
        "./bounded-contexts/payments/web.ts"
      ],
      "@chase-sets/design-system": [
        "./packages/design-system/src/index.ts"
      ],
      "@chase-sets/design-system/styles.css": [
        "./packages/design-system/src/styles/tailwind.css"
      ],
      "@chase-sets/auth-context": [
        "./contracts/auth-context/index.ts"
      ],
      "@chase-sets/bounded-context-module": [
        "./contracts/bounded-context-module/index.ts"
      ],
      "@chase-sets/bounded-context-runtime": [
        "./infrastructure/bounded-context-runtime/index.ts"
      ],
      "@chase-sets/dev-seeds": [
        "./contracts/dev-seeds/index.ts"
      ],
      "@chase-sets/event-core": [
        "./contracts/event-core/index.ts"
      ],
      "@chase-sets/event-core/*": [
        "./contracts/event-core/*.ts"
      ],
      "@chase-sets/event-core-postgres": [
        "./infrastructure/event-core-postgres/index.ts"
      ],
      "@chase-sets/http/*": [
        "./contracts/http/*.ts"
      ],
      "@chase-sets/primitives/*": [
        "./contracts/primitives/*.ts"
      ],
      "@chase-sets/sellable-units": [
        "./contracts/sellable-units/index.ts"
      ]
    }
  }
}
