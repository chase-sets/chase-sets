{
    "name": "chase-sets",
    "private": true,
    "type": "module",
    "packageManager": "pnpm@11.0.9",
    "engines": {
        "node": "24.x"
    },
    "workspaces": [
        "bounded-contexts/*",
        "contracts/*",
        "infrastructure/*",
        "packages/*",
        "deployables/*"
    ],
    "scripts": {
        "env:sync": "node ./scripts/local-env.mjs sync",
        "env:pull": "node ./scripts/local-env.mjs pull",
        "env:push": "node ./scripts/local-env.mjs push",
        "env:check": "node ./scripts/local-env.mjs check",
        "env:doctor": "node ./scripts/local-env.mjs doctor",
        "deps:install": "node ./scripts/worktree-deps.mjs install",
        "deps:doctor": "node ./scripts/worktree-deps.mjs doctor",
        "deps:prune-store": "node ./scripts/worktree-deps.mjs prune-store",
        "setup:worktree": "node ./scripts/worktree-deps.mjs install",
        "sync:workspace-metadata": "node ./scripts/sync-workspace-metadata.mjs",
        "dev": "node ./scripts/dev-system.mjs dev",
        "dev:bootstrap": "node ./scripts/dev-system.mjs bootstrap",
        "dev:down": "node ./scripts/dev-system.mjs down",
        "dev:db:refresh": "node ./scripts/dev-system.mjs refresh",
        "remote-dev": "node ./scripts/remote-dev.mjs",
        "smoke:platform": "node ./scripts/platform-smoke.mjs",
        "replay:projection": "node ./scripts/replay-projection.mjs",
        "stripe:listen": "node ./scripts/stripe-cli.mjs listen",
        "stripe:money-smoke": "node ./scripts/stripe-money-smoke-test.mjs",
        "test:design-system": "pnpm --filter @chase-sets/design-system run test",
        "check:no-any": "node ./scripts/check-no-any.mjs",
        "typecheck": "pnpm run check:no-any && tsc -p ./tsconfig.json --noEmit && node ./scripts/run-workspaces.mjs typecheck",
        "test": "pnpm run test:fast",
        "test:fast": "node ./scripts/run-workspaces.mjs test --exclude-test-profile=db && node ./scripts/run-workspaces.mjs test:fast --test-profile=db",
        "test:db": "node ./scripts/run-workspaces.mjs test --test-profile=db",
        "coverage": "pnpm run coverage:fast",
        "coverage:fast": "node ./scripts/run-workspaces.mjs test --exclude-test-profile=db -- --coverage --coverage.reporter=text",
        "coverage:db": "node ./scripts/run-workspaces.mjs test --test-profile=db -- --coverage --coverage.reporter=text",
        "build": "node ./scripts/run-workspaces.mjs build",
        "test:structure": "vitest run scripts/check-structure/account-capability-language.test.mjs",
        "test:remote-dev": "vitest run scripts/remote-dev.test.mjs",
        "test:local-env": "vitest run scripts/local-env.test.mjs",
        "test:process": "vitest run scripts/process.test.mjs",
        "test:sandbox": "vitest run scripts/sandbox.test.mjs",
        "test:platform-smoke": "vitest run scripts/platform-smoke-args.test.mjs",
        "test:digitalocean-app-deployment": "vitest run scripts/digitalocean-app-deployment.test.mjs",
        "test:digitalocean-registry-cleanup": "vitest run scripts/digitalocean-registry-cleanup.test.mjs",
        "test:workspace-metadata": "vitest run scripts/sync-workspace-metadata.test.mjs",
        "test:run-workspaces": "vitest run scripts/run-workspaces.test.mjs",
        "verify": "pnpm run sync:workspace-metadata && pnpm run verify:static && pnpm run typecheck && pnpm run test:fast && pnpm run build",
        "verify:metadata": "node ./scripts/sync-workspace-metadata.mjs --check",
        "verify:static": "pnpm run check:postage-adapters && pnpm run check:structure && pnpm run check:localization && pnpm run test:structure && pnpm run test:remote-dev && pnpm run test:local-env && pnpm run test:process && pnpm run test:sandbox && pnpm run test:platform-smoke && pnpm run test:digitalocean-app-deployment && pnpm run test:digitalocean-registry-cleanup && pnpm run test:workspace-metadata && pnpm run test:run-workspaces",
        "verify:typecheck": "pnpm run check:no-any && tsc -p ./tsconfig.json --noEmit && node ./scripts/run-workspaces.mjs typecheck --concurrency=4",
        "verify:test": "node ./scripts/run-workspaces.mjs test --exclude-test-profile=db --concurrency=4",
        "verify:test-db": "node ./scripts/run-workspaces.mjs test:fast --test-profile=db --concurrency=2",
        "verify:build": "node ./scripts/run-workspaces.mjs build --concurrency=4",
        "verify:db": "pnpm run verify:test-db",
        "dev:platform-api": "node ./scripts/dev-system.mjs dev platform-api",
        "dev:platform-worker": "node ./scripts/dev-system.mjs dev platform-worker",
        "dev:admin-web": "node ./scripts/dev-system.mjs dev admin-web",
        "dev:reseed": "pnpm run dev:db:refresh",
        "dev:marketplace": "node ./scripts/dev-system.mjs dev marketplace",
        "dev:public-web": "node ./scripts/dev-system.mjs dev public-web",
        "dev:marketplace-full": "node ./scripts/dev-system.mjs dev marketplace-full",
        "dev:observability": "node ./scripts/observability-stack.mjs up",
        "dev:observability:down": "node ./scripts/observability-stack.mjs down",
        "dev:observability:open": "node ./scripts/observability-stack.mjs open",
        "sandbox:doctor": "node ./scripts/sandbox.mjs doctor",
        "sandbox:env": "node ./scripts/sandbox.mjs env",
        "sandbox:compose": "node ./scripts/sandbox.mjs compose",
        "sandbox:down": "node ./scripts/sandbox.mjs down",
        "sandbox:clean": "node ./scripts/sandbox.mjs clean",
        "sandbox:list": "node ./scripts/sandbox.mjs list",
        "sandbox:clean:all": "node ./scripts/sandbox.mjs clean-all",
        "test:platform": "pnpm --filter @chase-sets/app-platform-api run test",
        "check:structure": "node ./scripts/check-structure.mjs",
        "check:structure:ci": "STRUCTURE_SINGLE_SLICE_SUPPORT_ENFORCEMENT=violation pnpm run check:structure",
        "check:structure:budget": "node ./scripts/structure-metrics-budget.mjs",
        "check:postage-adapters": "node ./scripts/check-postage-adapter-boundaries.mjs",
        "check:localization": "node ./scripts/check-localization.mjs"
    },
    "devDependencies": {
        "@tailwindcss/vite": "^4.2.2",
        "@testing-library/react": "^16.3.2",
        "@testing-library/user-event": "^14.6.1",
        "@types/node": "^25.6.2",
        "@types/react": "^19.2.14",
        "@types/react-dom": "^19.2.3",
        "@vitejs/plugin-react": "^6.0.1",
        "@vitest/coverage-v8": "^4.1.5",
        "jsdom": "^29.0.2",
        "react": "^19.2.5",
        "react-dom": "^19.2.5",
        "tailwindcss": "^4.2.2",
        "typescript": "^5.9.3",
        "vite": "^8.0.8",
        "vitest": "^4.1.4"
    },
    "dependencies": {
        "@react-router/dev": "^7.14.0",
        "@react-router/node": "^7.14.0",
        "@react-router/serve": "^7.14.0",
        "isbot": "^5.1.37",
        "pg": "^8.20.0",
        "react-router": "^7.14.0",
        "ulid": "^3.0.2"
    }
}
