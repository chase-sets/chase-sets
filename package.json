{
    "name": "chase-sets",
    "private": true,
    "type": "module",
    "workspaces": [
        "bounded-contexts/*",
        "contracts/*",
        "infrastructure/*",
        "packages/*",
        "deployables/*"
    ],
    "scripts": {
        "sync:workspace-metadata": "node ./scripts/sync-workspace-metadata.mjs",
        "dev": "node ./scripts/dev-system.mjs dev",
        "dev:bootstrap": "node ./scripts/dev-system.mjs bootstrap",
        "dev:down": "node ./scripts/dev-system.mjs down",
        "dev:db:refresh": "node ./scripts/dev-system.mjs refresh",
        "replay:projection": "node ./scripts/replay-projection.mjs",
        "stripe:listen": "node ./scripts/stripe-cli.mjs listen",
        "stripe:money-smoke": "node ./scripts/stripe-money-smoke-test.mjs",
        "dev:showcase": "npm run dev --workspace @chase-sets/app-design-system-showcase",
        "test:design-system": "npm run test --workspace @chase-sets/design-system",
        "typecheck": "node ./scripts/run-workspaces.mjs typecheck",
        "test": "npm run test:fast",
        "test:fast": "node ./scripts/run-workspaces.mjs test --exclude-test-profile=db",
        "test:db": "node ./scripts/run-workspaces.mjs test --test-profile=db",
        "coverage": "npm run coverage:fast",
        "coverage:fast": "node ./scripts/run-workspaces.mjs test --exclude-test-profile=db -- --coverage --coverage.reporter=text",
        "coverage:db": "node ./scripts/run-workspaces.mjs test --test-profile=db -- --coverage --coverage.reporter=text",
        "build": "node ./scripts/run-workspaces.mjs build",
        "test:structure": "vitest run scripts/check-structure/account-capability-language.test.mjs",
        "verify": "npm run sync:workspace-metadata && npm run check:postage-adapters && npm run check:structure && npm run check:ui-migration && npm run check:localization && npm run check:money-rollout && npm run test:structure && npm run typecheck && npm run test:fast && npm run build",
        "verify:db": "npm run test:db",
        "verify:design-system-contracts": "npm run verify:source --workspace @chase-sets/app-design-system-showcase",
        "dev:platform-api": "npm run dev --workspace @chase-sets/app-platform-api",
        "dev:admin-web": "node ./scripts/dev-system.mjs dev admin-web",
        "dev:reseed": "npm run dev:db:refresh",
        "dev:marketplace": "npm run dev --workspace @chase-sets/app-marketplace-web",
        "dev:marketplace-full": "node ./scripts/dev-system.mjs dev marketplace-full",
        "dev:observability": "node ./scripts/observability-stack.mjs up",
        "dev:observability:down": "node ./scripts/observability-stack.mjs down",
        "dev:observability:open": "node ./scripts/observability-stack.mjs open",
        "test:platform": "npm run test --workspace @chase-sets/app-platform-api",
        "check:structure": "node ./scripts/check-structure.mjs",
        "check:structure:ci": "STRUCTURE_SINGLE_SLICE_SUPPORT_ENFORCEMENT=violation npm run check:structure",
        "check:structure:budget": "node ./scripts/structure-metrics-budget.mjs",
        "check:postage-adapters": "node ./scripts/check-postage-adapter-boundaries.mjs",
        "check:localization": "node ./scripts/check-localization.mjs",
        "check:money-rollout": "node ./scripts/check-money-schema-rollout.mjs",
        "check:ui-migration": "node ./scripts/check-design-system-migration.mjs"
    },
    "devDependencies": {
        "@tailwindcss/vite": "^4.2.2",
        "@testing-library/react": "^16.3.2",
        "@testing-library/user-event": "^14.6.1",
        "@types/react": "^19.2.14",
        "@types/react-dom": "^19.2.3",
        "@vitejs/plugin-react": "^6.0.1",
        "@vitest/coverage-v8": "^4.1.5",
        "jsdom": "^29.0.2",
        "react": "^19.2.5",
        "react-dom": "^19.2.5",
        "tailwindcss": "^4.2.2",
        "typescript": "^5.9.3",
        "vite": "^8.0.8",
        "vitest": "^4.1.4"
    },
    "dependencies": {
        "@react-router/dev": "^7.14.0",
        "@react-router/node": "^7.14.0",
        "@react-router/serve": "^7.14.0",
        "isbot": "^5.1.37",
        "react-router": "^7.14.0",
        "ulid": "^3.0.2"
    }
}
