{
  "name": "chase-sets",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.0.9",
  "engines": {
    "node": "24.x"
  },
  "workspaces": [
    "bounded-contexts/*",
    "contracts/*",
    "infrastructure/*",
    "packages/*",
    "deployables/*"
  ],
  "scripts": {
    "env:sync": "node ./scripts/local-env.mjs sync",
    "env:pull": "node ./scripts/local-env.mjs pull",
    "env:push": "node ./scripts/local-env.mjs push",
    "env:check": "node ./scripts/local-env.mjs check",
    "env:doctor": "node ./scripts/local-env.mjs doctor",
    "deps:install": "node ./scripts/worktree-deps.mjs install",
    "deps:doctor": "node ./scripts/worktree-deps.mjs doctor",
    "deps:prune-store": "node ./scripts/worktree-deps.mjs prune-store",
    "setup:worktree": "node ./scripts/worktree-deps.mjs install",
    "sync:workspace-metadata": "node ./scripts/sync-workspace-metadata.mjs",
    "backfill:discovery-search-embeddings": "node --experimental-strip-types ./scripts/discovery-search-embedding-backfill.mjs",
    "benchmark:discovery-hybrid-retrieval": "node --experimental-strip-types ./scripts/benchmark-discovery-hybrid-retrieval.mjs",
    "evaluate:discovery-search-relevance": "node --experimental-strip-types ./scripts/discovery-search-relevance.mjs",
    "generate:discovery-search-relevance-embeddings": "node --experimental-strip-types ./scripts/discovery-search-relevance-embeddings.mjs",
    "generate:readme-manifest-sections": "node ./scripts/generate-readme-manifest-sections.mjs",
    "generate:agent-connector-packaging": "node --experimental-strip-types ./scripts/generate-agent-connector-packaging.mjs",
    "generate:brand-icons": "node ./scripts/generate-brand-icons.mjs",
    "generate:design-system-component-index": "node ./scripts/generate-design-system-component-index.mjs",
    "regenerate:lockfile-bound-artifacts": "node ./scripts/check-structure/regenerate-lockfile-bound-artifacts.mjs",
    "ds:regen": "node ./scripts/ds-regen.mjs",
    "campaign:market-data": "node ./scripts/campaign-market-data-snippets.mjs",
    "dev": "node ./scripts/dev-system.mjs dev",
    "dev:bootstrap": "node ./scripts/dev-system.mjs bootstrap",
    "dev:down": "node ./scripts/dev-system.mjs down",
    "dev:e2e:probe": "node ./scripts/browser-e2e-probe.mjs",
    "dev:db:refresh": "node ./scripts/dev-system.mjs refresh",
    "remote-dev": "node ./scripts/remote-dev.mjs",
    "smoke:platform": "node --experimental-strip-types ./scripts/platform-smoke.mjs",
    "smoke:public-web-routes": "node --experimental-strip-types ./scripts/public-web-route-smoke.mjs",
    "platform:kubernetes-deployment": "node ./scripts/platform-kubernetes-deployment.mjs",
    "platform:helm-local-boot": "node ./scripts/platform-helm-local-boot.mjs",
    "ops": "node ./scripts/ops.mjs",
    "catalog:real-provider-proof": "node --experimental-strip-types ./scripts/run-catalog-real-provider-proof.mjs",
    "observation-pack:capture": "node --experimental-strip-types ./scripts/run-catalog-observation-pack-capture.mjs",
    "observation-pack:verify": "node --experimental-strip-types ./scripts/verify-observation-pack.mjs",
    "representative-snapshot": "node ./scripts/representative-snapshot.mjs",
    "marketplace:easypost-refund-event-replay": "node ./scripts/easypost-refund-event-replay.mjs",
    "marketplace:provider-proof-status": "node ./scripts/marketplace-provider-proof-status.mjs",
    "guest-buy-now:freshness-probe": "node ./scripts/guest-buy-now-freshness-probe.mjs",
    "wake:drills": "node ./scripts/staging-wake-drills.mjs",
    "wake:mixed-version-drill": "node ./scripts/staging-mixed-version-wake-drill.mjs",
    "emergency-recovery:guide": "node ./scripts/emergency-recovery-guide.mjs",
    "rollback:readiness": "node ./scripts/rollback-readiness.mjs",
    "replay:projection": "node ./scripts/replay-projection.mjs",
    "stripe:listen": "node ./scripts/stripe-cli.mjs listen",
    "stripe:money-smoke": "node ./scripts/stripe-money-smoke-test.mjs",
    "format": "prettier . --write --ignore-unknown",
    "format:check": "node ./scripts/format-check.mjs",
    "test:design-system": "pnpm --filter @chase-sets/design-system run test",
    "check:no-any": "node ./scripts/check-no-any.mjs",
    "check:no-legacy-forms": "node ./scripts/check-no-legacy-forms.mjs --final",
    "check:design-system-hoc-budget": "node ./scripts/design-system-hoc-budget.mjs --check",
    "check:responsive-safety": "node ./scripts/check-responsive-safety.mjs --check",
    "check:design-system-raw-ui-budget": "node ./scripts/design-system-raw-ui-budget.mjs --check",
    "check:design-system-color-utilities": "node ./scripts/check-design-system-color-utilities.mjs",
    "check:readme-manifest-sections": "node ./scripts/generate-readme-manifest-sections.mjs --check",
    "check:agent-connector-packaging": "node --experimental-strip-types ./scripts/generate-agent-connector-packaging.mjs --check",
    "check:public-policies": "pnpm --filter @chase-sets/public-presence run check:public-policies",
    "check:developer-articles": "pnpm --filter @chase-sets/public-presence run check:developer-articles",
    "check:docs-index": "node ./scripts/check-docs-index.mjs",
    "check:docs-path-claims": "node ./scripts/check-docs-path-claims.mjs",
    "check:design-system-component-index": "node ./scripts/generate-design-system-component-index.mjs --check",
    "check:design-system-export-coverage": "node ./scripts/check-design-system-export-coverage.mjs",
    "check:package-export-targets": "node ./scripts/check-package-export-targets.mjs",
    "check:env-examples": "node ./scripts/check-env-examples.mjs",
    "typecheck": "node ./scripts/verify-typecheck.mjs",
    "typecheck:watch": "tsc -p ./tsconfig.json --noEmit --watch --preserveWatchOutput",
    "test": "pnpm run test:fast",
    "test:fast": "pnpm run verify:test",
    "test:db": "pnpm run verify:test-db",
    "coverage": "pnpm run coverage:fast",
    "coverage:clean": "node ./scripts/clean-coverage.mjs",
    "clean:logs": "node ./scripts/clean-logs.mjs",
    "coverage:fast": "node ./scripts/run-workspaces.mjs test --exclude-test-profile=db --concurrency=4 -- --coverage --coverage.reporter=text --coverage.reporter=lcov && node ./scripts/run-workspaces.mjs test:unit --test-profile=db --concurrency=4 -- --coverage --coverage.reporter=text --coverage.reporter=lcov",
    "coverage:db": "node ./scripts/run-workspaces.mjs \"test:db*\" --concurrency=2 -- --coverage --coverage.reporter=text --coverage.reporter=lcov",
    "coverage:ci": "pnpm run coverage:clean && pnpm run coverage:fast && pnpm run coverage:db && pnpm run coverage:summary",
    "coverage:summary": "node ./scripts/coverage-summary.mjs",
    "build": "node ./scripts/run-workspaces.mjs build",
    "test:structure": "vitest run --config ./vitest.scripts.config.mjs --testTimeout=120000 scripts/check-structure",
    "test:platform-smoke": "vitest run scripts/admin-shell-smoke-assertions.test.mjs scripts/platform-smoke-args.test.mjs scripts/platform-smoke-fetch.test.mjs scripts/platform-smoke-freshness.test.mjs scripts/platform-smoke-native-mcp.test.mjs",
    "test:no-legacy-forms": "vitest run scripts/check-no-legacy-forms.test.mjs",
    "test:form-migration-smoke": "pnpm --dir bounded-contexts/auth exec vitest run --config ./tests/vitest.config.mjs features/sign-in/ui/sign-in-page.test.tsx && pnpm --dir bounded-contexts/platform-operations exec vitest run --config ./tests/vitest.config.mjs features/platform-feedback/ui/admin-pages.test.tsx && pnpm --dir bounded-contexts/marketplace exec vitest run --config ./tests/vitest.config.mjs features/listings/ui/listing-list-page.test.tsx && pnpm --dir bounded-contexts/public-presence exec vitest run --config ./tests/vitest.config.mjs features/waitlist/ui/public-pages.test.tsx && pnpm --dir deployables/marketplace exec vitest run --config ./vitest.config.ts app/routes/layout.test.tsx",
    "test:e2e": "playwright test",
    "test:e2e:suite": "node ./scripts/run-e2e-suite.mjs",
    "test:e2e:deployed": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:install": "playwright install",
    "verify": "pnpm run sync:workspace-metadata && pnpm run verify:static && pnpm run verify:typecheck && pnpm run verify:test && pnpm run verify:test-db && pnpm run verify:build",
    "verify:metadata": "node ./scripts/sync-workspace-metadata.mjs --check",
    "test:scripts": "vitest run --config ./vitest.scripts.config.mjs",
    "check:kb-reference-ratchet": "node ./scripts/check-structure/kb-reference-ratchet.mjs",
    "check:static": "pnpm run verify:static",
    "verify:static": "pnpm run format:check -- --changed && pnpm run check:kb-reference-ratchet && pnpm run check:postage-adapters && pnpm run check:github-actions-runtime && pnpm run check:identity-creation-positions && pnpm run check:managed-postgres-authority && pnpm run check:managed-registry-authority && pnpm run check:environment-topology && pnpm run check:workflow-canonical-artifacts && pnpm run check:no-legacy-forms && pnpm run check:design-system-hoc-budget && pnpm run check:responsive-safety && pnpm run check:design-system-raw-ui-budget && pnpm run check:design-system-color-utilities && pnpm run check:readme-manifest-sections && pnpm run check:agent-connector-packaging && pnpm run check:public-policies && pnpm run check:developer-articles && pnpm run check:docs-index && pnpm run check:docs-path-claims && pnpm run check:design-system-component-index && pnpm run check:design-system-export-coverage && pnpm run check:package-export-targets && pnpm run check:env-examples && pnpm run check:structure && pnpm run check:localization && pnpm run check:buyer-seller-jargon && pnpm run check:operator-surface-pm && pnpm run test:scripts",
    "verify:static:scoped": "node ./scripts/verify-static-scoped.mjs",
    "verify:typecheck": "node ./scripts/verify-typecheck.mjs",
    "verify:test": "node ./scripts/run-workspaces.mjs test --exclude-test-profile=db --concurrency=4 && node ./scripts/run-workspaces.mjs test:unit --test-profile=db --concurrency=4",
    "verify:test-db": "node ./scripts/db-test-preflight.mjs && node ./scripts/run-workspaces.mjs \"test:db*\" --concurrency=2",
    "verify:build": "node ./scripts/run-workspaces.mjs build --concurrency=4",
    "verify:db": "pnpm run verify:test-db",
    "dev:platform-api": "node ./scripts/dev-system.mjs dev platform-api",
    "dev:platform-worker": "node ./scripts/dev-system.mjs dev platform-worker",
    "dev:admin-web": "node ./scripts/dev-system.mjs dev admin-web",
    "dev:browser-e2e": "node ./scripts/dev-system.mjs dev browser-e2e",
    "dev:reseed": "pnpm run dev:db:refresh",
    "dev:marketplace": "node ./scripts/dev-system.mjs dev marketplace",
    "dev:public-web": "node ./scripts/dev-system.mjs dev public-web",
    "dev:marketplace-full": "node ./scripts/dev-system.mjs dev marketplace-full",
    "dev:observability": "node ./scripts/observability-stack.mjs up",
    "dev:observability:down": "node ./scripts/observability-stack.mjs down",
    "dev:observability:open": "node ./scripts/observability-stack.mjs open",
    "sandbox:doctor": "node ./scripts/sandbox.mjs doctor",
    "sandbox:env": "node ./scripts/sandbox.mjs env",
    "sandbox:compose": "node ./scripts/sandbox.mjs compose",
    "sandbox:down": "node ./scripts/sandbox.mjs down",
    "sandbox:clean": "node ./scripts/sandbox.mjs clean",
    "sandbox:list": "node ./scripts/sandbox.mjs list",
    "sandbox:gc": "node ./scripts/sandbox.mjs gc",
    "sandbox:clean:all": "node ./scripts/sandbox.mjs clean-all",
    "test:platform": "pnpm --filter @chase-sets/app-platform-api run test",
    "check:structure": "node ./scripts/check-structure.mjs",
    "check:structure:ci": "STRUCTURE_SINGLE_SLICE_SUPPORT_ENFORCEMENT=violation pnpm run check:structure",
    "test:typecheck": "tsc -p ./tsconfig.tests.json --noEmit",
    "test:typecheck:watch": "tsc -p ./tsconfig.tests.json --noEmit --watch --preserveWatchOutput",
    "check:github-actions-runtime": "node ./scripts/check-github-actions-runtime.mjs",
    "check:identity-creation-positions": "node ./scripts/identity-creation-position-guard.mjs",
    "check:managed-postgres-authority": "node ./scripts/managed-postgres-authority-guard.mjs",
    "check:managed-registry-authority": "node ./scripts/managed-registry-authority-guard.mjs",
    "check:environment-topology": "node ./scripts/environment-topology-guard.mjs",
    "check:workflow-canonical-artifacts": "node ./scripts/workflow-canonical-artifacts.mjs",
    "check:postage-adapters": "node ./scripts/check-postage-adapter-boundaries.mjs",
    "check:localization": "node ./scripts/check-localization.mjs",
    "check:buyer-seller-jargon": "node ./scripts/check-buyer-seller-jargon.mjs",
    "check:operator-surface-pm": "node ./scripts/check-operator-surface-pm-content.mjs"
  },
  "devDependencies": {
    "@chase-sets/typescript-compiler-api": "workspace:*",
    "@playwright/test": "^1.60.0",
    "@react-router/dev": "^7.14.0",
    "@tailwindcss/vite": "^4.2.2",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^25.6.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "^4.1.5",
    "jsdom": "^29.0.2",
    "prettier": "^3.8.3",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "sharp": "^0.34.5",
    "tailwindcss": "^4.2.2",
    "tsx": "^4.21.0",
    "typescript": "^7.0.0",
    "vite": "^8.0.8",
    "vitest": "^4.1.4",
    "yaml": "^2.8.4"
  },
  "dependencies": {
    "@react-router/node": "^7.14.0",
    "@react-router/serve": "^7.14.0",
    "isbot": "^5.1.37",
    "pg": "^8.20.0",
    "react-router": "^7.14.0",
    "ulid": "^3.0.2"
  }
}
