global:
  scrape_interval: 15s
  evaluation_interval: 15s

scrape_configs:
  - job_name: otel-collector
    static_configs:
      - targets: ["otel-collector:9464"]
    relabel_configs:
      - target_label: deployment_environment
        replacement: ${stack_environment}
      - target_label: chase_sets_observability_stack
        replacement: single-shared-stack
