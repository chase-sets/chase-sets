{
	email ${acme_email}
}

(observability_diagnostics) {
	handle /__chase-sets/observability/boot-status {
		root * /srv/diagnostics
		rewrite * /boot-status.txt
		file_server
	}
}

${grafana_domains} {
	encode zstd gzip
	import observability_diagnostics
	reverse_proxy grafana:3000
}

${otel_domains} {
	import observability_diagnostics
	route {
		@authorized header X-Chase-Sets-Observability-Token ${otel_write_token}
		request_header @authorized -X-Chase-Sets-Observability-Token
		reverse_proxy @authorized otel-collector:4318
		respond "unauthorized" 401
	}
}

${prometheus_domains} {
	import observability_diagnostics
	route {
		@authorized header X-Chase-Sets-Observability-Query ${prometheus_query_token}
		request_header @authorized -X-Chase-Sets-Observability-Query
		reverse_proxy @authorized prometheus:9090
		respond "unauthorized" 401
	}
}
