#cloud-config
package_update: true
package_upgrade: true

write_files:
${write_files_yaml}

runcmd:
  - |
    set -eux
    apt-get install -y ca-certificates curl
    install -m 0755 -d /etc/apt/keyrings
    curl -fsSL https://download.docker.com/linux/ubuntu/gpg -o /etc/apt/keyrings/docker.asc
    chmod a+r /etc/apt/keyrings/docker.asc
    . /etc/os-release
    echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/docker.asc] https://download.docker.com/linux/ubuntu $${VERSION_CODENAME} stable" > /etc/apt/sources.list.d/docker.list
    apt-get update
    apt-get install -y docker-ce docker-ce-cli containerd.io docker-buildx-plugin docker-compose-plugin
    systemctl enable --now docker

    volume_device="/dev/disk/by-id/scsi-0DO_Volume_${volume_name}"
    for attempt in $(seq 1 60); do
      if [ -e "$${volume_device}" ]; then
        break
      fi
      sleep 2
    done

    if [ ! -e "$${volume_device}" ]; then
      echo "Persistent observability volume was not attached: $${volume_device}" >&2
      exit 1
    fi

    if ! blkid "$${volume_device}" >/dev/null 2>&1; then
      mkfs.ext4 -F "$${volume_device}"
    fi

    install -m 0755 -d /var/lib/chase-sets-observability
    if ! grep -q "$${volume_device} /var/lib/chase-sets-observability" /etc/fstab; then
      echo "$${volume_device} /var/lib/chase-sets-observability ext4 defaults,nofail,discard 0 2" >> /etc/fstab
    fi
    mount /var/lib/chase-sets-observability

    install -m 0755 -d \
      /var/lib/chase-sets-observability/app-logs \
      /var/lib/chase-sets-observability/caddy-config \
      /var/lib/chase-sets-observability/caddy-data \
      /var/lib/chase-sets-observability/diagnostics \
      /var/lib/chase-sets-observability/grafana \
      /var/lib/chase-sets-observability/loki \
      /var/lib/chase-sets-observability/prometheus \
      /var/lib/chase-sets-observability/tempo
    chown -R 472:472 /var/lib/chase-sets-observability/grafana
    chown -R 65534:65534 /var/lib/chase-sets-observability/prometheus
    chown -R 10001:10001 \
      /var/lib/chase-sets-observability/loki \
      /var/lib/chase-sets-observability/tempo
    cat >/var/lib/chase-sets-observability/diagnostics/boot-status.txt <<STATUS
    generated_at=$(date -u +%FT%TZ)
    status=bootstrap-running
    note=Grafana startup diagnostics update after docker compose starts.
    STATUS
    chmod 0644 /var/lib/chase-sets-observability/diagnostics/boot-status.txt
    chmod 0750 /opt/chase-sets-observability
    chmod 0600 /opt/chase-sets-observability/.env /opt/chase-sets-observability/Caddyfile

    cat >/usr/local/bin/chase-sets-observability-diagnostics <<'SCRIPT'
    #!/usr/bin/env bash
    set +e
    target=/var/lib/chase-sets-observability/diagnostics/boot-status.txt
    tmp="$target.tmp"
    redact() {
      sed -E 's/(password|token|secret|authorization|cookie)([^[:space:]]*)/\1=REDACTED/Ig'
    }
    cd /opt/chase-sets-observability || exit 0
    {
      echo "generated_at=$(date -u +%FT%TZ)"
      echo "status=compose-started"
      echo "hostname=$(hostname)"
      echo "kernel=$(uname -srmo)"
      echo "docker_version=$(docker --version 2>&1)"
      echo "docker_compose_version=$(docker compose version 2>&1)"
      echo
      echo "[compose ps]"
      docker compose ps --format json 2>&1 | redact
      echo
      echo "[grafana inspect]"
      docker inspect --format 'status={{.State.Status}} running={{.State.Running}} restarting={{.State.Restarting}} oom={{.State.OOMKilled}} exit={{.State.ExitCode}} health={{if .State.Health}}{{.State.Health.Status}}{{else}}none{{end}} started={{.State.StartedAt}} finished={{.State.FinishedAt}}' chase-sets-observability-grafana-1 2>&1 | redact
      echo
      echo "[grafana health from container]"
      docker compose exec -T grafana sh -lc 'wget -q -S -O - -T 5 http://127.0.0.1:3000/api/health' 2>&1 | redact
      echo
      echo "[grafana logs tail]"
      docker compose logs --no-color --tail=80 grafana 2>&1 | redact
    } > "$tmp"
    chmod 0644 "$tmp"
    mv "$tmp" "$target"
    SCRIPT
    chmod 0755 /usr/local/bin/chase-sets-observability-diagnostics

    cat >/usr/local/bin/chase-sets-observability-wait-for-grafana <<'SCRIPT'
    #!/usr/bin/env bash
    set +e
    cd /opt/chase-sets-observability || exit 1
    for attempt in $(seq 1 36); do
      status=$(docker inspect --format '{{if .State.Health}}{{.State.Health.Status}}{{else}}{{.State.Status}}{{end}}' chase-sets-observability-grafana-1 2>/dev/null || true)
      if [ "$status" = "healthy" ]; then
        /usr/local/bin/chase-sets-observability-diagnostics || true
        exit 0
      fi
      sleep 5
    done
    /usr/local/bin/chase-sets-observability-diagnostics || true
    docker compose ps
    docker compose logs --tail=120 grafana
    exit 1
    SCRIPT
    chmod 0755 /usr/local/bin/chase-sets-observability-wait-for-grafana

    cat >/etc/systemd/system/chase-sets-observability.service <<'UNIT'
    [Unit]
    Description=Chase Sets observability stack
    Requires=docker.service
    After=docker.service

    [Service]
    Type=oneshot
    RemainAfterExit=yes
    WorkingDirectory=/opt/chase-sets-observability
    ExecStart=/usr/bin/docker compose up -d --remove-orphans
    ExecStartPost=/usr/local/bin/chase-sets-observability-wait-for-grafana
    ExecStop=/usr/bin/docker compose down
    TimeoutStartSec=0

    [Install]
    WantedBy=multi-user.target
    UNIT

    cat >/etc/systemd/system/chase-sets-observability-diagnostics.service <<'UNIT'
    [Unit]
    Description=Refresh Chase Sets observability boot diagnostics
    Requires=docker.service
    After=docker.service chase-sets-observability.service

    [Service]
    Type=oneshot
    WorkingDirectory=/opt/chase-sets-observability
    ExecStart=/usr/local/bin/chase-sets-observability-diagnostics
    UNIT

    cat >/etc/systemd/system/chase-sets-observability-diagnostics.timer <<'UNIT'
    [Unit]
    Description=Refresh Chase Sets observability boot diagnostics after startup

    [Timer]
    OnBootSec=2min
    OnUnitActiveSec=2min
    AccuracySec=30s
    Unit=chase-sets-observability-diagnostics.service

    [Install]
    WantedBy=timers.target
    UNIT

    systemctl daemon-reload
    systemctl enable --now chase-sets-observability.service
    systemctl enable --now chase-sets-observability-diagnostics.timer
    docker image prune -af --filter until=72h || true
