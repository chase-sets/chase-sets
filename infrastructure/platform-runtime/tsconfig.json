{
  "extends": "../../tsconfig.vitest.json",
  "compilerOptions": {
    "rootDir": "../..",
    // TypeScript replaces inherited types; platform runtime also needs Node ambient types.
    "types": ["node", "vitest/globals"]
  },
  "include": ["*.ts", "../../contracts/**/*.ts", "../../bounded-contexts/**/*.ts", "../../infrastructure/**/*.ts"],
  "exclude": [
    "../../bounded-contexts/**/*.test.ts",
    "../../bounded-contexts/**/*.test.tsx",
    "../../bounded-contexts/**/*.tmp.*",
    "../../infrastructure/**/*.test.ts",
    "../../infrastructure/**/*.test.tsx"
  ]
}
