          "property": "visible",
          "assertion": {
            "equals": false
          }
        },
        {
          "identity": "scope-mobile-horizontal-overflow",
          "scope": "document",
          "property": "horizontal-overflow",
          "assertion": {
            "maximum": 1
          }
        }
      ],
      "artifact": "catalog-scope-cards-mobile"
    },
