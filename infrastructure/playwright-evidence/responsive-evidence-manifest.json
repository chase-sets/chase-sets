{
  "contract": "fail-closed-responsive-evidence",
  "schemaVersion": 1,
  "claims": [
    {
      "kind": "negative-control",
      "id": "hidden-accordion-target",
      "file": "deployables/marketplace/e2e/responsive-evidence-contract.spec.ts",
      "testTitle": "fails before capture when the exact accordion target is hidden @marketplace-browse",
      "route": {
        "name": "hidden accordion fixture",
        "path": "/responsive-evidence/hidden-accordion"
      },
      "fixture": {
        "identity": "responsive-evidence:hidden-accordion:v1"
      },
      "viewport": {
        "width": 390,
        "height": 844
      },
      "target": {
        "identity": "changed-grid-inside-accordion",
        "selector": "[data-evidence-target='changed-grid']",
        "populatedSelector": ":scope > [data-evidence-row]"
      },
      "measurements": [
        {
          "identity": "changed-grid-width",
          "scope": "target",
          "selector": ":scope",
          "property": "width",
          "assertion": {
            "minimum": 1
          }
        }
      ],
      "artifact": "hidden-accordion-target"
    },
    {
      "kind": "negative-control",
      "id": "zero-table-unrelated-list-item",
      "file": "deployables/marketplace/e2e/responsive-evidence-contract.spec.ts",
      "testTitle": "fails before capture when the exact table is empty despite an unrelated list item @marketplace-browse",
      "route": {
        "name": "empty scoped table fixture",
        "path": "/responsive-evidence/empty-table"
      },
      "fixture": {
        "identity": "responsive-evidence:empty-table-with-unrelated-list:v1"
      },
      "viewport": {
        "width": 820,
        "height": 900
      },
      "target": {
        "identity": "scoped-catalog-table",
        "selector": "[data-evidence-target='scope-table']",
        "populatedSelector": ":scope > tbody > tr"
      },
      "measurements": [
        {
          "identity": "scoped-table-width",
          "scope": "target",
          "selector": ":scope",
          "property": "width",
          "assertion": {
            "minimum": 1
          }
        }
      ],
      "artifact": "zero-table-unrelated-list-item"
    },
    {
      "kind": "claim",
      "id": "fixture-scope-cards-mobile",
      "file": "deployables/marketplace/e2e/responsive-evidence-contract.spec.ts",
      "testTitle": "records exact mobile card evidence at 390px @marketplace-browse",
      "route": {
        "name": "populated responsive scope fixture",
        "path": "/responsive-evidence/scope-transition"
      },
      "fixture": {
        "identity": "responsive-evidence:populated-scope-transition:v1"
      },
      "viewport": {
        "width": 390,
        "height": 844
      },
      "target": {
        "identity": "scoped-catalog-cards",
        "selector": "[data-evidence-target='scope-cards']",
        "populatedSelector": ":scope > [role='listitem']"
      },
      "measurements": [
        {
          "identity": "cards-fill-mobile-viewport",
          "scope": "target",
          "selector": ":scope",
          "property": "width",
          "assertion": {
            "equals": 390,
            "tolerance": 0.5
          }
        },
        {
          "identity": "mobile-primary-action-height",
          "scope": "target",
          "selector": ":scope [data-primary-action]",
          "property": "height",
          "assertion": {
            "equals": 44,
            "tolerance": 0.5
          }
        },
        {
          "identity": "tablet-table-is-hidden",
          "scope": "page",
          "selector": "[data-evidence-target='scope-table']",
          "property": "visible",
          "assertion": {
            "equals": false
          }
        },
        {
          "identity": "mobile-horizontal-overflow",
          "scope": "document",
          "property": "horizontal-overflow",
          "assertion": {
            "maximum": 0
          }
        }
      ],
      "artifact": "fixture-scope-cards-mobile"
    },
