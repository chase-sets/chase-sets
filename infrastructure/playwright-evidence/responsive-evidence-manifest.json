    {
      "kind": "claim",
      "id": "catalog-scope-cards-mobile",
      "file": "deployables/admin-web/e2e/catalog-scopes.spec.ts",
      "testTitle": "Scope Detail journey starts from populated cards at 390px @catalog-admin-scopes @catalog-admin-integrations",
      "route": {
        "name": "catalog scope-first landing",
        "path": "/catalog/scopes"
      },
      "fixture": {
