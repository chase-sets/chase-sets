{
  "name": "@chase-sets/platform-policy",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./index.ts",
    "./domain": "./domain.ts",
    "./define-policy": "./define-policy.ts",
    "./commands": "./commands.ts",
    "./consent-activation-authority": "./consent-activation-authority.ts",
