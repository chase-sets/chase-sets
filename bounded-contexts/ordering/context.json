{
  "contextName": "ordering",
  "packageName": "@chase-sets/ordering",
  "localeCatalogs": ["contracts/localization/locales/en/ordering.ts"],
  "ownedNouns": ["order", "postage-policy", "tax quote", "tax nexus readiness"],
  "streamPrefix": "ordering.",
  "apiBasePath": "/api/marketplace",
  "slices": ["orders", "postage-policies", "tax-quotes", "tax-nexus"],
  "allowedSupportDirectories": ["account-support", "request-support", "runtime-support", "seed-support", "ucp-support"],
  "publicExports": [".", "./context", "./routes/*", "./seed-support/*", "./server"],
  "allowedContextDependencies": ["@chase-sets/marketplace"],
  "seedRequirements": ["catalog", "identity", "inventory", "marketplace"],
  "eventSubscriptions": [
    {
      "sourceContextName": "identity",
      "projectionName": "ordering-account-projection",
      "subscriptionVersion": 1,
      "subscriptionName": "ordering.identity-account-projection",
      "eventTypes": [
        "identity.account.created",
        "identity.account.profile-updated",
        "identity.account.suspended",
        "identity.account.reactivated",
        "identity.account.closed"
      ],
      "order": 20,
      "projectionHandlerSetNames": ["ordering-account-projection"]
    },
    {
      "sourceContextName": "marketplace",
      "projectionName": "ordering-marketplace-supply-input-projection",
      "subscriptionVersion": 2,
      "filterToEventTypes": true,
      "eventTypes": [
        "marketplace.listing.created",
        "marketplace.listing.price-updated",
        "marketplace.listing.quantity-cap-updated",
        "marketplace.listing.purchase-limits-updated",
        "marketplace.listing.published",
        "marketplace.listing.paused",
        "marketplace.listing.withdrawn",
        "marketplace.seller-listing-availability.disabled",
        "marketplace.seller-listing-availability.enabled",
        "marketplace.seller-order-capacity.set",
        "marketplace.seller-order-capacity.cleared"
      ],
      "order": 30,
      "projectionHandlerSetNames": ["ordering-marketplace-supply-input-projection"]
    },
    {
      "sourceContextName": "catalog",
      "projectionName": "ordering-marketplace-supply-input-projection",
      "subscriptionVersion": 1,
      "filterToEventTypes": true,
      "eventTypes": ["catalog.catalog-item.product-measures-resolved"],
      "order": 31,
      "projectionHandlerSetNames": ["ordering-marketplace-supply-input-projection"]
    },
    {
      "sourceContextName": "inventory",
      "projectionName": "ordering-inventory-supply-input-projection",
      "subscriptionVersion": 1,
      "eventTypes": [
        "inventory.item.created",
        "inventory.item.adjusted",
        "inventory.hold.placed",
        "inventory.hold.converted",
        "inventory.hold.extended",
        "inventory.hold.released",
        "inventory.hold.expired"
      ],
      "order": 40,
      "projectionHandlerSetNames": ["ordering-inventory-supply-input-projection"]
    },
    {
      "sourceContextName": "fulfillment",
      "projectionName": "ordering-fulfillment-cancellation-inputs",
      "subscriptionVersion": 1,
      "eventTypes": [
        "fulfillment.shipment.created",
        "fulfillment.shipment.packing-started",
        "fulfillment.shipment.package-prepared",
        "fulfillment.shipment.label-attached",
        "fulfillment.shipment.dispatched",
        "fulfillment.shipment.cancelled"
      ],
      "order": 70,
      "projectionHandlerSetNames": ["ordering-fulfillment-cancellation-inputs"]
    },
    {
      "sourceContextName": "ordering",
      "projectionName": "ordering-order-review-opportunity-projection",
      "subscriptionVersion": 1,
      "filterToEventTypes": true,
      "eventTypes": ["ordering.order.created"],
      "order": 69,
      "projectionHandlerSetNames": ["ordering-order-review-opportunity-projection"]
    },
    {
      "sourceContextName": "fulfillment",
      "projectionName": "ordering-order-review-opportunity-projection",
      "subscriptionVersion": 1,
      "filterToEventTypes": true,
      "eventTypes": ["fulfillment.shipment.created", "fulfillment.shipment.delivered"],
      "order": 71,
      "projectionHandlerSetNames": ["ordering-order-review-opportunity-projection"]
    },
    {
      "sourceContextName": "platform-operations",
      "projectionName": "ordering-order-review-opportunity-projection",
      "subscriptionVersion": 1,
      "filterToEventTypes": true,
      "eventTypes": [
        "support.support-request.opened",
        "support.support-request.resolved",
        "support.support-request.cancelled"
      ],
      "order": 72,
      "projectionHandlerSetNames": ["ordering-order-review-opportunity-projection"]
    },
    {
      "sourceContextName": "marketplace",
      "projectionName": "ordering-order-review-opportunity-projection",
      "subscriptionVersion": 1,
      "filterToEventTypes": true,
      "eventTypes": ["marketplace.review.submitted", "marketplace.review.updated", "marketplace.review.withdrawn"],
      "order": 73,
      "projectionHandlerSetNames": ["ordering-order-review-opportunity-projection"]
    },
    {
      "sourceContextName": "payments",
      "projectionName": "ordering-order-money-timeline-projection",
      "subscriptionVersion": 1,
      "filterToEventTypes": true,
      "eventTypes": [
        "payments.refund-requested",
        "payments.refund-issued",
        "payments.refund-failed",
        "payments.payment-refunded"
      ],
      "order": 74,
      "projectionHandlerSetNames": ["ordering-order-money-timeline-projection"]
    },
    {
      "sourceContextName": "platform-operations",
      "projectionName": "ordering-order-money-timeline-projection",
      "subscriptionVersion": 1,
      "filterToEventTypes": true,
      "eventTypes": [
        "support.support-request.opened",
        "support.support-request.resolved",
        "support.support-request.closed",
        "support.support-request.cancelled"
      ],
      "order": 75,
      "projectionHandlerSetNames": ["ordering-order-money-timeline-projection"]
    },
    {
      "sourceContextName": "settlement",
      "projectionName": "ordering-order-money-timeline-projection",
      "subscriptionVersion": 1,
      "filterToEventTypes": true,
      "eventTypes": ["settlement.protection-coverage.settled.v1"],
      "order": 76,
      "projectionHandlerSetNames": ["ordering-order-money-timeline-projection"]
    }
  ],
  "eventReactions": [
    {
      "sourceContextName": "inventory",
      "reactionName": "ordering-inventory-reservation-outcomes",
      "subscriptionVersion": 1,
      "eventTypes": [
        "inventory.reservation.confirmed",
        "inventory.reservation.rejected",
        "inventory.reservation.released"
      ],
      "order": 45,
      "reactionHandlerSetNames": ["ordering-inventory-reservation-outcomes"],
      "idempotencyPolicy": "idempotent-command-dispatch",
      "retryPolicy": "retry-from-last-checkpoint",
      "failurePolicy": "surface-as-reaction-failure"
    },
    {
      "sourceContextName": "marketplace",
      "reactionName": "ordering-marketplace-offer-acceptance",
      "subscriptionVersion": 3,
      "filterToEventTypes": true,
      "eventTypes": ["marketplace.offer.accepted"],
      "order": 50,
      "reactionHandlerSetNames": ["ordering-marketplace-offer-acceptance"],
      "idempotencyPolicy": "idempotent-command-dispatch",
      "retryPolicy": "retry-from-last-checkpoint",
      "failurePolicy": "surface-as-reaction-failure"
    },
    {
      "sourceContextName": "payments",
      "reactionName": "ordering-payment-capture",
      "subscriptionVersion": 1,
      "eventTypes": [
        "payments.payment-created",
        "payments.payment-captured",
        "payments.payment-failed",
        "payments.payment-cancelled"
      ],
      "order": 60,
      "reactionHandlerSetNames": ["ordering-payment-capture"],
      "idempotencyPolicy": "idempotent-command-dispatch",
      "retryPolicy": "retry-from-last-checkpoint",
      "failurePolicy": "surface-as-reaction-failure"
    },
    {
      "sourceContextName": "platform-operations",
      "reactionName": "ordering-support-cancellation",
      "subscriptionVersion": 1,
      "filterToEventTypes": true,
      "eventTypes": ["support.support-request.resolved"],
      "order": 65,
      "reactionHandlerSetNames": ["ordering-support-cancellation"],
      "idempotencyPolicy": "idempotent-command-dispatch",
      "retryPolicy": "retry-from-last-checkpoint",
      "failurePolicy": "surface-as-reaction-failure"
    }
  ],
  "projectionGroups": [
    {
      "projectionName": "ordering-account-projection",
      "sourceContextNames": ["identity"],
      "ownedTables": ["ordering_account_pages"],
      "requiredDuringBootstrap": true,
      "resetStrategy": "replay-only"
    },
    {
      "projectionName": "ordering-marketplace-supply-input-projection",
      "sourceContextNames": ["marketplace", "catalog"],
      "ownedTables": ["ordering_market_listing_inputs"],
      "requiredDuringBootstrap": true,
      "resetStrategy": "replay-only"
    },
    {
      "projectionName": "ordering-inventory-supply-input-projection",
      "sourceContextNames": ["inventory"],
      "ownedTables": ["ordering_inventory_item_inputs", "ordering_inventory_hold_inputs"],
      "requiredDuringBootstrap": true,
      "resetStrategy": "replay-only"
    },
    {
      "projectionName": "ordering-inventory-reservation-outcomes",
      "handlerKind": "reaction",
      "sourceContextNames": ["inventory"],
      "ownedTables": [],
      "requiredDuringBootstrap": false,
      "resetStrategy": "replay-only"
    },
    {
      "projectionName": "ordering-order-projection",
      "sourceContextNames": ["ordering"],
      "ownedTables": ["ordering_order_pages", "ordering_order_line_pages", "ordering_order_hold_pages"],
      "requiredDuringBootstrap": false,
      "resetStrategy": "replay-only"
    },
    {
      "projectionName": "ordering-marketplace-offer-acceptance",
      "handlerKind": "reaction",
      "sourceContextNames": ["marketplace"],
      "ownedTables": ["ordering_offer_acceptance_inputs"],
      "requiredDuringBootstrap": false,
      "resetStrategy": "replay-only"
    },
    {
      "projectionName": "ordering-payment-capture",
      "handlerKind": "reaction",
      "sourceContextNames": ["payments"],
      "ownedTables": ["ordering_payment_capture_inputs", "ordering_payment_deadline_inputs"],
      "requiredDuringBootstrap": false,
      "resetStrategy": "replay-only"
    },
    {
      "projectionName": "ordering-support-cancellation",
      "handlerKind": "reaction",
      "sourceContextNames": ["platform-operations"],
      "ownedTables": [],
      "requiredDuringBootstrap": false,
      "resetStrategy": "replay-only"
    },
    {
      "projectionName": "ordering-fulfillment-cancellation-inputs",
      "sourceContextNames": ["fulfillment"],
      "ownedTables": ["ordering_fulfillment_cancellation_inputs"],
      "requiredDuringBootstrap": false,
      "resetStrategy": "replay-only"
    },
    {
      "projectionName": "ordering-order-review-opportunity-projection",
      "sourceContextNames": ["ordering", "fulfillment", "platform-operations", "marketplace"],
      "ownedTables": [
        "ordering_order_review_shipment_sources",
        "ordering_order_review_support_request_sources",
        "ordering_order_review_eligibility_pages",
        "ordering_order_review_pages"
      ],
      "requiredDuringBootstrap": false,
      "resetStrategy": "replay-only"
    },
    {
      "projectionName": "ordering-order-money-timeline-projection",
      "sourceContextNames": ["payments", "platform-operations", "settlement"],
      "ownedTables": [
        "ordering_order_refund_timeline_pages",
        "ordering_order_refund_totals",
        "ordering_order_support_money_pages",
        "ordering_order_hold_reconciliations"
      ],
      "requiredDuringBootstrap": false,
      "resetStrategy": "replay-only"
    },
    {
      "projectionName": "ordering-postage-policy-projection",
      "sourceContextNames": ["ordering"],
      "ownedTables": ["ordering_postage_policy_pages", "ordering_postage_policy_history"],
      "requiredDuringBootstrap": true,
      "resetStrategy": "replay-only"
    }
  ],
  "hostPorts": [
    {
      "portName": "taxQuoteResolver",
      "providedBy": "platform-api",
      "purpose": "Consume the provider-agnostic tax quote resolver owned by the Ordering tax-quotes slice when creating order tax snapshots."
    },
    {
      "portName": "notificationOutbox",
      "providedBy": "platform-worker",
      "purpose": "Durable outbound notification outbox consumed only by order event projectors."
    },
    {
      "portName": "authenticityFeePolicyResolver",
      "providedBy": "commercial-terms",
      "purpose": "Resolves the authenticity-check fee policy (m109 #4275) so Ordering can offer and freeze the buyer opt-in fee at checkout preview and order-creation time."
    },
    {
      "portName": "inventoryCleanupAuthority",
      "providedBy": "platform-api, platform-worker",
      "purpose": "Required available|not-mounted capability supplying Inventory's read-only reservation and Hold cleanup authority (#7222) so Ordering can decide cleanup from complete Inventory source streams without importing Inventory or reading a projection."
    }
  ],
  "apiDeployables": ["platform-api"],
  "sourceRuntimeDeployables": ["platform-api", "platform-worker"],
  "apiMounts": [
    {
      "mountPath": "/api/marketplace",
      "kind": "primary",
      "requiresAuth": true,
      "readFreshnessRoutes": [
        {
          "routePath": "/purchases/:id",
          "methods": ["GET", "HEAD"],
          "dependencies": [
            {
              "readModelTable": "ordering_order_pages"
            },
            {
              "readModelTable": "ordering_order_line_pages"
            },
            {
              "readModelTable": "ordering_order_hold_pages"
            },
            {
              "readModelTable": "ordering_order_review_eligibility_pages"
            },
            {
              "readModelTable": "ordering_order_review_pages"
            }
          ]
        },
        {
          "routePath": "/sales/:id",
          "methods": ["GET", "HEAD"],
          "dependencies": [
            {
              "readModelTable": "ordering_order_pages"
            },
            {
              "readModelTable": "ordering_order_line_pages"
            },
            {
              "readModelTable": "ordering_order_hold_pages"
            },
            {
              "readModelTable": "ordering_order_review_eligibility_pages"
            },
            {
              "readModelTable": "ordering_order_review_pages"
            }
          ]
        },
        {
          "routePath": "/sales",
          "methods": ["GET", "HEAD"],
          "dependencies": [
            {
              "projectionName": "ordering-marketplace-offer-acceptance"
            },
            {
              "readModelTable": "ordering_order_pages"
            },
            {
              "readModelTable": "ordering_order_line_pages"
            }
          ]
        },
        {
          "routePath": "/admin/postage-policies",
          "methods": ["GET", "HEAD"],
          "dependencies": [
            {
              "readModelTable": "ordering_postage_policy_pages"
            }
          ]
        },
        {
          "routePath": "/admin/postage-policies/:id",
          "methods": ["GET", "HEAD"],
          "dependencies": [
            {
              "readModelTable": "ordering_postage_policy_pages"
            },
            {
              "readModelTable": "ordering_postage_policy_history"
            }
          ]
        }
      ]
    }
  ],
  "mcpCapabilities": {
    "tools": [
      { "name": "ordering.list-orders", "ownerSlice": "orders" },
      { "name": "ordering.get-order", "ownerSlice": "orders" }
    ],
    "resources": [{ "uriTemplate": "chase-sets://ordering/{accountId}/orders/{orderId}", "ownerSlice": "orders" }]
  },
  "readAfterWriteRouteInventory": [
    {
      "id": "ordering.accepted-offer-to-sales-list",
      "owner": "ordering",
      "risk": "critical",
      "freshnessSlo": {
        "flowClass": "critical-customer-handoff",
        "p95Ms": 1000,
        "p99Ms": 2250
      },
      "source": {
        "routeId": "sell-checkout-confirmation",
        "actions": ["View committed sales after accepting an offer in seller checkout"],
        "command": "AcceptOfferMatch"
      },
      "destination": {
        "routeId": "account-sales",
        "apiContextName": "ordering",
        "apiRoutePath": "/sales",
        "readModelTables": ["ordering_order_pages", "ordering_order_line_pages"],
        "projectionDependencies": ["ordering-marketplace-offer-acceptance"],
        "freshnessDependencyReason": "The sales list must wait for the Marketplace accepted-offer process that creates the Ordering order, then wait on the Ordering-owned sale list read models when an Ordering receipt is present. Account and fulfillment joins are display/cancellation adornments and must not gate the accepted-offer handoff.",
        "helperUses": ["loadAfterWrite"],
        "transientRecovery": {
          "kinds": "refreshable-catching-up",
          "behavior": "Seller checkout confirmation preserves the Marketplace accepted-offer receipt on the Sales link; the Sales loader forwards that receipt to Ordering so accepted-offer inputs and order pages catch up before the seller sees the post-sale list."
        }
      }
    },
    {
      "id": "ordering.purchase-cancel-to-detail",
      "owner": "ordering",
      "risk": "important",
      "freshnessSlo": {
        "flowClass": "important-self-refresh",
        "p95Ms": 2500,
        "p99Ms": 5000
      },
      "source": {
        "routeId": "account-purchase",
        "actions": ["Cancel purchase"],
        "command": "CancelOrder",
        "helperUses": ["navigateAfterWrite"]
      },
      "destination": {
        "routeId": "account-purchase",
        "apiContextName": "ordering",
        "apiRoutePath": "/purchases/:id",
        "readModelTables": ["ordering_order_pages", "ordering_order_line_pages", "ordering_order_hold_pages"],
        "helperUses": ["loadAfterWrite"],
        "transientRecovery": {
          "kinds": "refreshable-catching-up",
          "behavior": "Purchase detail forwards the cancellation afterWrite receipt to Ordering and retries fresh-write not-found while the order projection records the cancelled status."
        }
      }
    },
    {
      "id": "ordering.sale-cancel-to-detail",
      "owner": "ordering",
      "risk": "important",
      "freshnessSlo": {
        "flowClass": "important-self-refresh",
        "p95Ms": 2500,
        "p99Ms": 5000
      },
      "source": {
        "routeId": "account-sale",
        "actions": ["Cancel sale"],
        "command": "CancelOrder",
        "helperUses": ["navigateAfterWrite"]
      },
      "destination": {
        "routeId": "account-sale",
        "apiContextName": "ordering",
        "apiRoutePath": "/sales/:id",
        "readModelTables": ["ordering_order_pages", "ordering_order_line_pages", "ordering_order_hold_pages"],
        "helperUses": ["loadAfterWrite"],
        "transientRecovery": {
          "kinds": "refreshable-catching-up",
          "behavior": "Sale detail forwards the cancellation afterWrite receipt to Ordering and retries fresh-write not-found while the order projection records the cancelled status."
        }
      }
    },
    {
      "id": "ordering.postage-policy-create-to-list",
      "owner": "ordering",
      "risk": "important",
      "freshnessSlo": {
        "flowClass": "important-self-refresh",
        "p95Ms": 2500,
        "p99Ms": 5000
      },
      "source": {
        "routeId": "ordering-postage-policies",
        "actions": ["Create postage policy draft"],
        "command": "CreatePostagePolicy",
        "helperUses": ["navigateAfterWrite"]
      },
      "destination": {
        "routeId": "ordering-postage-policies",
        "apiContextName": "ordering",
        "apiRoutePath": "/admin/postage-policies",
        "readModelTables": ["ordering_postage_policy_pages"],
        "helperUses": ["loadAfterWrite"],
        "transientRecovery": {
          "kinds": "refreshable-catching-up",
          "behavior": "Postage policy list forwards the create afterWrite receipt to Ordering so the new draft is present before the admin list renders."
        }
      }
    },
    {
      "id": "ordering.postage-policy-command-to-home",
      "owner": "ordering",
      "risk": "important",
      "freshnessSlo": {
        "flowClass": "important-self-refresh",
        "p95Ms": 2500,
        "p99Ms": 5000
      },
      "source": {
        "routeId": "ordering-postage-policies",
        "actions": [
          "Revise postage policy",
          "Activate postage policy",
          "Retire postage policy",
          "Clone postage policy"
        ],
        "command": "Postage policy lifecycle commands",
        "helperUses": ["navigateAfterWrite"]
      },
      "destination": {
        "routeId": "ordering-postage-policies",
        "apiContextName": "ordering",
        "apiRoutePath": "/admin/postage-policies/:id",
        "readModelTables": ["ordering_postage_policy_pages", "ordering_postage_policy_history"],
        "helperUses": ["loadAfterWrite"],
        "transientRecovery": {
          "kinds": "refreshable-catching-up",
          "behavior": "The postage policy home keeps the selected policy drawer open, forwards lifecycle afterWrite receipts to Ordering, and retries fresh-write not-found while page and history projections catch up."
        }
      }
    }
  ],
  "mutationConsistencyInventory": [
    {
      "id": "ordering.checkout-order-command-snapshots",
      "owner": "ordering",
      "risk": "critical",
      "strategy": "snapshot-return",
      "surfaces": [
        "api-route:bounded-contexts/ordering/features/orders/api/route.ts:POST /purchases/checkout",
        "api-route:bounded-contexts/ordering/features/orders/api/route.ts:POST /purchases/checkout/preview"
      ],
      "visibleDestination": {
        "description": "Checkout preview returns the command-owned fulfillment/economics snapshot; checkout confirmation returns created order IDs plus the Ordering commit receipt for downstream handoff."
      },
      "proof": {
        "authoritativeResponse": "previewCheckoutFulfillment returns the calculated package, shipping, tax, total, and material-change snapshot before order creation; createOrdersFromCheckout returns the committed order ids from the command and API commit receipt metadata.",
        "tests": ["bounded-contexts/ordering/features/orders/api/route.test.ts"]
      }
    },
    {
      "id": "ordering.order-cancel-command-snapshot",
      "owner": "ordering",
      "risk": "important",
      "strategy": "snapshot-return",
      "surfaces": [
        "api-route:bounded-contexts/ordering/features/orders/api/route.ts:POST /purchases/:id/cancel",
        "api-route:bounded-contexts/ordering/features/orders/api/route.ts:POST /sales/:id/cancel"
      ],
      "visibleDestination": {
        "description": "Purchase and sale cancellation endpoints return the cancelled order id, aggregate version, status, and commit receipt so callers can render or redirect without trusting a stale projection."
      },
      "proof": {
        "authoritativeResponse": "cancelPurchase and cancelSale return the command result version and the API route returns the cancelled status alongside commit receipt headers.",
        "tests": ["bounded-contexts/ordering/features/orders/api/route.test.ts"]
      }
    },
    {
      "id": "ordering.purchase-cancel-fresh-read",
      "owner": "ordering",
      "risk": "important",
      "strategy": "fresh-read",
      "surfaces": [
        "post-form:bounded-contexts/ordering/features/orders/ui/order-detail-page.tsx:H2df726441e2a#1",
        "route-action:bounded-contexts/ordering/routes/account-purchase.tsx"
      ],
      "visibleDestination": {
        "routeId": "account-purchase",
        "apiContextName": "ordering",
        "apiRoutePath": "/purchases/:id",
        "readModelTables": ["ordering_order_pages", "ordering_order_line_pages", "ordering_order_hold_pages"],
        "transientRecovery": {
          "kinds": "refreshable-catching-up",
          "behavior": "Purchase cancellation redirects back to purchase detail with afterWrite; the loader forwards the receipt to Ordering and retries fresh-write not-found until the order projection catches up or the token expires."
        }
      },
      "proof": {
        "tests": [
          "bounded-contexts/ordering/tests/account-purchase-route.test.tsx",
          "bounded-contexts/ordering/features/orders/ui/order-detail-page.test.tsx"
        ]
      }
    },
    {
      "id": "ordering.sale-cancel-fresh-read",
      "owner": "ordering",
      "risk": "important",
      "strategy": "fresh-read",
      "surfaces": ["route-action:bounded-contexts/ordering/routes/account-sale.tsx"],
      "visibleDestination": {
        "routeId": "account-sale",
        "apiContextName": "ordering",
        "apiRoutePath": "/sales/:id",
        "readModelTables": ["ordering_order_pages", "ordering_order_line_pages", "ordering_order_hold_pages"],
        "transientRecovery": {
          "kinds": "refreshable-catching-up",
          "behavior": "Sale cancellation redirects back to sale detail with afterWrite; the loader forwards the receipt to Ordering and retries fresh-write not-found until the order projection catches up or the token expires."
        }
      },
      "proof": {
        "tests": ["bounded-contexts/ordering/tests/account-sale-route.test.tsx"]
      }
    },
    {
      "id": "ordering.postage-policy-command-snapshots",
      "owner": "ordering",
      "risk": "important",
      "strategy": "snapshot-return",
      "surfaces": [
        "api-client:bounded-contexts/ordering/client.ts:POST H1cf225056a37#1",
        "api-client:bounded-contexts/ordering/client.ts:POST H6af656666ad9#1",
