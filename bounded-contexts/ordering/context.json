{
  "contextName": "ordering",
  "packageName": "@chase-sets/ordering",
  "ownedNouns": [
    "cart",
    "order"
  ],
  "streamPrefix": "ordering.",
  "apiBasePath": "/api/marketplace",
  "slices": [
    "cart",
    "orders",
    "accounts"
  ],
  "allowedSupportDirectories": [
    "request-support",
    "seed-support"
  ],
  "publicExports": [
    ".",
    "./context",
    "./routes/*",
    "./seed-support/*",
    "./server"
  ],
  "allowedContextDependencies": [
    "@chase-sets/catalog",
    "@chase-sets/reputation"
  ],
  "seedRequirements": [
    "catalog",
    "identity",
    "inventory",
    "marketplace"
  ],
  "eventSubscriptions": [
    {
      "sourceContextName": "catalog",
      "projectionName": "ordering-catalog-item-projection",
      "subscriptionVersion": 1,
      "projectorNames": [
        "ordering-catalog-item-projection"
      ],
      "eventTypes": [
        "catalog.catalog-item.created",
        "catalog.catalog-item.blueprint-assigned",
        "catalog.catalog-item.metadata-revised",
        "catalog.catalog-item.published",
        "catalog.catalog-item.retired",
        "catalog.catalog-item.archived",
        "catalog.blueprint.created",
        "catalog.blueprint.revised",
        "catalog.blueprint.dimensions-set",
        "catalog.blueprint.version-rules-set",
        "catalog.blueprint.published",
        "catalog.dimension.created",
        "catalog.dimension.revised",
        "catalog.dimension.choice-added",
        "catalog.dimension.choice-revised"
      ],
      "order": 10
    },
    {
      "sourceContextName": "identity",
      "projectionName": "ordering-account-projection",
      "subscriptionVersion": 1,
      "projectorNames": [
        "ordering-account-projection"
      ],
      "eventTypes": [
        "identity.account.created",
        "identity.account.profile-updated",
        "identity.account.suspended",
        "identity.account.reactivated",
        "identity.account.closed"
      ],
      "order": 20
    },
    {
      "sourceContextName": "marketplace",
      "projectionName": "ordering-marketplace-supply-input-projection",
      "subscriptionVersion": 1,
      "projectorNames": [
        "ordering-marketplace-supply-input-projection"
      ],
      "eventTypes": [
        "marketplace.listing.created",
        "marketplace.listing.price-updated",
        "marketplace.listing.quantity-cap-updated",
        "marketplace.listing.published",
        "marketplace.listing.paused",
        "marketplace.listing.withdrawn"
      ],
      "order": 30
    },
    {
      "sourceContextName": "inventory",
      "projectionName": "ordering-inventory-supply-input-projection",
      "subscriptionVersion": 1,
      "projectorNames": [
        "ordering-inventory-supply-input-projection"
      ],
      "eventTypes": [
        "inventory.record.created",
        "inventory.record.adjusted",
        "inventory.hold.placed",
        "inventory.hold.released"
      ],
      "order": 40
    },
    {
      "sourceContextName": "inventory",
      "projectionName": "ordering-inventory-reservation-outcomes",
      "subscriptionVersion": 1,
      "projectorNames": [
        "ordering-inventory-reservation-outcomes"
      ],
      "eventTypes": [
        "inventory.reservation.confirmed",
        "inventory.reservation.rejected",
        "inventory.reservation.released"
      ],
      "order": 45
    },
    {
      "sourceContextName": "marketplace",
      "projectionName": "ordering-marketplace-offer-acceptance",
      "subscriptionVersion": 1,
      "projectorNames": [
        "ordering-marketplace-offer-acceptance"
      ],
      "eventTypes": [
        "marketplace.offer.accepted"
      ],
      "order": 50
    },
    {
      "sourceContextName": "payments",
      "projectionName": "ordering-payment-capture",
      "subscriptionVersion": 1,
      "projectorNames": [
        "ordering-payment-capture"
      ],
      "eventTypes": [
        "payments.payment-captured"
      ],
      "order": 60
    }
  ],
  "projectionGroups": [
    {
      "projectionName": "ordering-catalog-item-projection",
      "sourceContextNames": [
        "catalog"
      ],
      "ownedTables": [
        "ordering_catalog_items",
        "ordering_catalog_blueprints",
        "ordering_catalog_dimensions",
        "ordering_catalog_dimension_choices"
      ],
      "requiredDuringBootstrap": true
    },
    {
      "projectionName": "ordering-account-projection",
      "sourceContextNames": [
        "identity"
      ],
      "ownedTables": [
        "ordering_account_pages"
      ],
      "requiredDuringBootstrap": true
    },
    {
      "projectionName": "ordering-marketplace-supply-input-projection",
      "sourceContextNames": [
        "marketplace"
      ],
      "ownedTables": [
        "ordering_market_listing_inputs"
      ],
      "requiredDuringBootstrap": true
    },
    {
      "projectionName": "ordering-inventory-supply-input-projection",
      "sourceContextNames": [
        "inventory"
      ],
      "ownedTables": [
        "ordering_inventory_record_inputs",
        "ordering_inventory_hold_inputs"
      ],
      "requiredDuringBootstrap": true
    },
    {
      "projectionName": "ordering-inventory-reservation-outcomes",
      "sourceContextNames": [
        "inventory"
      ],
      "ownedTables": [
        "ordering_order_pages",
        "ordering_order_hold_pages"
      ],
      "requiredDuringBootstrap": false
    },
    {
      "projectionName": "ordering-marketplace-offer-acceptance",
      "sourceContextNames": [
        "marketplace"
      ],
      "ownedTables": [
        "ordering_offer_acceptance_inputs"
      ],
      "requiredDuringBootstrap": false
    },
    {
      "projectionName": "ordering-payment-capture",
      "sourceContextNames": [
        "payments"
      ],
      "ownedTables": [
        "ordering_payment_capture_inputs"
      ],
      "requiredDuringBootstrap": false
    }
  ],
  "hostPorts": [],
  "apiDeployables": [
    "platform-api"
  ],
  "sourceRuntimeDeployables": [
    "platform-api"
  ],
  "apiMounts": [
    {
      "mountPath": "/api/marketplace",
      "kind": "primary",
      "requiresAuth": true,
      "drainProjectorsOnWrite": true
    }
  ],
  "deployableContributions": [
    {
      "deployable": "marketplace-web",
      "routes": [
        {
          "routeId": "account-cart",
          "routePath": "account/cart",
          "fileExport": "./routes/account-cart",
          "routeType": "route",
          "sourceContext": "ordering"
        },
        {
          "routeId": "account-order",
          "routePath": "account/orders/:orderId",
          "fileExport": "./routes/account-order",
          "routeType": "route",
          "sourceContext": "ordering"
        },
        {
          "routeId": "account-orders",
          "routePath": "account/orders",
          "fileExport": "./routes/account-orders",
          "routeType": "route",
          "sourceContext": "ordering"
        },
        {
          "routeId": "account-sale",
          "routePath": "account/sales/:orderId",
          "fileExport": "./routes/account-sale",
          "routeType": "route",
          "sourceContext": "ordering"
        },
        {
          "routeId": "account-sales",
          "routePath": "account/sales",
          "fileExport": "./routes/account-sales",
          "routeType": "route",
          "sourceContext": "ordering"
        }
      ]
    }
  ],
  "shellContributions": [
    {
      "deployable": "marketplace-web",
      "slot": "top-nav",
      "key": "cart",
      "label": "Cart",
      "icon": "cart",
      "href": "/account/cart",
      "order": 110,
      "visibility": "signed-in",
      "requiredPermissions": [
        "orders.manage"
      ]
    },
    {
      "deployable": "marketplace-web",
      "slot": "top-nav",
      "key": "orders",
      "label": "Orders",
      "icon": "cart",
      "href": "/account/orders",
      "order": 170,
      "visibility": "signed-in",
      "requiredPermissions": [
        "orders.view"
      ]
    },
    {
      "deployable": "marketplace-web",
      "slot": "top-nav",
      "key": "sales",
      "label": "Sales",
      "icon": "package",
      "href": "/account/sales",
      "order": 190,
      "visibility": "signed-in",
      "requiredPermissions": [
        "orders.view",
        "listings.view"
      ]
    },
    {
      "deployable": "marketplace-web",
      "slot": "bottom-nav",
      "key": "cart",
      "label": "Cart",
      "icon": "cart",
      "href": "/account/cart",
      "order": 110,
      "visibility": "signed-in",
      "requiredPermissions": [
        "orders.manage"
      ]
    },
    {
      "deployable": "marketplace-web",
      "slot": "bottom-nav",
      "key": "orders",
      "label": "Orders",
      "icon": "cart",
      "href": "/account/orders",
      "order": 170,
      "visibility": "signed-in",
      "requiredPermissions": [
        "orders.view"
      ]
    },
    {
      "deployable": "marketplace-web",
      "slot": "bottom-nav",
      "key": "sales",
      "label": "Sales",
      "icon": "package",
      "href": "/account/sales",
      "order": 190,
      "visibility": "signed-in",
      "requiredPermissions": [
        "orders.view",
        "listings.view"
      ]
    }
  ],
  "directoryIntent": {
    "cart": {
      "classification": "slice",
      "purpose": "Own cart feature behavior, read models, and UI contracts for the ordering context.",
      "allowedWhen": "Always; slice directories are the default root shape for implemented context features.",
      "expectedConsumers": [
        "Internal ordering module composition"
      ]
    },
    "orders": {
      "classification": "slice",
      "purpose": "Own orders feature behavior, read models, and UI contracts for the ordering context.",
      "allowedWhen": "Always; slice directories are the default root shape for implemented context features.",
      "expectedConsumers": [
        "Internal ordering module composition"
      ]
    },
    "accounts": {
      "classification": "slice",
      "purpose": "Own accounts feature behavior, read models, and UI contracts for the ordering context.",
      "allowedWhen": "Always; slice directories are the default root shape for implemented context features.",
      "expectedConsumers": [
        "Internal ordering module composition"
      ]
    },
    "request-support": {
      "classification": "support",
      "purpose": "Provide reusable request-support assets shared by multiple ordering slices.",
      "allowedWhen": "Allowed only when capability cannot stay inside one slice and cross-slice reuse is explicit.",
      "expectedConsumers": [
        "Multiple ordering slices",
        "Deployable composition for ordering"
      ],
      "justification": "request-support centralizes reusable context-local composition that should not duplicate across slices.",
      "createdFor": "Multi-slice ordering workflows that need shared runtime helpers.",
      "sunsetWhen": "Remove when all consumers can move the behavior back into slice-local modules."
    },
    "seed-support": {
      "classification": "support",
      "purpose": "Provide reusable seed-support assets shared by multiple ordering slices.",
      "allowedWhen": "Allowed only when capability cannot stay inside one slice and cross-slice reuse is explicit.",
      "expectedConsumers": [
        "Multiple ordering slices",
        "Deployable composition for ordering"
      ],
      "justification": "seed-support centralizes reusable context-local composition that should not duplicate across slices.",
      "createdFor": "Multi-slice ordering workflows that need shared runtime helpers.",
      "sunsetWhen": "Remove when all consumers can move the behavior back into slice-local modules."
    },
    "routes": {
      "classification": "routes",
      "purpose": "Expose ordering-owned route modules consumed by generated deployable adapters.",
      "allowedWhen": "Required whenever the context contributes routes to any deployable.",
      "expectedConsumers": [
        "Generated deployable route adapters"
      ]
    }
  }
}
