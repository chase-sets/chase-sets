{
  "contextName": "ordering",
  "packageName": "@chase-sets/ordering",
  "ownedNouns": [
    "cart",
    "order"
  ],
  "streamPrefix": "ordering.",
  "apiBasePath": "/api/marketplace",
  "slices": [
    "cart",
    "orders",
    "accounts"
  ],
  "allowedSupportDirectories": [
    "integration",
    "request-support",
    "seed-support"
  ],
  "publicExports": [
    ".",
    "./integration/*",
    "./routes/*",
    "./seed-support/*",
    "./server"
  ],
  "allowedContextDependencies": [
    "@chase-sets/catalog",
    "@chase-sets/reputation"
  ],
  "requiredPorts": [
    "inventoryReservations",
    "supplyResolver"
  ],
  "integrationCapabilities": [
    {
      "key": "ordering.order-snapshot-reader",
      "exportName": "createOrderSnapshotReader",
      "fileExport": "./integration/order-snapshot-reader",
      "kind": "runtime-port"
    },
    {
      "key": "ordering.buyer-gateway",
      "exportName": "createOrderingBuyerGateway",
      "fileExport": "./integration/buyer-gateway",
      "kind": "request-gateway"
    }
  ],
  "seedRequirements": [
    "catalog",
    "identity",
    "inventory",
    "marketplace"
  ],
  "apiRequirements": [
    {
      "capabilityKey": "marketplace.supply-resolver",
      "portName": "supplyResolver"
    },
    {
      "capabilityKey": "inventory.reservation-gateway",
      "portName": "inventoryReservations"
    }
  ],
  "hostPorts": [],
  "apiDeployables": [
    "marketplace-api"
  ],
  "apiMounts": [
    {
      "mountPath": "/api/marketplace",
      "kind": "primary",
      "requiresAuth": true,
      "drainProjectorsOnWrite": true
    }
  ],
  "deployableContributions": [
    {
      "deployable": "marketplace",
      "routes": [
        { "routeId": "account-cart", "routePath": "account/cart", "fileExport": "./routes/account-cart", "routeType": "route", "sourceContext": "ordering" },
        { "routeId": "account-order", "routePath": "account/orders/:orderId", "fileExport": "./routes/account-order", "routeType": "route", "sourceContext": "ordering" },
        { "routeId": "account-orders", "routePath": "account/orders", "fileExport": "./routes/account-orders", "routeType": "route", "sourceContext": "ordering" },
        { "routeId": "account-sale", "routePath": "account/sales/:orderId", "fileExport": "./routes/account-sale", "routeType": "route", "sourceContext": "ordering" },
        { "routeId": "account-sales", "routePath": "account/sales", "fileExport": "./routes/account-sales", "routeType": "route", "sourceContext": "ordering" }
      ]
    }
  ],
  "shellContributions": [
    { "deployable": "marketplace", "slot": "top-nav", "key": "cart", "label": "Cart", "icon": "cart", "href": "/account/cart", "order": 110, "visibility": "signed-in", "requiredPermissions": ["orders.manage"] },
    { "deployable": "marketplace", "slot": "top-nav", "key": "orders", "label": "Orders", "icon": "cart", "href": "/account/orders", "order": 170, "visibility": "signed-in", "requiredPermissions": ["orders.view"] },
    { "deployable": "marketplace", "slot": "top-nav", "key": "sales", "label": "Sales", "icon": "package", "href": "/account/sales", "order": 190, "visibility": "signed-in", "requiredPermissions": ["orders.view", "listings.view"] },
    { "deployable": "marketplace", "slot": "bottom-nav", "key": "cart", "label": "Cart", "icon": "cart", "href": "/account/cart", "order": 110, "visibility": "signed-in", "requiredPermissions": ["orders.manage"] },
    { "deployable": "marketplace", "slot": "bottom-nav", "key": "orders", "label": "Orders", "icon": "cart", "href": "/account/orders", "order": 170, "visibility": "signed-in", "requiredPermissions": ["orders.view"] },
    { "deployable": "marketplace", "slot": "bottom-nav", "key": "sales", "label": "Sales", "icon": "package", "href": "/account/sales", "order": 190, "visibility": "signed-in", "requiredPermissions": ["orders.view", "listings.view"] }
  ]
}
