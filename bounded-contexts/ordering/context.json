{
  "contextName": "ordering",
  "packageName": "@chase-sets/ordering",
  "ownedNouns": ["order", "postage-policy", "tax quote", "tax nexus readiness"],
  "streamPrefix": "ordering.",
  "apiBasePath": "/api/marketplace",
  "slices": ["orders", "postage-policies", "tax-quotes", "tax-nexus"],
  "allowedSupportDirectories": ["account-support", "request-support", "runtime-support", "seed-support", "ucp-support"],
  "publicExports": [".", "./context", "./routes/*", "./seed-support/*", "./server"],
  "allowedContextDependencies": ["@chase-sets/marketplace"],
  "seedRequirements": ["catalog", "identity", "inventory", "marketplace"],
  "eventSubscriptions": [
    {
      "sourceContextName": "identity",
      "projectionName": "ordering-account-projection",
      "subscriptionVersion": 1,
      "eventTypes": [
        "identity.account.created",
        "identity.account.profile-updated",
        "identity.account.suspended",
        "identity.account.reactivated",
        "identity.account.closed"
      ],
      "order": 20,
      "projectionHandlerSetNames": ["ordering-account-projection"]
    },
    {
      "sourceContextName": "marketplace",
      "projectionName": "ordering-marketplace-supply-input-projection",
      "subscriptionVersion": 1,
      "eventTypes": [
        "marketplace.listing.created",
        "marketplace.listing.price-updated",
        "marketplace.listing.quantity-cap-updated",
        "marketplace.listing.purchase-limits-updated",
        "marketplace.listing.published",
        "marketplace.listing.paused",
        "marketplace.listing.withdrawn",
        "marketplace.seller-listing-availability.disabled",
        "marketplace.seller-listing-availability.enabled"
      ],
      "order": 30,
      "projectionHandlerSetNames": ["ordering-marketplace-supply-input-projection"]
    },
    {
      "sourceContextName": "inventory",
      "projectionName": "ordering-inventory-supply-input-projection",
      "subscriptionVersion": 1,
      "eventTypes": [
        "inventory.item.created",
        "inventory.item.adjusted",
        "inventory.hold.placed",
        "inventory.hold.released"
      ],
      "order": 40,
      "projectionHandlerSetNames": ["ordering-inventory-supply-input-projection"]
    },
    {
      "sourceContextName": "inventory",
      "projectionName": "ordering-inventory-reservation-outcomes",
      "subscriptionVersion": 1,
      "eventTypes": [
        "inventory.reservation.confirmed",
        "inventory.reservation.rejected",
        "inventory.reservation.released"
      ],
      "order": 45,
      "projectionHandlerSetNames": ["ordering-inventory-reservation-outcomes"]
    },
    {
      "sourceContextName": "marketplace",
      "projectionName": "ordering-marketplace-offer-acceptance",
      "subscriptionVersion": 1,
      "eventTypes": ["marketplace.offer.accepted"],
      "order": 50,
      "projectionHandlerSetNames": ["ordering-marketplace-offer-acceptance"]
    },
    {
      "sourceContextName": "payments",
      "projectionName": "ordering-payment-capture",
      "subscriptionVersion": 1,
      "eventTypes": ["payments.payment-captured"],
      "order": 60,
      "projectionHandlerSetNames": ["ordering-payment-capture"]
    },
    {
      "sourceContextName": "fulfillment",
      "projectionName": "ordering-fulfillment-cancellation-inputs",
      "subscriptionVersion": 1,
      "eventTypes": [
        "fulfillment.shipment.created",
        "fulfillment.shipment.packing-started",
        "fulfillment.shipment.package-prepared",
        "fulfillment.shipment.label-attached",
        "fulfillment.shipment.dispatched",
        "fulfillment.shipment.cancelled"
      ],
      "order": 70,
      "projectionHandlerSetNames": ["ordering-fulfillment-cancellation-inputs"]
    }
  ],
  "projectionGroups": [
    {
      "projectionName": "ordering-account-projection",
      "sourceContextNames": ["identity"],
      "ownedTables": ["ordering_account_pages"],
      "requiredDuringBootstrap": true,
      "resetStrategy": "replay-only"
    },
    {
      "projectionName": "ordering-marketplace-supply-input-projection",
      "sourceContextNames": ["marketplace"],
      "ownedTables": ["ordering_market_listing_inputs"],
      "requiredDuringBootstrap": true,
      "resetStrategy": "replay-only"
    },
    {
      "projectionName": "ordering-inventory-supply-input-projection",
      "sourceContextNames": ["inventory"],
      "ownedTables": ["ordering_inventory_item_inputs", "ordering_inventory_hold_inputs"],
      "requiredDuringBootstrap": true,
      "resetStrategy": "replay-only"
    },
    {
      "projectionName": "ordering-inventory-reservation-outcomes",
      "sourceContextNames": ["inventory"],
      "ownedTables": ["ordering_order_pages", "ordering_order_hold_pages"],
      "requiredDuringBootstrap": false,
      "resetStrategy": "replay-only"
    },
    {
      "projectionName": "ordering-marketplace-offer-acceptance",
      "sourceContextNames": ["marketplace"],
      "ownedTables": ["ordering_offer_acceptance_inputs"],
      "requiredDuringBootstrap": false,
      "resetStrategy": "replay-only"
    },
    {
      "projectionName": "ordering-payment-capture",
      "sourceContextNames": ["payments"],
      "ownedTables": ["ordering_payment_capture_inputs"],
      "requiredDuringBootstrap": false,
      "resetStrategy": "replay-only"
    },
    {
      "projectionName": "ordering-fulfillment-cancellation-inputs",
      "sourceContextNames": ["fulfillment"],
      "ownedTables": ["ordering_fulfillment_cancellation_inputs"],
      "requiredDuringBootstrap": false,
      "resetStrategy": "replay-only"
    },
    {
      "projectionName": "ordering-postage-policy-projection",
      "sourceContextNames": ["ordering"],
      "ownedTables": ["ordering_postage_policy_pages", "ordering_postage_policy_history"],
      "requiredDuringBootstrap": true,
      "resetStrategy": "replay-only"
    }
  ],
  "hostPorts": [
    {
      "portName": "taxQuoteResolver",
      "providedBy": "platform-api",
      "purpose": "Consume the provider-agnostic tax quote resolver owned by the Ordering tax-quotes slice when creating order tax snapshots."
    },
    {
      "portName": "notificationOutbox",
      "providedBy": "platform-worker",
      "purpose": "Durable outbound notification outbox consumed only by order event projectors."
    }
  ],
  "apiDeployables": ["platform-api"],
  "sourceRuntimeDeployables": ["admin-support-api", "admin-support-worker", "platform-api"],
  "apiMounts": [
    {
      "mountPath": "/api/marketplace",
      "kind": "primary",
      "requiresAuth": true
    }
  ],
  "deployableContributions": [
    {
      "deployable": "admin-web",
      "routes": [
        {
          "routeId": "ordering-postage-policies",
          "routePath": "postage-policies",
          "fileExport": "./routes/admin/postage-policies",
          "routeType": "route",
          "sourceContext": "ordering",
          "section": "commerce"
        },
        {
          "routeId": "ordering-postage-policies-detail",
          "routePath": "postage-policies/:id",
          "fileExport": "./routes/admin/postage-policies-detail",
          "routeType": "route",
          "sourceContext": "ordering",
          "section": "commerce"
        }
      ]
    },
    {
      "deployable": "marketplace-web",
      "routes": [
        {
          "routeId": "account-purchase",
          "routePath": "account/purchases/:purchaseId",
          "fileExport": "./routes/account-purchase",
          "routeType": "route",
          "sourceContext": "ordering"
        },
        {
          "routeId": "account-purchases",
          "routePath": "account/purchases",
          "fileExport": "./routes/account-purchases",
          "routeType": "route",
          "sourceContext": "ordering"
        },
        {
          "routeId": "account-sale",
          "routePath": "account/sales/:orderId",
          "fileExport": "./routes/account-sale",
          "routeType": "route",
          "sourceContext": "ordering"
        },
        {
          "routeId": "account-sales",
          "routePath": "account/sales",
          "fileExport": "./routes/account-sales",
          "routeType": "route",
          "sourceContext": "ordering"
        }
      ]
    }
  ],
  "shellContributions": [
    {
      "deployable": "admin-web",
      "slot": "primary-nav",
      "key": "postage-policies",
      "label": "Postage Policies",
      "icon": "settings",
      "href": "/postage-policies",
      "section": "commerce",
      "order": 75,
      "visibility": "signed-in",
      "requiredPermissions": ["postage-policies.view"]
    },
    {
      "deployable": "marketplace-web",
      "slot": "top-nav",
      "key": "purchases",
      "label": "Purchases",
      "icon": "bag",
      "href": "/account/purchases",
      "order": 170,
      "visibility": "signed-in",
      "requiredPermissions": ["orders.view"]
    },
    {
      "deployable": "marketplace-web",
      "slot": "top-nav",
      "key": "sales",
      "label": "Sales",
      "icon": "dollar",
      "href": "/account/sales",
      "order": 190,
      "visibility": "signed-in",
      "requiredPermissions": ["orders.view", "listings.view"]
    },
    {
      "deployable": "marketplace-web",
      "slot": "bottom-nav",
      "key": "purchases",
      "label": "Purchases",
      "icon": "bag",
      "href": "/account/purchases",
      "order": 170,
      "visibility": "signed-in",
      "requiredPermissions": ["orders.view"]
    },
    {
      "deployable": "marketplace-web",
      "slot": "bottom-nav",
      "key": "sales",
      "label": "Sales",
      "icon": "dollar",
      "href": "/account/sales",
      "order": 190,
      "visibility": "signed-in",
      "requiredPermissions": ["orders.view", "listings.view"]
    }
  ],
  "directoryIntent": {
    "orders": {
      "classification": "slice",
      "purpose": "Own orders feature behavior, read models, and UI contracts for the ordering context.",
      "expectedConsumers": ["Internal ordering module composition"]
    },
    "postage-policies": {
      "classification": "slice",
      "purpose": "Own postage-policy behavior, active policy resolution, admin lifecycle commands, read models, and UI contracts for Ordering package-plan policy.",
      "expectedConsumers": ["Internal ordering module composition", "Ordering order creation"]
    },
    "tax-quotes": {
      "classification": "slice",
      "purpose": "Own provider-agnostic tax quote contracts, local quote behavior, and future provider integration shape used by Ordering order tax snapshots.",
      "expectedConsumers": ["Ordering order creation", "Platform API tax quote resolver composition"]
    },
    "tax-nexus": {
      "classification": "slice",
      "purpose": "Own sales tax nexus thresholds, collection-readiness posture, and provider-dependency tracking behind order tax quotes.",
      "expectedConsumers": ["Tax launch readiness review", "Platform API production tax quote gating"]
    },
    "account-support": {
      "classification": "support",
      "purpose": "Provide reusable account-support assets shared by ordering-owned features and composition seams.",
      "expectedConsumers": ["orders"]
    },
    "request-support": {
      "classification": "support",
      "purpose": "Provide reusable request-support assets shared by ordering-owned features and composition seams.",
      "expectedConsumers": ["postage-policies"],
      "crossCuttingRuntimeComposition": true
    },
    "runtime-support": {
      "classification": "support",
      "purpose": "Provide reusable runtime-support assets shared by ordering-owned features and composition seams.",
      "expectedConsumers": ["orders"]
    },
    "seed-support": {
      "classification": "support",
      "purpose": "Provide reusable seed-support assets shared by ordering-owned features and composition seams.",
      "expectedConsumers": ["Multiple ordering slices", "Deployable composition for ordering"],
      "crossCuttingRuntimeComposition": true
    },
    "ucp-support": {
      "classification": "support",
      "purpose": "Provide Ordering-owned UCP order read adapters over purchase and sale projections while UCP stays a protocol facade.",
      "expectedConsumers": ["Platform UCP route composition"]
    },
    "routes": {
      "classification": "routes",
      "purpose": "Expose ordering-owned route modules consumed by generated deployable adapters.",
      "expectedConsumers": ["Generated deployable route adapters"]
    }
  },
  "runtimeDeployables": ["platform-worker"]
}
