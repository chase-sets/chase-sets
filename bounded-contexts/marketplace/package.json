{
  "name": "@chase-sets/marketplace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "vitest run --config ./tests/vitest.config.mjs",
    "test:unit": "vitest run --config ./tests/vitest.config.mjs --exclude features/reviews/tests/review-eligibility-sql.db.test.ts --exclude features/seller-metrics/tests/behavioral-metrics-sql.db.test.ts --exclude features/listings/tests/seller-availability-restore-sweep-sql.db.test.ts",
    "test:db": "vitest run --config ./tests/vitest.config.mjs features/reviews/tests/review-eligibility-sql.db.test.ts features/seller-metrics/tests/behavioral-metrics-sql.db.test.ts features/listings/tests/seller-availability-restore-sweep-sql.db.test.ts",
    "test:watch": "vitest --config ./tests/vitest.config.mjs"
  },
  "chaseSets": {
    "testProfile": "db"
  },
  "exports": {
    ".": "./index.ts",
    "./context": "./context.json",
    "./routes/*": "./routes/*.tsx",
    "./seed-support/*": "./support/seed-support/*.ts",
    "./server": "./server.ts",
    "./web": "./web.ts"
  },
  "types": "./index.ts",
  "dependencies": {
    "@chase-sets/auth-context": "workspace:*",
    "@chase-sets/bounded-context-module": "workspace:*",
    "@chase-sets/bounded-context-runtime": "workspace:*",
    "@chase-sets/seller-attention-queue": "workspace:*",
    "@chase-sets/seller-desk": "workspace:*",
    "@chase-sets/catalog-seed": "workspace:*",
    "@chase-sets/commercial-terms": "workspace:*",
    "@chase-sets/customer-feedback": "workspace:*",
    "@chase-sets/design-system": "workspace:*",
    "@chase-sets/event-core": "workspace:*",
    "@chase-sets/event-core-postgres": "workspace:*",
    "@chase-sets/http": "workspace:*",
    "@chase-sets/identity": "workspace:*",
    "@chase-sets/inventory": "workspace:*",
    "@chase-sets/localization": "workspace:*",
    "@chase-sets/notification-outbox": "workspace:*",
    "@chase-sets/outbound-messaging": "workspace:*",
    "@chase-sets/platform-operations": "workspace:*",
    "@chase-sets/platform-policy": "workspace:*",
    "@chase-sets/platform-runtime": "workspace:*",
    "@chase-sets/primitives": "workspace:*",
    "@chase-sets/product-measures": "workspace:*",
    "@chase-sets/product-selection": "workspace:*",
    "@chase-sets/review-eligibility": "workspace:*",
    "hono": "^4.12.12",
    "sharp": "^0.34.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "vitest": "^4.1.4"
  }
}
