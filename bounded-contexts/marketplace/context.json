{
  "contextName": "marketplace",
  "packageName": "@chase-sets/marketplace",
  "ownedNouns": ["listing", "offer", "seller-listing-availability", "review", "review-summary"],
  "streamPrefix": "marketplace.",
  "apiBasePath": "/api/marketplace",
  "slices": ["listings", "offers", "reviews"],
  "allowedSupportDirectories": [
    "request-support",
    "realtime-support",
    "route-support",
    "runtime-support",
    "seed-support"
  ],
  "publicExports": [".", "./context", "./routes/*", "./seed-support/*", "./server"],
  "allowedContextDependencies": [
    "@chase-sets/commercial-terms",
    "@chase-sets/identity",
    "@chase-sets/inventory",
    "@chase-sets/platform-operations"
  ],
  "seedRequirements": ["catalog", "commercial-terms", "identity", "inventory"],
  "eventSubscriptions": [
    {
      "sourceContextName": "catalog",
      "projectionName": "marketplace-catalog-item-projection",
      "subscriptionVersion": 3,
      "eventTypes": [
        "catalog.catalog-item.created",
        "catalog.catalog-item.blueprint-assigned",
        "catalog.catalog-item.display-identity-resolved",
        "catalog.catalog-item.published",
        "catalog.catalog-item.retired",
        "catalog.catalog-item.archived",
        "catalog.catalog-item.product-measures-resolved",
        "catalog.blueprint.created",
        "catalog.blueprint.revised",
        "catalog.blueprint.dimensions-set",
        "catalog.blueprint.product-resolution-rules-set",
        "catalog.blueprint.published",
        "catalog.dimension.created",
        "catalog.dimension.revised",
        "catalog.dimension.option-added",
        "catalog.dimension.option-revised"
      ],
      "order": 10,
      "projectionHandlerSetNames": ["marketplace-catalog-item-projection"]
    },
    {
      "sourceContextName": "identity",
      "projectionName": "marketplace-identity-account-projection",
      "subscriptionVersion": 1,
      "eventTypes": [
        "identity.account.created",
        "identity.account.profile-updated",
        "identity.account.suspended",
        "identity.account.reactivated",
        "identity.account.closed",
        "identity.account.badge-assigned",
        "identity.account.badge-removed"
      ],
      "order": 20,
      "projectionHandlerSetNames": ["marketplace-identity-account-projection"]
    },
    {
      "sourceContextName": "inventory",
      "projectionName": "marketplace-inventory-supply-projection",
      "subscriptionVersion": 1,
      "eventTypes": [
        "inventory.storage-location.created",
        "inventory.storage-location.updated",
        "inventory.storage-location.archived",
        "inventory.item.created",
        "inventory.item.adjusted",
        "inventory.hold.placed",
        "inventory.hold.released"
      ],
      "order": 30,
      "projectionHandlerSetNames": ["marketplace-inventory-supply-projection"]
    },
    {
      "sourceContextName": "marketplace",
      "projectionName": "marketplace-identity-account-projection",
      "subscriptionVersion": 1,
      "eventTypes": ["reputation.review.submitted", "reputation.review.updated", "reputation.review.withdrawn"],
      "order": 40,
      "projectionHandlerSetNames": ["marketplace-identity-account-projection"]
    },
    {
      "sourceContextName": "identity",
      "projectionName": "reputation-account-projection",
      "subscriptionVersion": 1,
      "eventTypes": [
        "identity.account.created",
        "identity.account.profile-updated",
        "identity.account.suspended",
        "identity.account.reactivated",
        "identity.account.closed"
      ],
      "order": 50,
      "projectionHandlerSetNames": ["reputation-account-projection"]
    },
    {
      "sourceContextName": "ordering",
      "projectionName": "reputation-order-source-projection",
      "subscriptionVersion": 1,
      "eventTypes": [
        "ordering.order.created",
        "ordering.order.pending-payment-recorded",
        "ordering.order.cancelled",
        "ordering.order.ready-for-fulfillment-recorded"
      ],
      "order": 60,
      "projectionHandlerSetNames": ["reputation-order-source-projection"]
    },
    {
      "sourceContextName": "fulfillment",
      "projectionName": "reputation-shipment-source-projection",
      "subscriptionVersion": 1,
      "eventTypes": [
        "fulfillment.shipment.created",
        "fulfillment.shipment.dispatched",
        "fulfillment.shipment.delivered",
        "fulfillment.shipment.returned",
        "fulfillment.shipment.exception-raised"
      ],
      "order": 70,
      "projectionHandlerSetNames": ["reputation-shipment-source-projection"]
    },
    {
      "sourceContextName": "platform-operations",
      "projectionName": "reputation-support-source-projection",
      "subscriptionVersion": 1,
      "eventTypes": [
        "support.support-request.opened",
        "support.support-request.resolved",
        "support.support-request.cancelled"
      ],
      "order": 90,
      "projectionHandlerSetNames": ["reputation-support-source-projection"]
    }
  ],
  "projectionGroups": [
    {
      "projectionName": "marketplace-catalog-item-projection",
      "sourceContextNames": ["catalog"],
      "ownedTables": [
        "marketplace_catalog_items",
        "marketplace_catalog_blueprints",
        "marketplace_catalog_dimensions",
        "marketplace_catalog_dimension_options"
      ],
      "requiredDuringBootstrap": true,
      "resetStrategy": "replay-only"
    },
    {
      "projectionName": "marketplace-identity-account-projection",
      "sourceContextNames": ["identity", "marketplace"],
      "ownedTables": ["marketplace_account_pages", "marketplace_account_reviews"],
      "requiredDuringBootstrap": true,
      "resetStrategy": "replay-only"
    },
    {
      "projectionName": "marketplace-inventory-supply-projection",
      "sourceContextNames": ["inventory"],
      "ownedTables": ["marketplace_supply_locations", "marketplace_supply_items", "marketplace_supply_holds"],
      "requiredDuringBootstrap": true,
      "resetStrategy": "replay-only"
    },
    {
      "projectionName": "marketplace-listing-projection",
      "sourceContextNames": ["marketplace"],
      "ownedTables": ["marketplace_listing_pages", "marketplace_seller_listing_availability_pages"],
      "requiredDuringBootstrap": false,
      "resetStrategy": "truncate-owned-tables"
    },
    {
      "projectionName": "marketplace-offer-projection",
      "sourceContextNames": ["marketplace"],
      "ownedTables": ["marketplace_offer_pages"],
      "requiredDuringBootstrap": false,
      "resetStrategy": "truncate-owned-tables"
    },
    {
      "projectionName": "reputation-account-projection",
      "sourceContextNames": ["identity"],
      "ownedTables": ["reputation_account_pages"],
      "requiredDuringBootstrap": true,
      "resetStrategy": "replay-only"
    },
    {
      "projectionName": "reputation-order-source-projection",
      "sourceContextNames": ["ordering"],
      "ownedTables": ["reputation_order_sources"],
      "requiredDuringBootstrap": true,
      "resetStrategy": "replay-only"
    },
    {
      "projectionName": "reputation-shipment-source-projection",
      "sourceContextNames": ["fulfillment"],
      "ownedTables": ["reputation_shipment_sources"],
      "requiredDuringBootstrap": true,
      "resetStrategy": "replay-only"
    },
    {
      "projectionName": "reputation-support-source-projection",
      "sourceContextNames": ["platform-operations"],
      "ownedTables": ["reputation_review_eligibility_pages"],
      "requiredDuringBootstrap": false,
      "resetStrategy": "replay-only"
    }
  ],
  "hostPorts": [
    {
      "portName": "commercialTermsResolver",
      "providedBy": "commercial-terms",
      "purpose": "Resolve account listing terms without making Marketplace own commercial terms policy."
    },
    {
      "portName": "listingPhotoStorage",
      "providedBy": "platform-api",
      "purpose": "Store normalized Marketplace Listing Photo WebP assets in the environment asset bucket without making Marketplace own object-storage infrastructure."
    }
  ],
  "apiDeployables": ["platform-api"],
  "apiMounts": [
    {
      "mountPath": "/api/marketplace",
      "kind": "primary",
      "requiresAuth": true,
      "readFreshnessRoutes": [
        {
          "routePath": "/account/listings/:id",
          "methods": ["GET", "HEAD"],
          "dependencies": [
            {
              "readModelTable": "marketplace_listing_pages"
            }
          ]
        },
        {
          "routePath": "/account/offers/submitted/:id",
          "methods": ["GET", "HEAD"],
          "dependencies": [
            {
              "readModelTable": "marketplace_offer_pages"
            }
          ]
        }
      ]
    },
    {
      "mountPath": "/api/marketplace",
      "kind": "additional",
      "requiresAuth": true
    }
  ],
  "readAfterWriteRouteInventory": [
    {
      "id": "marketplace.listing-create-to-detail",
      "owner": "marketplace",
      "risk": "critical",
      "source": {
        "routeIds": ["account-listings", "account-listing"],
        "actions": ["Create listing", "Update listing", "Publish listing"],
        "command": "Marketplace listing commands",
        "helperUses": ["appendFreshWriteToken"]
      },
      "destination": {
        "routeId": "account-listing",
        "apiContextName": "marketplace",
        "apiRoutePath": "/account/listings/:id",
        "readModelTables": ["marketplace_listing_pages"],
        "helperUses": ["loadFreshlyWrittenResource"],
        "transientRecovery": "Listing detail loader retries fresh-write not-found while the marketplace listing projection catches up."
      }
    },
    {
      "id": "marketplace.listing-list-self-refresh",
      "owner": "marketplace",
      "risk": "important",
      "source": {
        "routeId": "account-listings",
        "actions": [
          "Disable seller listing availability",
          "Enable seller listing availability",
          "Create listing and return to list"
        ],
        "command": "Marketplace listing list commands",
        "helperUses": ["appendFreshWriteToken"]
      },
      "destination": {
        "routeId": "account-listings",
        "transientRecovery": "List refresh still needs exact dependency classification for listing and seller-availability read models."
      },
      "exception": {
        "status": "accepted",
        "owner": "marketplace",
        "reviewBy": "2026-07-31",
        "reason": "Marketplace list self-refresh migration is tracked by #1084; the helper use is represented so new drift fails closed."
      }
    },
    {
      "id": "marketplace.submitted-offer-detail",
      "owner": "marketplace",
      "risk": "important",
      "source": {
        "routeId": "account-offer-submitted",
        "actions": ["Load newly submitted offer"],
        "command": "SubmitOffer",
        "helperUses": ["loadFreshlyWrittenResource"]
      },
      "destination": {
        "routeId": "account-offer-submitted",
        "apiContextName": "marketplace",
        "apiRoutePath": "/account/offers/submitted/:id",
        "readModelTables": ["marketplace_offer_pages"],
        "helperUses": ["loadFreshlyWrittenResource"],
        "transientRecovery": "Submitted Offer detail uses exact Marketplace offer-page freshness and bounded fresh-write not-found retry."
      }
    },
    {
      "id": "reputation.review-submit-to-detail",
      "owner": "marketplace",
      "risk": "important",
      "source": {
        "routeIds": ["account-purchase-review", "account-sale-review"],
        "actions": ["Submit purchase review", "Submit sale review"],
        "command": "SubmitReview"
      },
      "destination": {
        "routeId": "account-review",
        "helperUses": ["loadFreshlyWrittenResource"],
        "transientRecovery": "Review detail uses compatibility fresh-write recovery while exact review read-model dependencies are audited."
      },
      "exception": {
        "status": "accepted",
        "owner": "marketplace",
        "reviewBy": "2026-07-31",
        "reason": "Review detail projection dependency and shared route-support helper migration is tracked by #1084.",
        "files": ["bounded-contexts/marketplace/support/route-support/review-submission-route.tsx"],
        "helperUses": ["appendFreshWriteToken"]
      }
    }
  ],
  "deployableContributions": [
    {
      "deployable": "marketplace-web",
      "routes": [
        {
          "routeId": "account-listing",
          "routePath": "account/listings/:listingId",
          "fileExport": "./routes/account-listing",
          "routeType": "route",
          "sourceContext": "marketplace"
        },
        {
          "routeId": "account-listings",
          "routePath": "account/listings",
          "fileExport": "./routes/account-listings",
          "routeType": "route",
          "sourceContext": "marketplace"
        },
        {
          "routeId": "account-offer-match",
          "routePath": "account/offers/matches/:offerId",
          "fileExport": "./routes/account-offer-match",
          "routeType": "route",
          "sourceContext": "marketplace"
        },
        {
          "routeId": "account-offer-matches",
          "routePath": "account/offers/matches",
          "fileExport": "./routes/account-offer-matches",
          "routeType": "route",
          "sourceContext": "marketplace"
        },
        {
          "routeId": "account-offer-submitted",
          "routePath": "account/offers/submitted/:offerId",
          "fileExport": "./routes/account-offer-submitted",
          "routeType": "route",
          "sourceContext": "marketplace"
        },
        {
          "routeId": "account-offers-submitted",
          "routePath": "account/offers/submitted",
          "fileExport": "./routes/account-offers-submitted",
          "routeType": "route",
          "sourceContext": "marketplace"
        },
        {
          "routeId": "account-purchase-review",
          "routePath": "account/purchases/:purchaseId/review",
          "fileExport": "./routes/marketplace/account-purchase-review",
          "routeType": "route",
          "sourceContext": "marketplace"
        },
        {
          "routeId": "account-received-reviews",
          "routePath": "account/reviews/received",
          "fileExport": "./routes/marketplace/account-received-reviews",
          "routeType": "route",
          "sourceContext": "marketplace"
        },
        {
          "routeId": "account-review-summary",
          "routePath": "account/reviews",
          "fileExport": "./routes/marketplace/account-review-summary",
          "routeType": "route",
          "sourceContext": "marketplace"
        },
        {
          "routeId": "account-review",
          "routePath": "account/reviews/:reviewId",
          "fileExport": "./routes/marketplace/account-review",
          "routeType": "route",
          "sourceContext": "marketplace"
        },
        {
          "routeId": "account-sale-review",
          "routePath": "account/sales/:orderId/review",
          "fileExport": "./routes/marketplace/account-sale-review",
          "routeType": "route",
          "sourceContext": "marketplace"
        },
        {
          "routeId": "account-written-reviews",
          "routePath": "account/reviews/written",
          "fileExport": "./routes/marketplace/account-written-reviews",
          "routeType": "route",
          "sourceContext": "marketplace"
        }
      ]
    }
  ],
  "shellContributions": [
    {
      "deployable": "marketplace-web",
      "slot": "top-nav",
      "key": "reviews",
      "label": "Reviews",
      "icon": "star",
      "href": "/account/reviews",
      "order": 160,
      "visibility": "signed-in",
      "requiredPermissions": ["reputation.view"]
    },
    {
      "deployable": "marketplace-web",
      "slot": "bottom-nav",
      "key": "reviews",
      "label": "Reviews",
      "icon": "star",
      "href": "/account/reviews",
      "order": 160,
      "visibility": "signed-in",
      "requiredPermissions": ["reputation.view"]
    },
    {
      "deployable": "marketplace-web",
      "slot": "top-nav",
      "placements": ["top-nav", "bottom-nav"],
      "key": "listings",
      "label": "Listings",
      "icon": "store",
      "href": "/account/listings",
      "order": 120,
      "visibility": "signed-in",
      "requiredPermissions": ["listings.view"]
    },
    {
      "deployable": "marketplace-web",
      "slot": "top-nav",
      "placements": ["top-nav", "bottom-nav"],
      "key": "offer-matches",
      "label": "Offer Matches",
      "icon": "tag",
      "href": "/account/offers/matches",
      "order": 130,
      "visibility": "signed-in",
      "requiredPermissions": ["offers.view", "listings.view"]
    },
    {
      "deployable": "marketplace-web",
      "slot": "top-nav",
      "placements": ["top-nav", "bottom-nav"],
      "key": "submitted-offers",
      "label": "Submitted Offers",
      "icon": "message",
      "href": "/account/offers/submitted",
      "order": 140,
      "visibility": "signed-in",
      "requiredPermissions": ["offers.view"]
    }
  ],
  "directoryIntent": {
    "listings": {
      "classification": "slice",
      "purpose": "Own listings feature behavior, read models, and UI contracts for the marketplace context.",
      "expectedConsumers": ["Internal marketplace module composition"]
    },
    "offers": {
      "classification": "slice",
      "purpose": "Own offers feature behavior, read models, and UI contracts for the marketplace context.",
      "expectedConsumers": ["Internal marketplace module composition"]
    },
    "reviews": {
      "classification": "slice",
      "purpose": "Own post-transaction review behavior, review-summary read models, review eligibility, and UI contracts for the marketplace context.",
      "expectedConsumers": ["Internal marketplace module composition"]
    },
    "route-support": {
      "classification": "support",
      "purpose": "Provide shared Marketplace review-submission route composition for purchase and sale routes that differ only by entry path and not-found copy.",
      "expectedConsumers": ["routes"]
    },
    "request-support": {
      "classification": "support",
      "purpose": "Provide reusable request-support assets shared by marketplace-owned features and composition seams.",
      "expectedConsumers": ["listings", "offers"],
      "crossCuttingRuntimeComposition": true
    },
    "realtime-support": {
      "classification": "support",
      "purpose": "Provide Marketplace-owned realtime patch helpers shared by listings and offers account route modules.",
      "expectedConsumers": ["listings", "offers"]
    },
    "runtime-support": {
      "classification": "support",
      "purpose": "Provide reusable runtime-support assets shared by marketplace-owned features and composition seams.",
      "expectedConsumers": ["listings", "offers"]
    },
    "seed-support": {
      "classification": "support",
      "purpose": "Provide reusable seed-support assets shared by marketplace-owned features and composition seams.",
      "expectedConsumers": ["Multiple marketplace slices", "Deployable composition for marketplace"],
      "crossCuttingRuntimeComposition": true
    },
    "routes": {
      "classification": "routes",
      "purpose": "Expose marketplace-owned route modules consumed by generated deployable adapters.",
      "expectedConsumers": ["Generated deployable route adapters"]
    }
  },
  "runtimeDeployables": ["platform-worker"]
}
