{
  "contextName": "marketplace",
  "packageName": "@chase-sets/marketplace",
  "ownedNouns": ["listing", "offer", "seller-listing-availability", "review", "review-summary"],
  "streamPrefix": "marketplace.",
  "apiBasePath": "/api/marketplace",
  "slices": ["listings", "offers", "reviews"],
  "allowedSupportDirectories": [
    "request-support",
    "realtime-support",
    "route-support",
    "runtime-support",
    "seed-support"
  ],
  "publicExports": [".", "./context", "./routes/*", "./seed-support/*", "./server"],
  "allowedContextDependencies": [
    "@chase-sets/commercial-terms",
    "@chase-sets/identity",
    "@chase-sets/inventory",
    "@chase-sets/platform-operations"
  ],
  "seedRequirements": ["catalog", "commercial-terms", "identity", "inventory"],
  "eventSubscriptions": [
    {
      "sourceContextName": "catalog",
      "projectionName": "marketplace-catalog-item-projection",
      "subscriptionVersion": 3,
      "eventTypes": [
        "catalog.catalog-item.created",
        "catalog.catalog-item.blueprint-assigned",
        "catalog.catalog-item.display-identity-resolved",
        "catalog.catalog-item.published",
        "catalog.catalog-item.retired",
        "catalog.catalog-item.archived",
        "catalog.catalog-item.product-measures-resolved",
        "catalog.blueprint.created",
        "catalog.blueprint.revised",
        "catalog.blueprint.dimensions-set",
        "catalog.blueprint.product-resolution-rules-set",
        "catalog.blueprint.published",
        "catalog.dimension.created",
        "catalog.dimension.revised",
        "catalog.dimension.option-added",
        "catalog.dimension.option-revised"
      ],
      "order": 10,
      "projectionHandlerSetNames": ["marketplace-catalog-item-projection"]
    },
    {
      "sourceContextName": "identity",
      "projectionName": "marketplace-identity-account-projection",
      "subscriptionVersion": 1,
      "eventTypes": [
        "identity.account.created",
        "identity.account.profile-updated",
        "identity.account.suspended",
        "identity.account.reactivated",
        "identity.account.closed",
        "identity.account.badge-assigned",
        "identity.account.badge-removed"
      ],
      "order": 20,
      "projectionHandlerSetNames": ["marketplace-identity-account-projection"]
    },
    {
      "sourceContextName": "inventory",
      "projectionName": "marketplace-inventory-supply-projection",
      "subscriptionVersion": 1,
      "eventTypes": [
        "inventory.storage-location.created",
        "inventory.storage-location.updated",
        "inventory.storage-location.archived",
        "inventory.item.created",
        "inventory.item.adjusted",
        "inventory.hold.placed",
        "inventory.hold.released"
      ],
      "order": 30,
      "projectionHandlerSetNames": ["marketplace-inventory-supply-projection"]
    },
    {
      "sourceContextName": "marketplace",
      "projectionName": "marketplace-identity-account-projection",
      "subscriptionVersion": 1,
      "eventTypes": ["reputation.review.submitted", "reputation.review.updated", "reputation.review.withdrawn"],
      "order": 40,
      "projectionHandlerSetNames": ["marketplace-identity-account-projection"]
    },
    {
      "sourceContextName": "identity",
      "projectionName": "reputation-account-projection",
      "subscriptionVersion": 1,
      "eventTypes": [
        "identity.account.created",
        "identity.account.profile-updated",
        "identity.account.suspended",
        "identity.account.reactivated",
        "identity.account.closed"
      ],
      "order": 50,
      "projectionHandlerSetNames": ["reputation-account-projection"]
    },
    {
      "sourceContextName": "ordering",
      "projectionName": "reputation-order-source-projection",
      "subscriptionVersion": 1,
      "eventTypes": [
        "ordering.order.created",
        "ordering.order.pending-payment-recorded",
        "ordering.order.cancelled",
        "ordering.order.ready-for-fulfillment-recorded"
      ],
      "order": 60,
      "projectionHandlerSetNames": ["reputation-order-source-projection"]
    },
    {
      "sourceContextName": "fulfillment",
      "projectionName": "reputation-shipment-source-projection",
      "subscriptionVersion": 1,
      "eventTypes": [
        "fulfillment.shipment.created",
        "fulfillment.shipment.dispatched",
        "fulfillment.shipment.delivered",
        "fulfillment.shipment.returned",
        "fulfillment.shipment.exception-raised"
      ],
      "order": 70,
      "projectionHandlerSetNames": ["reputation-shipment-source-projection"]
    },
    {
      "sourceContextName": "platform-operations",
      "projectionName": "reputation-support-source-projection",
      "subscriptionVersion": 1,
      "eventTypes": [
        "support.support-request.opened",
        "support.support-request.resolved",
        "support.support-request.cancelled"
      ],
      "order": 90,
      "projectionHandlerSetNames": ["reputation-support-source-projection"]
    }
  ],
  "projectionGroups": [
    {
      "projectionName": "marketplace-catalog-item-projection",
      "sourceContextNames": ["catalog"],
      "ownedTables": [
        "marketplace_catalog_items",
        "marketplace_catalog_blueprints",
        "marketplace_catalog_dimensions",
        "marketplace_catalog_dimension_options"
      ],
      "requiredDuringBootstrap": true,
      "resetStrategy": "replay-only"
    },
    {
      "projectionName": "marketplace-identity-account-projection",
      "sourceContextNames": ["identity", "marketplace"],
      "ownedTables": ["marketplace_account_pages", "marketplace_account_reviews"],
      "requiredDuringBootstrap": true,
      "resetStrategy": "replay-only"
    },
    {
      "projectionName": "marketplace-inventory-supply-projection",
      "sourceContextNames": ["inventory"],
      "ownedTables": ["marketplace_supply_locations", "marketplace_supply_items", "marketplace_supply_holds"],
      "requiredDuringBootstrap": true,
      "resetStrategy": "replay-only"
    },
    {
      "projectionName": "marketplace-listing-projection",
      "sourceContextNames": ["marketplace"],
      "ownedTables": ["marketplace_listing_pages", "marketplace_seller_listing_availability_pages"],
      "requiredDuringBootstrap": false,
      "resetStrategy": "truncate-owned-tables"
    },
    {
      "projectionName": "marketplace-offer-projection",
      "sourceContextNames": ["marketplace"],
      "ownedTables": ["marketplace_offer_pages"],
      "requiredDuringBootstrap": false,
      "resetStrategy": "truncate-owned-tables"
    },
    {
      "projectionName": "reputation-review-projection",
      "sourceContextNames": ["marketplace"],
      "ownedTables": ["reputation_review_pages", "review_summary_pages"],
      "requiredDuringBootstrap": false,
      "resetStrategy": "truncate-owned-tables"
    },
    {
      "projectionName": "reputation-account-projection",
      "sourceContextNames": ["identity"],
      "ownedTables": ["reputation_account_pages"],
      "requiredDuringBootstrap": true,
      "resetStrategy": "replay-only"
    },
    {
      "projectionName": "reputation-order-source-projection",
      "sourceContextNames": ["ordering"],
      "ownedTables": ["reputation_order_sources"],
      "requiredDuringBootstrap": true,
      "resetStrategy": "replay-only"
    },
    {
      "projectionName": "reputation-shipment-source-projection",
      "sourceContextNames": ["fulfillment"],
      "ownedTables": ["reputation_shipment_sources"],
      "requiredDuringBootstrap": true,
      "resetStrategy": "replay-only"
    },
    {
      "projectionName": "reputation-support-source-projection",
      "sourceContextNames": ["platform-operations"],
      "ownedTables": ["reputation_review_eligibility_pages"],
      "requiredDuringBootstrap": false,
      "resetStrategy": "replay-only"
    }
  ],
  "hostPorts": [
    {
      "portName": "commercialTermsResolver",
      "providedBy": "commercial-terms",
      "purpose": "Resolve account listing terms without making Marketplace own commercial terms policy."
    },
    {
      "portName": "listingPhotoStorage",
      "providedBy": "platform-api",
      "purpose": "Store normalized Marketplace Listing Photo WebP assets in the environment asset bucket without making Marketplace own object-storage infrastructure."
    }
  ],
  "apiDeployables": ["platform-api"],
  "apiMounts": [
    {
      "mountPath": "/api/marketplace",
      "kind": "primary",
      "requiresAuth": true,
      "readFreshnessRoutes": [
        {
          "routePath": "/account/listings",
          "methods": ["GET", "HEAD"],
          "dependencies": [
            {
              "readModelTable": "marketplace_listing_pages"
            }
          ]
        },
        {
          "routePath": "/account/listings/fee-lock-report",
          "methods": ["GET", "HEAD"],
          "dependencies": [
            {
              "readModelTable": "marketplace_listing_pages"
            }
          ]
        },
        {
          "routePath": "/account/listing-inventory",
          "methods": ["GET", "HEAD"],
          "dependencies": [
            {
              "readModelTable": "marketplace_supply_items"
            },
            {
              "readModelTable": "marketplace_supply_locations"
            },
            {
              "readModelTable": "marketplace_supply_holds"
            },
            {
              "readModelTable": "marketplace_catalog_items"
            }
          ]
        },
        {
          "routePath": "/account/supply-locations/exists",
          "methods": ["GET", "HEAD"],
          "dependencies": [
            {
              "readModelTable": "marketplace_supply_locations"
            }
          ]
        },
        {
          "routePath": "/account/listing-availability",
          "methods": ["GET", "HEAD"],
          "dependencies": [
            {
              "readModelTable": "marketplace_seller_listing_availability_pages"
            }
          ]
        },
        {
          "routePath": "/account/listings/:id",
          "methods": ["GET", "HEAD"],
          "dependencies": [
            {
              "readModelTable": "marketplace_listing_pages"
            }
          ]
        },
        {
          "routePath": "/account/offers/submitted/:id",
          "methods": ["GET", "HEAD"],
          "dependencies": [
            {
              "readModelTable": "marketplace_offer_pages"
            }
          ]
        },
        {
          "routePath": "/account/offers/matches/:id",
          "methods": ["GET", "HEAD"],
          "dependencies": [
            {
              "readModelTable": "marketplace_offer_pages"
            }
          ]
        },
        {
          "routePath": "/reviews/:id",
          "methods": ["GET", "HEAD"],
          "dependencies": [
            {
              "readModelTable": "reputation_review_pages"
            }
          ]
        }
      ]
    },
    {
      "mountPath": "/api/marketplace",
      "kind": "additional",
      "requiresAuth": true
    }
  ],
  "readAfterWriteRouteInventory": [
    {
      "id": "marketplace.listing-create-to-detail",
      "owner": "marketplace",
      "risk": "critical",
      "source": {
        "routeIds": ["account-listings", "account-listing"],
        "actions": ["Create listing", "Update listing", "Publish listing"],
        "command": "Marketplace listing commands",
        "helperUses": ["appendFreshWriteToken"]
      },
      "destination": {
        "routeId": "account-listing",
        "apiContextName": "marketplace",
        "apiRoutePath": "/account/listings/:id",
        "readModelTables": ["marketplace_listing_pages"],
        "helperUses": ["loadFreshlyWrittenResource"],
        "transientRecovery": {
          "kinds": "refreshable-catching-up",
          "behavior": "Listing detail loader treats valid fresh-write not-found and projection freshness timeout responses as temporary listing preparation while the marketplace listing projection catches up."
        }
      }
    },
    {
      "id": "marketplace.listing-list-self-refresh",
      "owner": "marketplace",
      "risk": "important",
      "source": {
        "routeId": "account-listings",
        "actions": ["Disable seller listing availability", "Enable seller listing availability"],
        "command": "Marketplace listing list commands",
        "helperUses": ["appendFreshWriteToken"]
      },
      "destination": {
        "routeId": "account-listings",
        "apiContextName": "marketplace",
        "apiRoutePath": "/account/listings",
        "readModelTables": ["marketplace_listing_pages"],
        "helperUses": ["loadFreshlyWrittenResource"],
        "transientRecovery": {
          "kinds": "refreshable-catching-up",
          "behavior": "Account Listings self-refresh forwards the Marketplace commit receipt to the listing-page API reads and retries valid fresh-write not-found responses while the listing projection catches up."
        }
      }
    },
    {
      "id": "marketplace.listing-fee-lock-self-refresh",
      "owner": "marketplace",
      "risk": "important",
      "source": {
        "routeId": "account-listings",
        "actions": ["Disable seller listing availability", "Enable seller listing availability"],
        "command": "Marketplace listing list commands",
        "helperUses": ["appendFreshWriteToken"]
      },
      "destination": {
        "routeId": "account-listings",
        "apiContextName": "marketplace",
        "apiRoutePath": "/account/listings/fee-lock-report",
        "readModelTables": ["marketplace_listing_pages"],
        "helperUses": ["loadFreshlyWrittenResource"],
        "transientRecovery": {
          "kinds": "refreshable-catching-up",
          "behavior": "Account Listings loads the fee-lock report inside the same fresh-write loader, so valid post-write list refreshes wait on the Marketplace listing projection before rendering fee and price rows."
        }
      }
    },
    {
      "id": "marketplace.listing-inventory-self-refresh",
      "owner": "marketplace",
      "risk": "important",
      "source": {
        "routeIds": ["account-inventory", "account-inventory-item"],
        "actions": ["Create inventory item and return to listing setup", "Create listing from inventory item detail"],
        "command": "Inventory item commands",
        "helperUses": ["appendFreshWriteToken"]
      },
      "destination": {
        "routeId": "account-listings",
        "apiContextName": "marketplace",
        "apiRoutePath": "/account/listing-inventory",
        "readModelTables": [
          "marketplace_supply_items",
          "marketplace_supply_locations",
          "marketplace_supply_holds",
          "marketplace_catalog_items"
        ],
        "helperUses": ["loadFreshlyWrittenResource"],
        "transientRecovery": {
          "kinds": "refreshable-catching-up",
          "behavior": "Account Listings loads seller inventory options inside the fresh-write loader and renders a route-owned empty inventory fallback when valid post-write supply reads are still catching up."
        }
      }
    },
    {
      "id": "marketplace.listing-stock-location-self-refresh",
      "owner": "marketplace",
      "risk": "important",
      "source": {
        "routeIds": ["account-inventory", "account-inventory-locations"],
        "actions": ["Create inventory item", "Create inventory storage location"],
        "command": "Inventory storage location commands",
        "helperUses": ["appendFreshWriteToken"]
      },
      "destination": {
        "routeId": "account-listings",
        "apiContextName": "marketplace",
        "apiRoutePath": "/account/supply-locations/exists",
        "readModelTables": ["marketplace_supply_locations"],
        "helperUses": ["loadFreshlyWrittenResource"],
        "transientRecovery": {
          "kinds": "refreshable-catching-up",
          "behavior": "Account Listings checks Listing stock readiness with exact Marketplace supply-location freshness and falls back to asking for ship-from details instead of throwing a generic page error while valid post-write supply reads catch up."
        }
      }
    },
    {
      "id": "marketplace.listing-availability-self-refresh",
      "owner": "marketplace",
      "risk": "important",
      "source": {
        "routeId": "account-listings",
        "actions": ["Disable seller listing availability", "Enable seller listing availability"],
        "command": "Seller Listing Availability commands",
        "helperUses": ["appendFreshWriteToken"]
      },
      "destination": {
        "routeId": "account-listings",
        "apiContextName": "marketplace",
        "apiRoutePath": "/account/listing-availability",
        "readModelTables": ["marketplace_seller_listing_availability_pages"],
        "helperUses": ["loadFreshlyWrittenResource"],
        "transientRecovery": {
          "kinds": "refreshable-catching-up",
          "behavior": "Account Listings loads Seller Listing Availability inside the fresh-write loader, so availability toggles redirect with a Marketplace receipt and the destination waits on the availability page before showing the account-wide control."
        }
      }
    },
    {
      "id": "marketplace.submitted-offer-detail",
      "owner": "marketplace",
      "risk": "important",
      "source": {
        "routeId": "account-offer-submitted",
        "actions": ["Load newly submitted offer"],
        "command": "SubmitOffer",
        "helperUses": ["loadFreshlyWrittenResource"]
      },
      "destination": {
        "routeId": "account-offer-submitted",
        "apiContextName": "marketplace",
        "apiRoutePath": "/account/offers/submitted/:id",
        "readModelTables": ["marketplace_offer_pages"],
        "helperUses": ["loadFreshlyWrittenResource"],
        "transientRecovery": {
          "kinds": "refreshable-catching-up",
          "behavior": "Submitted Offer detail uses exact Marketplace offer-page freshness and treats valid fresh-write not-found and projection freshness timeout responses as temporary submitted-offer preparation while the offer projection catches up."
        }
      }
    },
    {
      "id": "marketplace.offer-match-accept-to-detail",
      "owner": "marketplace",
      "risk": "important",
      "source": {
        "routeId": "account-offer-match",
        "actions": ["Accept offer match"],
        "command": "AcceptOffer",
        "helperUses": ["appendFreshWriteToken"]
      },
      "destination": {
        "routeId": "account-offer-match",
        "apiContextName": "marketplace",
        "apiRoutePath": "/account/offers/matches/:id",
        "readModelTables": ["marketplace_offer_pages"],
        "helperUses": ["loadFreshlyWrittenResource"],
        "transientRecovery": {
          "kinds": "refreshable-catching-up",
          "behavior": "Offer Match detail redirects with the AcceptOffer command receipt; the destination loader forwards it to the offer-page read and treats valid fresh-write not-found and projection freshness timeout responses as temporary offer-match preparation while the offer projection catches up."
        }
      }
    },
    {
      "id": "reputation.review-submit-to-detail",
      "owner": "marketplace",
      "risk": "important",
      "source": {
        "routeIds": ["account-purchase-review", "account-sale-review"],
        "actions": ["Submit purchase review", "Submit sale review"],
        "command": "SubmitReview",
        "helperUses": ["appendFreshWriteToken"]
      },
      "destination": {
        "routeId": "account-review",
        "apiContextName": "marketplace",
        "apiRoutePath": "/reviews/:id",
        "readModelTables": ["reputation_review_pages"],
        "helperUses": ["loadFreshlyWrittenResource"],
        "transientRecovery": {
          "kinds": "refreshable-catching-up",
          "behavior": "Review submission redirects with the SubmitReview command receipt; the account review loader forwards it to the review detail read and retries valid fresh-write not-found responses while the review projection catches up."
        }
      }
    }
  ],
  "mutationConsistencyInventory": [
    {
      "id": "marketplace.listing-api-client-command-snapshots",
      "owner": "marketplace",
      "risk": "important",
      "strategy": "snapshot-return",
      "surfaces": [
        "api-client:bounded-contexts/marketplace/client.ts:POST H04af719a48e5#1",
        "api-client:bounded-contexts/marketplace/client.ts:POST H188a5fe9c458#1",
        "api-client:bounded-contexts/marketplace/client.ts:POST H59449737c72f#1",
        "api-client:bounded-contexts/marketplace/client.ts:POST H717d12dd6ee0#1",
        "api-client:bounded-contexts/marketplace/client.ts:POST H9128ca46a67f#1",
        "api-client:bounded-contexts/marketplace/client.ts:POST H94718dd21134#1",
        "api-client:bounded-contexts/marketplace/client.ts:POST H9b81d7eb5cbd#1",
        "api-client:bounded-contexts/marketplace/client.ts:POST He218f5201552#1"
      ],
      "visibleDestination": {
        "description": "Marketplace configured-fetch clients return command-owned listing and terms snapshots and attach response consistency metadata for route actions that redirect to fresh detail or list reads."
      },
      "proof": {
        "authoritativeResponse": "The client returns the API response body with non-enumerable command receipt metadata from attachResponseMetadata; listing drafts, listing commands, photo uploads, and fee previews are scoped to the command response and do not claim downstream projection freshness.",
        "tests": [
          "bounded-contexts/marketplace/features/listings/api/route.test.ts",
          "bounded-contexts/marketplace/tests/account-listings-web-route.test.ts"
        ]
      }
    },
    {
      "id": "marketplace.listing-api-command-snapshots",
      "owner": "marketplace",
      "risk": "important",
      "strategy": "snapshot-return",
      "surfaces": [
        "api-route:bounded-contexts/marketplace/features/listings/api/route.ts:POST /guest/listing-draft-intents",
        "api-route:bounded-contexts/marketplace/features/listings/api/route.ts:POST /listing-availability/disable",
        "api-route:bounded-contexts/marketplace/features/listings/api/route.ts:POST /listing-availability/enable",
        "api-route:bounded-contexts/marketplace/features/listings/api/route.ts:POST /listing-draft-intents/:id/claim",
        "api-route:bounded-contexts/marketplace/features/listings/api/route.ts:POST /listings",
        "api-route:bounded-contexts/marketplace/features/listings/api/route.ts:POST /listings/:id/pause",
        "api-route:bounded-contexts/marketplace/features/listings/api/route.ts:POST /listings/:id/photos",
        "api-route:bounded-contexts/marketplace/features/listings/api/route.ts:POST /listings/:id/price",
        "api-route:bounded-contexts/marketplace/features/listings/api/route.ts:POST /listings/:id/publish",
        "api-route:bounded-contexts/marketplace/features/listings/api/route.ts:POST /listings/:id/purchase-limits",
        "api-route:bounded-contexts/marketplace/features/listings/api/route.ts:POST /listings/:id/quantity-cap",
        "api-route:bounded-contexts/marketplace/features/listings/api/route.ts:POST /listings/:id/withdraw",
        "api-route:bounded-contexts/marketplace/features/listings/api/route.ts:POST /listings/preview",
        "api-route:bounded-contexts/marketplace/features/listings/api/route.ts:POST /terms/public-standard/listing-preview"
      ],
      "visibleDestination": {
        "description": "Listing API commands return command-owned ids, versions, statuses, draft intent snapshots, or fee quote snapshots; browser form destinations use the returned receipt for fresh detail/list reads."
      },
      "proof": {
        "authoritativeResponse": "Listing create/update/publish/pause/withdraw and availability commands respond from the committed command result with id/version/status; draft intent and claim routes return the draft snapshot; fee preview routes return the computed terms snapshot, with stale fee quote responses carrying the current quote.",
        "tests": [
          "bounded-contexts/marketplace/features/listings/api/route.test.ts",
          "bounded-contexts/marketplace/features/listings/api/runtime.test.ts",
          "bounded-contexts/marketplace/tests/account-listing-route.test.ts",
          "bounded-contexts/marketplace/tests/account-listings-web-route.test.ts"
        ]
      }
    },
    {
      "id": "marketplace.offer-api-command-snapshots",
      "owner": "marketplace",
      "risk": "important",
      "strategy": "snapshot-return",
      "surfaces": [
        "api-route:bounded-contexts/marketplace/features/offers/api/route.ts:POST /offers/matches/:id/accept",
        "api-route:bounded-contexts/marketplace/features/offers/api/route.ts:POST /offers/submitted"
      ],
      "visibleDestination": {
        "description": "Offer API commands return command-owned id/version/status snapshots; submitted-offer and accepted-offer browser destinations use the receipt for fresh offer reads."
      },
      "proof": {
        "authoritativeResponse": "SubmitOffer returns id/version/status=submitted and AcceptOffer returns id/version/status=accepted directly from the command result; stale fee quote failures return the current quote snapshot instead of rendering stale acceptance terms.",
        "tests": [
          "bounded-contexts/marketplace/features/offers/api/route.test.ts",
          "bounded-contexts/marketplace/features/offers/api/runtime.test.ts",
          "bounded-contexts/marketplace/tests/account-offers-route.test.ts"
        ]
      }
    },
    {
      "id": "marketplace.review-api-command-snapshots",
      "owner": "marketplace",
      "risk": "important",
      "strategy": "snapshot-return",
      "surfaces": [
        "api-route:bounded-contexts/marketplace/features/reviews/api/route.ts:POST /",
        "api-route:bounded-contexts/marketplace/features/reviews/api/route.ts:POST /:id/update",
        "api-route:bounded-contexts/marketplace/features/reviews/api/route.ts:POST /:id/withdraw"
      ],
      "visibleDestination": {
        "description": "Review API commands return command-owned review id/version/status snapshots; review submission routes use the receipt for a fresh review detail read."
      },
      "proof": {
        "authoritativeResponse": "SubmitReview, UpdateReview, and WithdrawReview respond from the command result with review id, stream version, and status before any review read-model projection is consulted.",
        "tests": [
          "bounded-contexts/marketplace/features/reviews/api/route.test.ts",
          "bounded-contexts/marketplace/features/reviews/api/runtime.test.ts",
          "bounded-contexts/marketplace/tests/account-purchase-review-route.test.tsx",
          "bounded-contexts/marketplace/tests/account-sale-review-route.test.tsx"
        ]
      }
    },
