{
  "contextName": "identity",
  "packageName": "@chase-sets/identity",
  "ownedNouns": [
    "user",
    "account",
    "membership",
    "invitation",
    "api-key",
    "consent"
  ],
  "streamPrefix": "identity.",
  "apiBasePath": "/api/identity",
  "slices": [
    "accounts",
    "users",
    "memberships",
    "invitations",
    "api-keys",
    "consents",
    "customer"
  ],
  "allowedSupportDirectories": [
    "integration",
    "read-model-support",
    "request-support",
    "route-support",
    "seed-support",
    "shell-support",
    "tests"
  ],
  "publicExports": [
    ".",
    "./integration/*",
    "./routes/*",
    "./seed-support/*",
    "./server",
    "./web"
  ],
  "allowedContextDependencies": [],
  "requiredPorts": [],
  "integrationCapabilities": [
    {
      "key": "identity.bootstrap-port",
      "exportName": "createIdentityBootstrapPort",
      "fileExport": "./integration/bootstrap-port",
      "kind": "runtime-port"
    },
    {
      "key": "identity.user-directory",
      "exportName": "createIdentityUserDirectoryPort",
      "fileExport": "./integration/user-directory",
      "kind": "runtime-port"
    },
    {
      "key": "identity.membership-port",
      "exportName": "createIdentityMembershipPort",
      "fileExport": "./integration/membership-port",
      "kind": "runtime-port"
    },
    {
      "key": "identity.invitation-port",
      "exportName": "createIdentityInvitationPort",
      "fileExport": "./integration/invitation-port",
      "kind": "runtime-port"
    },
    {
      "key": "identity.provisioning-port",
      "exportName": "createIdentityProvisioningPort",
      "fileExport": "./integration/provisioning-port",
      "kind": "runtime-port"
    }
  ],
  "seedRequirements": [],
  "apiRequirements": [],
  "hostPorts": [],
  "apiDeployables": [
    "identity-api"
  ],
  "runtimeDeployables": [
    "identity-api",
    "inventory-api",
    "marketplace-api"
  ],
  "apiMounts": [
    {
      "mountPath": "/api/identity",
      "kind": "primary",
      "requiresAuth": true,
      "drainProjectorsOnWrite": false
    }
  ],
  "deployableContributions": [
    {
      "deployable": "identity-admin",
      "routes": [
        {
          "routeId": "accounts",
          "routePath": "accounts",
          "fileExport": "./routes/admin/accounts",
          "routeType": "route",
          "sourceContext": "identity"
        },
        {
          "routeId": "accounts-detail",
          "routePath": "accounts/:id",
          "fileExport": "./routes/admin/accounts-detail",
          "routeType": "route",
          "sourceContext": "identity"
        },
        {
          "routeId": "api-keys",
          "routePath": "api-keys",
          "fileExport": "./routes/admin/api-keys",
          "routeType": "route",
          "sourceContext": "identity"
        },
        {
          "routeId": "api-keys-detail",
          "routePath": "api-keys/:id",
          "fileExport": "./routes/admin/api-keys-detail",
          "routeType": "route",
          "sourceContext": "identity"
        },
        {
          "routeId": "invitations",
          "routePath": "invitations",
          "fileExport": "./routes/admin/invitations",
          "routeType": "route",
          "sourceContext": "identity"
        },
        {
          "routeId": "invitations-detail",
          "routePath": "invitations/:id",
          "fileExport": "./routes/admin/invitations-detail",
          "routeType": "route",
          "sourceContext": "identity"
        },
        {
          "routeId": "memberships",
          "routePath": "memberships",
          "fileExport": "./routes/admin/memberships",
          "routeType": "route",
          "sourceContext": "identity"
        },
        {
          "routeId": "memberships-detail",
          "routePath": "memberships/:id",
          "fileExport": "./routes/admin/memberships-detail",
          "routeType": "route",
          "sourceContext": "identity"
        },
        {
          "routeId": "users",
          "routePath": "users",
          "fileExport": "./routes/admin/users",
          "routeType": "route",
          "sourceContext": "identity"
        },
        {
          "routeId": "users-detail",
          "routePath": "users/:id",
          "fileExport": "./routes/admin/users-detail",
          "routeType": "route",
          "sourceContext": "identity"
        }
      ]
    },
    {
      "deployable": "marketplace",
      "routes": [
        {
          "routeId": "account",
          "routePath": "account",
          "fileExport": "./routes/marketplace/account",
          "routeType": "route",
          "sourceContext": "identity"
        },
        {
          "routeId": "account-consents",
          "routePath": "account/consents",
          "fileExport": "./routes/marketplace/account-consents",
          "routeType": "route",
          "sourceContext": "identity"
        },
        {
          "routeId": "account-security",
          "routePath": "account/security",
          "fileExport": "./routes/marketplace/account-security",
          "routeType": "route",
          "sourceContext": "identity"
        },
        {
          "routeId": "account-team",
          "routePath": "account/team",
          "fileExport": "./routes/marketplace/account-team",
          "routeType": "route",
          "sourceContext": "identity"
        }
      ]
    }
  ],
  "shellContributions": [
    {
      "deployable": "identity-admin",
      "slot": "primary-nav",
      "key": "accounts",
      "label": "Accounts",
      "icon": "package",
