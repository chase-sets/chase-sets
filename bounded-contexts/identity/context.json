      "href": "/memberships",
      "order": 30,
      "visibility": "signed-in",
      "requiredPermissions": []
    },
    {
      "deployable": "identity-admin",
      "slot": "primary-nav",
      "key": "invitations",
      "label": "Invitations",
      "icon": "info",
      "href": "/invitations",
      "order": 40,
      "visibility": "signed-in",
      "requiredPermissions": []
    },
    {
      "deployable": "identity-admin",
      "slot": "primary-nav",
      "key": "api-keys",
      "label": "API Keys",
      "icon": "settings",
      "href": "/api-keys",
      "order": 60,
      "visibility": "signed-in",
      "requiredPermissions": []
    },
    {
      "deployable": "marketplace",
