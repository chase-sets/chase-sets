{
  "contextName": "support",
  "packageName": "@chase-sets/support",
  "ownedNouns": ["support-request"],
  "streamPrefix": "support.",
  "apiBasePath": "/api/marketplace",
  "slices": ["support-requests"],
  "allowedSupportDirectories": ["request-support", "runtime-support", "seed-support"],
  "publicExports": [".", "./context", "./routes/*", "./seed-support/*", "./server"],
  "allowedContextDependencies": ["@chase-sets/identity", "@chase-sets/ordering"],
  "seedRequirements": ["identity", "ordering", "fulfillment", "payments", "settlement"],
  "eventSubscriptions": [
    {
      "sourceContextName": "ordering",
      "projectionName": "support-order-source-projection",
      "subscriptionVersion": 1,
      "eventTypes": [
        "ordering.order.created",
        "ordering.order.cancelled",
        "ordering.order.ready-for-fulfillment-recorded"
      ],
      "order": 70,
      "projectionHandlerSetNames": ["support-order-source-projection"]
    },
    {
      "sourceContextName": "fulfillment",
      "projectionName": "support-shipment-source-projection",
      "subscriptionVersion": 1,
      "eventTypes": [
        "fulfillment.shipment.created",
        "fulfillment.shipment.dispatched",
        "fulfillment.shipment.delivered",
        "fulfillment.shipment.returned",
        "fulfillment.shipment.exception-raised"
      ],
      "order": 80,
      "projectionHandlerSetNames": ["support-shipment-source-projection"]
    }
  ],
  "projectionGroups": [
    {
      "projectionName": "support-order-source-projection",
      "sourceContextNames": ["ordering"],
      "ownedTables": ["support_order_sources"],
      "requiredDuringBootstrap": true,
      "resetStrategy": "replay-only"
    },
    {
      "projectionName": "support-shipment-source-projection",
      "sourceContextNames": ["fulfillment"],
      "ownedTables": ["support_shipment_sources"],
      "requiredDuringBootstrap": true,
      "resetStrategy": "replay-only"
    }
  ],
  "hostPorts": [
    {
      "portName": "transactionalEmailOutbox",
      "providedBy": "platform-worker",
      "purpose": "Durable transactional email outbox consumed only by support request event projectors."
    }
  ],
  "apiDeployables": ["platform-api"],
  "apiMounts": [
    {
      "mountPath": "/api/marketplace",
      "kind": "primary",
      "requiresAuth": true
    }
  ],
  "deployableContributions": [
    {
      "deployable": "marketplace-web",
      "routes": [
        {
          "routeId": "account-support",
          "routePath": "account/support",
          "fileExport": "./routes/marketplace/account-support",
          "routeType": "route",
          "sourceContext": "support"
        }
      ]
    },
    {
      "deployable": "admin-web",
      "routes": [
        {
          "routeId": "support-operations",
          "routePath": "support-requests",
          "fileExport": "./routes/admin/operations-queue",
          "routeType": "route",
          "sourceContext": "support",
          "placement": "root"
        },
        {
          "routeId": "support-operations-detail",
          "routePath": "support-requests/:id",
          "fileExport": "./routes/admin/operations-request-detail",
          "routeType": "route",
          "sourceContext": "support",
          "placement": "root"
        }
      ]
    }
  ],
  "shellContributions": [
    {
      "deployable": "marketplace-web",
      "slot": "top-nav",
      "key": "support",
      "label": "Support",
      "icon": "help",
      "href": "/account/support",
      "order": 200,
      "visibility": "signed-in",
      "requiredPermissions": ["support.view"]
    },
    {
      "deployable": "marketplace-web",
      "slot": "bottom-nav",
      "key": "support",
      "label": "Support",
      "icon": "help",
      "href": "/account/support",
      "order": 200,
      "visibility": "signed-in",
      "requiredPermissions": ["support.view"]
    },
    {
      "deployable": "admin-web",
      "slot": "primary-nav",
      "key": "support-operations",
      "label": "Support",
      "icon": "help",
      "href": "/support-requests",
      "order": 30,
      "visibility": "signed-in",
      "requiredPermissions": ["support.manage"]
    }
  ],
  "directoryIntent": {
    "support-requests": {
      "classification": "slice",
      "purpose": "Own support request workflow behavior, read models, API contracts, marketplace-facing support terminology, and operator queue UI.",
      "allowedWhen": "Always; slice directories are the default root shape for implemented context features.",
      "expectedConsumers": [
        "Internal support module composition",
        "Marketplace account support route",
        "Admin support operations route"
      ]
    },
    "request-support": {
      "classification": "support",
      "purpose": "Provide reusable request-support assets shared by support-owned routes and deployable composition.",
      "allowedWhen": "Allowed only when capability cannot stay inside one feature and cross-feature reuse is explicit.",
      "expectedConsumers": ["support-requests"],
      "justification": "request-support centralizes context-local API client composition for marketplace support entrypoints.",
      "createdFor": "support workflows that span purchase and sale entrypoints.",
      "sunsetWhen": "Remove when all consumers can move behavior back into feature-local modules.",
      "crossCuttingRuntimeComposition": true
    },
    "runtime-support": {
      "classification": "support",
      "purpose": "Provide reusable runtime-support assets shared by support-owned features and composition roots.",
      "allowedWhen": "Allowed only when capability cannot stay inside one feature and cross-feature reuse is explicit.",
      "expectedConsumers": ["support-requests"],
      "justification": "runtime-support centralizes context-local runtime and schema composition.",
      "createdFor": "support request workflow runtime and projections.",
      "sunsetWhen": "Remove when all consumers can move the behavior back into feature-local modules."
    },
    "seed-support": {
      "classification": "support",
      "purpose": "Provide reusable seed-support assets shared by support-owned features and deployable composition.",
      "allowedWhen": "Allowed only when capability cannot stay inside one feature and cross-feature reuse is explicit.",
      "expectedConsumers": ["Deployable composition for support"],
      "justification": "seed-support keeps support bootstrap data explicit.",
      "createdFor": "support workflow local development.",
      "sunsetWhen": "Remove when support no longer needs seed helpers.",
      "crossCuttingRuntimeComposition": true
    },
    "routes": {
      "classification": "routes",
      "purpose": "Expose support-owned route modules consumed by generated deployable adapters.",
      "allowedWhen": "Required whenever the context contributes routes to any deployable.",
      "expectedConsumers": ["Generated deployable route adapters"]
    }
  },
  "runtimeDeployables": ["platform-worker"]
}
