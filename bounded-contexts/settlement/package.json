{
  "name": "@chase-sets/settlement",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc -p ./tests/tsconfig.json --noEmit",
    "test": "vitest run --config ./tests/vitest.config.mjs",
    "test:unit": "vitest run --config ./tests/vitest.config.mjs --exclude features/wallets/read-model/queries.db.test.ts --exclude features/wallets/read-model/wallet-adjustment-projection.db.test.ts --exclude features/wallets/read-model/ledger-sale-credit-total.db.test.ts --exclude features/wallets/integrations/account-risk-source/account-risk-source-review-sql.db.test.ts",
    "test:db": "vitest run --config ./tests/vitest.config.mjs features/wallets/read-model/queries.db.test.ts features/wallets/read-model/wallet-adjustment-projection.db.test.ts features/wallets/read-model/ledger-sale-credit-total.db.test.ts features/wallets/integrations/account-risk-source/account-risk-source-review-sql.db.test.ts",
    "test:watch": "vitest --config ./tests/vitest.config.mjs"
  },
  "chaseSets": {
    "testProfile": "db"
  },
  "exports": {
    ".": "./index.ts",
    "./context": "./context.json",
    "./routes/*": "./routes/*.tsx",
    "./seed-support/*": "./support/seed-support/*.ts",
    "./server": "./server.ts"
  },
  "types": "./index.ts",
  "dependencies": {
    "@chase-sets/auth-context": "workspace:*",
    "@chase-sets/bounded-context-module": "workspace:*",
    "@chase-sets/bounded-context-runtime": "workspace:*",
    "@chase-sets/design-system": "workspace:*",
    "@chase-sets/event-core": "workspace:*",
    "@chase-sets/event-core-postgres": "workspace:*",
    "@chase-sets/http": "workspace:*",
    "@chase-sets/identity": "workspace:*",
    "@chase-sets/localization": "workspace:*",
    "@chase-sets/money-movement": "workspace:*",
    "@chase-sets/notification-outbox": "workspace:*",
    "@chase-sets/outbound-messaging": "workspace:*",
    "@chase-sets/payments": "workspace:*",
    "@chase-sets/platform-policy": "workspace:*",
    "@chase-sets/platform-runtime": "workspace:*",
    "@chase-sets/primitives": "workspace:*",
    "@chase-sets/provider-webhook-inbox": "workspace:*",
    "@stripe/connect-js": "3.4.5",
    "hono": "^4.12.12"
  },
  "devDependencies": {
    "vitest": "^4.1.4"
  }
}
