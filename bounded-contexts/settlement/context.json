{
  "contextName": "settlement",
  "packageName": "@chase-sets/settlement",
  "ownedNouns": [
    "wallet",
    "payout",
    "ledger-entry"
  ],
  "streamPrefix": "settlement.",
  "apiBasePath": "/api/settlement",
  "slices": [
    "wallets",
    "payouts"
  ],
  "allowedSupportDirectories": [
    "tests"
  ],
  "publicExports": [
    ".",
    "./client",
    "./routes/*",
    "./web"
  ],
  "allowedContextDependencies": [],
  "requiredPorts": [],
  "apiDeployables": [
    "marketplace-api"
  ],
  "apiMounts": [
    {
      "mountPath": "/api/settlement",
      "kind": "primary",
      "requiresAuth": true,
      "drainProjectorsOnWrite": true
    }
  ],
  "deployableContributions": [
    {
      "deployable": "marketplace",
      "routes": [
        { "routeId": "account-payout", "routePath": "account/payouts/:payoutId", "fileExport": "./routes/marketplace/account-payout", "routeType": "route", "sourceContext": "settlement" },
        { "routeId": "account-payouts", "routePath": "account/payouts", "fileExport": "./routes/marketplace/account-payouts", "routeType": "route", "sourceContext": "settlement" },
        { "routeId": "account-settlement", "routePath": "account/settlement", "fileExport": "./routes/marketplace/account-settlement", "routeType": "route", "sourceContext": "settlement" }
      ]
    }
  ]
}
