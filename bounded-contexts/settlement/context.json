{
  "contextName": "settlement",
  "packageName": "@chase-sets/settlement",
  "ownedNouns": ["wallet", "payout", "payout-readiness", "ledger-entry"],
  "streamPrefix": "settlement.",
  "apiBasePath": "/api/settlement",
  "slices": ["wallets", "payout-readiness", "payouts"],
  "allowedSupportDirectories": ["request-support", "runtime-support", "seed-support"],
  "publicExports": [".", "./context", "./routes/*", "./seed-support/*", "./server"],
  "allowedContextDependencies": ["@chase-sets/identity"],
  "seedRequirements": ["identity", "payments"],
  "eventSubscriptions": [
    {
      "sourceContextName": "payments",
      "projectionName": "settlement-payment-input-projection",
      "subscriptionVersion": 1,
      "eventTypes": [
        "payments.payment-created",
        "payments.payment-authorized",
        "payments.payment-captured",
        "payments.payment-failed",
        "payments.payment-cancelled",
        "payments.payment-refunded",
        "payments.payment-disputed",
        "payments.refund-requested",
        "payments.refund-issued",
        "payments.refund-failed"
      ],
      "order": 10,
      "projectionHandlerSetNames": ["settlement-payment-input-projection"]
    },
    {
      "sourceContextName": "payments",
      "projectionName": "settlement-support-hold-projection",
      "subscriptionVersion": 1,
      "eventTypes": [
        "payments.payment-disputed",
        "payments.payment-fraud-warning-received",
        "payments.payment-fraud-review-opened",
        "payments.payment-fraud-review-closed"
      ],
      "order": 11,
      "projectionHandlerSetNames": ["settlement-support-hold-projection"]
    },
    {
      "sourceContextName": "platform-operations",
      "projectionName": "settlement-support-hold-projection",
      "subscriptionVersion": 1,
      "eventTypes": [
        "support.support-request.opened",
        "support.support-request.escalated",
        "support.support-request.resolved",
        "support.support-request.closed",
        "support.support-request.cancelled"
      ],
      "order": 80,
      "projectionHandlerSetNames": ["settlement-support-hold-projection"]
    },
    {
      "sourceContextName": "fulfillment",
      "projectionName": "settlement-fulfillment-source-projection",
      "subscriptionVersion": 1,
      "eventTypes": [
        "fulfillment.shipment.created",
        "fulfillment.shipment.dispatched",
        "fulfillment.shipment.delivered",
        "fulfillment.shipment.returned",
        "fulfillment.shipment.exception-raised"
      ],
      "order": 60,
      "projectionHandlerSetNames": ["settlement-fulfillment-source-projection"]
    },
    {
      "sourceContextName": "identity",
      "projectionName": "settlement-account-risk-source-projection",
      "subscriptionVersion": 1,
      "eventTypes": [
        "identity.account.created",
        "identity.account.badge-assigned",
        "identity.account.badge-removed",
        "identity.shipping-address.added",
        "identity.shipping-address.updated",
        "identity.shipping-address.archived"
      ],
      "order": 20,
      "projectionHandlerSetNames": ["settlement-account-risk-source-projection"]
    },
    {
      "sourceContextName": "marketplace",
      "projectionName": "settlement-account-risk-source-projection",
      "subscriptionVersion": 1,
      "eventTypes": [
        "marketplace.listing.created",
        "marketplace.review.submitted",
        "marketplace.review.updated",
        "marketplace.review.withdrawn"
      ],
      "order": 70,
      "projectionHandlerSetNames": ["settlement-account-risk-source-projection"]
    },
    {
      "sourceContextName": "payments",
      "projectionName": "settlement-account-risk-source-projection",
      "subscriptionVersion": 1,
      "eventTypes": [
        "payments.payment-created",
        "payments.payment-disputed",
        "payments.payment-fraud-warning-received",
        "payments.payment-fraud-review-opened",
        "payments.payment-fraud-review-closed",
        "payments.checkout-affordances-published"
      ],
      "order": 71,
      "projectionHandlerSetNames": ["settlement-account-risk-source-projection"]
    }
  ],
  "projectionGroups": [
    {
      "projectionName": "settlement-payment-input-projection",
      "sourceContextNames": ["payments"],
      "ownedTables": ["settlement_payment_sources", "settlement_refund_sources"],
      "requiredDuringBootstrap": true,
      "resetStrategy": "replay-only"
    },
    {
      "projectionName": "settlement-support-hold-projection",
      "sourceContextNames": ["platform-operations", "payments"],
      "ownedTables": ["settlement_support_holds"],
      "requiredDuringBootstrap": false,
      "resetStrategy": "replay-only"
    },
    {
      "projectionName": "settlement-fulfillment-source-projection",
      "sourceContextNames": ["fulfillment"],
      "ownedTables": ["settlement_order_fulfillment_sources"],
      "requiredDuringBootstrap": false,
      "resetStrategy": "replay-only"
    },
    {
      "projectionName": "settlement-account-risk-source-projection",
      "sourceContextNames": ["identity", "marketplace", "payments"],
      "ownedTables": [
        "settlement_account_risk_sources",
        "settlement_account_review_sources",
        "settlement_account_instrument_risk_sources",
        "settlement_account_address_risk_sources",
        "settlement_account_velocity_sources"
      ],
      "requiredDuringBootstrap": false,
      "resetStrategy": "replay-only"
    },
    {
      "projectionName": "settlement-payout-projection",
      "sourceContextNames": ["settlement"],
      "ownedTables": ["settlement_payout_pages"],
      "requiredDuringBootstrap": false,
      "resetStrategy": "truncate-owned-tables"
    },
    {
      "projectionName": "settlement-payout-readiness-projection",
      "sourceContextNames": ["settlement"],
      "ownedTables": ["settlement_payout_readiness_pages"],
      "requiredDuringBootstrap": false,
      "resetStrategy": "truncate-owned-tables"
    }
  ],
  "hostPorts": [
    {
      "portName": "moneyMovementGateway",
      "providedBy": "platform-api",
      "purpose": "Provider-neutral money movement adapter for payout setup, platform-balance transfers, connected-account payouts, and payout webhooks."
    },
    {
      "portName": "notificationOutbox",
      "providedBy": "platform-worker",
      "purpose": "Durable outbound notification outbox consumed only by event projectors."
    }
  ],
  "apiDeployables": ["platform-api"],
  "apiMounts": [
    {
      "mountPath": "/api/settlement",
      "kind": "primary",
      "requiresAuth": true,
      "readFreshnessRoutes": [
        {
          "routePath": "/payouts/:id",
          "methods": ["GET", "HEAD"],
          "dependencies": [
            {
              "readModelTable": "settlement_payout_pages"
            }
          ]
        },
        {
          "routePath": "/payout-readiness",
          "methods": ["GET", "HEAD"],
          "dependencies": [
            {
              "readModelTable": "settlement_payout_readiness_pages"
            }
          ]
        }
      ]
    },
    {
      "mountPath": "/api/settlement/provider",
      "kind": "additional",
      "requiresAuth": false
    }
  ],
  "readAfterWriteRouteInventory": [
    {
      "id": "settlement.payout-request-to-detail",
      "owner": "settlement",
      "risk": "critical",
      "freshnessSlo": {
        "flowClass": "critical-customer-handoff",
        "p95Ms": 1000,
        "p99Ms": 2250
      },
      "source": {
        "routeId": "account-payouts",
        "actions": ["Request payout"],
        "command": "Settlement payout request command",
        "helperUses": ["navigateAfterWrite"]
      },
      "destination": {
        "routeId": "account-payout",
        "apiContextName": "settlement",
        "apiRoutePath": "/payouts/:id",
        "readModelTables": ["settlement_payout_pages"],
        "helperUses": ["loadAfterWrite"],
        "transientRecovery": {
          "kinds": "refreshable-catching-up",
          "behavior": "Payout detail redirects carry the Settlement payout request receipt; the API waits on settlement_payout_pages and the loader treats fresh 404 or projection freshness timeout as temporary payout preparation."
        }
      }
    },
    {
      "id": "settlement.payout-readiness-self-refresh",
      "owner": "settlement",
      "risk": "critical",
      "freshnessSlo": {
        "flowClass": "important-self-refresh",
        "p95Ms": 2500,
        "p99Ms": 5000
      },
      "source": {
        "routeId": "account-payout-setup",
        "actions": ["Refresh payout setup status", "Complete provider payout setup"],
        "command": "RecordPayoutReadiness",
        "helperUses": ["navigateAfterWrite", "navigateAfterWriteWithPlatformPostWriteToken"]
      },
      "destination": {
        "routeId": "account-sell-list",
        "apiContextName": "settlement",
        "apiRoutePath": "/payout-readiness",
        "readModelTables": ["settlement_payout_readiness_pages"],
        "transientRecovery": {
          "kinds": "refreshable-catching-up",
          "behavior": "Payout setup refresh and provider exit render the command-owned readiness snapshot immediately; when a safe returnTo target is present and the refresh result is ready, the account-payout-setup route redirects to that target with the Settlement receipt so follow-on account surfaces such as Sell List forward afterWrite to the Settlement payout-readiness API and wait on settlement_payout_readiness_pages."
        }
      }
    }
  ],
  "deployableContributions": [
    {
      "deployable": "marketplace-web",
      "routes": [
        {
          "routeId": "account-money-health",
          "routePath": "account/money-health",
          "fileExport": "./routes/marketplace/account-money-health",
          "routeType": "route",
          "sourceContext": "settlement"
        },
        {
          "routeId": "account-payout-operations",
          "routePath": "account/payout-operations",
          "fileExport": "./routes/marketplace/account-payout-operations",
          "routeType": "route",
          "sourceContext": "settlement"
        },
        {
          "routeId": "account-payout-setup",
          "routePath": "account/payouts/setup",
          "fileExport": "./routes/marketplace/account-payout-setup",
          "routeType": "route",
          "sourceContext": "settlement"
        },
        {
          "routeId": "account-payout",
          "routePath": "account/payouts/:payoutId",
          "fileExport": "./routes/marketplace/account-payout",
          "routeType": "route",
          "sourceContext": "settlement"
        },
        {
          "routeId": "account-payouts",
          "routePath": "account/payouts",
          "fileExport": "./routes/marketplace/account-payouts",
          "routeType": "route",
          "sourceContext": "settlement"
        },
        {
          "routeId": "account-settlement",
          "routePath": "account/settlement",
          "fileExport": "./routes/marketplace/account-settlement",
          "routeType": "route",
          "sourceContext": "settlement"
        }
      ]
    }
  ],
  "shellContributions": [
    {
      "deployable": "marketplace-web",
      "slot": "top-nav",
      "placements": ["top-nav", "bottom-nav"],
      "key": "wallet",
      "label": "Wallet",
      "icon": "wallet",
      "href": "/account/settlement",
      "order": 180,
      "visibility": "signed-in",
      "requiredPermissions": ["payouts.view"]
    },
    {
      "deployable": "marketplace-web",
      "slot": "top-nav",
      "placements": ["top-nav", "bottom-nav"],
      "key": "payouts",
      "label": "Payouts",
      "icon": "wallet",
      "href": "/account/payouts",
      "order": 185,
      "visibility": "signed-in",
      "requiredPermissions": ["payouts.view"]
    }
  ],
  "directoryIntent": {
    "wallets": {
      "classification": "slice",
      "purpose": "Own wallets feature behavior, read models, and UI contracts for the settlement context.",
      "expectedConsumers": ["Internal settlement module composition"]
    },
    "payouts": {
      "classification": "slice",
      "purpose": "Own payouts feature behavior, read models, and UI contracts for the settlement context.",
      "expectedConsumers": ["Internal settlement module composition"]
    },
    "payout-readiness": {
      "classification": "slice",
      "purpose": "Own payout readiness behavior, provider requirement state, read models, and UI contracts for the settlement context.",
      "expectedConsumers": ["Internal settlement module composition"]
    },
    "request-support": {
      "classification": "support",
      "purpose": "Provide reusable request-support assets shared by settlement-owned features and composition seams.",
      "expectedConsumers": ["Multiple settlement slices", "Deployable composition for settlement"],
      "crossCuttingRuntimeComposition": true
    },
    "runtime-support": {
      "classification": "support",
      "purpose": "Provide reusable runtime-support assets shared by settlement-owned features and composition seams.",
      "expectedConsumers": ["payout-readiness", "payouts", "wallets"]
    },
    "seed-support": {
      "classification": "support",
      "purpose": "Provide reusable seed-support assets shared by settlement-owned features and composition seams.",
      "expectedConsumers": ["Multiple settlement slices", "Deployable composition for settlement"],
      "crossCuttingRuntimeComposition": true
    },
    "routes": {
      "classification": "routes",
      "purpose": "Expose settlement-owned route modules consumed by generated deployable adapters.",
      "expectedConsumers": ["Generated deployable route adapters"]
    }
  },
  "mutationConsistencyInventory": [
    {
      "id": "settlement.payout-readiness-api-session-snapshots",
      "owner": "settlement",
      "risk": "critical",
      "strategy": "snapshot-return",
      "surfaces": [
        "api-route:bounded-contexts/settlement/features/payout-readiness/api/route.ts:POST /payout-setup/account-management-embedded-session",
        "api-route:bounded-contexts/settlement/features/payout-readiness/api/route.ts:POST /payout-setup/embedded-session",
        "api-route:bounded-contexts/settlement/features/payout-readiness/api/route.ts:POST /payout-setup/refresh"
      ],
      "visibleDestination": {
        "description": "Payout setup API mutations return the provider session or provider-neutral readiness snapshot produced by the Settlement command path, so setup pages do not need to trust a lagging payout-readiness projection for immediate status."
      },
      "proof": {
        "authoritativeResponse": "createPayoutSetupSession returns the embedded session plus the readiness row created from provider readiness recorded by the command; refreshProviderReadiness returns the provider-neutral readiness row built from the same provider response and recorded timestamp; account-management sessions return the provider session needed by the embedded management component without a projection read.",
        "tests": [
          "bounded-contexts/settlement/features/payout-readiness/api/runtime.test.ts",
          "bounded-contexts/settlement/features/payout-readiness/api/route.test.ts",
          "bounded-contexts/settlement/features/payout-readiness/ui/payout-setup-page.test.tsx"
        ]
      }
    },
    {
      "id": "settlement.payout-api-command-snapshots",
      "owner": "settlement",
      "risk": "critical",
      "strategy": "snapshot-return",
      "surfaces": [
        "api-route:bounded-contexts/settlement/features/payouts/api/route.ts:POST /payouts",
        "api-route:bounded-contexts/settlement/features/payouts/api/route.ts:POST /payouts/preview",
        "api-route:bounded-contexts/settlement/features/payouts/api/route.ts:POST /payouts/reconciliation/run"
      ],
      "visibleDestination": {
        "description": "Payout request, preview, and reconciliation mutations return the command-owned payout status, preview, or durable job snapshot that the seller or operator sees immediately after the write."
      },
      "proof": {
        "authoritativeResponse": "requestPayout now returns the final payout aggregate snapshot after provider submission or failure reversal, previewPayoutRequest returns the computed money-readiness preview, and enqueuePayoutReconciliationJob returns the durable job public snapshot used by the operations page.",
        "tests": [
          "bounded-contexts/settlement/features/payouts/api/runtime.test.ts",
          "bounded-contexts/settlement/features/payouts/api/route.test.ts",
          "bounded-contexts/settlement/features/payouts/ui/payout-operations-page.test.tsx",
          "bounded-contexts/settlement/routes/marketplace/account-payout-operations-route.test.ts"
        ]
      }
    },
    {
      "id": "settlement.wallet-operator-ledger-entry-snapshots",
      "owner": "settlement",
      "risk": "critical",
      "strategy": "snapshot-return",
      "surfaces": [
        "api-route:bounded-contexts/settlement/features/wallets/api/route.ts:POST /wallet/adjustments",
        "api-route:bounded-contexts/settlement/features/wallets/api/route.ts:POST /wallet/dispute-holds",
        "api-route:bounded-contexts/settlement/features/wallets/api/route.ts:POST /wallet/dispute-releases",
        "api-route:bounded-contexts/settlement/features/wallets/api/route.ts:POST /wallet/negative-balances/evaluate-collections",
        "api-route:bounded-contexts/settlement/features/wallets/api/route.ts:POST /wallet/refund-debits"
      ],
      "visibleDestination": {
        "description": "Operator wallet mutations return the committed ledger-entry snapshot or negative-balance collections counts without waiting for the wallet ledger read model."
      },
      "proof": {
        "authoritativeResponse": "WalletServices.postEntry builds the response from the settlement.wallet.ledger-entry-posted event that was just committed, duplicate idempotency-key retries return an explicit idempotent duplicate response instead of asking the operator to repeat the input, and evaluateNegativeBalanceCollections returns command-owned escalated/skipped counts.",
        "tests": [
          "bounded-contexts/settlement/features/wallets/api/route.test.ts",
          "bounded-contexts/settlement/features/wallets/domain/domain.test.ts",
          "bounded-contexts/settlement/features/wallets/read-model/queries.test.ts"
        ]
      }
    },
    {
      "id": "settlement.money-movement-webhook-provider-callback",
      "owner": "settlement",
      "risk": "internal",
      "strategy": "non-user-visible",
      "surfaces": ["api-route:bounded-contexts/settlement/features/payouts/api/route.ts:POST /money-movement/webhooks"],
      "exception": {
        "owner": "settlement",
        "reviewBy": "2026-09-30",
        "issue": "#1832",
        "reason": "The money movement webhook route is mounted under the unauthenticated /api/settlement/provider callback surface, records provider events into Settlement commands/inbox rows, and returns only provider acknowledgement state. bounded-contexts/settlement/features/payouts/api/route.test.ts proves the route accepts raw provider callbacks without marketplace auth and returns received/ignored acknowledgements; bounded-contexts/settlement/features/payouts/api/runtime.test.ts proves duplicate provider failure webhooks do not create duplicate wallet reversals."
      }
    },
    {
      "id": "settlement.account-payouts-route-snapshot-correction",
      "owner": "settlement",
      "risk": "critical",
      "strategy": "snapshot-return",
      "surfaces": [
        "post-form:bounded-contexts/settlement/features/payout-readiness/ui/payout-readiness-panel.tsx:H2df726441e2a#1",
        "post-form:bounded-contexts/settlement/features/payout-readiness/ui/payout-readiness-panel.tsx:H2df726441e2a#2",
        "post-form:bounded-contexts/settlement/features/payout-readiness/ui/payout-readiness-panel.tsx:H2df726441e2a#3",
        "post-form:bounded-contexts/settlement/features/payouts/ui/payout-list-page.tsx:H2df726441e2a#1",
        "post-form:bounded-contexts/settlement/features/payouts/ui/payout-list-page.tsx:H2df726441e2a#2",
        "post-form:bounded-contexts/settlement/features/payouts/ui/payout-list-page.tsx:H2df726441e2a#3",
        "route-action:bounded-contexts/settlement/routes/marketplace/account-payouts.tsx"
      ],
      "visibleDestination": {
        "routeId": "account-payouts",
        "description": "The account payouts action returns payout preview, draft, or refreshed readiness snapshots for same-page controls; confirmed payout requests redirect with the original fresh-write receipt to payout detail recovery; start/manage setup intents are navigation-only and do not run a Settlement mutation."
      },
      "proof": {
        "authoritativeResponse": "preview-payout returns the computed preview snapshot, edit-payout returns the submitted draft snapshot, refresh-payout-setup returns and renders the refreshed readiness snapshot, confirm-payout preserves the createPayout commit receipt via navigateAfterWrite, and start/manage setup branches only redirect to setup routes.",
        "tests": [
          "bounded-contexts/settlement/routes/marketplace/account-payouts-route.test.ts",
          "bounded-contexts/settlement/features/payouts/api/route.test.ts",
          "bounded-contexts/settlement/features/payouts/ui/payout-detail-page.test.tsx",
          "bounded-contexts/settlement/features/payout-readiness/ui/payout-readiness-panel.test.tsx"
        ]
      }
    },
    {
      "id": "settlement.account-payout-setup-route-snapshot-correction",
      "owner": "settlement",
      "risk": "critical",
      "strategy": "snapshot-return",
      "surfaces": [
        "post-form:bounded-contexts/settlement/features/payout-readiness/ui/payout-setup-page.tsx:H2df726441e2a#1",
        "route-action:bounded-contexts/settlement/routes/marketplace/account-payout-setup.tsx"
      ],
      "visibleDestination": {
        "routeId": "account-payout-setup",
        "description": "The payout setup page refresh form and provider-exit handler render the readiness snapshot returned by the refresh command before any loader revalidation can lag."
      },
      "proof": {
        "authoritativeResponse": "account-payout-setup refresh returns payoutReadiness action data from refreshPayoutSetup, and provider exit stores the same API snapshot locally while triggering route revalidation as a secondary correction path.",
        "tests": [
          "bounded-contexts/settlement/routes/marketplace/account-payout-setup-route-action.test.ts",
          "bounded-contexts/settlement/features/payout-readiness/ui/payout-setup-page.test.tsx",
          "bounded-contexts/settlement/features/payout-readiness/api/runtime.test.ts"
        ]
      }
    },
    {
      "id": "settlement.account-payout-operations-job-snapshot",
      "owner": "settlement",
      "risk": "important",
      "strategy": "snapshot-return",
      "surfaces": [
        "post-form:bounded-contexts/settlement/features/payouts/ui/payout-operations-page.tsx:H2df726441e2a#1",
        "route-action:bounded-contexts/settlement/routes/marketplace/account-payout-operations.tsx"
      ],
      "visibleDestination": {
        "routeId": "account-payout-operations",
        "description": "The payout operations reconciliation form returns the durable reconciliation job snapshot and renders queued/running/completed progress instead of relying on the reconciliation list projection to update immediately."
      },
      "proof": {
        "authoritativeResponse": "runPayoutReconciliation returns the durable job public snapshot from enqueuePayoutReconciliationJob, and the operations page renders job status/progress/result fields with an explicit queued state until worker convergence updates the durable job.",
        "tests": [
          "bounded-contexts/settlement/routes/marketplace/account-payout-operations-route.test.ts",
          "bounded-contexts/settlement/features/payouts/api/route.test.ts",
          "bounded-contexts/settlement/features/payouts/ui/payout-operations-page.test.tsx"
        ]
      }
    }
  ],
  "runtimeDeployables": ["platform-worker"],
  "apiRuntimeProfiles": ["proof", "public"],
  "workerRuntimeProfiles": ["proof", "public"]
}
