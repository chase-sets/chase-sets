  "directoryIntent": {
    "wallets": {
      "classification": "slice",
      "purpose": "Own wallets feature behavior, read models, and UI contracts for the settlement context.",
      "expectedConsumers": ["Internal settlement module composition"]
    },
    "payouts": {
      "classification": "slice",
      "purpose": "Own payouts feature behavior, read models, and UI contracts for the settlement context.",
      "expectedConsumers": ["Internal settlement module composition"]
    },
    "payout-readiness": {
      "classification": "slice",
      "purpose": "Own payout readiness behavior, provider requirement state, read models, and UI contracts for the settlement context.",
      "expectedConsumers": ["Internal settlement module composition"]
    },
    "money-dashboard": {
      "classification": "slice",
      "purpose": "Compose Settlement wallet, payout, readiness, attention, and account-facing money workflows into the Seller Desk Money surface.",
      "expectedConsumers": ["Internal settlement module composition"]
    },
    "protection-coverage": {
      "classification": "slice",
      "purpose": "Own the ProtectionCoverage reservation aggregate, protection-reserve accounting, read models, and reconciliation for the settlement context.",
      "expectedConsumers": ["Internal settlement module composition"]
    },
    "liability-allocation": {
      "classification": "slice",
      "purpose": "Allocate refund liability per the authorized LiabilityAllocation: post the seller-funded portion to the wallet ledger-entry record, consume the platform-funded protection-coverage reservation, reconcile the correlated support hold, and quarantine mismatches for operator repair.",
      "expectedConsumers": ["Internal settlement module composition"]
    },
    "request-support": {
      "classification": "support",
      "purpose": "Provide reusable request-support assets shared by settlement-owned features and composition seams.",
      "expectedConsumers": ["wallets"],
      "crossCuttingRuntimeComposition": true
    },
    "runtime-support": {
      "classification": "support",
      "purpose": "Provide reusable runtime-support assets shared by settlement-owned features and composition seams.",
      "expectedConsumers": ["payout-readiness", "payouts", "protection-coverage", "wallets"]
    },
    "seed-support": {
      "classification": "support",
      "purpose": "Provide reusable seed-support assets shared by settlement-owned features and composition seams.",
      "expectedConsumers": ["Multiple settlement slices", "Deployable composition for settlement"],
      "crossCuttingRuntimeComposition": true
    },
    "routes": {
      "classification": "routes",
      "purpose": "Expose settlement-owned route modules consumed by generated deployable adapters.",
      "expectedConsumers": ["Generated deployable route adapters"]
    }
  },
  "mutationConsistencyInventory": [
    {
      "id": "settlement.payout-readiness-api-session-snapshots",
      "owner": "settlement",
      "risk": "critical",
      "strategy": "snapshot-return",
      "surfaces": [
        "api-route:bounded-contexts/settlement/features/payout-readiness/api/route.ts:POST /payout-setup/account-management-embedded-session",
        "api-route:bounded-contexts/settlement/features/payout-readiness/api/route.ts:POST /payout-setup/embedded-session",
        "api-route:bounded-contexts/settlement/features/payout-readiness/api/route.ts:POST /payout-setup/notification-banner-session",
        "api-route:bounded-contexts/settlement/features/payout-readiness/api/route.ts:POST /payout-setup/refresh"
      ],
      "visibleDestination": {
        "description": "Payout setup API mutations return the provider session or provider-neutral readiness snapshot produced by the Settlement command path, so setup pages do not need to trust a lagging payout-readiness projection for immediate status."
      },
      "proof": {
        "authoritativeResponse": "createPayoutSetupSession returns the embedded session plus the readiness row created from provider readiness recorded by the command; refreshProviderReadiness returns the provider-neutral readiness row built from the same provider response and recorded timestamp; account-management sessions return the provider session needed by the embedded management component without a projection read; notification-banner sessions return the provider session needed by the read-only Stripe banner without changing Settlement readiness.",
        "tests": [
          "bounded-contexts/settlement/features/payout-readiness/api/runtime.test.ts",
          "bounded-contexts/settlement/features/payout-readiness/api/route.test.ts",
          "bounded-contexts/settlement/features/payout-readiness/ui/payout-setup-page.test.tsx"
        ]
      }
    },
    {
      "id": "settlement.payout-api-command-snapshots",
      "owner": "settlement",
      "risk": "critical",
      "strategy": "snapshot-return",
      "surfaces": [
        "api-route:bounded-contexts/settlement/features/payouts/api/route.ts:POST /payouts",
        "api-route:bounded-contexts/settlement/features/payouts/api/route.ts:POST /payouts/preview",
        "api-route:bounded-contexts/settlement/features/payouts/api/route.ts:POST /payouts/reconciliation/run"
      ],
      "visibleDestination": {
        "description": "Payout request, preview, and reconciliation mutations return the command-owned payout status, preview, or durable job snapshot that the seller or operator sees immediately after the write."
      },
      "proof": {
        "authoritativeResponse": "requestPayout now returns the final payout aggregate snapshot after provider submission or failure reversal, previewPayoutRequest returns the computed money-readiness preview, and enqueuePayoutReconciliationJob returns the durable job public snapshot used by the operations page.",
        "tests": [
          "bounded-contexts/settlement/features/payouts/api/runtime.test.ts",
          "bounded-contexts/settlement/features/payouts/api/route.test.ts",
          "bounded-contexts/settlement/features/payouts/ui/payout-operations-page.test.tsx",
          "bounded-contexts/settlement/routes/admin/payout-operations-route.test.ts"
        ]
      }
    },
    {
      "id": "settlement.wallet-operator-ledger-entry-snapshots",
      "owner": "settlement",
      "risk": "critical",
      "strategy": "snapshot-return",
      "surfaces": [
        "api-route:bounded-contexts/settlement/features/wallets/api/route.ts:POST /wallet/dispute-holds",
        "api-route:bounded-contexts/settlement/features/wallets/api/route.ts:POST /wallet/dispute-releases",
        "api-route:bounded-contexts/settlement/features/wallets/api/route.ts:POST /wallet/negative-balances/evaluate-collections",
        "api-route:bounded-contexts/settlement/features/wallets/api/route.ts:POST /wallet/refund-debits"
      ],
      "visibleDestination": {
        "description": "Operator wallet mutations return the committed ledger-entry snapshot or negative-balance collections counts without waiting for the wallet ledger read model."
      },
      "proof": {
        "authoritativeResponse": "WalletServices.postEntry builds the response from the settlement.wallet.ledger-entry-posted event that was just committed, duplicate idempotency-key retries return an explicit idempotent duplicate response instead of asking the operator to repeat the input, and evaluateNegativeBalanceCollections returns command-owned escalated/skipped counts.",
        "tests": [
          "bounded-contexts/settlement/features/wallets/api/route.test.ts",
          "bounded-contexts/settlement/features/wallets/domain/domain.test.ts",
