{
  "contextName": "settlement",
  "packageName": "@chase-sets/settlement",
  "ownedNouns": ["wallet", "wallet-adjustment", "payout", "payout-readiness", "ledger-entry"],
  "streamPrefix": "settlement.",
  "apiBasePath": "/api/settlement",
  "slices": [
    "wallets",
    "payout-readiness",
    "payouts",
    "money-dashboard",
    "protection-coverage",
    "liability-allocation"
  ],
  "allowedSupportDirectories": ["request-support", "runtime-support", "seed-support"],
  "publicExports": [".", "./context", "./routes/*", "./seed-support/*", "./server"],
  "allowedContextDependencies": ["@chase-sets/customer-feedback", "@chase-sets/identity"],
  "seedRequirements": ["identity", "payments"],
  "eventSubscriptions": [
    {
      "sourceContextName": "payments",
      "projectionName": "settlement-payment-input-projection",
      "subscriptionVersion": 3,
      "eventTypes": [
        "payments.payment-created",
        "payments.payment-authorized",
        "payments.payment-captured",
        "payments.payment-failed",
        "payments.payment-cancelled",
        "payments.payment-refunded",
        "payments.payment-disputed",
        "payments.refund-requested",
        "payments.refund-issued",
        "payments.refund-failed"
      ],
      "order": 10,
      "projectionHandlerSetNames": ["settlement-payment-input-projection"]
    },
    {
      "sourceContextName": "platform-operations",
      "projectionName": "settlement-liability-allocation-reserve-projection",
      "subscriptionVersion": 1,
      "eventTypes": ["support.support-request.platform-coverage-requested.v1"],
      "order": 12,
      "projectionHandlerSetNames": ["settlement-liability-allocation-reserve-projection"]
    },
    {
      "sourceContextName": "platform-operations",
      "projectionName": "settlement-support-hold-lifecycle-projection",
      "subscriptionVersion": 1,
      "eventTypes": [
        "support.support-request.opened",
        "support.support-request.resolved",
        "support.support-request.closed",
        "support.support-request.cancelled"
      ],
      "order": 81,
      "projectionHandlerSetNames": ["settlement-support-hold-lifecycle-projection"]
    },
    {
      "sourceContextName": "settlement",
      "projectionName": "settlement-support-hold-projection",
      "subscriptionVersion": 1,
      "eventTypes": ["settlement.protection-coverage.settled.v1"],
      "order": 13,
      "projectionHandlerSetNames": ["settlement-support-hold-projection"]
    },
    {
      "sourceContextName": "payments",
      "projectionName": "settlement-support-hold-projection",
      "subscriptionVersion": 1,
      "eventTypes": [
        "payments.payment-disputed",
        "payments.payment-fraud-warning-received",
        "payments.payment-fraud-review-opened",
        "payments.payment-fraud-review-closed"
      ],
      "order": 11,
      "projectionHandlerSetNames": ["settlement-support-hold-projection"]
    },
    {
      "sourceContextName": "platform-operations",
      "projectionName": "settlement-support-hold-projection",
      "subscriptionVersion": 1,
      "eventTypes": [
        "support.support-request.opened",
        "support.support-request.escalated",
        "support.support-request.resolved",
        "support.support-request.closed",
        "support.support-request.cancelled"
      ],
      "order": 80,
      "projectionHandlerSetNames": ["settlement-support-hold-projection"]
    },
    {
      "sourceContextName": "fulfillment",
      "projectionName": "settlement-fulfillment-source-projection",
      "subscriptionVersion": 1,
      "eventTypes": [
        "fulfillment.shipment.created",
        "fulfillment.shipment.dispatched",
        "fulfillment.shipment.delivered",
        "fulfillment.shipment.returned",
        "fulfillment.shipment.exception-raised"
      ],
      "order": 60,
      "projectionHandlerSetNames": ["settlement-fulfillment-source-projection"]
    },
    {
      "sourceContextName": "inventory",
      "projectionName": "settlement-inventory-recovery-workflow",
      "subscriptionVersion": 1,
      "sourceContextMount": "when-mounted",
      "eventTypes": ["inventory.recovered-item.value-reported.v1"],
      "order": 61,
      "projectionHandlerSetNames": ["settlement-inventory-recovery-workflow"]
    },
    {
      "sourceContextName": "identity",
      "projectionName": "settlement-account-risk-source-projection",
      "subscriptionVersion": 1,
      "eventTypes": [
        "identity.account.created",
        "identity.account.badge-assigned",
        "identity.account.badge-removed",
        "identity.shipping-address.added",
        "identity.shipping-address.updated",
        "identity.shipping-address.archived"
      ],
      "order": 20,
      "projectionHandlerSetNames": ["settlement-account-risk-source-projection"]
    },
    {
      "sourceContextName": "marketplace",
      "projectionName": "settlement-account-risk-source-projection",
      "subscriptionVersion": 2,
      "eventTypes": [
        "marketplace.listing.created",
        "marketplace.review.submitted",
        "marketplace.review.updated",
        "marketplace.review.withdrawn",
        "marketplace.review.revealed",
        "marketplace.review-scoring.disposition-projected.v1",
        "marketplace.review-hold.placed",
        "marketplace.review-hold.extended",
        "marketplace.review-hold.reduced",
        "marketplace.review-hold.released",
        "marketplace.review-hold.terminal-recorded"
      ],
      "order": 70,
      "projectionHandlerSetNames": ["settlement-account-risk-source-projection"]
    },
    {
      "sourceContextName": "payments",
      "projectionName": "settlement-account-risk-source-projection",
      "subscriptionVersion": 1,
      "eventTypes": [
        "payments.payment-created",
        "payments.payment-disputed",
        "payments.payment-fraud-warning-received",
        "payments.payment-fraud-review-opened",
        "payments.payment-fraud-review-closed",
        "payments.checkout-affordances-published"
      ],
      "order": 71,
      "projectionHandlerSetNames": ["settlement-account-risk-source-projection"]
    }
  ],
  "projectionGroups": [
    {
      "projectionName": "settlement-payment-input-projection",
      "sourceContextNames": ["payments"],
      "ownedTables": [
        "settlement_payment_sources",
        "settlement_refund_sources",
        "settlement_protection_reserve_facts",
        "settlement_refund_liability_allocations"
      ],
      "requiredDuringBootstrap": true,
      "resetStrategy": "replay-only"
    },
    {
      "projectionName": "settlement-support-hold-projection",
      "sourceContextNames": ["platform-operations", "payments", "settlement"],
      "ownedTables": ["settlement_support_holds"],
      "requiredDuringBootstrap": false,
      "resetStrategy": "replay-only"
    },
    {
      "projectionName": "settlement-liability-allocation-reserve-projection",
      "sourceContextNames": ["platform-operations"],
      "ownedTables": [],
      "sideEffectOnly": true,
      "requiredDuringBootstrap": false,
      "resetStrategy": "replay-only"
    },
    {
      "projectionName": "settlement-inventory-recovery-workflow",
      "sourceContextNames": ["inventory"],
      "optionalSourceContextNames": ["inventory"],
      "ownedTables": [],
      "requiredDuringBootstrap": false,
      "resetStrategy": "replay-only",
      "sideEffectOnly": true
    },
    {
      "projectionName": "settlement-support-hold-lifecycle-projection",
      "sourceContextNames": ["platform-operations"],
      "ownedTables": [],
      "sideEffectOnly": true,
      "requiredDuringBootstrap": false,
      "resetStrategy": "replay-only"
    },
    {
      "projectionName": "settlement-fulfillment-source-projection",
      "sourceContextNames": ["fulfillment"],
      "ownedTables": ["settlement_order_fulfillment_sources"],
      "requiredDuringBootstrap": false,
      "resetStrategy": "replay-only"
    },
    {
      "projectionName": "settlement-account-risk-source-projection",
      "projectionRevision": 2,
      "sourceContextNames": ["identity", "marketplace", "payments"],
      "ownedTables": [
        "settlement_account_risk_sources",
        "settlement_account_review_sources",
        "settlement_account_instrument_risk_sources",
        "settlement_account_address_risk_sources",
        "settlement_account_velocity_sources"
      ],
      "requiredDuringBootstrap": false,
      "resetStrategy": "replay-only"
    },
    {
      "projectionName": "settlement-payout-projection",
      "sourceContextNames": ["settlement"],
      "ownedTables": ["settlement_payout_pages"],
      "requiredDuringBootstrap": false,
      "resetStrategy": "truncate-owned-tables"
    },
    {
      "projectionName": "settlement-protection-coverage-projection",
      "sourceContextNames": ["settlement"],
      "ownedTables": [
        "settlement_protection_coverage",
        "settlement_protection_coverage_rejections",
        "settlement_protection_coverage_recoveries"
      ],
      "requiredDuringBootstrap": false,
      "resetStrategy": "truncate-owned-tables"
    },
    {
      "projectionName": "settlement-payout-readiness-projection",
      "sourceContextNames": ["settlement"],
      "ownedTables": ["settlement_payout_readiness_pages"],
      "requiredDuringBootstrap": false,
      "resetStrategy": "truncate-owned-tables"
    },
    {
      "projectionName": "platform-policy-document-projection",
      "sourceContextNames": ["settlement"],
      "ownedTables": ["platform_policy_documents", "platform_policy_document_history"],
      "requiredDuringBootstrap": false,
      "resetStrategy": "truncate-owned-tables"
    }
  ],
  "hostPorts": [
    {
      "portName": "moneyMovementGateway",
      "providedBy": "platform-api",
      "purpose": "Provider-neutral money movement adapter for payout setup, platform-balance transfers, connected-account payouts, and payout webhooks."
    },
    {
      "portName": "webhookTelemetry",
      "providedBy": "platform-api",
      "purpose": "Record support-safe Stripe webhook failure classes, retry decisions, and provider event references."
    },
    {
      "portName": "notificationOutbox",
      "providedBy": "platform-worker",
      "purpose": "Durable outbound notification outbox consumed only by event projectors."
    },
    {
      "portName": "termsAcceptanceResolver",
      "providedBy": "identity",
      "purpose": "Resolve whether a buyer has accepted the active Terms of Service version so wallet balance credit can be applied at checkout without Settlement querying Identity storage."
    }
  ],
  "apiDeployables": ["platform-api"],
  "apiMounts": [
    {
      "mountPath": "/api/settlement",
      "kind": "primary",
      "requiresAuth": true,
      "readFreshnessRoutes": [
        {
          "routePath": "/payouts/:id",
          "methods": ["GET", "HEAD"],
          "dependencies": [
            {
              "readModelTable": "settlement_payout_pages"
            }
          ]
        },
        {
          "routePath": "/payout-readiness",
          "methods": ["GET", "HEAD"],
          "dependencies": [
            {
              "readModelTable": "settlement_payout_readiness_pages"
            }
          ]
        }
      ]
    },
    {
      "mountPath": "/api/settlement/provider",
      "kind": "additional",
      "requiresAuth": false
    }
  ],
  "mcpCapabilities": {
    "tools": [
      { "name": "settlement.get-wallet", "ownerSlice": "wallets" },
      { "name": "settlement.list-ledger-entries", "ownerSlice": "wallets" },
      { "name": "settlement.list-payouts", "ownerSlice": "payouts" },
      { "name": "settlement.get-payout", "ownerSlice": "payouts" },
      { "name": "settlement.request-payout", "ownerSlice": "payouts" },
      { "name": "settlement.refresh-readiness", "ownerSlice": "payout-readiness" },
      { "name": "settlement.create-payout-onboarding-link", "ownerSlice": "payout-readiness" }
    ],
    "resources": [
      {
        "uriTemplate": "chase-sets://settlement/{accountId}/wallet",
        "ownerSlice": "wallets"
      },
      {
        "uriTemplate": "chase-sets://settlement/{accountId}/payouts/{payoutId}",
        "ownerSlice": "payouts"
      }
    ]
  },
  "readAfterWriteRouteInventory": [
    {
      "id": "settlement.payout-request-to-detail",
      "owner": "settlement",
      "risk": "critical",
      "freshnessSlo": {
        "flowClass": "critical-customer-handoff",
        "p95Ms": 1000,
        "p99Ms": 2250
      },
      "source": {
        "routeId": "account-desk-money",
        "actions": ["Request payout"],
        "command": "Settlement payout request command",
        "helperUses": ["navigateAfterWrite"]
      },
      "destination": {
        "routeId": "account-desk-payout",
        "apiContextName": "settlement",
        "apiRoutePath": "/payouts/:id",
        "readModelTables": ["settlement_payout_pages"],
        "helperUses": ["loadAfterWrite"],
        "transientRecovery": {
          "kinds": "refreshable-catching-up",
          "behavior": "Payout detail redirects carry the Settlement payout request receipt; the API waits on settlement_payout_pages and the loader treats fresh 404 or projection freshness timeout as temporary payout preparation."
        }
      }
    },
    {
      "id": "settlement.payout-readiness-self-refresh",
      "owner": "settlement",
      "risk": "critical",
      "freshnessSlo": {
        "flowClass": "important-self-refresh",
        "p95Ms": 2500,
        "p99Ms": 5000
      },
      "source": {
        "routeId": "account-desk-settings",
        "actions": ["Refresh payout setup status", "Complete provider payout setup"],
        "command": "RecordPayoutReadiness",
        "helperUses": ["navigateAfterWrite", "navigateAfterWriteWithPlatformPostWriteToken"]
      },
      "destination": {
        "routeId": "account-sell-list",
        "apiContextName": "settlement",
        "apiRoutePath": "/payout-readiness",
        "readModelTables": ["settlement_payout_readiness_pages"],
        "transientRecovery": {
          "kinds": "refreshable-catching-up",
          "behavior": "Payout setup refresh and provider exit render the command-owned readiness snapshot immediately; when a safe returnTo target is present and the refresh result is ready, the account-payout-setup route redirects to that target with the Settlement receipt so follow-on account surfaces such as Sell List forward afterWrite to the Settlement payout-readiness API and wait on settlement_payout_readiness_pages."
        }
      }
    }
  ],
  "deployableContributions": [
    {
      "deployable": "admin-web",
      "routes": [
        {
          "routeId": "settlement-money-health",
          "routePath": "money-health",
          "fileExport": "./routes/admin/money-health",
          "routeType": "route",
          "sourceContext": "settlement",
          "section": "commerce"
        },
        {
          "routeId": "settlement-payout-operations",
          "routePath": "payout-operations",
          "fileExport": "./routes/admin/payout-operations",
          "routeType": "route",
          "sourceContext": "settlement",
          "section": "commerce"
        },
        {
          "routeId": "settlement-wallet-workbench",
          "routePath": "wallet-workbench/:accountId",
          "fileExport": "./routes/admin/wallet-workbench",
          "routeType": "route",
          "sourceContext": "settlement",
          "section": "commerce"
        }
      ]
    },
    {
      "deployable": "marketplace-web",
      "routes": [
        {
          "routeId": "account-desk-money",
          "routePath": "account/desk/money",
          "fileExport": "./routes/marketplace/account-desk-money",
          "routeType": "route",
          "sourceContext": "settlement"
        },
        {
          "routeId": "account-desk-payout",
          "routePath": "account/desk/payouts/:payoutId",
          "fileExport": "./routes/marketplace/account-desk-payout",
          "routeType": "route",
          "sourceContext": "settlement"
        },
        {
          "routeId": "account-desk-settings",
          "routePath": "account/desk/settings",
          "fileExport": "./routes/marketplace/account-payout-setup",
          "routeType": "route",
          "sourceContext": "settlement"
        },
        {
          "routeId": "account-payout-setup",
          "routePath": "account/payouts/setup",
          "fileExport": "./routes/marketplace/account-desk-settings",
          "routeType": "route",
          "sourceContext": "settlement"
        },
        {
          "routeId": "account-payout",
          "routePath": "account/payouts/:payoutId",
          "fileExport": "./routes/marketplace/account-payout",
          "routeType": "route",
          "sourceContext": "settlement"
        },
        {
          "routeId": "account-payouts",
          "routePath": "account/payouts",
          "fileExport": "./routes/marketplace/account-payouts",
          "routeType": "route",
          "sourceContext": "settlement"
        },
        {
          "routeId": "account-settlement",
          "routePath": "account/settlement",
          "fileExport": "./routes/marketplace/account-settlement",
          "routeType": "route",
          "sourceContext": "settlement"
        },
        {
          "routeId": "account-wallet-adjustment",
          "routePath": "account/wallet/adjustments/:reference",
          "fileExport": "./routes/marketplace/account-wallet-adjustment",
          "routeType": "route",
          "sourceContext": "settlement"
        }
      ]
    }
  ],
  "shellContributions": [
    {
      "deployable": "admin-web",
      "slot": "primary-nav",
      "key": "settlement-money-health",
      "label": "Money Health",
      "icon": "wallet",
      "href": "/money-health",
      "section": "commerce",
      "order": 80,
      "visibility": "signed-in",
      "requiredPermissions": ["payouts.reconcile"]
    },
    {
      "deployable": "admin-web",
      "slot": "primary-nav",
      "key": "settlement-payout-operations",
      "label": "Payout Operations",
      "icon": "wallet",
      "href": "/payout-operations",
      "section": "commerce",
      "order": 85,
      "visibility": "signed-in",
      "requiredPermissions": ["payouts.reconcile"]
    },
    {
      "deployable": "marketplace-web",
      "slot": "top-nav",
      "placements": ["top-nav", "bottom-nav"],
      "key": "money",
      "label": "Money",
      "icon": "wallet",
      "href": "/account/desk/money",
      "order": 180,
      "visibility": "signed-in",
      "requiredPermissions": ["payouts.view"]
    }
