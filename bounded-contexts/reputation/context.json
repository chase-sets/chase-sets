{
  "contextName": "reputation",
  "packageName": "@chase-sets/reputation",
  "ownedNouns": [
    "review",
    "review-summary"
  ],
  "streamPrefix": "reputation.",
  "apiBasePath": "/api/marketplace",
  "slices": [
    "reviews"
  ],
  "allowedSupportDirectories": [
    "request-support",
    "route-support",
    "runtime-support",
    "seed-support"
  ],
  "publicExports": [
    ".",
    "./context",
    "./routes/*",
    "./seed-support/*",
    "./server"
  ],
  "allowedContextDependencies": [
    "@chase-sets/identity"
  ],
  "seedRequirements": [
    "identity",
    "fulfillment"
  ],
  "eventSubscriptions": [
    {
      "sourceContextName": "identity",
      "projectionName": "reputation-account-projection",
      "subscriptionVersion": 1,
      "projectorNames": [
        "reputation-account-projection"
      ],
      "eventTypes": [
        "identity.account.created",
        "identity.account.profile-updated",
        "identity.account.suspended",
        "identity.account.reactivated",
        "identity.account.closed"
      ],
      "order": 10
    },
    {
      "sourceContextName": "ordering",
      "projectionName": "reputation-order-source-projection",
      "subscriptionVersion": 1,
      "projectorNames": [
        "reputation-order-source-projection"
      ],
      "eventTypes": [
        "ordering.order.created",
        "ordering.order.pending-payment-recorded",
        "ordering.order.cancelled",
        "ordering.order.ready-for-fulfillment-recorded"
      ],
      "order": 20
    },
    {
      "sourceContextName": "fulfillment",
      "projectionName": "reputation-shipment-source-projection",
      "subscriptionVersion": 1,
      "projectorNames": [
        "reputation-shipment-source-projection"
      ],
      "eventTypes": [
        "fulfillment.shipment.created",
        "fulfillment.shipment.dispatched",
        "fulfillment.shipment.delivered",
        "fulfillment.shipment.returned",
        "fulfillment.shipment.exception-raised"
      ],
      "order": 30
    },
    {
      "sourceContextName": "support",
      "projectionName": "reputation-support-source-projection",
      "subscriptionVersion": 1,
      "projectorNames": [
        "reputation-support-source-projection"
      ],
      "eventTypes": [
        "support.support-request.opened",
        "support.support-request.resolved",
        "support.support-request.cancelled"
      ],
      "order": 90
    }
  ],
  "projectionGroups": [
    {
      "projectionName": "reputation-account-projection",
      "sourceContextNames": [
        "identity"
      ],
      "ownedTables": [
        "reputation_account_pages"
      ],
      "requiredDuringBootstrap": true
    },
    {
      "projectionName": "reputation-order-source-projection",
      "sourceContextNames": [
        "ordering"
      ],
      "ownedTables": [
        "reputation_order_sources"
      ],
      "requiredDuringBootstrap": true
    },
    {
      "projectionName": "reputation-shipment-source-projection",
      "sourceContextNames": [
        "fulfillment"
      ],
      "ownedTables": [
        "reputation_shipment_sources"
      ],
      "requiredDuringBootstrap": true
    },
    {
      "projectionName": "reputation-support-source-projection",
      "sourceContextNames": [
        "support"
      ],
      "ownedTables": [
        "reputation_review_eligibility_pages"
      ],
      "requiredDuringBootstrap": false
    }
  ],
  "hostPorts": [],
  "apiDeployables": [
    "platform-api"
  ],
  "apiMounts": [
    {
      "mountPath": "/api/marketplace",
      "kind": "primary",
      "requiresAuth": true,
      "drainProjectorsOnWrite": true
    }
  ],
  "deployableContributions": [
    {
      "deployable": "marketplace-web",
      "routes": [
        {
          "routeId": "account-purchase-review",
          "routePath": "account/purchases/:purchaseId/review",
          "fileExport": "./routes/marketplace/account-purchase-review",
          "routeType": "route",
          "sourceContext": "reputation"
        },
        {
          "routeId": "account-received-reviews",
          "routePath": "account/reviews/received",
          "fileExport": "./routes/marketplace/account-received-reviews",
          "routeType": "route",
          "sourceContext": "reputation"
        },
        {
          "routeId": "account-review-summary",
          "routePath": "account/reviews",
          "fileExport": "./routes/marketplace/account-review-summary",
          "routeType": "route",
          "sourceContext": "reputation"
        },
        {
          "routeId": "account-review",
          "routePath": "account/reviews/:reviewId",
          "fileExport": "./routes/marketplace/account-review",
          "routeType": "route",
          "sourceContext": "reputation"
        },
        {
          "routeId": "account-sale-review",
          "routePath": "account/sales/:orderId/review",
          "fileExport": "./routes/marketplace/account-sale-review",
          "routeType": "route",
          "sourceContext": "reputation"
        },
        {
          "routeId": "account-written-reviews",
          "routePath": "account/reviews/written",
          "fileExport": "./routes/marketplace/account-written-reviews",
          "routeType": "route",
          "sourceContext": "reputation"
        }
      ]
    }
  ],
  "shellContributions": [
    {
      "deployable": "marketplace-web",
      "slot": "top-nav",
      "key": "reviews",
      "label": "Reviews",
      "icon": "star",
      "href": "/account/reviews",
      "order": 160,
      "visibility": "signed-in",
      "requiredPermissions": [
        "reputation.view"
      ]
    },
    {
      "deployable": "marketplace-web",
      "slot": "bottom-nav",
      "key": "reviews",
      "label": "Reviews",
      "icon": "star",
      "href": "/account/reviews",
      "order": 160,
      "visibility": "signed-in",
      "requiredPermissions": [
        "reputation.view"
      ]
    }
  ],
  "directoryIntent": {
    "reviews": {
      "classification": "slice",
      "purpose": "Own reviews feature behavior, read models, and UI contracts for the reputation context.",
      "allowedWhen": "Always; slice directories are the default root shape for implemented context features.",
      "expectedConsumers": [
        "Internal reputation module composition"
      ]
    },
    "request-support": {
      "classification": "support",
      "purpose": "Provide reusable request-support assets shared by reputation-owned features and composition seams.",
      "allowedWhen": "Allowed only when capability cannot stay inside one feature and cross-feature reuse is explicit.",
      "expectedConsumers": [
        "Multiple reputation slices",
        "Deployable composition for reputation"
      ],
      "justification": "request-support centralizes context-local composition that should not duplicate across features.",
      "createdFor": "reputation workflows that span multiple features or public entrypoints.",
      "sunsetWhen": "Remove when all consumers can move the behavior back into feature-local modules.",
      "crossCuttingRuntimeComposition": true
    },
    "route-support": {
      "classification": "support",
      "purpose": "Provide reusable route-support assets shared by reputation-owned route modules.",
      "allowedWhen": "Allowed only when route-layer behavior is duplicated across reputation-owned deployable routes.",
      "expectedConsumers": [
        "routes"
      ],
      "justification": "route-support centralizes route composition for the shared review-submission workflow.",
      "createdFor": "purchase and sale review submission routes that differ only by entry-point path and not-found copy.",
      "sunsetWhen": "Remove when the route modules no longer share meaningful request and rendering behavior."
    },
    "runtime-support": {
      "classification": "support",
      "purpose": "Provide reusable runtime-support assets shared by reputation-owned features and composition seams.",
      "allowedWhen": "Allowed only when capability cannot stay inside one feature and cross-feature reuse is explicit.",
      "expectedConsumers": [
        "reviews"
      ],
      "justification": "runtime-support centralizes context-local composition that should not duplicate across features.",
      "createdFor": "reputation workflows that span multiple features or public entrypoints.",
      "sunsetWhen": "Remove when all consumers can move the behavior back into feature-local modules."
    },
    "seed-support": {
      "classification": "support",
      "purpose": "Provide reusable seed-support assets shared by reputation-owned features and composition seams.",
      "allowedWhen": "Allowed only when capability cannot stay inside one feature and cross-feature reuse is explicit.",
      "expectedConsumers": [
        "Multiple reputation slices",
        "Deployable composition for reputation"
      ],
      "justification": "seed-support centralizes context-local composition that should not duplicate across features.",
      "createdFor": "reputation workflows that span multiple features or public entrypoints.",
      "sunsetWhen": "Remove when all consumers can move the behavior back into feature-local modules.",
      "crossCuttingRuntimeComposition": true
    },
    "routes": {
      "classification": "routes",
      "purpose": "Expose reputation-owned route modules consumed by generated deployable adapters.",
      "allowedWhen": "Required whenever the context contributes routes to any deployable.",
      "expectedConsumers": [
        "Generated deployable route adapters"
      ]
    }
  },
  "runtimeDeployables": [
    "platform-worker"
  ]
}
