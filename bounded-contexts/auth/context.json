  "directoryIntent": {
    "account-selection": {
      "classification": "slice",
      "purpose": "Own account-selection feature behavior, read models, and UI contracts for the auth context.",
      "expectedConsumers": ["Internal auth module composition"]
    },
    "agent-grants": {
      "classification": "slice",
      "purpose": "Own the connected-agents self-service UI: grant listing, connect instructions, spending-mandate controls, and per-grant activity, over the Identity-owned linked platform authorizations and the UCP OAuth ucp-support routes.",
      "expectedConsumers": ["Internal auth module composition"]
    },
    "registration": {
      "classification": "slice",
      "purpose": "Own registration feature behavior, read models, and UI contracts for the auth context.",
      "expectedConsumers": ["Internal auth module composition"]
    },
    "sessions": {
      "classification": "slice",
      "purpose": "Own sessions feature behavior, read models, and UI contracts for the auth context.",
      "expectedConsumers": ["Internal auth module composition"]
    },
    "sign-in": {
      "classification": "slice",
      "purpose": "Own sign-in feature behavior, read models, and UI contracts for the auth context.",
      "expectedConsumers": ["Internal auth module composition"]
    },
    "api-support": {
      "classification": "support",
      "purpose": "Provide reusable api-support assets shared by auth-owned features and composition seams.",
      "expectedConsumers": ["Deployable composition for auth", "sessions"]
    },
    "auth-support": {
      "classification": "support",
      "purpose": "Provide reusable auth-support assets shared by auth-owned features and composition seams.",
      "expectedConsumers": ["Multiple auth slices"]
    },
    "request-support": {
      "classification": "support",
      "purpose": "Provide reusable request-support assets shared by auth-owned features and composition seams.",
      "expectedConsumers": ["registration", "sign-in"],
      "crossCuttingRuntimeComposition": true
    },
    "route-support": {
      "classification": "support",
      "purpose": "Provide reusable route-support assets shared by auth-owned features and composition seams.",
      "expectedConsumers": ["registration", "sign-in"]
    },
    "runtime-support": {
      "classification": "support",
      "purpose": "Provide reusable runtime-support assets shared by auth-owned features and composition seams.",
      "expectedConsumers": ["sessions"]
    },
    "seed-support": {
      "classification": "support",
      "purpose": "Provide reusable seed-support assets shared by auth-owned features and composition seams.",
      "expectedConsumers": ["Multiple auth slices", "Deployable composition for auth"],
      "crossCuttingRuntimeComposition": true
    },
    "social-login-support": {
      "classification": "support",
      "purpose": "Provide provider-neutral social-login adapters for Auth sign-in, registration, and API callback composition while keeping provider details out of feature UI and session aggregates.",
      "expectedConsumers": ["sign-in", "registration", "Deployable composition for auth"]
    },
    "ucp-support": {
      "classification": "support",
      "purpose": "Provide Auth-owned UCP OAuth authorization, token, and revocation routes while Identity owns durable linked platform authorization facts.",
      "expectedConsumers": ["Deployable composition for UCP identity linking"]
    },
    "ui-support": {
      "classification": "support",
      "purpose": "Provide reusable ui-support assets shared by auth-owned features and composition seams.",
      "expectedConsumers": ["registration", "sign-in"]
    },
    "routes": {
      "classification": "routes",
      "purpose": "Expose auth-owned route modules consumed by generated deployable adapters.",
      "expectedConsumers": ["Generated deployable route adapters"]
    }
  },
  "runtimeDeployables": ["platform-worker"],
  "readAfterWriteRouteInventory": [
    {
      "id": "auth.current-session-fresh-read",
      "owner": "auth",
      "risk": "important",
      "freshnessSlo": {
        "flowClass": "important-self-refresh",
        "p95Ms": 2500,
        "p99Ms": 5000
      },
      "source": {
        "routeIds": ["register", "sign-in"],
        "actions": [
          "Complete password registration",
          "Complete passkey registration",
          "Complete first magic-link authentication",
          "Complete first phone-code authentication"
        ],
        "command": "Auth browser authentication that starts the selected account session"
      },
      "destination": {
        "routeIds": ["account"],
        "apiContextName": "auth",
        "apiRoutePath": "/session",
        "readModelTables": ["identity_sessions"],
        "transientRecovery": {
          "kinds": "refreshable-catching-up",
          "behavior": "Marketplace routes that require the current actor forward the browser auth receipt to the Auth session API with read target `auth`, so the Auth session projection catches up before actor resolution decides whether the user is signed in."
        }
      },
      "proof": {
        "tests": ["infrastructure/platform-runtime/auth.test.ts"]
      }
    },
    {
      "id": "auth.session-detail-self-refresh",
      "owner": "auth",
      "risk": "important",
      "freshnessSlo": {
        "flowClass": "important-self-refresh",
        "p95Ms": 2500,
        "p99Ms": 5000
      },
      "source": {
        "routeIds": ["sessions-detail", "account-sessions-detail"],
        "actions": ["Switch session account", "Revoke session"],
        "command": "Auth session commands",
        "helperUses": ["appendFreshWriteTokenFromSources"]
      },
      "destination": {
        "routeIds": ["sessions-detail", "account-sessions-detail"],
        "apiContextName": "auth",
        "apiRoutePath": "/sessions/:id",
        "readModelTables": ["identity_sessions"],
        "transientRecovery": {
          "kinds": "refreshable-catching-up",
          "behavior": "Session detail reloads carry the Auth command receipt to the Auth API so the read-consistency gate waits for the session projection before showing switched or revoked session state."
        }
      }
    },
    {
      "id": "auth.browser-registration-identity-freshness-carrier",
      "owner": "auth",
      "risk": "important",
      "source": {
        "routeIds": ["register", "sign-in"],
        "actions": [
          "Complete password registration",
          "Complete passkey registration",
          "Complete first magic-link authentication",
          "Complete first phone-code authentication"
        ],
        "command": "Auth browser authentication that creates Identity account state"
      },
      "destination": {
        "routeId": "account"
      },
      "exception": {
        "status": "not-post-write-read",
        "owner": "auth",
        "reviewBy": "2026-09-30",
        "reason": "The shared Auth host carries browser authentication write receipts into the account redirect. Auth owns the current-session fresh read separately; Identity owns the projection-backed account and current-actor-display destination reads and declares their exact freshness dependencies.",
        "files": ["bounded-contexts/auth/support/route-support/auth-host.ts"],
        "helperUses": ["navigateAfterWrite"]
      }
    }
  ],
  "mutationConsistencyInventory": [
    {
      "id": "auth.deployable-shell-sign-out-forms",
      "owner": "auth",
      "risk": "important",
      "strategy": "snapshot-return",
      "surfaces": [
        "post-form:deployables/admin-web/app/admin-account-menu.tsx:Heda552c623b5#1",
        "post-form:deployables/marketplace/app/routes/layout.tsx:H471446951fc0#1",
        "post-form:deployables/marketplace/app/routes/layout.tsx:Hb720c9850c28#1",
        "post-form:deployables/marketplace/app/routes/layout.tsx:Hcebdacd493da#1"
      ],
      "visibleDestination": {
        "description": "Deployable shell POST forms submit to Auth-owned sign-out and guest-checkout-exit route actions. The action response is the authoritative visible result: Auth revokes the applicable session or guest-checkout token, clears browser session cookies, and redirects to the host signed-out destination without waiting on a projection-backed read model."
      },
      "proof": {
        "authoritativeResponse": "bounded-contexts/auth/support/route-support/auth-host.test.ts proves sign-out revokes guest checkout and session state, clears both cookies, and returns the signed-out redirect; deployables/admin-web/app/admin-layouts.test.tsx and deployables/marketplace/app/routes/layout.test.tsx prove the composition-root forms point at the Auth-owned POST routes.",
        "tests": [
          "pnpm --filter @chase-sets/auth run test -- support/route-support/auth-host.test.ts",
          "pnpm --filter @chase-sets/app-admin-web run test -- app/admin-layouts.test.tsx",
          "pnpm --filter @chase-sets/app-marketplace-web run test -- app/routes/layout.test.tsx"
        ]
      }
    },
    {
      "id": "auth.admin-registration-disabled-host-guard",
      "owner": "auth",
      "risk": "important",
      "strategy": "read-model-neutral",
      "surfaces": [
        "api-route:deployables/platform-api/src/app.ts:POST /api/auth/register",
        "api-route:deployables/platform-api/src/app.ts:POST /api/auth/register"
      ],
      "exception": {
        "owner": "auth",
        "reviewBy": "2026-09-30",
        "issue": "#1819",
        "reason": "The landing-profile platform-api composition root rejects admin self-registration before any Auth command runs when ADMIN_REGISTRATION_ENABLED is false. deployables/platform-api/__tests__/app.test.ts proves the POST returns the authoritative registration_disabled response and does not depend on a projection-backed post-write read."
      }
    },
    {
      "id": "auth.session-detail-fresh-read",
      "owner": "auth",
      "risk": "important",
      "strategy": "fresh-read",
      "surfaces": [
