{
  "contextName": "auth",
  "packageName": "@chase-sets/auth",
  "ownedNouns": ["authentication", "session-journey", "account-selection"],
  "streamPrefix": "auth.",
  "apiBasePath": "/api/auth",
  "slices": ["account-selection", "registration", "sessions", "sign-in"],
  "allowedSupportDirectories": [
    "api-support",
    "auth-support",
    "request-support",
    "route-support",
    "runtime-support",
    "seed-support",
    "social-login-support",
    "ucp-support",
    "ui-support"
  ],
  "publicExports": [".", "./context", "./host-config", "./routes/*", "./seed-support/*", "./server", "./web"],
  "allowedContextDependencies": ["@chase-sets/identity"],
  "seedRequirements": ["identity"],
  "eventSubscriptions": [
    {
      "sourceContextName": "identity",
      "projectionName": "auth-identity-account-projection",
      "subscriptionVersion": 1,
      "eventTypes": [
        "identity.account.created",
        "identity.account.profile-updated",
        "identity.account.suspended",
        "identity.account.reactivated",
        "identity.account.closed"
      ],
      "order": 5,
      "projectionHandlerSetNames": ["auth-identity-account-projection"]
    },
    {
      "sourceContextName": "identity",
      "projectionName": "auth-identity-user-projection",
      "subscriptionVersion": 1,
      "eventTypes": [
        "identity.user.created",
        "identity.user.profile-updated",
        "identity.user.contact-method-added",
        "identity.user.contact-method-verified",
        "identity.user.auth-method-enabled",
        "identity.user.password-credential-attached",
        "identity.user.passkey-registered",
        "identity.user.social-login-linked",
        "identity.user.suspended",
        "identity.user.reactivated"
      ],
      "order": 10,
      "projectionHandlerSetNames": ["auth-identity-user-projection"]
    },
    {
      "sourceContextName": "identity",
      "projectionName": "auth-identity-membership-projection",
      "subscriptionVersion": 1,
      "eventTypes": [
        "identity.membership.granted",
        "identity.membership.role-changed",
        "identity.membership.revoked",
        "identity.membership.reinstated"
      ],
      "order": 20,
      "projectionHandlerSetNames": ["auth-identity-membership-projection"]
    },
    {
      "sourceContextName": "identity",
      "projectionName": "auth-identity-invitation-projection",
      "subscriptionVersion": 1,
      "eventTypes": [
        "identity.invitation.created",
        "identity.invitation.resent",
        "identity.invitation.cancelled",
        "identity.invitation.accepted",
        "identity.invitation.declined",
        "identity.invitation.expired"
      ],
      "order": 30,
      "projectionHandlerSetNames": ["auth-identity-invitation-projection"]
    }
  ],
  "projectionGroups": [
    {
      "projectionName": "auth-identity-account-projection",
      "sourceContextNames": ["identity"],
      "ownedTables": ["auth_identity_accounts"],
      "requiredDuringBootstrap": true,
      "resetStrategy": "replay-only"
    },
    {
      "projectionName": "auth-identity-user-projection",
      "sourceContextNames": ["identity"],
      "ownedTables": ["auth_identity_users", "auth_identity_user_emails", "auth_identity_user_phones"],
      "requiredDuringBootstrap": true,
      "resetStrategy": "replay-only"
    },
    {
      "projectionName": "auth-identity-membership-projection",
      "sourceContextNames": ["identity"],
      "ownedTables": ["auth_identity_memberships", "auth_identity_user_memberships"],
      "requiredDuringBootstrap": true,
      "resetStrategy": "replay-only"
    },
    {
      "projectionName": "auth-identity-invitation-projection",
      "sourceContextNames": ["identity"],
      "ownedTables": ["auth_identity_invitations"],
      "requiredDuringBootstrap": true,
      "resetStrategy": "replay-only"
    }
  ],
  "hostPorts": [
    {
      "portName": "notificationOutbox",
      "providedBy": "platform-worker",
      "purpose": "Durable outbound notification outbox used for magic-link email, SMS sign-in codes, and future Auth notification channels."
    },
    {
      "portName": "socialLoginProviders",
      "providedBy": "platform-api",
      "purpose": "Configured Social Login Provider adapters used by Auth-owned sign-in and registration journeys."
    },
    {
      "portName": "adminGoogleWorkspaceSso",
      "providedBy": "platform-api",
      "purpose": "Configured Google Workspace hosted-domain policy used by Auth-owned admin SSO journeys."
    }
  ],
  "apiDeployables": ["admin-support-api", "platform-api"],
  "apiMounts": [
    {
      "mountPath": "/api/auth",
      "kind": "primary",
      "requiresAuth": false
    }
  ],
  "mutationConsistencyInventory": [
    {
      "id": "auth.deployable-shell-sign-out-forms",
      "owner": "auth",
      "risk": "important",
      "strategy": "snapshot-return",
      "surfaces": [
        "post-form:deployables/admin-web/app/admin-account-menu.tsx:Heda552c623b5#1",
        "post-form:deployables/marketplace/app/routes/layout.tsx:H471446951fc0#1",
        "post-form:deployables/marketplace/app/routes/layout.tsx:Hb720c9850c28#1",
        "post-form:deployables/marketplace/app/routes/layout.tsx:Hcebdacd493da#1"
      ],
      "visibleDestination": {
        "description": "Deployable shell POST forms submit to Auth-owned sign-out and guest-checkout-exit route actions. The action response is the authoritative visible result: Auth revokes the applicable session or guest-checkout token, clears browser session cookies, and redirects to the host signed-out destination without waiting on a projection-backed read model."
      },
      "proof": {
        "authoritativeResponse": "bounded-contexts/auth/support/route-support/auth-host.test.ts proves sign-out revokes guest checkout and session state, clears both cookies, and returns the signed-out redirect; deployables/admin-web/app/admin-layouts.test.tsx and deployables/marketplace/app/routes/layout.test.tsx prove the composition-root forms point at the Auth-owned POST routes.",
        "tests": [
          "pnpm --filter @chase-sets/auth run test -- support/route-support/auth-host.test.ts",
          "pnpm --filter @chase-sets/app-admin-web run test -- app/admin-layouts.test.tsx",
          "pnpm --filter @chase-sets/app-marketplace-web run test -- app/routes/layout.test.tsx"
        ]
      }
    },
    {
      "id": "auth.admin-registration-disabled-host-guard",
      "owner": "auth",
      "risk": "important",
      "strategy": "read-model-neutral",
      "surfaces": ["api-route:deployables/admin-support-api/src/app.ts:POST /api/auth/register"],
      "exception": {
        "owner": "auth",
        "reviewBy": "2026-09-30",
        "issue": "#1819",
        "reason": "The admin-support-api composition root rejects admin self-registration before any Auth command runs when ADMIN_REGISTRATION_ENABLED is false. deployables/admin-support-api/__tests__/app.test.ts proves the POST returns the authoritative registration_disabled response and does not depend on a projection-backed post-write read."
      }
    }
  ],
  "deployableContributions": [
    {
      "deployable": "admin-web",
      "routes": [
        {
          "routeId": "account-select",
          "routePath": "account-select",
          "fileExport": "./routes/catalog-admin/account-select",
          "routeType": "route",
          "sourceContext": "auth",
          "placement": "root",
          "section": "catalog"
        },
        {
          "routeId": "sign-in",
          "routePath": "sign-in",
          "fileExport": "./routes/catalog-admin/sign-in",
          "routeType": "route",
          "sourceContext": "auth",
          "placement": "root",
          "section": "catalog"
        },
        {
          "routeId": "sign-out",
          "routePath": "sign-out",
          "fileExport": "./routes/catalog-admin/sign-out",
          "routeType": "route",
          "sourceContext": "auth",
          "placement": "root",
          "section": "catalog"
        }
      ]
    },
    {
      "deployable": "admin-web",
      "routes": [
        {
          "routeId": "account-select",
          "routePath": "account-select",
          "fileExport": "./routes/access-admin/account-select",
          "routeType": "route",
          "sourceContext": "auth",
          "placement": "root",
          "section": "access"
        },
        {
          "routeId": "sign-in",
          "routePath": "sign-in",
          "fileExport": "./routes/access-admin/sign-in",
          "routeType": "route",
          "sourceContext": "auth",
          "placement": "root",
          "section": "access"
        },
        {
          "routeId": "sign-out",
          "routePath": "sign-out",
          "fileExport": "./routes/access-admin/sign-out",
          "routeType": "route",
          "sourceContext": "auth",
          "placement": "root",
