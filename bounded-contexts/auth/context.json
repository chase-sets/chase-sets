          "fileExport": "./routes/marketplace/sign-in",
          "routeType": "route",
          "sourceContext": "auth"
        },
        {
          "routeId": "sign-out",
          "routePath": "sign-out",
          "fileExport": "./routes/marketplace/sign-out",
          "routeType": "route",
          "sourceContext": "auth"
        }
      ]
    }
