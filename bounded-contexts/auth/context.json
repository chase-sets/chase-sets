{
  "contextName": "auth",
  "packageName": "@chase-sets/auth",
  "ownedNouns": ["authentication", "session-journey", "account-selection"],
  "streamPrefix": "auth.",
  "apiBasePath": "/api/auth",
  "slices": ["account-selection", "agent-grants", "registration", "sessions", "sign-in"],
  "allowedSupportDirectories": [
    "api-support",
    "auth-support",
    "request-support",
    "route-support",
    "runtime-support",
    "seed-support",
    "social-login-support",
    "ucp-support",
    "ui-support"
  ],
  "publicExports": [".", "./context", "./host-config", "./routes/*", "./seed-support/*", "./server", "./web"],
  "allowedContextDependencies": ["@chase-sets/customer-feedback", "@chase-sets/identity"],
  "seedRequirements": ["identity"],
  "eventSubscriptions": [
    {
      "sourceContextName": "identity",
      "projectionName": "auth-identity-account-projection",
      "subscriptionVersion": 1,
      "eventTypes": [
        "identity.account.created",
        "identity.account.profile-updated",
        "identity.account.suspended",
        "identity.account.reactivated",
        "identity.account.closed"
      ],
      "order": 5,
      "projectionHandlerSetNames": ["auth-identity-account-projection"]
    },
    {
      "sourceContextName": "identity",
      "projectionName": "auth-identity-user-projection",
      "subscriptionVersion": 1,
      "eventTypes": [
        "identity.user.created",
        "identity.user.profile-updated",
        "identity.user.contact-method-added",
        "identity.user.contact-method-verified",
        "identity.user.auth-method-enabled",
        "identity.user.password-credential-attached",
        "identity.user.passkey-registered",
        "identity.user.social-login-linked",
        "identity.user.suspended",
        "identity.user.reactivated"
      ],
      "order": 10,
      "projectionHandlerSetNames": ["auth-identity-user-projection"]
    },
    {
      "sourceContextName": "identity",
      "projectionName": "auth-identity-membership-projection",
      "subscriptionVersion": 1,
      "eventTypes": [
        "identity.membership.granted",
        "identity.membership.role-changed",
        "identity.membership.revoked",
        "identity.membership.reinstated"
      ],
      "order": 20,
      "projectionHandlerSetNames": ["auth-identity-membership-projection"]
    },
    {
      "sourceContextName": "identity",
      "projectionName": "auth-identity-invitation-projection",
      "subscriptionVersion": 1,
      "eventTypes": [
        "identity.invitation.created",
        "identity.invitation.resent",
        "identity.invitation.cancelled",
        "identity.invitation.accepted",
        "identity.invitation.declined",
        "identity.invitation.expired"
      ],
      "order": 30,
      "projectionHandlerSetNames": ["auth-identity-invitation-projection"]
    },
    {
      "sourceContextName": "ordering",
      "sourceContextMount": "when-all-sources-mounted",
      "projectionName": "auth-agent-order-webhook-projection",
      "subscriptionVersion": 1,
      "eventTypes": ["ordering.order.created", "ordering.order.cancelled"],
      "order": 40,
      "projectionHandlerSetNames": ["auth-agent-order-webhook-projection"]
    },
    {
      "sourceContextName": "fulfillment",
      "sourceContextMount": "when-all-sources-mounted",
      "projectionName": "auth-agent-order-webhook-projection",
      "subscriptionVersion": 1,
      "eventTypes": ["fulfillment.shipment.dispatched", "fulfillment.shipment.delivered"],
      "order": 50,
      "projectionHandlerSetNames": ["auth-agent-order-webhook-projection"]
    },
    {
      "sourceContextName": "payments",
      "sourceContextMount": "when-all-sources-mounted",
      "projectionName": "auth-agent-order-webhook-projection",
      "subscriptionVersion": 1,
      "eventTypes": ["payments.refund-issued"],
      "order": 60,
      "projectionHandlerSetNames": ["auth-agent-order-webhook-projection"]
    }
  ],
  "projectionGroups": [
    {
      "projectionName": "auth-identity-account-projection",
      "sourceContextNames": ["identity"],
      "ownedTables": ["auth_identity_accounts"],
      "requiredDuringBootstrap": true,
      "resetStrategy": "replay-only"
    },
    {
      "projectionName": "auth-identity-user-projection",
      "sourceContextNames": ["identity"],
      "ownedTables": ["auth_identity_users", "auth_identity_user_emails", "auth_identity_user_phones"],
      "requiredDuringBootstrap": true,
      "resetStrategy": "replay-only"
    },
    {
      "projectionName": "auth-identity-membership-projection",
      "sourceContextNames": ["identity"],
      "ownedTables": ["auth_identity_memberships", "auth_identity_user_memberships"],
      "requiredDuringBootstrap": true,
      "resetStrategy": "replay-only"
    },
    {
      "projectionName": "auth-identity-invitation-projection",
      "sourceContextNames": ["identity"],
      "ownedTables": ["auth_identity_invitations"],
      "requiredDuringBootstrap": true,
      "resetStrategy": "replay-only"
    },
    {
      "projectionName": "auth-agent-order-webhook-projection",
      "sourceContextNames": ["ordering", "fulfillment", "payments"],
      "sourceContextMount": "when-all-sources-mounted",
      "ownedTables": ["identity_agent_webhook_deliveries"],
      "requiredDuringBootstrap": false,
      "resetStrategy": "append-only-no-reset"
    },
    {
      "projectionName": "auth-session-projection",
      "sourceContextNames": ["auth"],
      "ownedTables": ["identity_sessions", "identity_session_lookup"],
      "requiredDuringBootstrap": false,
      "resetStrategy": "truncate-owned-tables"
    }
  ],
  "hostPorts": [
    {
      "portName": "notificationOutbox",
      "providedBy": "platform-worker",
      "purpose": "Durable outbound notification outbox used for magic-link email, SMS sign-in codes, and future Auth notification channels."
    },
    {
      "portName": "agentWebhookOrderResolvers",
      "providedBy": "platform-worker",
      "purpose": "Ordering-owned read-model resolvers used by Auth's agent webhook projection to map order and shipment events to the buyer account."
    },
    {
      "portName": "socialLoginProviders",
      "providedBy": "platform-api",
      "purpose": "Configured Social Login Provider adapters used by Auth-owned sign-in and registration journeys."
    },
    {
      "portName": "adminGoogleWorkspaceSso",
      "providedBy": "platform-api",
      "purpose": "Configured Google Workspace hosted-domain policy used by Auth-owned admin SSO journeys."
    },
    {
      "portName": "registrationAdmission",
      "providedBy": "platform-api",
      "purpose": "Registration admission and disposable-email screening policy plus the Public Presence admitted-waitlist lookup used by Auth-owned registration journeys."
    },
    {
      "portName": "securityLifetimes",
      "providedBy": "platform-api",
      "purpose": "Bounds-validated, env-configurable session/token lifetimes (issue #4292): session, account-selection, magic-link, challenge, social-login-state, guest-checkout, and UCP OAuth TTLs. Env-tier by design, never admin-policy-editable."
    }
  ],
  "apiDeployables": ["platform-api"],
  "apiMounts": [
    {
      "mountPath": "/api/auth",
      "kind": "primary",
      "requiresAuth": false,
      "readFreshnessRoutes": [
        {
          "routePath": "/session",
          "methods": ["GET", "HEAD"],
          "dependencies": [
            {
              "readModelTable": "identity_sessions"
            },
            {
              "readModelTable": "auth_identity_user_memberships"
            },
            {
              "readModelTable": "auth_identity_memberships"
            }
          ]
        },
        {
          "routePath": "/sessions/:id",
          "methods": ["GET", "HEAD"],
          "dependencies": [
            {
              "readModelTable": "identity_sessions"
            }
          ]
        }
      ]
    }
  ],
  "anonymousRoutes": [
    { "routePath": "/api/auth/session", "methods": ["GET", "HEAD"] },
    { "routePath": "/api/auth/register", "methods": ["POST"] },
    { "routePath": "/api/auth/password-sign-in", "methods": ["POST"] },
    { "routePath": "/api/auth/magic-link/request", "methods": ["POST"] },
    { "routePath": "/api/auth/magic-link/consume", "methods": ["POST"] },
    { "routePath": "/api/auth/passkeys/challenge", "methods": ["POST"] },
    { "routePath": "/api/auth/passkeys/register", "methods": ["POST"] },
    { "routePath": "/api/auth/passkeys/sign-in", "methods": ["POST"] },
    { "routePath": "/api/auth/invitations/acceptance-link/request", "methods": ["POST"] },
    { "routePath": "/api/auth/invitations/accept", "methods": ["POST"] },
    { "routePath": "/api/auth/guest-checkout/start", "methods": ["POST"] },
    { "routePath": "/api/auth/guest-checkout/claim-link/request", "methods": ["POST"] },
    { "routePath": "/api/auth/guest-checkout/claim-with-magic-link", "methods": ["POST"] },
    { "routePath": "/api/auth/guest-checkout/claim-with-continuation", "methods": ["POST"] },
    { "routePath": "/api/auth/guest-checkout/claim-with-passkey", "methods": ["POST"] },
    { "routePath": "/api/auth/account-selection/resolve", "methods": ["POST"] },
    { "routePath": "/api/auth/account-selection/complete", "methods": ["POST"] },
    { "routePath": "/api/auth/social/", "methods": ["GET", "HEAD"], "match": "prefix" }
  ],
  "deployableContributions": [
