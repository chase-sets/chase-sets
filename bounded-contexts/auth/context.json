        },
        {
          "routeId": "sessions",
          "routePath": "sessions",
          "fileExport": "./routes/access-admin/sessions",
          "routeType": "route",
          "sourceContext": "auth",
          "section": "access"
        },
        {
          "routeId": "sessions-detail",
