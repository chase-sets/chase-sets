{
  "contextName": "auth",
  "packageName": "@chase-sets/auth",
  "ownedNouns": [
    "authentication",
    "session-journey",
    "account-selection"
  ],
  "streamPrefix": "auth.",
  "apiBasePath": "/api/auth",
  "slices": [
    "customer",
    "sessions"
  ],
  "allowedSupportDirectories": [
    "auth-api",
    "auth-support",
    "request-support",
    "route-support",
    "seed-support"
  ],
  "publicExports": [
    ".",
    "./context",
    "./host-config",
    "./routes/*",
    "./seed-support/*",
    "./server"
  ],
  "allowedContextDependencies": [
    "@chase-sets/identity"
  ],
  "seedRequirements": [
    "identity"
  ],
  "eventSubscriptions": [
    {
      "sourceContextName": "identity",
      "projectionName": "auth-identity-user-projection",
      "subscriptionVersion": 1,
      "projectorNames": [
        "auth-identity-user-projection"
      ],
      "eventTypes": [
        "identity.user.created",
        "identity.user.profile-updated",
        "identity.user.contact-method-added",
        "identity.user.contact-method-verified",
        "identity.user.auth-method-enabled",
        "identity.user.password-credential-attached",
        "identity.user.passkey-registered",
        "identity.user.suspended",
        "identity.user.reactivated"
      ],
      "order": 10
    },
    {
      "sourceContextName": "identity",
      "projectionName": "auth-identity-membership-projection",
      "subscriptionVersion": 1,
      "projectorNames": [
        "auth-identity-membership-projection"
      ],
      "eventTypes": [
        "identity.membership.granted",
        "identity.membership.role-changed",
        "identity.membership.revoked",
        "identity.membership.reinstated"
      ],
      "order": 20
    },
    {
      "sourceContextName": "identity",
      "projectionName": "auth-identity-invitation-projection",
      "subscriptionVersion": 1,
      "projectorNames": [
        "auth-identity-invitation-projection"
      ],
      "eventTypes": [
        "identity.invitation.created",
        "identity.invitation.resent",
        "identity.invitation.cancelled",
        "identity.invitation.accepted",
        "identity.invitation.declined",
        "identity.invitation.expired"
      ],
      "order": 30
    }
  ],
  "projectionGroups": [
    {
      "projectionName": "auth-identity-user-projection",
      "sourceContextNames": [
        "identity"
      ],
      "ownedTables": [
        "auth_identity_users",
        "auth_identity_user_emails"
      ],
      "requiredDuringBootstrap": true
    },
    {
      "projectionName": "auth-identity-membership-projection",
      "sourceContextNames": [
        "identity"
      ],
      "ownedTables": [
        "auth_identity_memberships",
        "auth_identity_user_memberships"
      ],
      "requiredDuringBootstrap": true
    },
    {
      "projectionName": "auth-identity-invitation-projection",
      "sourceContextNames": [
        "identity"
      ],
      "ownedTables": [
        "auth_identity_invitations"
      ],
      "requiredDuringBootstrap": true
    }
  ],
  "hostPorts": [],
  "apiDeployables": [
    "platform-api"
  ],
  "apiMounts": [
    {
      "mountPath": "/api/auth",
      "kind": "primary",
      "requiresAuth": false,
      "drainProjectorsOnWrite": true
    }
  ],
  "deployableContributions": [
    {
      "deployable": "admin-web",
      "routes": [
        {
          "routeId": "account-select",
          "routePath": "account-select",
          "fileExport": "./routes/catalog-admin/account-select",
          "routeType": "route",
          "sourceContext": "auth",
          "placement": "root"
        },
        {
          "routeId": "sign-in",
          "routePath": "sign-in",
          "fileExport": "./routes/catalog-admin/sign-in",
          "routeType": "route",
          "sourceContext": "auth",
          "placement": "root"
        },
        {
          "routeId": "sign-out",
          "routePath": "sign-out",
          "fileExport": "./routes/catalog-admin/sign-out",
          "routeType": "route",
          "sourceContext": "auth",
          "placement": "root"
        }
      ]
    },
    {
      "deployable": "admin-web",
      "routes": [
        {
          "routeId": "account-select",
          "routePath": "account-select",
          "fileExport": "./routes/identity-admin/account-select",
          "routeType": "route",
          "sourceContext": "auth",
          "placement": "root"
        },
        {
          "routeId": "sign-in",
          "routePath": "sign-in",
          "fileExport": "./routes/identity-admin/sign-in",
          "routeType": "route",
          "sourceContext": "auth",
          "placement": "root"
        },
        {
          "routeId": "sign-out",
          "routePath": "sign-out",
          "fileExport": "./routes/identity-admin/sign-out",
          "routeType": "route",
          "sourceContext": "auth",
          "placement": "root"
        },
        {
          "routeId": "sessions",
          "routePath": "sessions",
          "fileExport": "./routes/identity-admin/sessions",
          "routeType": "route",
          "sourceContext": "auth"
        },
        {
          "routeId": "sessions-detail",
          "routePath": "sessions/:id",
          "fileExport": "./routes/identity-admin/sessions-detail",
          "routeType": "route",
          "sourceContext": "auth"
        }
      ]
    },
    {
      "deployable": "marketplace-web",
      "routes": [
        {
          "routeId": "account-select",
          "routePath": "account/select",
          "fileExport": "./routes/marketplace/account-select",
          "routeType": "route",
          "sourceContext": "auth"
        },
        {
          "routeId": "register",
          "routePath": "register",
          "fileExport": "./routes/marketplace/register",
          "routeType": "route",
          "sourceContext": "auth"
        },
        {
          "routeId": "sign-in",
          "routePath": "sign-in",
          "fileExport": "./routes/marketplace/sign-in",
          "routeType": "route",
          "sourceContext": "auth"
        },
        {
          "routeId": "sign-out",
          "routePath": "sign-out",
          "fileExport": "./routes/marketplace/sign-out",
          "routeType": "route",
          "sourceContext": "auth"
        }
      ]
    }
  ],
  "shellContributions": [
    {
      "deployable": "admin-web",
      "slot": "primary-nav",
      "key": "sessions",
      "label": "Sessions",
      "icon": "clock",
      "href": "/sessions",
      "order": 50,
      "visibility": "signed-in",
      "requiredPermissions": []
    },
    {
      "deployable": "marketplace-web",
      "slot": "top-nav",
      "key": "sign-in",
      "label": "Sign In",
      "icon": "user",
      "href": "/sign-in",
      "order": 900,
      "visibility": "signed-out",
      "requiredPermissions": []
    },
    {
      "deployable": "marketplace-web",
      "slot": "top-nav",
      "key": "register",
      "label": "Register",
      "icon": "plus",
      "href": "/register",
      "order": 910,
      "visibility": "signed-out",
      "requiredPermissions": []
    },
    {
      "deployable": "marketplace-web",
      "slot": "bottom-nav",
      "key": "sign-in",
      "label": "Sign In",
      "icon": "user",
      "href": "/sign-in",
      "order": 900,
      "visibility": "signed-out",
      "requiredPermissions": []
    },
    {
      "deployable": "marketplace-web",
      "slot": "bottom-nav",
      "key": "register",
      "label": "Register",
      "icon": "plus",
      "href": "/register",
      "order": 910,
      "visibility": "signed-out",
      "requiredPermissions": []
    }
  ],
  "directoryIntent": {
    "customer": {
      "classification": "slice",
      "purpose": "Own customer feature behavior, read models, and UI contracts for the auth context.",
      "allowedWhen": "Always; slice directories are the default root shape for implemented context features.",
      "expectedConsumers": [
        "Internal auth module composition"
      ]
    },
    "sessions": {
      "classification": "slice",
      "purpose": "Own sessions feature behavior, read models, and UI contracts for the auth context.",
      "allowedWhen": "Always; slice directories are the default root shape for implemented context features.",
      "expectedConsumers": [
        "Internal auth module composition"
      ]
    },
    "auth-support": {
      "classification": "support",
      "purpose": "Provide reusable auth-support assets shared by multiple auth slices.",
      "allowedWhen": "Allowed only when capability cannot stay inside one slice and cross-slice reuse is explicit.",
      "expectedConsumers": [
        "sessions"
      ],
      "crossCuttingRuntimeComposition": true,
      "justification": "auth-support centralizes reusable context-local composition that should not duplicate across slices.",
      "createdFor": "Multi-slice auth workflows that need shared runtime helpers.",
      "sunsetWhen": "Remove when all consumers can move the behavior back into slice-local modules."
    },
    "auth-api": {
      "classification": "support",
      "purpose": "Provide reusable auth API request handlers and middleware shared by auth-owned HTTP surfaces.",
      "allowedWhen": "Allowed when auth-specific API composition spans multiple entrypoints and should remain context-owned.",
      "expectedConsumers": [
        "Deployable composition for auth",
        "Multiple auth slices"
      ],
      "justification": "auth-api keeps auth-owned Hono handlers inside the auth context instead of leaking API glue into deployables.",
      "createdFor": "Manifest-driven platform API composition across auth-owned routes and middleware.",
      "sunsetWhen": "Remove when auth API composition can collapse fully into slice-local modules without duplication."
    },
    "request-support": {
      "classification": "support",
      "purpose": "Provide reusable request-support assets shared by multiple auth slices.",
      "allowedWhen": "Allowed only when capability cannot stay inside one slice and cross-slice reuse is explicit.",
      "expectedConsumers": [
        "Multiple auth slices",
        "Deployable composition for auth"
      ],
      "justification": "request-support centralizes reusable context-local composition that should not duplicate across slices.",
      "createdFor": "Multi-slice auth workflows that need shared runtime helpers.",
      "sunsetWhen": "Remove when all consumers can move the behavior back into slice-local modules."
    },
    "route-support": {
      "classification": "support",
      "purpose": "Provide reusable route-support assets shared by multiple auth slices.",
      "allowedWhen": "Allowed only when capability cannot stay inside one slice and cross-slice reuse is explicit.",
      "expectedConsumers": [
        "Multiple auth slices",
        "Deployable composition for auth"
      ],
      "justification": "route-support centralizes reusable context-local composition that should not duplicate across slices.",
      "createdFor": "Multi-slice auth workflows that need shared runtime helpers.",
      "sunsetWhen": "Remove when all consumers can move the behavior back into slice-local modules."
    },
    "seed-support": {
      "classification": "support",
      "purpose": "Provide reusable seed-support assets shared by multiple auth slices.",
      "allowedWhen": "Allowed only when capability cannot stay inside one slice and cross-slice reuse is explicit.",
      "expectedConsumers": [
        "Multiple auth slices",
        "Deployable composition for auth"
      ],
      "justification": "seed-support centralizes reusable context-local composition that should not duplicate across slices.",
      "createdFor": "Multi-slice auth workflows that need shared runtime helpers.",
      "sunsetWhen": "Remove when all consumers can move the behavior back into slice-local modules."
    },
    "routes": {
      "classification": "routes",
      "purpose": "Expose auth-owned route modules consumed by generated deployable adapters.",
      "allowedWhen": "Required whenever the context contributes routes to any deployable.",
      "expectedConsumers": [
        "Generated deployable route adapters"
      ]
    }
  }
}
