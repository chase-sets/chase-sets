{
  "contextName": "inventory",
  "packageName": "@chase-sets/inventory",
  "localeCatalogs": ["contracts/localization/locales/en/inventory.ts"],
  "ownedNouns": ["inventory-item", "inventory-hold", "import-batch", "recovered-item", "storage-location"],
  "streamPrefix": "inventory.",
  "accountCapabilities": [
    {
      "key": "inventory.locations",
      "description": "Declares the Account's inventory location limit.",
      "kind": "limit",
      "defaultValue": 0
    }
  ],
  "apiBasePath": "/api/inventory",
  "slices": [
    "inventory-items",
    "hold-collisions",
    "import-batches",
    "holds",
    "reservations",
    "recovered-items",
    "restock-decisions",
    "storage-locations"
  ],
  "allowedSupportDirectories": ["catalog-item-support", "request-support", "runtime-support", "seed-support"],
  "publicExports": [".", "./context", "./routes/*", "./seed-support/*", "./server"],
  "allowedContextDependencies": ["@chase-sets/customer-feedback"],
  "seedRequirements": ["catalog", "identity"],
  "eventSubscriptions": [
    {
      "sourceContextName": "catalog",
      "projectionName": "inventory-catalog-item-projection",
      "subscriptionVersion": 4,
      "eventTypes": [
        "catalog.catalog-item.created",
        "catalog.catalog-item.blueprint-assigned",
        "catalog.catalog-item.published",
        "catalog.catalog-item.display-identity-resolved",
        "catalog.catalog-item.external-catalog-item-reference-linked",
        "catalog.catalog-item.external-catalog-item-reference-unlinked",
        "catalog.catalog-item.external-product-reference-linked",
        "catalog.catalog-item.external-product-reference-unlinked",
        "catalog.catalog-item.gtin-linked",
        "catalog.catalog-item.gtin-unlinked",
        "catalog.catalog-item.retired",
        "catalog.catalog-item.archived",
        "catalog.blueprint.created",
        "catalog.blueprint.revised",
        "catalog.blueprint.dimensions-set",
        "catalog.blueprint.product-resolution-rules-set",
        "catalog.blueprint.published",
        "catalog.dimension.created",
        "catalog.dimension.revised",
        "catalog.dimension.option-added",
        "catalog.dimension.option-revised"
      ],
      "order": 10,
      "projectionHandlerSetNames": ["inventory-catalog-item-projection"]
    },
    {
      "sourceContextName": "ordering",
      "projectionName": "inventory-order-reservation-workflow",
      "subscriptionVersion": 1,
      "eventTypes": ["ordering.order.created", "ordering.order.cancelled"],
      "order": 20,
      "projectionHandlerSetNames": ["inventory-order-reservation-workflow"]
    },
    {
      "sourceContextName": "fulfillment",
      "projectionName": "inventory-fulfillment-restock-workflow",
      "subscriptionVersion": 1,
      "sourceContextMount": "when-mounted",
      "eventTypes": ["fulfillment.shipment.created", "fulfillment.shipment.returned"],
      "order": 30,
      "projectionHandlerSetNames": ["inventory-fulfillment-restock-workflow"]
    },
    {
      "sourceContextName": "fulfillment",
      "projectionName": "inventory-fulfillment-recovered-item-workflow",
      "subscriptionVersion": 1,
      "sourceContextMount": "when-mounted",
      "eventTypes": ["fulfillment.return-shipment.facility-intake-completed.v1"],
      "order": 31,
      "projectionHandlerSetNames": ["inventory-fulfillment-recovered-item-workflow"]
    }
  ],
  "projectionGroups": [
    {
      "projectionName": "inventory-catalog-item-projection",
      "sourceContextNames": ["catalog"],
      "ownedTables": [
        "inventory_catalog_items",
        "inventory_catalog_blueprints",
        "inventory_catalog_dimensions",
        "inventory_catalog_dimension_options",
        "inventory_catalog_external_catalog_item_references",
        "inventory_catalog_external_product_references"
      ],
      "requiredDuringBootstrap": true,
      "resetStrategy": "replay-only"
    },
    {
      "projectionName": "inventory-order-reservation-workflow",
      "sourceContextNames": ["ordering"],
      "ownedTables": [],
      "requiredDuringBootstrap": false,
      "resetStrategy": "replay-only",
      "sideEffectOnly": true
    },
    {
      "projectionName": "inventory-fulfillment-restock-workflow",
      "sourceContextNames": ["fulfillment"],
      "optionalSourceContextNames": ["fulfillment"],
      "ownedTables": ["inventory_fulfillment_shipment_sources"],
      "requiredDuringBootstrap": false,
      "resetStrategy": "truncate-owned-tables"
    },
    {
      "projectionName": "inventory-fulfillment-recovered-item-workflow",
      "sourceContextNames": ["fulfillment"],
      "optionalSourceContextNames": ["fulfillment"],
      "ownedTables": [],
      "requiredDuringBootstrap": false,
      "resetStrategy": "replay-only",
      "sideEffectOnly": true
    },
    {
      "projectionName": "inventory-recovered-item-projection",
      "sourceContextNames": ["inventory"],
      "ownedTables": ["inventory_recovered_items", "inventory_recovered_item_audit", "inventory_recovered_item_values"],
      "requiredDuringBootstrap": false,
      "resetStrategy": "truncate-owned-tables"
    },
    {
      "projectionName": "inventory-reservation-projection",
      "sourceContextNames": ["inventory"],
      "ownedTables": ["inventory_reservation_pages"],
      "requiredDuringBootstrap": false,
      "resetStrategy": "truncate-owned-tables"
    },
    {
      "projectionName": "inventory-restock-decision-projection",
      "sourceContextNames": ["inventory"],
      "ownedTables": ["inventory_restock_decisions"],
      "requiredDuringBootstrap": false,
      "resetStrategy": "truncate-owned-tables"
    },
    {
      "projectionName": "inventory-item-projection",
      "sourceContextNames": ["inventory"],
      "ownedTables": ["inventory_items"],
      "requiredDuringBootstrap": false,
      "resetStrategy": "truncate-owned-tables"
    },
    {
      "projectionName": "inventory-item-ledger-projection",
      "sourceContextNames": ["inventory"],
      "ownedTables": ["inventory_item_ledger"],
      "requiredDuringBootstrap": false,
      "resetStrategy": "truncate-owned-tables"
    },
    {
      "projectionName": "inventory-hold-collision-projection",
      "sourceContextNames": ["inventory"],
      "ownedTables": ["inventory_hold_collisions"],
      "requiredDuringBootstrap": false,
      "resetStrategy": "truncate-owned-tables"
    },
    {
      "projectionName": "inventory-hold-projection",
      "sourceContextNames": ["inventory"],
      "ownedTables": ["inventory_holds"],
      "requiredDuringBootstrap": false,
      "resetStrategy": "truncate-owned-tables"
    },
    {
      "projectionName": "inventory-storage-location-projection",
      "sourceContextNames": ["inventory"],
      "ownedTables": ["inventory_storage_locations"],
      "requiredDuringBootstrap": false,
      "resetStrategy": "truncate-owned-tables"
    }
  ],
  "hostPorts": [
    {
      "portName": "draftListingCreator",
      "providedBy": "platform-api, platform-worker",
      "purpose": "Creates Marketplace draft listings from committed import batch rows without Inventory depending on Marketplace implementation."
    }
  ],
  "apiDeployables": ["platform-api"],
  "runtimeDeployables": ["platform-worker"],
  "apiMounts": [
    {
      "mountPath": "/api/inventory",
      "kind": "primary",
      "requiresAuth": true,
      "readFreshnessRoutes": [
        {
          "routePath": "/items/:id",
          "methods": ["GET", "HEAD"],
          "dependencies": [
            {
              "readModelTable": "inventory_items"
            },
            {
              "readModelTable": "inventory_holds"
            },
            {
              "readModelTable": "inventory_item_ledger"
            }
          ]
        },
        {
          "routePath": "/storage-locations",
          "methods": ["GET", "HEAD"],
          "dependencies": [
            {
              "readModelTable": "inventory_storage_locations"
            }
          ]
        },
        {
          "routePath": "/restock-decisions",
          "methods": ["GET", "HEAD"],
          "dependencies": [
            {
              "readModelTable": "inventory_restock_decisions"
            },
            {
              "readModelTable": "inventory_item_ledger"
            },
            {
              "readModelTable": "inventory_items"
            }
          ]
        }
      ]
    }
  ],
  "mcpCapabilities": {
    "tools": [
      { "name": "inventory.list-import-sources", "ownerSlice": "import-batches" },
      { "name": "inventory.create-import-batch", "ownerSlice": "import-batches" },
      { "name": "inventory.get-import-batch", "ownerSlice": "import-batches" },
      { "name": "inventory.commit-import-batch", "ownerSlice": "import-batches" },
      { "name": "inventory.list-items", "ownerSlice": "inventory-items" },
      { "name": "inventory.adjust-item", "ownerSlice": "inventory-items" }
    ],
    "resources": [
      {
        "uriTemplate": "chase-sets://inventory/{accountId}/items/{inventoryItemId}",
        "ownerSlice": "inventory-items"
      },
      {
        "uriTemplate": "chase-sets://inventory/{accountId}/import-batches/{batchId}",
        "ownerSlice": "import-batches"
      }
    ]
  },
  "readAfterWriteRouteInventory": [
    {
      "id": "inventory.item-create-to-detail",
      "owner": "inventory",
      "risk": "important",
      "freshnessSlo": {
        "flowClass": "important-self-refresh",
        "p95Ms": 2500,
        "p99Ms": 5000
      },
      "source": {
        "routeId": "account-inventory",
        "actions": ["Create inventory item"],
        "command": "Inventory item create command",
        "helperUses": ["navigateAfterWrite"]
      },
      "destination": {
        "routeId": "account-inventory-item",
        "apiContextName": "inventory",
        "apiRoutePath": "/items/:id",
        "readModelTables": ["inventory_items", "inventory_holds", "inventory_item_ledger"],
        "helperUses": ["loadAfterWrite"],
        "transientRecovery": {
          "kinds": "refreshable-catching-up",
          "behavior": "Inventory item create redirects to the created item detail with afterWrite so the item detail API waits on exact item, hold, and ledger projections before rendering the new stock record."
        }
      }
    },
    {
      "id": "inventory.item-adjust-to-detail",
      "owner": "inventory",
      "risk": "critical",
      "freshnessSlo": {
        "flowClass": "important-self-refresh",
        "p95Ms": 2500,
        "p99Ms": 5000
      },
      "source": {
        "routeId": "account-inventory-item",
        "actions": ["Adjust inventory item", "Place inventory hold", "Release inventory hold"],
        "command": "Inventory item and hold commands",
        "helperUses": ["navigateAfterWrite"]
      },
      "destination": {
        "routeId": "account-inventory-item",
        "apiContextName": "inventory",
        "apiRoutePath": "/items/:id",
        "readModelTables": ["inventory_items", "inventory_holds", "inventory_item_ledger"],
        "helperUses": ["loadAfterWrite"],
        "transientRecovery": {
          "kinds": "refreshable-catching-up",
          "behavior": "Inventory item detail forwards afterWrite to the API so exact item, hold, and ledger projections gate the detail read."
        }
      }
    },
    {
      "id": "inventory.import-batch-detail",
      "owner": "inventory",
      "risk": "important",
      "source": {
        "routeIds": ["account-inventory-imports", "account-inventory-import"],
        "actions": ["Load newly created import batch"],
        "command": "Inventory import batch job commands",
        "helperUses": ["loadAfterWrite"]
      },
      "destination": {
        "routeIds": ["account-inventory-imports", "account-inventory-import"],
        "helperUses": ["loadAfterWrite"],
        "transientRecovery": {
          "kinds": "refreshable-catching-up",
          "behavior": "Import batch detail uses the completed import job receipt for compatibility fresh-write not-found retries, and the import result page carries that same receipt into inventory and listing setup handoff links while job-backed inventory routes remain snapshot-owned."
        }
      },
      "exception": {
        "status": "not-read-model-backed",
        "owner": "inventory",
        "reviewBy": "2026-07-31",
        "reason": "Import create and commit commands return durable InventoryImportBatchJobStatus snapshots and the page follows the job event stream; the completed job result now carries the Inventory commit receipt into import, inventory, and listing setup links, but the authoritative Inventory post-write contract remains the job snapshot rather than an Inventory read-model freshness wait.",
        "files": ["bounded-contexts/inventory/features/import-batches/ui/import-batch-page.tsx"],
        "helperUses": ["navigateAfterWrite"]
      }
    },
    {
      "id": "inventory.storage-locations-list",
      "owner": "inventory",
      "risk": "important",
      "freshnessSlo": {
        "flowClass": "important-self-refresh",
        "p95Ms": 2500,
        "p99Ms": 5000
      },
      "source": {
        "routeId": "account-inventory-locations",
        "actions": ["Create storage location", "Update storage location", "Archive storage location"],
        "command": "Inventory storage location commands",
        "helperUses": ["navigateAfterWrite"]
      },
      "destination": {
        "routeId": "account-inventory-locations",
        "apiContextName": "inventory",
        "apiRoutePath": "/storage-locations",
        "readModelTables": ["inventory_storage_locations"],
        "helperUses": ["loadAfterWrite"],
        "transientRecovery": {
          "kinds": "refreshable-catching-up",
          "behavior": "Storage location writes redirect with afterWrite and the locations loader converts valid projection catch-up timeouts into route-owned temporary recovery copy."
        }
      }
    },
    {
      "id": "inventory.restock-decision-list",
      "owner": "inventory",
      "risk": "important",
      "freshnessSlo": {
        "flowClass": "important-self-refresh",
        "p95Ms": 2500,
        "p99Ms": 5000
      },
      "source": {
        "routeId": "account-inventory-restock-decisions",
        "actions": ["Record restock decision"],
        "command": "Restock decision command",
        "helperUses": ["navigateAfterWrite"]
      },
      "destination": {
        "routeId": "account-inventory-restock-decisions",
        "apiContextName": "inventory",
        "apiRoutePath": "/restock-decisions",
        "readModelTables": ["inventory_restock_decisions", "inventory_item_ledger", "inventory_items"],
        "helperUses": ["loadAfterWrite"],
        "transientRecovery": {
          "kinds": "refreshable-catching-up",
          "behavior": "Restock decision actions redirect with afterWrite to the pending queue so the list waits for the decision projection before rendering the updated queue."
        }
      }
    }
  ],
  "mutationConsistencyInventory": [
    {
      "id": "inventory.api-command-snapshots",
      "owner": "inventory",
      "risk": "important",
      "strategy": "snapshot-return",
      "surfaces": [
        "api-route:bounded-contexts/inventory/features/holds/api/route.ts:POST /",
        "api-route:bounded-contexts/inventory/features/holds/api/route.ts:POST /:id/release",
        "api-route:bounded-contexts/inventory/features/holds/api/route.ts:POST /:id/extend",
        "api-route:bounded-contexts/inventory/features/import-batches/api/route.ts:POST /",
        "api-route:bounded-contexts/inventory/features/import-batches/api/route.ts:POST /:id/commit",
        "api-route:bounded-contexts/inventory/features/inventory-items/api/route.ts:POST /",
        "api-route:bounded-contexts/inventory/features/inventory-items/api/route.ts:POST /:id/adjustments",
        "api-route:bounded-contexts/inventory/features/inventory-items/api/route.ts:POST /:id/holds",
        "api-route:bounded-contexts/inventory/features/inventory-items/api/route.ts:POST /listing-stock/ensure",
        "api-route:bounded-contexts/inventory/features/storage-locations/api/route.ts:PATCH /:id",
        "api-route:bounded-contexts/inventory/features/storage-locations/api/route.ts:POST /"
      ],
      "visibleDestination": {
        "description": "Inventory API commands return command-owned ids, versions, durable job statuses, or listing-stock snapshots that callers can render or carry into a fresh-read route without trusting a stale projection response."
      },
      "proof": {
        "authoritativeResponse": "Item, hold, checkout-reservation, and storage-location commands return the committed aggregate id/version or reservation snapshot; import-batch commands return durable job public snapshots; listing-stock ensure returns the command-owned inventory stock snapshot.",
        "tests": [
          "bounded-contexts/inventory/tests/acceptance/inventory-api.test.ts",
          "bounded-contexts/inventory/features/holds/api/route.test.ts",
          "bounded-contexts/inventory/features/inventory-items/api/route.test.ts",
          "bounded-contexts/inventory/features/import-batches/api/runtime.test.ts"
        ]
      }
    },
    {
      "id": "inventory.account-sku-mappings-resolve-inventory-items",
      "owner": "inventory",
      "risk": "informational",
      "strategy": "snapshot-return",
      "surfaces": [
        "api-route:bounded-contexts/inventory/features/import-batches/api/route.ts:POST /account-sku-mappings/resolve-inventory-items"
      ],
      "visibleDestination": {
        "description": "A POST-shaped read (the seller-SKU batch is a request body, not query params) that resolves seller SKUs to inventory items live from account_sku_mappings and inventory_items on every call -- no write, no snapshot to trust or distrust; built for m113 bulk reprice ingestion (#4328) to reuse Inventory's native-SKU resolution (m71) without a cross-context write."
      },
      "proof": {
        "authoritativeResponse": "resolveAccountSellerSkusToInventoryItems queries the current account_sku_mappings and inventory_items rows on every call; there is no cached or projected intermediate to go stale.",
        "tests": [
          "bounded-contexts/inventory/features/import-batches/tests/account-sku-mappings-resolve-inventory-items.db.test.ts"
        ]
      }
    },
    {
      "id": "inventory.import-batch-job-snapshot",
      "owner": "inventory",
      "risk": "important",
      "strategy": "snapshot-return",
      "surfaces": [
        "post-form:bounded-contexts/inventory/features/import-batches/ui/import-batch-page.tsx:H2df726441e2a#1",
        "post-form:bounded-contexts/inventory/features/import-batches/ui/import-batch-page.tsx:H2df726441e2a#2",
        "route-action:bounded-contexts/inventory/routes/marketplace/account-inventory-imports.tsx"
      ],
      "visibleDestination": {
        "routeId": "account-inventory-imports",
        "description": "Import create and commit actions redirect with the durable job id, render job progress from the command-owned job snapshot, and reload the completed batch from the terminal job result path."
      },
      "proof": {
        "authoritativeResponse": "createImportBatch and commitImportBatch return InventoryImportBatchJobStatus snapshots; the import page subscribes to the job event stream and navigates only after a completed terminal snapshot includes the batch result.",
        "tests": [
          "bounded-contexts/inventory/tests/account-inventory-routes.test.ts",
          "bounded-contexts/inventory/features/import-batches/ui/import-batch-page.test.tsx",
          "bounded-contexts/inventory/features/import-batches/api/runtime.test.ts"
        ]
      }
    },
    {
      "id": "inventory.import-row-review-resolution-snapshot",
      "owner": "inventory",
      "risk": "important",
      "strategy": "snapshot-return",
      "surfaces": [
        "api-route:bounded-contexts/inventory/features/import-batches/api/route.ts:POST /:id/rows/:rowId/resolve",
        "post-form:bounded-contexts/inventory/features/import-batches/ui/import-batch-page.tsx:H2df726441e2a#3"
      ],
      "visibleDestination": {
        "routeId": "account-inventory-import",
        "description": "Native import review row fixes synchronously update the Inventory import-batch row and account SKU mapping, return the updated InventoryImportBatchDetail snapshot, then redirect back to the same import batch detail route after the write completes."
      },
      "proof": {
        "authoritativeResponse": "resolveRow validates the selected catalog item/options and storage location, writes the row resolution plus account SKU mapping in Inventory-owned tables, refreshes batch counts, and returns getImportBatch from the same request before the browser route redirects.",
        "tests": [
          "bounded-contexts/inventory/features/import-batches/api/runtime.test.ts",
          "bounded-contexts/inventory/features/import-batches/api/route.test.ts",
          "bounded-contexts/inventory/features/import-batches/ui/import-batch-page.test.tsx"
        ]
      }
    },
    {
      "id": "inventory.list-from-inventory-create-publish-snapshot",
      "owner": "inventory",
      "risk": "important",
      "strategy": "snapshot-return",
      "surfaces": [
        "post-form:bounded-contexts/inventory/features/inventory-items/ui/list-from-inventory-drawer.tsx:H2df726441e2a#1"
      ],
      "visibleDestination": {
        "description": "The list-from-inventory drawer posts to the marketplace create-and-publish listing route from the inventory item; on success the marketplace route redirects to the new listing detail with a post-write receipt token, so the seller lands on the command-owned listing without visiting the listings section or trusting a stale projection."
      },
      "proof": {
        "authoritativeResponse": "The marketplace create route returns the command-owned listing id, version, and fee-quote fingerprint, and publish returns the published version; the redirect carries those receipts via the marketplace post-write token, so the inventory item surface performs no post-write read of an inventory projection.",
        "tests": [
          "bounded-contexts/inventory/features/inventory-items/ui/list-from-inventory-drawer.test.tsx",
          "bounded-contexts/marketplace/tests/account-listings-new-route.test.ts"
        ]
      }
    },
    {
      "id": "inventory.restock-decision-record-to-list",
      "owner": "inventory",
      "risk": "important",
      "strategy": "fresh-read",
      "surfaces": [
        "api-route:bounded-contexts/inventory/features/restock-decisions/api/route.ts:POST /:id/decision",
        "post-form:bounded-contexts/inventory/features/restock-decisions/ui/restock-decision-queue-page.tsx:H2df726441e2a#1",
        "post-form:bounded-contexts/inventory/features/restock-decisions/ui/restock-decision-queue-page.tsx:H2df726441e2a#2",
        "route-action:bounded-contexts/inventory/routes/marketplace/account-inventory-restock-decisions.tsx"
      ],
      "visibleDestination": {
        "routeId": "account-inventory-restock-decisions",
        "apiContextName": "inventory",
        "apiRoutePath": "/restock-decisions",
        "readModelTables": ["inventory_restock_decisions", "inventory_item_ledger", "inventory_items"],
        "transientRecovery": {
          "kinds": "refreshable-catching-up",
          "behavior": "Restock and write-off actions return a committed decision id/version and redirect to the queue with an afterWrite receipt so the updated pending list is projection-gated."
        }
      },
      "proof": {
        "authoritativeResponse": "recordRestockDecision returns the committed restock-decision aggregate id/version; restock uses a deterministic inventory adjustment idempotency key before recording the decision outcome.",
        "tests": [
          "bounded-contexts/inventory/tests/order-cancellation-subscription.test.ts",
          "bounded-contexts/inventory/features/restock-decisions/domain/domain.test.ts"
        ]
      }
    },
    {
      "id": "inventory.item-create-to-detail-fresh-read",
      "owner": "inventory",
      "risk": "important",
      "strategy": "fresh-read",
      "surfaces": [
        "post-form:bounded-contexts/inventory/features/inventory-items/ui/inventory-item-list-page.tsx:H2df726441e2a#1",
        "route-action:bounded-contexts/inventory/routes/marketplace/account-inventory.tsx"
      ],
      "visibleDestination": {
        "routeId": "account-inventory-item",
        "apiContextName": "inventory",
        "apiRoutePath": "/items/:id",
        "readModelTables": ["inventory_items", "inventory_holds", "inventory_item_ledger"],
        "transientRecovery": {
          "kinds": "refreshable-catching-up",
          "behavior": "Inventory item create redirects to the created item detail with afterWrite and the detail loader retries valid fresh-write not-found reads before falling back to temporary recovery."
        }
      },
      "proof": {
        "tests": ["bounded-contexts/inventory/tests/account-inventory-routes.test.ts"]
      }
    },
    {
      "id": "inventory.item-detail-actions-fresh-read",
      "owner": "inventory",
      "risk": "critical",
      "strategy": "fresh-read",
      "surfaces": [
        "post-form:bounded-contexts/inventory/features/inventory-items/ui/inventory-item-detail-page.tsx:H2df726441e2a#1",
        "post-form:bounded-contexts/inventory/features/inventory-items/ui/inventory-item-detail-page.tsx:H2df726441e2a#2",
        "post-form:bounded-contexts/inventory/features/inventory-items/ui/inventory-item-detail-page.tsx:H2df726441e2a#3",
        "route-action:bounded-contexts/inventory/routes/marketplace/account-inventory-item.tsx"
      ],
      "visibleDestination": {
        "routeId": "account-inventory-item",
        "apiContextName": "inventory",
        "apiRoutePath": "/items/:id",
        "readModelTables": ["inventory_items", "inventory_holds", "inventory_item_ledger"],
