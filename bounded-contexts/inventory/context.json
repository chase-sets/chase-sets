{
  "contextName": "inventory",
  "packageName": "@chase-sets/inventory",
  "ownedNouns": [
    "inventory-record",
    "inventory-hold",
    "storage-location"
  ],
  "streamPrefix": "inventory.",
  "apiBasePath": "/api/inventory",
  "slices": [
    "records",
    "holds",
    "storage-locations",
    "catalog-items"
  ],
  "allowedSupportDirectories": [
    "seed-support",
    "tests"
  ],
  "publicExports": [
    ".",
    "./client",
    "./integration",
    "./routes/*",
    "./seed-support/*",
    "./web"
  ],
  "allowedContextDependencies": [
    "@chase-sets/catalog"
  ],
  "requiredPorts": [],
  "apiDeployables": [
    "inventory-api"
  ],
  "apiMounts": [
    {
      "mountPath": "/api/inventory",
      "kind": "primary",
      "requiresAuth": true,
      "drainProjectorsOnWrite": true
    }
  ],
  "deployableContributions": [
    {
      "deployable": "marketplace",
      "routes": [
        { "routeId": "account-inventory", "routePath": "account/inventory", "fileExport": "./routes/marketplace/account-inventory", "routeType": "route", "sourceContext": "inventory" },
        { "routeId": "account-inventory-locations", "routePath": "account/inventory/locations", "fileExport": "./routes/marketplace/account-inventory-locations", "routeType": "route", "sourceContext": "inventory" },
        { "routeId": "account-inventory-record", "routePath": "account/inventory/records/:recordId", "fileExport": "./routes/marketplace/account-inventory-record", "routeType": "route", "sourceContext": "inventory" }
      ]
    }
  ],
  "shellContributions": [
    { "deployable": "marketplace", "slot": "top-nav", "key": "inventory", "label": "Inventory", "icon": "package", "href": "/account/inventory", "order": 100, "visibility": "signed-in", "requiredPermissions": ["inventory.view"] },
    { "deployable": "marketplace", "slot": "bottom-nav", "key": "inventory", "label": "Inventory", "icon": "package", "href": "/account/inventory", "order": 100, "visibility": "signed-in", "requiredPermissions": ["inventory.view"] }
  ]
}
