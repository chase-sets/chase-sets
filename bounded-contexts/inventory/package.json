{
  "name": "@chase-sets/inventory",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "chaseSets": {
    "testProfile": "db"
  },
  "scripts": {
    "test": "vitest run --config ./tests/vitest.config.mjs",
    "test:watch": "vitest --config ./tests/vitest.config.mjs",
    "test:fast": "vitest run --config ./tests/vitest.config.mjs --exclude tests/acceptance/inventory-api.test.ts",
    "test:unit": "vitest run --config ./tests/vitest.config.mjs --exclude tests/acceptance/inventory-api.test.ts --exclude features/import-batches/tests/account-sku-mappings-resolve-inventory-items.db.test.ts",
    "test:db": "vitest run --config ./tests/vitest.config.mjs tests/acceptance/inventory-api.test.ts features/import-batches/tests/account-sku-mappings-resolve-inventory-items.db.test.ts"
  },
  "exports": {
    ".": "./index.ts",
    "./context": "./context.json",
    "./routes/*": "./routes/*.tsx",
    "./seed-support/*": "./support/seed-support/*.ts",
    "./server": "./server.ts"
  },
  "types": "./index.ts",
  "dependencies": {
    "@chase-sets/bounded-context-module": "workspace:*",
    "@chase-sets/bounded-context-runtime": "workspace:*",
    "@chase-sets/catalog-seed": "workspace:*",
    "@chase-sets/customer-feedback": "workspace:*",
    "@chase-sets/design-system": "workspace:*",
    "@chase-sets/event-core": "workspace:*",
    "@chase-sets/event-core-postgres": "workspace:*",
    "@chase-sets/platform-operations": "workspace:*",
    "@chase-sets/http": "workspace:*",
    "@chase-sets/identity": "workspace:*",
    "@chase-sets/localization": "workspace:*",
    "@chase-sets/platform-runtime": "workspace:*",
    "@chase-sets/primitives": "workspace:*",
    "@chase-sets/product-selection": "workspace:*",
    "hono": "^4.12.12"
  },
  "devDependencies": {
    "@chase-sets/catalog": "workspace:*"
  }
}
