{
  "contextName": "pricing",
  "packageName": "@chase-sets/pricing",
  "localeCatalogs": ["contracts/localization/locales/en/pricing.ts"],
  "ownedNouns": [
    "market-price",
    "market-price-snapshot",
    "price-recommendation",
    "price-signal",
    "trades-tape",
    "daily-product-rollup",
    "platform-daily-rollup",
    "gross-merchandise-value",
    "market-state-snapshot",
    "repricing-policy",
    "repricing-policy-assignment",
    "bulk-reprice-job"
  ],
  "streamPrefix": "pricing.",
  "apiBasePath": "/api/marketplace",
  "slices": [
    "recommendations",
    "price-signals",
    "market-trades",
    "market-rollups",
    "market-estimates",
    "repricing-policies",
    "repricing-engine",
    "public-market-pages",
    "bulk-reprice-ingestion"
  ],
  "allowedSupportDirectories": ["realtime-support", "request-support", "route-support", "runtime-support"],
  "publicExports": [".", "./context", "./routes/*", "./server"],
  "allowedContextDependencies": ["@chase-sets/marketplace", "@chase-sets/inventory"],
  "seedRequirements": [
    "catalog",
    "identity",
    "inventory",
    "marketplace",
    "ordering",
    "fulfillment",
    "payments",
    "settlement",
    "authenticity"
  ],
  "eventSubscriptions": [
    {
      "sourceContextName": "catalog",
      "projectionName": "pricing-catalog-input-projection",
      "subscriptionVersion": 5,
      "eventTypes": [
        "catalog.catalog-item.created",
        "catalog.catalog-item.display-identity-resolved",
        "catalog.catalog-item.published",
        "catalog.catalog-item.retired",
        "catalog.catalog-item.archived",
        "catalog.catalog-item.external-product-reference-linked",
        "catalog.catalog-item.external-product-reference-unlinked",
        "catalog.catalog-item.category-assigned",
        "catalog.catalog-item.category-removed"
      ],
      "order": 10,
      "projectionHandlerSetNames": ["pricing-catalog-input-projection"]
    },
    {
      "sourceContextName": "inventory",
      "projectionName": "pricing-inventory-input-projection",
      "subscriptionVersion": 2,
      "eventTypes": [
        "inventory.item.created",
        "inventory.item.adjusted",
        "inventory.hold.placed",
        "inventory.hold.converted",
        "inventory.hold.extended",
        "inventory.hold.released",
        "inventory.hold.expired"
      ],
      "order": 20,
      "projectionHandlerSetNames": ["pricing-inventory-input-projection"]
    },
    {
      "sourceContextName": "marketplace",
      "projectionName": "pricing-market-input-projection",
      "subscriptionVersion": 1,
      "eventTypes": [
        "marketplace.listing.created",
        "marketplace.listing.price-updated",
        "marketplace.listing.quantity-cap-updated",
        "marketplace.listing.published",
        "marketplace.listing.paused",
        "marketplace.listing.withdrawn",
        "marketplace.offer.submitted",
        "marketplace.offer.accepted"
      ],
      "order": 30,
      "projectionHandlerSetNames": ["pricing-market-input-projection"]
    },
    {
      "sourceContextName": "ordering",
      "projectionName": "pricing-order-input-projection",
      "subscriptionVersion": 1,
      "eventTypes": [
        "ordering.order.created",
        "ordering.order.cancelled",
        "ordering.order.ready-for-fulfillment-recorded"
      ],
      "order": 40,
      "projectionHandlerSetNames": ["pricing-order-input-projection"]
    },
    {
      "sourceContextName": "fulfillment",
      "projectionName": "pricing-fulfillment-input-projection",
      "subscriptionVersion": 1,
      "eventTypes": ["fulfillment.shipment.created", "fulfillment.shipment.delivered", "fulfillment.shipment.returned"],
      "order": 50,
      "projectionHandlerSetNames": ["pricing-fulfillment-input-projection"]
    },
    {
      "sourceContextName": "ordering",
      "projectionName": "pricing-market-trades-projection",
      "subscriptionVersion": 1,
      "filterToEventTypes": true,
      "eventTypes": [
        "ordering.order.created",
        "ordering.order.cancelled",
        "ordering.order.ready-for-fulfillment-recorded"
      ],
      "order": 60,
      "projectionHandlerSetNames": ["pricing-market-trades-projection"]
    },
    {
      "sourceContextName": "fulfillment",
      "projectionName": "pricing-market-trades-projection",
      "subscriptionVersion": 1,
      "filterToEventTypes": true,
      "eventTypes": ["fulfillment.shipment.created", "fulfillment.shipment.delivered", "fulfillment.shipment.returned"],
      "order": 70,
      "projectionHandlerSetNames": ["pricing-market-trades-projection"]
    },
    {
      "sourceContextName": "identity",
      "projectionName": "pricing-market-trades-projection",
      "subscriptionVersion": 1,
      "filterToEventTypes": true,
      "eventTypes": ["identity.account.badge-assigned"],
      "order": 80,
      "projectionHandlerSetNames": ["pricing-market-trades-projection"]
    },
    {
      "sourceContextName": "payments",
      "projectionName": "pricing-market-trades-projection",
      "subscriptionVersion": 1,
      "filterToEventTypes": true,
      "eventTypes": ["payments.payment-fraud-warning-received"],
      "order": 90,
      "projectionHandlerSetNames": ["pricing-market-trades-projection"]
    },
    {
      "sourceContextName": "authenticity",
      "sourceContextMount": "when-mounted",
      "projectionName": "pricing-market-trades-projection",
      "subscriptionVersion": 1,
      "filterToEventTypes": true,
      "eventTypes": ["authenticity.case.opened", "authenticity.case.verdict-recorded"],
      "order": 100,
      "projectionHandlerSetNames": ["pricing-market-trades-projection"]
    },
    {
      "sourceContextName": "settlement",
      "projectionName": "pricing-market-trades-projection",
      "subscriptionVersion": 1,
      "filterToEventTypes": true,
      "eventTypes": ["settlement.account-linkage.flagged", "settlement.account-linkage.cleared"],
      "order": 110,
      "projectionHandlerSetNames": ["pricing-market-trades-projection"]
    }
  ],
  "eventReactions": [
    {
      "sourceContextName": "marketplace",
      "reactionName": "pricing-repricing-evaluation-reaction",
      "subscriptionVersion": 1,
      "filterToEventTypes": true,
      "eventTypes": [
        "marketplace.listing.created",
        "marketplace.listing.price-updated",
        "marketplace.listing.quantity-cap-updated",
        "marketplace.listing.published",
        "marketplace.listing.paused",
        "marketplace.listing.withdrawn"
      ],
      "order": 31,
      "reactionHandlerSetNames": ["pricing-repricing-evaluation-reaction"],
      "idempotencyPolicy": "idempotent-command-dispatch",
      "retryPolicy": "retry-from-last-checkpoint",
      "failurePolicy": "surface-as-reaction-failure"
    },
    {
      "sourceContextName": "pricing",
      "reactionName": "pricing-repricing-evaluation-reaction",
      "subscriptionVersion": 1,
      "filterToEventTypes": true,
      "eventTypes": ["pricing.market-price.estimated"],
      "order": 32,
      "reactionHandlerSetNames": ["pricing-repricing-evaluation-reaction"],
      "idempotencyPolicy": "idempotent-command-dispatch",
      "retryPolicy": "retry-from-last-checkpoint",
      "failurePolicy": "surface-as-reaction-failure"
    }
  ],
  "projectionGroups": [
    {
      "projectionName": "pricing-catalog-input-projection",
      "sourceContextNames": ["catalog"],
      "ownedTables": ["pricing_catalog_item_inputs", "pricing_external_product_reference_inputs"],
      "requiredDuringBootstrap": true,
      "resetStrategy": "replay-only"
    },
    {
      "projectionName": "pricing-inventory-input-projection",
      "sourceContextNames": ["inventory"],
      "ownedTables": ["pricing_inventory_item_inputs", "pricing_inventory_hold_inputs"],
      "requiredDuringBootstrap": true,
      "resetStrategy": "replay-only"
    },
    {
      "projectionName": "pricing-market-input-projection",
      "sourceContextNames": ["marketplace"],
      "ownedTables": ["pricing_market_listing_inputs", "pricing_buyer_offer_inputs"],
      "requiredDuringBootstrap": true,
      "resetStrategy": "replay-only"
    },
    {
      "projectionName": "pricing-order-input-projection",
      "sourceContextNames": ["ordering"],
      "ownedTables": ["pricing_order_signal_lines"],
      "requiredDuringBootstrap": true,
      "resetStrategy": "replay-only"
    },
    {
      "projectionName": "pricing-fulfillment-input-projection",
      "sourceContextNames": ["fulfillment"],
      "ownedTables": ["pricing_fulfillment_signal_lines"],
      "requiredDuringBootstrap": true,
      "resetStrategy": "replay-only"
    },
    {
      "projectionName": "pricing-market-trades-projection",
      "sourceContextNames": ["ordering", "fulfillment", "identity", "payments", "authenticity", "settlement"],
      "optionalSourceContextNames": ["authenticity"],
      "ownedTables": [
        "pricing_market_trades",
        "pricing_market_trade_authenticity_cases",
        "pricing_market_trade_linkage_clusters",
        "pricing_market_trade_rollup_rederive_queue"
      ],
      "requiredDuringBootstrap": true,
      "resetStrategy": "replay-only"
    },
    {
      "projectionName": "pricing-repricing-evaluation-reaction",
      "handlerKind": "reaction",
      "sourceContextNames": ["marketplace", "pricing"],
      "ownedTables": [],
      "sideEffectOnly": true,
      "requiredDuringBootstrap": false,
      "resetStrategy": "replay-only"
    }
  ],
  "hostPorts": [],
  "apiDeployables": ["platform-api"],
  "apiMounts": [
    {
      "mountPath": "/api/marketplace",
      "kind": "primary",
      "requiresAuth": true
    }
  ],
  "mcpCapabilities": {
    "tools": [
      { "name": "pricing.recommend-price", "ownerSlice": "recommendations" },
      { "name": "pricing.explain-signals", "ownerSlice": "recommendations" }
    ],
    "resources": [
      {
        "uriTemplate": "chase-sets://pricing/catalog-items/{catalogItemId}/recommendations",
        "ownerSlice": "recommendations"
      }
    ]
  },
  "mutationConsistencyInventory": [
    {
      "id": "pricing.recommendation-publish-command-snapshot",
      "owner": "pricing",
      "risk": "important",
      "strategy": "snapshot-return",
      "surfaces": [
        "api-route:bounded-contexts/pricing/features/recommendations/api/route.ts:POST /recommendations/:id/publish"
      ],
      "visibleDestination": {
        "description": "Recommendation publish responses include the command-owned recommendation snapshot and version so callers do not need to trust a potentially lagging recommendation feed read."
      },
      "proof": {
        "authoritativeResponse": "publishRecommendation returns the aggregate state produced by the command handler, and the API route returns that snapshot alongside id/version receipt fields.",
        "tests": [
          "bounded-contexts/pricing/features/recommendations/api/runtime.test.ts",
          "bounded-contexts/pricing/features/recommendations/api/route.test.ts"
        ]
      }
    },
    {
      "id": "pricing.recommendation-job-command-snapshots",
      "owner": "pricing",
      "risk": "important",
      "strategy": "snapshot-return",
      "surfaces": [
        "api-route:bounded-contexts/pricing/features/recommendations/api/route.ts:POST /recommendations/apply",
        "api-route:bounded-contexts/pricing/features/recommendations/api/route.ts:POST /recommendations/dismiss",
        "api-route:bounded-contexts/pricing/features/recommendations/api/route.ts:POST /recommendations/refresh"
      ],
      "visibleDestination": {
        "description": "Refresh, apply, and dismiss responses return the durable job public snapshot that owns queued/running/completed state for the submitted recommendation write."
      },
      "proof": {
        "authoritativeResponse": "enqueueRecommendationJob persists and returns the durable job public snapshot; the account route reloads that snapshot by jobId before rendering post-write recommendation controls.",
        "tests": [
          "bounded-contexts/pricing/features/recommendations/api/route.test.ts",
          "bounded-contexts/pricing/tests/account-repricing-route.test.ts"
        ]
      }
    },
    {
      "id": "pricing.bulk-reprice-ingestion-job-snapshots",
      "owner": "pricing",
      "risk": "important",
      "strategy": "snapshot-return",
      "surfaces": [
        "api-route:bounded-contexts/pricing/features/bulk-reprice-ingestion/api/route.ts:POST /",
        "api-route:bounded-contexts/pricing/features/bulk-reprice-ingestion/api/route.ts:POST /jobs/:jobId/cancel",
        "post-form:bounded-contexts/pricing/features/bulk-reprice-ingestion/ui/bulk-reprice-page.tsx:H2df726441e2a#1",
        "post-form:bounded-contexts/pricing/features/bulk-reprice-ingestion/ui/bulk-reprice-page.tsx:H2df726441e2a#2",
        "route-action:bounded-contexts/pricing/support/route-support/bulk-reprice/action.ts"
      ],
      "visibleDestination": {
        "routeId": "account-bulk-reprice",
        "description": "Create-job and cancel-job responses (both the API route and the account/bulk-reprice route action that fronts it) return the durable job public snapshot that owns queued/running/completed state for the submitted bulk reprice upload; the upload/cancel forms on the page are disabled while that snapshot is queued or running."
      },
      "proof": {
        "authoritativeResponse": "enqueueJob and cancelJob both return the durable job store's own record (via toBulkRepriceJobStatus), never a lagging read-model row; the route action redirects with jobId and the loader reloads that same snapshot.",
        "tests": ["bounded-contexts/pricing/features/bulk-reprice-ingestion/tests/bulk-reprice-ingestion.db.test.ts"]
      }
    },
    {
      "id": "pricing.account-repricing-job-correction",
      "owner": "pricing",
      "risk": "important",
      "strategy": "snapshot-return",
      "surfaces": [
        "post-form:bounded-contexts/pricing/features/recommendations/ui/recommendation-list-page.tsx:H2df726441e2a#1",
        "post-form:bounded-contexts/pricing/features/recommendations/ui/recommendation-list-page.tsx:H2df726441e2a#2",
        "route-action:bounded-contexts/pricing/routes/marketplace/account-repricing.tsx"
      ],
      "visibleDestination": {
        "routeId": "account-repricing",
        "description": "The account repricing page renders the active durable job snapshot, pauses recommendation controls while it is queued or running, and the SSE terminal path reloads the recommendation list."
      },
      "proof": {
        "authoritativeResponse": "The route action redirects with jobId, the loader fetches the durable job snapshot, and the list page disables refresh/apply/dismiss controls until terminal status triggers a page refetch.",
        "tests": [
          "bounded-contexts/pricing/tests/account-repricing-route.test.ts",
          "bounded-contexts/pricing/features/recommendations/ui/recommendation-list-page.test.tsx"
        ]
      }
    }
  ],
  "deployableContributions": [
    {
      "deployable": "marketplace-web",
      "routes": [
        {
          "routeId": "account-repricing",
          "routePath": "account/repricing",
          "fileExport": "./routes/marketplace/account-repricing",
          "routeType": "route",
          "sourceContext": "pricing",
          "delivery": "server-only",
          "authorization": {
            "kind": "authenticated",
            "requiredPermissions": []
          },
          "canonicalLink": {
            "kind": "not-applicable",
            "reason": "Canonical-link publication is deferred with mobile route extraction."
          },
          "availability": {
            "web": true,
            "mobile": false
          },
          "pageComponentExport": "default",
          "unsupportedMobile": {
            "owner": "pricing",
            "followUp": "#5238",
            "reason": "Portable data operations have not been extracted for this route."
          }
        },
        {
          "routeId": "account-bulk-reprice",
          "routePath": "account/bulk-reprice",
          "fileExport": "./routes/marketplace/bulk-reprice",
          "routeType": "route",
          "sourceContext": "pricing",
          "delivery": "server-only",
          "authorization": {
            "kind": "authenticated",
            "requiredPermissions": []
          },
          "canonicalLink": {
            "kind": "not-applicable",
            "reason": "Canonical-link publication is deferred with mobile route extraction."
          },
          "availability": {
            "web": true,
            "mobile": false
          },
          "pageComponentExport": "default",
          "unsupportedMobile": {
            "owner": "pricing",
            "followUp": "#5238",
            "reason": "Portable data operations have not been extracted for this route."
          }
        }
      ]
    },
    {
      "deployable": "public-web",
      "routes": [
        {
          "routeId": "market-price-history",
          "routePath": "market/:slug",
          "fileExport": "./routes/marketplace/market-price-history",
          "routeType": "route",
          "sourceContext": "pricing"
        }
      ]
    }
  ],
  "shellContributions": [
    {
      "deployable": "marketplace-web",
      "slot": "top-nav",
      "key": "repricing",
      "label": "Pricing",
      "icon": "chart",
      "href": "/account/repricing",
      "order": 120,
      "visibility": "signed-in",
      "requiredPermissions": ["pricing.view"]
    },
    {
      "deployable": "marketplace-web",
      "slot": "bottom-nav",
      "key": "repricing",
      "label": "Pricing",
      "icon": "chart",
      "href": "/account/repricing",
      "order": 120,
      "visibility": "signed-in",
      "requiredPermissions": ["pricing.view"]
    }
  ],
  "directoryIntent": {
    "recommendations": {
      "classification": "slice",
      "purpose": "Own recommendations feature behavior, read models, and UI contracts for the pricing context.",
      "expectedConsumers": ["Internal pricing module composition"]
    },
    "price-signals": {
      "classification": "slice",
      "purpose": "Own provider market evidence ingestion and normalized Price Signal records for the pricing context.",
      "expectedConsumers": ["Internal pricing module composition"]
    },
    "market-trades": {
      "classification": "slice",
      "purpose": "Own the pricing trades-tape: the normalized, replay-backfilled trade history projected from Ordering and Fulfillment events, plus its tape-integrity reactions (fraud exclusions from Identity/Payments risk flags, pair-scoped self-dealing exclusions from Settlement linkage facts, verified markers from Authenticity verdicts) and stat-hygiene policy.",
      "expectedConsumers": ["Internal pricing module composition"]
    },
    "market-rollups": {
      "classification": "slice",
      "purpose": "Own the daily-product-rollup and market-state-snapshot read models, and the denormalized product market aggregate, computed from the trades-tape and current listing/offer state, plus the query API that serves them.",
      "expectedConsumers": ["Internal pricing module composition"]
    },
    "market-estimates": {
      "classification": "slice",
      "purpose": "Own the blended Market-Value Estimate: the event-sourced Market Price aggregate publishing pricing.market-price.estimated per resolved product (platform verified trades weighted highest, unverified next, external comps by the market-estimate policy, all time-decayed), its minimum-input gate, the current-estimate read model, and the estimate recompute pass riding the market-rollups closer job.",
      "expectedConsumers": ["Internal pricing module composition"]
    },
    "repricing-policies": {
      "classification": "slice",
      "purpose": "Own the RepricingPolicy aggregate (seller-owned rule pipeline: anchor chain, offset, floor, ceiling, tolerance, budgets, scope) and the resolved listing-to-policy assignment read model that is the repricing evaluation engine's work queue input.",
      "expectedConsumers": ["Internal pricing module composition"]
    },
    "repricing-engine": {
      "classification": "slice",
      "purpose": "React to changed market signals, evaluate assigned Repricing Policies in simultaneous product rounds, suppress writes inside tolerance, and publish RepricingPolicyEvaluated facts.",
      "expectedConsumers": ["Internal pricing module composition", "platform-worker"]
    },
    "public-market-pages": {
      "classification": "slice",
      "purpose": "Own the public, unauthenticated, SEO-indexable market price-history page per catalog item: the public-safe read composition over the catalog item identity and the market-rollups query API, its API routes, and its UI.",
      "expectedConsumers": ["Internal pricing module composition", "public-web"]
    },
    "bulk-reprice-ingestion": {
      "classification": "slice",
      "purpose": "Own the removable bulk reprice ingestion on-ramp (m113 #4328): diff-first CSV/API upload, seller-SKU/listingId resolution, chunked apply through Marketplace's bulk price-update port, per-row outcome tracking, and the results-CSV export. Deletable as one directory plus the mount lines documented in docs/bulk-reprice-ingestion.md -- nothing outside this directory (besides the documented mount points) imports from it.",
      "expectedConsumers": ["Internal pricing module composition"]
    },
    "runtime-support": {
      "classification": "support",
      "purpose": "Provide reusable runtime-support assets shared by pricing-owned features and composition seams.",
      "expectedConsumers": ["recommendations"]
    },
    "realtime-support": {
      "classification": "support",
      "purpose": "Provide Pricing-owned realtime topic/patch helpers so the market-rollups closer job can advance Discovery's item-detail market panel over the shared item: topic namespace.",
      "expectedConsumers": ["market-rollups"]
    },
    "request-support": {
      "classification": "support",
      "purpose": "Provide Pricing request HTTP client composition for route loaders and composition seams.",
      "expectedConsumers": ["recommendations", "public-market-pages", "bulk-reprice-ingestion"],
      "crossCuttingRuntimeComposition": true
    },
    "route-support": {
      "classification": "support",
      "purpose": "Provide the bulk-reprice-ingestion slice's route loader/action modules (m113 #4328) so the route module itself stays a thin re-export.",
      "expectedConsumers": ["routes"]
    },
    "routes": {
      "classification": "routes",
      "purpose": "Expose pricing-owned route modules consumed by generated deployable adapters.",
      "expectedConsumers": ["Generated deployable route adapters"]
    }
  },
  "runtimeDeployables": ["platform-worker"],
  "apiRuntimeProfiles": ["proof", "public"],
  "workerRuntimeProfiles": ["proof", "public"]
}
