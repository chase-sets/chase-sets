{
  "contextName": "collections",
  "packageName": "@chase-sets/collections",
  "ownedNouns": ["saved-list", "saved-list-line", "tracked-quantity", "saved-list-visibility", "saved-list-cover"],
  "streamPrefix": "collections.",
  "apiBasePath": "/api/collections",
  "slices": ["saved-lists", "saved-list-valuation"],
  "allowedSupportDirectories": ["runtime-support"],
  "publicExports": [".", "./context", "./server"],
  "allowedContextDependencies": [],
  "seedRequirements": [],
  "hostPorts": [
    {
      "portName": "savedListProductCatalog",
      "providedBy": "platform-api",
      "purpose": "Validates exact Catalog Product selections before they enter a Saved List without Collections reading Catalog tables."
    },
    {
      "portName": "inventorySavedListImportBatchCreator",
      "providedBy": "platform-api",
      "purpose": "Creates an Inventory-owned review-first import batch from an authorized immutable Saved List source snapshot."
    }
  ],
  "eventSubscriptions": [
    {
      "sourceContextName": "collections",
      "projectionName": "collections-saved-list-valuation-projection",
      "subscriptionVersion": 1,
      "eventTypes": [
        "collections.saved-list.created",
        "collections.saved-list.archived",
        "collections.saved-list.visibility-changed",
        "collections.saved-list.line-added",
        "collections.saved-list.line-changed",
        "collections.saved-list.line-removed"
      ],
      "order": 10,
      "projectionHandlerSetNames": ["collections-saved-list-valuation-projection"]
    },
    {
      "sourceContextName": "pricing",
      "projectionName": "collections-saved-list-valuation-projection",
      "subscriptionVersion": 1,
      "eventTypes": ["pricing.market-price.estimated"],
      "order": 20,
      "projectionCascadeChunkSize": 100,
      "projectionHandlerSetNames": ["collections-saved-list-valuation-projection"]
    }
  ],
  "projectionGroups": [
    {
      "projectionName": "collections-saved-list-valuation-projection",
      "sourceContextNames": ["collections", "pricing"],
      "ownedTables": [
        "collections_saved_list_valuation_lists",
        "collections_saved_list_valuation_lines",
        "collections_saved_list_market_estimates"
      ],
      "requiredDuringBootstrap": true,
      "resetStrategy": "truncate-owned-tables"
    }
  ],
  "apiDeployables": ["platform-api"],
  "apiRuntimeProfiles": ["proof", "public"],
  "apiMounts": [
    {
      "mountPath": "/api/collections",
      "kind": "primary",
      "requiresAuth": true
    }
  ],
  "workerRuntimeProfiles": ["proof", "public"],
  "runtimeDeployables": ["platform-worker"],
  "deployableContributions": [],
  "shellContributions": [],
  "directoryIntent": {
    "saved-lists": {
      "classification": "slice",
      "purpose": "The saved-lists slice owns the event-sourced Saved List lifecycle, exact Product membership, tracked quantity, private line metadata, deterministic ordering, visibility state, cover selection, and versioned command/event contracts.",
      "expectedConsumers": [
        "Internal Collections module composition",
        "Saved List projection, valuation, sharing, Inventory handoff, sell-through, and My Collection slices"
      ]
    },
    "saved-list-valuation": {
      "classification": "slice",
      "purpose": "The saved-list-valuation slice projects current Pricing market estimates against Saved List tracked quantities and exposes honest owner/viewer value coverage without inventory economics or history.",
      "expectedConsumers": [
        "Internal Collections module composition",
        "My Collection Saved List detail",
        "Shared Saved List presentation"
      ]
    },
    "runtime-support": {
      "classification": "support",
      "purpose": "Provide the Collections event-store schema and runtime service composition seam without taking Saved List behavior out of its slice.",
      "expectedConsumers": ["Root Collections module composition"]
    },
    "routes": {
      "classification": "routes",
      "purpose": "Reserve Collections route metadata for later My Collection and shared Saved List route contributions.",
      "expectedConsumers": ["Future generated deployable route adapters"]
    }
  }
}
