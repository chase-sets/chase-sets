{
  "contextName": "public-presence",
  "packageName": "@chase-sets/public-presence",
  "ownedNouns": ["public-presence", "waitlist-signup", "promo-bar-message"],
  "streamPrefix": "public-presence.",
  "apiBasePath": "/api/public-presence",
  "slices": ["waitlist", "promo-bar"],
  "allowedSupportDirectories": ["request-support", "runtime-support", "shell-support", "ui-support"],
  "publicExports": [".", "./context", "./routes/*", "./server", "./web"],
  "allowedContextDependencies": [],
  "seedRequirements": [],
  "eventSubscriptions": [
    {
      "sourceContextName": "public-presence",
      "projectionName": "public-presence-waitlist-projection",
      "subscriptionVersion": 1,
      "eventTypes": ["public-presence.waitlist-signup.recorded", "public-presence.waitlist-signup.updated"],
      "streamPrefixes": ["public-presence.waitlist-signup-"],
      "order": 10,
      "projectionHandlerSetNames": ["public-presence-waitlist-projection"]
    },
    {
      "sourceContextName": "public-presence",
      "projectionName": "public-presence-waitlist-transactional-email-projection",
      "subscriptionVersion": 1,
      "eventTypes": ["public-presence.waitlist-signup.recorded"],
      "streamPrefixes": ["public-presence.waitlist-signup-"],
      "order": 20,
      "projectionHandlerSetNames": ["public-presence-waitlist-transactional-email-projection"]
    }
  ],
  "projectionGroups": [
    {
      "projectionName": "public-presence-waitlist-projection",
      "sourceContextNames": ["public-presence"],
      "ownedTables": ["public_presence_waitlist_signups"],
      "requiredDuringBootstrap": true,
      "resetStrategy": "replay-only"
    },
    {
      "projectionName": "public-presence-waitlist-transactional-email-projection",
      "sourceContextNames": ["public-presence"],
      "ownedTables": ["transactional_email_outbox"],
      "requiredDuringBootstrap": true,
      "resetStrategy": "append-only-no-reset"
    }
  ],
  "hostPorts": [
    {
      "portName": "transactionalEmailOutbox",
      "providedBy": "platform-worker",
      "purpose": "Durable transactional email outbox consumed only by event projectors."
    }
  ],
  "apiDeployables": ["admin-support-api", "platform-api"],
  "apiMounts": [
    {
      "mountPath": "/api/public-presence",
      "kind": "primary",
      "requiresAuth": false
    },
    {
      "mountPath": "/api/public-presence/admin",
      "kind": "additional",
      "requiresAuth": true
    }
  ],
  "deployableContributions": [
    {
      "deployable": "public-web",
      "routes": [
        {
          "routeId": "home",
          "routePath": "",
          "fileExport": "./routes/marketplace/home",
          "routeType": "index",
          "sourceContext": "public-presence",
          "placement": "root"
        },
        {
          "routeId": "faq",
          "routePath": "faq",
          "fileExport": "./routes/marketplace/faq",
          "routeType": "route",
          "sourceContext": "public-presence",
          "placement": "root"
        },
        {
          "routeId": "contact",
          "routePath": "contact",
          "fileExport": "./routes/marketplace/contact",
          "routeType": "route",
          "sourceContext": "public-presence",
          "placement": "root"
        },
        {
          "routeId": "terms",
          "routePath": "terms",
          "fileExport": "./routes/marketplace/terms",
          "routeType": "route",
          "sourceContext": "public-presence",
          "placement": "root"
        },
        {
          "routeId": "privacy",
          "routePath": "privacy",
          "fileExport": "./routes/marketplace/privacy",
          "routeType": "route",
          "sourceContext": "public-presence",
          "placement": "root"
        },
        {
          "routeId": "refunds-and-returns",
          "routePath": "refunds-and-returns",
          "fileExport": "./routes/marketplace/refunds-and-returns",
          "routeType": "route",
          "sourceContext": "public-presence",
          "placement": "root"
        },
        {
          "routeId": "order-protection",
          "routePath": "order-protection",
          "fileExport": "./routes/marketplace/order-protection",
          "routeType": "route",
          "sourceContext": "public-presence",
          "placement": "root"
        },
        {
          "routeId": "sales-fees",
          "routePath": "sales-fees",
          "fileExport": "./routes/marketplace/sales-fees",
          "routeType": "route",
          "sourceContext": "public-presence",
          "placement": "root"
        }
      ]
    },
    {
      "deployable": "admin-web",
      "routes": [
        {
          "routeId": "waitlist",
          "routePath": "waitlist",
          "fileExport": "./routes/admin/waitlist",
          "routeType": "route",
          "sourceContext": "public-presence",
          "section": "growth"
        },
        {
          "routeId": "promo-bar",
          "routePath": "promo-bar",
          "fileExport": "./routes/admin/promo-bar",
          "routeType": "route",
          "sourceContext": "public-presence",
          "section": "growth"
        }
      ]
    }
  ],
  "shellContributions": [
    {
      "deployable": "admin-web",
      "slot": "primary-nav",
      "key": "waitlist",
      "label": "Waitlist",
      "icon": "message",
      "href": "/waitlist",
      "section": "growth",
      "order": 20,
      "visibility": "signed-in",
      "requiredPermissions": ["public-presence.view"]
    },
    {
      "deployable": "admin-web",
      "slot": "primary-nav",
      "key": "promo-bar",
      "label": "Promo Bar",
      "icon": "spark",
      "href": "/promo-bar",
      "section": "growth",
      "order": 21,
      "visibility": "signed-in",
      "requiredPermissions": ["public-presence.view"]
    }
  ],
  "directoryIntent": {
    "waitlist": {
      "classification": "slice",
      "purpose": "Own prelaunch waitlist behavior, read models, and admin review surfaces.",
      "allowedWhen": "Always; slice directories are the default root shape for implemented context features.",
      "expectedConsumers": ["Internal public-presence module composition", "Public web routes", "Admin review routes"]
    },
    "request-support": {
      "classification": "support",
      "purpose": "Provide public-presence API clients shared by route modules.",
      "allowedWhen": "Allowed only for context-local request composition.",
      "expectedConsumers": ["Public web routes", "Admin waitlist route"],
      "justification": "request-support centralizes the Public Presence API client for route modules.",
      "createdFor": "Waitlist submission and review routes.",
      "sunsetWhen": "Remove when all consumers can move behavior back into feature-local modules.",
      "crossCuttingRuntimeComposition": true
    },
    "runtime-support": {
      "classification": "support",
      "purpose": "Provide event-store, schema, and projector composition for the public-presence context.",
      "allowedWhen": "Allowed only for context runtime composition.",
      "expectedConsumers": ["waitlist"],
      "justification": "runtime-support centralizes event-store composition for the waitlist slice.",
      "createdFor": "public-presence API and worker runtime.",
      "sunsetWhen": "Remove when public presence no longer needs runtime composition."
    },
    "shell-support": {
      "classification": "support",
      "purpose": "Provide deployable-facing public-presence page shell exports for waitlist routes.",
      "allowedWhen": "Allowed only for shell composition consumed by context web exports.",
      "expectedConsumers": ["waitlist"],
      "justification": "shell-support keeps deployable-facing page shell exports out of feature internals.",
      "createdFor": "public-presence waitlist page shell composition.",
      "sunsetWhen": "Remove when public presence no longer exports deployable-facing shell modules."
    },
    "ui-support": {
      "classification": "support",
      "purpose": "Expose browser-safe Public Presence UI contracts and scoped translation helpers without moving waitlist behavior out of the slice.",
      "allowedWhen": "Allowed only for browser-safe Public Presence UI contracts consumed through the context web export or waitlist UI.",
      "expectedConsumers": ["waitlist"],
      "justification": "The waitlist slice owns analytics event names and public-page UI vocabulary; public-web needs the event allowlist and scoped translator without duplicating bounded-context terms or importing unrelated localization namespaces.",
      "createdFor": "Public Presence waitlist analytics capture and public-page localization.",
      "sunsetWhen": "Remove if analytics capture and public-page translation move fully into feature-local browser entrypoints or an approved experimentation context."
    },
    "promo-bar": {
      "classification": "slice",
      "purpose": "Own public marketplace promo-bar-message management, read models, and public rendering contracts.",
      "allowedWhen": "Always; slice directories are the default root shape for implemented context features.",
      "expectedConsumers": ["Public marketplace page shell", "Admin promo bar route"]
    },
    "routes": {
      "classification": "routes",
      "purpose": "Expose public-presence-owned route modules consumed by generated deployable adapters.",
      "allowedWhen": "Required whenever the context contributes routes to any deployable.",
      "expectedConsumers": ["Generated deployable route adapters"]
    }
  },
  "runtimeDeployables": ["admin-support-worker", "platform-worker"]
}
