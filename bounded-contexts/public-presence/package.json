{
  "name": "@chase-sets/public-presence",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "compile:public-policies": "node --experimental-strip-types ./features/policies/integrations/compile-policy-publications.mjs",
    "check:public-policies": "node --experimental-strip-types ./features/policies/integrations/compile-policy-publications.mjs --check",
    "compile:help-articles": "node ./features/help/integrations/compile-help-articles.mjs",
    "check:help-articles": "node ./features/help/integrations/compile-help-articles.mjs --check",
    "compile:developer-articles": "node --experimental-strip-types ./features/developer-portal/integrations/compile-developer-articles.mjs",
    "check:developer-articles": "node --experimental-strip-types ./features/developer-portal/integrations/compile-developer-articles.mjs --check",
    "pretest": "pnpm run check:public-policies && pnpm run check:help-articles && pnpm run check:developer-articles",
    "typecheck": "tsc -p ./tests/tsconfig.json --noEmit",
    "test": "vitest run --config ./tests/vitest.config.mjs",
    "test:watch": "vitest --config ./tests/vitest.config.mjs",
    "generate:landing-image-variants": "node ./features/waitlist/ui/assets/generate-image-variants.mjs",
    "generate:og-images": "node ./features/waitlist/ui/assets/generate-og-images.mjs"
  },
  "exports": {
    ".": "./index.ts",
    "./context": "./context.json",
    "./routes/*": "./routes/*.tsx",
    "./server": "./server.ts",
    "./web": "./web.ts"
  },
  "types": "./index.ts",
  "dependencies": {
    "@chase-sets/auth-context": "workspace:*",
    "@chase-sets/bounded-context-module": "workspace:*",
    "@chase-sets/design-system": "workspace:*",
    "@chase-sets/event-core": "workspace:*",
    "@chase-sets/event-core-postgres": "workspace:*",
    "@chase-sets/http": "workspace:*",
    "@chase-sets/localization": "workspace:*",
    "@chase-sets/notification-outbox": "workspace:*",
    "@chase-sets/outbound-messaging": "workspace:*",
    "@chase-sets/platform-runtime": "workspace:*",
    "@chase-sets/platform-policy": "workspace:*",
    "@chase-sets/primitives": "workspace:*",
    "@chase-sets/public-docs": "workspace:*",
    "hono": "^4.12.12",
    "react": "^19.2.5",
    "react-router": "^7.14.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "jsdom": "^29.0.2",
    "prettier": "^3.8.3",
    "sharp": "^0.34.5",
    "vitest": "^4.1.4",
    "yaml": "^2.8.4"
  }
}
