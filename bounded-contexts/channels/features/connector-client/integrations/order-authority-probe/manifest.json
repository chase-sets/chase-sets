{
  "manifest_version": 3,
  "name": "Chase Sets Temporary Order Authority Capture",
  "version": "1.0.0",
  "background": { "service_worker": "worker.js" },
  "permissions": ["storage"],
  "host_permissions": ["https://sp-api.tcgplayer.com/*", "https://order-management-api.tcgplayer.com/*"],
  "content_security_policy": {
    "extension_pages": "default-src 'self'; script-src 'self'; object-src 'none'; connect-src 'self' https://sp-api.tcgplayer.com https://order-management-api.tcgplayer.com"
  }
}
