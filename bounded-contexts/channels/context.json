  "readAfterWriteRouteInventory": [
    {
      "id": "channels.publication-settings-to-detail",
      "owner": "channels",
      "risk": "important",
      "freshnessSlo": {
        "flowClass": "important-self-refresh",
        "p95Ms": 2500,
        "p99Ms": 5000
      },
      "source": {
        "routeId": "channels-publication-connection",
        "actions": ["Replace settings"],
        "command": "ReplaceChannelConnectionPublicationSettings"
      },
      "destination": {
        "routeId": "channels-publication-connection",
        "apiContextName": "channels",
        "apiRoutePath": "/publication/:connectionId",
        "readModelTables": ["channels_connection_publication_settings"],
        "helperUses": ["loadAfterWrite"],
        "transientRecovery": {
          "kinds": "refreshable-catching-up",
          "behavior": "Publication projection lag retains the existing form loading state with bounded read revalidation; the settings write is never replayed."
        }
      }
    }
  ],
  "mutationConsistencyInventory": [
    {
      "id": "channels.drift-decision-snapshots",
      "owner": "channels",
      "risk": "important",
      "strategy": "snapshot-return",
      "surfaces": [
        "api-route:bounded-contexts/channels/features/reconciliation/api/route.ts:POST /:connectionId/drift/:channelListingId/accept",
        "api-route:bounded-contexts/channels/features/reconciliation/api/route.ts:POST /:connectionId/drift/:channelListingId/repush",
        "post-form:bounded-contexts/channels/features/reconciliation/ui/drift-panel.tsx:Hb08a81ecfd73#1"
      ],
      "visibleDestination": {
        "routeId": "channels-connection-detail",
        "description": "The existing detail child shows the committed decision snapshot and reloads account-qualified rows, attention and operation log."
      },
      "proof": {
        "authoritativeResponse": "The real decision transaction returns its revision and operation identity. The form stays disabled during submission and revalidation; uncertainty retains the exact request, and conflicts require explicit refresh. Accepted/requested copy never asserts enqueue, application or health.",
        "tests": [
          "bounded-contexts/channels/features/reconciliation/tests/channel-reconciliation-runtime.db.test.ts",
          "bounded-contexts/channels/features/reconciliation/tests/channel-drift-detail.test.tsx"
        ]
      }
    },
    {
      "id": "channels.connection-attention-resolution",
      "owner": "channels",
      "risk": "important",
      "strategy": "optimistic-with-correction",
      "surfaces": [
        "api-route:bounded-contexts/channels/features/connection-attention/api/route.ts:POST /:connectionId/attention/resolve",
        "post-form:bounded-contexts/channels/features/connection-attention/ui/health-panel.tsx:H1abed2c1c746#1"
      ],
      "visibleDestination": {
        "routeId": "channels-connection-detail",
        "description": "Attention resolution redirects to the account-scoped combined query without changing manual or health producer state."
      },
      "proof": {
        "correction": "The form retains its generation until the guarded write succeeds; stale writes return 409 and a visible error. Successful redirects revalidate the same query. No optimistic dismissal is made.",
        "tests": [
          "bounded-contexts/channels/features/connection-attention/tests/channel-attention-lifecycle.db.test.ts",
          "bounded-contexts/channels/features/connection-attention/tests/channel-connection-health-panel-states.test.tsx"
        ]
      }
    },
    {
      "id": "channels.connector-pairing-command-snapshots",
      "owner": "channels",
      "risk": "critical",
      "strategy": "snapshot-return",
      "surfaces": [
        "post-form:bounded-contexts/channels/features/connector-feed/ui/pairing-panel.tsx:Hb08a81ecfd73#1",
        "post-form:bounded-contexts/channels/features/connector-feed/ui/pairing-panel.tsx:Hb08a81ecfd73#2",
        "route-action:bounded-contexts/channels/features/connections/ui/account-channels-connection-route-adapter.tsx"
      ],
      "visibleDestination": {
        "routeId": "channels-connection-detail",
        "description": "Pairing actions return the committed one-use code or redirect to a current authority read; no optimistic paired status or last-seen is invented."
      },
      "proof": {
        "authoritativeResponse": "Code creation returns the committed pairing identity and expiry. Unpair compares identity/revision before cleanup and the loader revalidates from the locked connection and pairing state. Malformed pairing DTOs render unavailable.",
        "tests": [
          "bounded-contexts/channels/features/connector-feed/tests/connector-pairing-lifecycle.db.test.ts",
          "bounded-contexts/channels/features/connector-feed/tests/connector-pairing-surface.test.tsx",
          "bounded-contexts/channels/features/connector-feed/tests/connector-contracts.test.ts",
          "deployables/platform-api/__tests__/connector-mount-gate-isolation.db.test.ts"
        ]
      }
    },
    {
      "id": "channels.connection-command-snapshots",
      "owner": "channels",
      "risk": "important",
      "strategy": "snapshot-return",
      "surfaces": [
        "api-route:bounded-contexts/channels/features/connections/api/route.ts:POST /:id/pause",
        "api-route:bounded-contexts/channels/features/connections/api/route.ts:POST /:id/resume",
        "api-route:bounded-contexts/channels/features/connections/api/route.ts:POST /:id/disconnect",
        "api-client:bounded-contexts/channels/support/request-support/api-client.ts:POST H542755c24d1e#1",
        "api-client:bounded-contexts/channels/support/request-support/api-client.ts:POST H16abbc610122#1",
        "api-client:bounded-contexts/channels/support/request-support/api-client.ts:POST Hf47bd35ee32b#1",
        "post-form:bounded-contexts/channels/features/connections/ui/connection-pages.tsx:Hbd7dd2c17dad#1",
        "route-action:bounded-contexts/channels/features/connections/ui/account-channels-connection-route-adapter.tsx"
      ],
      "visibleDestination": {
        "description": "Each public Channel Connection mutation returns the committed aggregate snapshot without waiting for or rereading the asynchronous projection. The seller connection list/detail UI renders only that committed snapshot: no optimistic status or action-set change is invented before the response resolves."
      },
      "proof": {
        "authoritativeResponse": "The route maps CommandExecutionResult.state directly to the closed public DTO for writes and accepted no-ops; the detail route action returns the same committed connection to the page, which re-renders its status badge and allowed-action set from that value alone.",
        "tests": [
          "bounded-contexts/channels/features/connections/tests/channel-connection-http-contract.test.ts",
          "bounded-contexts/channels/features/connections/tests/channel-connection-command-snapshot-responses.test.ts",
          "bounded-contexts/channels/features/connections/tests/channel-connection-actions.test.tsx"
        ]
      }
    },
    {
      "id": "channels.publication-configuration-optimistic-correction",
      "owner": "channels",
      "risk": "important",
      "strategy": "optimistic-with-correction",
      "surfaces": [
        "api-client:bounded-contexts/channels/support/request-support/api-client.ts:POST H2b969724e1a0#1",
        "api-client:bounded-contexts/channels/support/request-support/api-client.ts:PUT H7bd6e2a2b805#1",
        "api-route:bounded-contexts/channels/features/listing-composition/api/route.ts:POST /:connectionId/mappings/:dimension/:sourceKey/decision",
        "api-route:bounded-contexts/channels/features/listing-composition/api/route.ts:PUT /:connectionId/settings",
        "post-form:bounded-contexts/channels/features/listing-composition/ui/publication-pages.tsx:Ha94213ead578#1",
        "post-form:bounded-contexts/channels/features/listing-composition/ui/publication-pages.tsx:Ha98ce7edb16e#1",
        "route-action:bounded-contexts/channels/routes/marketplace/account-channels-publication-connection.tsx"
      ],
      "visibleDestination": {
        "description": "Publication settings and mapping forms retain submitted values while the real data-router revalidates; a changed configuration stream version remounts the form from authoritative loader data, while conflicts and command errors remain visible."
      },
      "proof": {
        "correction": "Both forms are keyed by configurationStreamVersion. The post-write action-data handoff retains the command streamVersion, the detail loader reads through loadAfterWrite, and a lower projection version renders the existing loading state with bounded revalidation until the account-scoped API result reaches the written version; conflicts and command failures remain direct.",
        "tests": [
          "bounded-contexts/channels/features/listing-composition/tests/channel-publication-settings-route.test.tsx",
          "bounded-contexts/channels/features/listing-composition/tests/channel-mapping-review-route.test.ts"
        ]
      }
    },
    {
      "id": "channels.manual-sync-command-snapshots",
      "owner": "channels",
      "risk": "critical",
      "strategy": "snapshot-return",
      "surfaces": [
