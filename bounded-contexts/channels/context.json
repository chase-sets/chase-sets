      "requiredPermissions": ["channels.view"]
    }
  ],
  "mutationConsistencyInventory": [
    {
      "id": "channels.connection-command-snapshots",
      "owner": "channels",
      "risk": "important",
      "strategy": "snapshot-return",
      "surfaces": [
        "api-route:bounded-contexts/channels/features/connections/api/route.ts:POST /:id/pause",
        "api-route:bounded-contexts/channels/features/connections/api/route.ts:POST /:id/resume",
        "api-route:bounded-contexts/channels/features/connections/api/route.ts:POST /:id/disconnect",
        "api-client:bounded-contexts/channels/support/request-support/api-client.ts:POST H542755c24d1e#1",
        "api-client:bounded-contexts/channels/support/request-support/api-client.ts:POST H16abbc610122#1",
        "api-client:bounded-contexts/channels/support/request-support/api-client.ts:POST Hf47bd35ee32b#1",
        "post-form:bounded-contexts/channels/features/connections/ui/connection-pages.tsx:Hbd7dd2c17dad#1",
        "route-action:bounded-contexts/channels/routes/marketplace/account-channels-connection.tsx"
      ],
      "visibleDestination": {
        "description": "Each public Channel Connection mutation returns the committed aggregate snapshot without waiting for or rereading the asynchronous projection. The seller connection list/detail UI renders only that committed snapshot: no optimistic status or action-set change is invented before the response resolves."
      },
      "proof": {
        "authoritativeResponse": "The route maps CommandExecutionResult.state directly to the closed public DTO for writes and accepted no-ops; the detail route action returns the same committed connection to the page, which re-renders its status badge and allowed-action set from that value alone.",
        "tests": [
          "bounded-contexts/channels/features/connections/tests/channel-connection-http-contract.test.ts",
          "bounded-contexts/channels/features/connections/tests/channel-connection-command-snapshot-responses.test.ts",
          "bounded-contexts/channels/features/connections/tests/channel-connection-actions.test.tsx"
        ]
      }
    },
    {
      "id": "channels.publication-configuration-optimistic-correction",
      "owner": "channels",
      "risk": "important",
      "strategy": "optimistic-with-correction",
      "surfaces": [
        "api-client:bounded-contexts/channels/support/request-support/api-client.ts:POST H2b969724e1a0#1",
        "api-client:bounded-contexts/channels/support/request-support/api-client.ts:PUT H7bd6e2a2b805#1",
        "api-route:bounded-contexts/channels/features/listing-composition/api/route.ts:POST /:connectionId/mappings/:dimension/:sourceKey/decision",
        "api-route:bounded-contexts/channels/features/listing-composition/api/route.ts:PUT /:connectionId/settings",
        "post-form:bounded-contexts/channels/features/listing-composition/ui/publication-pages.tsx:Ha94213ead578#1",
        "post-form:bounded-contexts/channels/features/listing-composition/ui/publication-pages.tsx:Ha98ce7edb16e#1",
        "route-action:bounded-contexts/channels/routes/marketplace/account-channels-publication-connection.tsx"
      ],
      "visibleDestination": {
        "description": "Publication settings and mapping forms retain submitted values while the real data-router revalidates; a changed configuration stream version remounts the form from authoritative loader data, while conflicts and command errors remain visible."
      },
      "proof": {
        "correction": "Both forms are keyed by configurationStreamVersion. The route action returns conflicts and command failures directly; successful actions invoke normal React Router loader revalidation, and a newer version replaces the optimistic form with the account-scoped API result.",
        "tests": [
          "bounded-contexts/channels/features/listing-composition/tests/channel-publication-settings-route.test.tsx",
          "bounded-contexts/channels/features/listing-composition/tests/channel-mapping-review-route.test.ts"
        ]
      }
    },
    {
      "id": "channels.manual-sync-command-snapshots",
      "owner": "channels",
      "risk": "critical",
      "strategy": "snapshot-return",
      "surfaces": [
        "api-client:bounded-contexts/channels/features/manual-sync/api/route.ts:POST Hb42b68759444#1",
        "api-route:bounded-contexts/channels/features/manual-sync/api/route.ts:POST /:connectionId/manual-sync/compose",
        "api-route:bounded-contexts/channels/features/manual-sync/api/route.ts:POST /:connectionId/manual-sync/ingest",
        "api-route:bounded-contexts/channels/features/manual-sync/api/route.ts:POST /:connectionId/manual-sync/runs/:runId/download",
        "api-route:bounded-contexts/channels/features/manual-sync/api/route.ts:POST /:connectionId/manual-sync/runs/:runId/release",
        "api-route:bounded-contexts/channels/features/manual-sync/api/route.ts:POST /:connectionId/manual-sync/runs/:runId/upload-attempt",
        "api-route:bounded-contexts/channels/features/manual-sync/api/route.ts:POST /:connectionId/manual-sync/runs/:runId/validation-cancelled",
        "api-route:bounded-contexts/channels/features/manual-sync/api/route.ts:POST /:connectionId/manual-sync/runs/:runId/verify"
      ],
      "visibleDestination": {
        "routeId": "account-channel-connection",
        "description": "Every manual sync API mutation returns the committed producer run/panel, exact CSV, ingest receipt, or verification snapshot; failures return a closed error without claiming projected success."
      },
      "proof": {
        "authoritativeResponse": "The route returns the exact result from the imported TCGplayer run service and Marketplace clamp port. Run revisions fence every lifecycle write, and bounded upload refusal occurs before the producer parser/write call.",
        "tests": [
          "bounded-contexts/channels/features/manual-sync/api/manual-sync-route.test.ts",
          "bounded-contexts/channels/features/manual-sync/api/manual-sync-runtime.test.ts",
          "bounded-contexts/channels/features/manual-sync/domain/manual-sync-contracts.test.ts"
        ]
      }
    },
    {
      "id": "channels.manual-sync-panel-optimistic-correction",
      "owner": "channels",
      "risk": "critical",
      "strategy": "optimistic-with-correction",
      "surfaces": [
        "post-form:bounded-contexts/channels/features/manual-sync/ui/manual-sync-panel.tsx:H1abed2c1c746#1",
        "post-form:bounded-contexts/channels/features/manual-sync/ui/manual-sync-panel.tsx:H1abed2c1c746#2",
        "post-form:bounded-contexts/channels/features/manual-sync/ui/manual-sync-panel.tsx:H1abed2c1c746#3",
        "post-form:bounded-contexts/channels/features/manual-sync/ui/manual-sync-panel.tsx:H1abed2c1c746#4",
        "post-form:bounded-contexts/channels/features/manual-sync/ui/manual-sync-panel.tsx:H1abed2c1c746#5",
        "route-action:bounded-contexts/channels/features/outbound-sync/ui/account-channel-connection-route.tsx",
        "route-action:bounded-contexts/channels/routes/marketplace/account-channel-connection.tsx"
      ],
      "visibleDestination": {
        "routeId": "account-channel-connection",
        "description": "The connection page exposes only actions admitted by the exact loaded run revision, keeps action errors visible, and revalidates the account-scoped panel after successful writes."
      },
      "proof": {
        "correction": "Successful actions redirect to the same connection route so its authenticated loader replaces the panel with the latest producer revision; failures render a canonical error banner and stale or unlisted actions write nothing.",
        "tests": [
          "bounded-contexts/channels/features/manual-sync/ui/manual-sync-panel.test.tsx",
          "bounded-contexts/channels/features/manual-sync/api/manual-sync-route.test.ts",
          "bounded-contexts/channels/features/manual-sync/domain/manual-sync-contracts.test.ts"
        ]
      }
    }
  ],
  "directoryIntent": {
    "connections": {
      "classification": "slice",
      "purpose": "Own the connections slice lifecycle, setup authority, HTTP contract, and projection.",
      "expectedConsumers": ["Internal Channels module composition"]
    },
    "publication-port": {
      "classification": "slice",
      "purpose": "Own the publication-port provider-neutral Channel Publication contract and immutable provider registry.",
      "expectedConsumers": ["Internal Channels publication workflows and provider integrations"]
    },
    "listing-composition": {
      "classification": "slice",
      "purpose": "Own the listing-composition Channel Publication Facts, configuration, eligibility, desired state, Links, and reconciliation runs.",
      "expectedConsumers": ["Channels account publication routes and registered channel publication consumers"]
    },
    "request-support": {
      "classification": "support",
      "purpose": "Compose authenticated Channels publication requests and adapt request-time Marketplace capabilities at the context boundary.",
      "expectedConsumers": ["manual-sync"],
      "crossCuttingRuntimeComposition": true
    },
    "runtime-support": {
      "classification": "support",
      "purpose": "Own the context-level Channels runtime service composition contract.",
      "expectedConsumers": ["Root Channels module and API composition"]
    },
    "tcgplayer-csv": {
      "classification": "slice",
      "purpose": "The tcgplayer-csv slice owns TCGplayer export snapshots, staged CSV composition, and replayable Channel Sync Runs.",
      "expectedConsumers": ["Channels manual and connector sync workflows"]
    },
    "manual-sync": {
      "classification": "slice",
      "purpose": "Own the manual-sync Channel Sync Run panel, frozen manual lease policy resolution, bounded export ingress, Marketplace clamp coordination, and channel attention source.",
      "expectedConsumers": ["Channels account connection route, platform API, platform worker, and Seller Desk"]
    },
    "outbound-sync": {
      "classification": "slice",
      "purpose": "Own Channels outbound-sync operations, execution admission, leases, and connection-scoped activity.",
      "expectedConsumers": ["Internal Channels module composition", "Channel connector and manual claim workflows"]
    },
    "tcgplayer-csv": {
      "classification": "slice",
      "purpose": "The tcgplayer-csv slice owns TCGplayer export snapshots, staged CSV composition, and replayable Channel Sync Runs.",
      "expectedConsumers": ["Channels manual and connector sync workflows"]
    },
    "routes": {
      "classification": "routes",
      "purpose": "Expose Channels-owned account route modules consumed by generated deployable adapters.",
      "expectedConsumers": ["Generated deployable route adapters"]
    }
  },
  "runtimeDeployables": ["platform-worker"],
  "localeCatalogs": ["contracts/localization/locales/en/channels.ts"]
}
