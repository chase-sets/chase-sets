{
  "contextName": "channels",
  "packageName": "@chase-sets/channels",
  "ownedNouns": [
    "channel-connection",
    "channel-publication-facts",
    "channel-composition-profile",
    "channel-publication-settings",
    "channel-publication-eligibility",
    "channel-listing-desired-state",
    "channel-listing-reconciliation-run",
    "channel-inventory-snapshot",
    "channel-sync-run"
  ],
  "streamPrefix": "channels.",
  "apiBasePath": "/api/channels",
  "slices": ["connections", "publication-port", "listing-composition", "tcgplayer-csv", "outbound-sync"],
  "allowedSupportDirectories": ["request-support"],
  "publicExports": [".", "./context", "./server", "./routes/*"],
  "allowedContextDependencies": [],
  "seedRequirements": [],
  "hostPorts": [],
  "eventSubscriptions": [
    {
      "sourceContextName": "marketplace",
      "projectionName": "channel-marketplace-publication-facts",
      "subscriptionVersion": 1,
      "filterToEventTypes": true,
      "eventTypes": [
        "marketplace.listing.created",
        "marketplace.listing.price-updated",
        "marketplace.listing.quantity-cap-updated",
        "marketplace.listing.published",
        "marketplace.listing.paused",
        "marketplace.listing.auto-unlisted",
        "marketplace.listing.withdrawn",
        "marketplace.seller-listing-availability.enabled",
        "marketplace.seller-listing-availability.disabled"
      ],
      "order": 10,
      "projectionHandlerSetNames": ["channel-marketplace-publication-facts"]
    },
    {
      "sourceContextName": "catalog",
      "projectionName": "channel-catalog-publication-facts",
      "subscriptionVersion": 1,
      "filterToEventTypes": true,
      "eventTypes": [
        "catalog.catalog-item.category-assigned",
        "catalog.catalog-item.category-removed",
        "catalog.catalog-item.external-product-reference-linked",
        "catalog.catalog-item.external-product-reference-unlinked",
        "catalog.catalog-item.external-catalog-item-reference-linked",
        "catalog.catalog-item.external-catalog-item-reference-unlinked"
      ],
      "order": 20,
      "projectionHandlerSetNames": ["channel-catalog-publication-facts"]
    },
    {
      "sourceContextName": "inventory",
      "projectionName": "channel-inventory-publication-facts",
      "subscriptionVersion": 1,
      "filterToEventTypes": true,
      "eventTypes": [
        "inventory.item.created",
        "inventory.item.adjusted",
        "inventory.hold.placed",
        "inventory.hold.converted",
        "inventory.hold.extended",
        "inventory.hold.released",
        "inventory.hold.expired",
        "inventory.hold.consumed"
      ],
      "order": 30,
      "projectionHandlerSetNames": ["channel-inventory-publication-facts"]
    },
    {
      "sourceContextName": "channels",
      "projectionName": "channel-owned-publication-state",
      "subscriptionVersion": 1,
      "filterToEventTypes": true,
      "eventTypes": [
        "channels.connection.connected",
        "channels.connection.activated",
        "channels.connection.paused",
        "channels.connection.resumed",
        "channels.connection.disconnected",
        "channels.channel-publication-configuration.settings-replaced",
        "channels.channel-publication-configuration.mapping-candidate-recorded",
        "channels.channel-publication-configuration.mapping-review-decided",
        "channels.channel-listing.desired-state-changed",
        "channels.channel-listing.publication-blocked",
        "channels.channel-listing.publication-recorded",
        "channels.channel-listing-reconciliation.run-enqueued",
        "channels.channel-listing-reconciliation.chunk-drained",
        "channels.channel-listing-reconciliation.run-settled"
      ],
      "order": 40,
      "projectionHandlerSetNames": ["channel-connection-publication-facts", "channel-listing-state-projection"]
    }
  ],
  "eventReactions": [
    {
      "sourceContextName": "marketplace",
      "reactionName": "channel-listing-desired-state-reaction",
      "subscriptionVersion": 1,
      "filterToEventTypes": true,
      "eventTypes": [
        "marketplace.listing.created",
        "marketplace.listing.price-updated",
        "marketplace.listing.quantity-cap-updated",
        "marketplace.listing.published",
        "marketplace.listing.paused",
        "marketplace.listing.auto-unlisted",
        "marketplace.listing.withdrawn",
        "marketplace.seller-listing-availability.enabled",
        "marketplace.seller-listing-availability.disabled"
      ],
      "order": 60,
      "reactionHandlerSetNames": ["channel-listing-desired-state-reaction"],
      "idempotencyPolicy": "idempotent-command-dispatch",
      "retryPolicy": "retry-from-last-checkpoint",
      "failurePolicy": "surface-as-reaction-failure"
    },
    {
      "sourceContextName": "catalog",
      "reactionName": "channel-listing-desired-state-reaction",
      "subscriptionVersion": 1,
      "filterToEventTypes": true,
      "eventTypes": [
        "catalog.catalog-item.category-assigned",
        "catalog.catalog-item.category-removed",
        "catalog.catalog-item.external-product-reference-linked",
        "catalog.catalog-item.external-product-reference-unlinked",
        "catalog.catalog-item.external-catalog-item-reference-linked",
        "catalog.catalog-item.external-catalog-item-reference-unlinked"
      ],
      "order": 61,
      "reactionHandlerSetNames": ["channel-listing-desired-state-reaction"],
      "idempotencyPolicy": "idempotent-command-dispatch",
      "retryPolicy": "retry-from-last-checkpoint",
      "failurePolicy": "surface-as-reaction-failure"
    },
    {
      "sourceContextName": "inventory",
      "reactionName": "channel-listing-desired-state-reaction",
      "subscriptionVersion": 1,
      "filterToEventTypes": true,
      "eventTypes": [
        "inventory.item.created",
        "inventory.item.adjusted",
        "inventory.hold.placed",
        "inventory.hold.converted",
        "inventory.hold.extended",
        "inventory.hold.released",
        "inventory.hold.expired",
        "inventory.hold.consumed"
      ],
      "order": 62,
      "reactionHandlerSetNames": ["channel-listing-desired-state-reaction"],
      "idempotencyPolicy": "idempotent-command-dispatch",
      "retryPolicy": "retry-from-last-checkpoint",
      "failurePolicy": "surface-as-reaction-failure"
    },
    {
      "sourceContextName": "channels",
      "reactionName": "channel-listing-desired-state-reaction",
      "subscriptionVersion": 1,
      "filterToEventTypes": true,
      "eventTypes": [
        "channels.connection.connected",
        "channels.connection.activated",
        "channels.connection.paused",
        "channels.connection.resumed",
        "channels.connection.disconnected",
        "channels.channel-publication-configuration.settings-replaced",
        "channels.channel-publication-configuration.mapping-candidate-recorded",
        "channels.channel-publication-configuration.mapping-review-decided",
        "channels.channel-listing-reconciliation.run-enqueued",
        "channels.channel-listing-reconciliation.chunk-drained",
        "channels.channel-listing-reconciliation.run-settled"
      ],
      "order": 63,
      "reactionHandlerSetNames": ["channel-listing-desired-state-reaction"],
      "idempotencyPolicy": "idempotent-command-dispatch",
      "retryPolicy": "retry-from-last-checkpoint",
      "failurePolicy": "surface-as-reaction-failure"
    },
    {
      "sourceContextName": "channels",
      "reactionName": "channel-outbound-operation-enqueue",
      "subscriptionVersion": 1,
      "filterToEventTypes": true,
      "eventTypes": ["channels.channel-listing.desired-state-changed"],
      "order": 64,
      "reactionHandlerSetNames": ["channel-outbound-operation-enqueue"],
      "idempotencyPolicy": "idempotent-command-dispatch",
      "retryPolicy": "retry-from-last-checkpoint",
      "failurePolicy": "surface-as-reaction-failure"
    }
  ],
  "projectionGroups": [
    {
      "projectionName": "channel-connection-projection",
      "sourceContextNames": ["channels"],
      "ownedTables": ["channel_connections"],
      "requiredDuringBootstrap": false,
      "resetStrategy": "truncate-owned-tables"
    },
    {
      "projectionName": "channel-marketplace-publication-facts",
      "sourceContextNames": ["marketplace"],
      "ownedTables": ["channels_listing_publication_facts", "channels_seller_availability_facts"],
      "requiredDuringBootstrap": true,
      "resetStrategy": "replay-only"
    },
    {
      "projectionName": "channel-catalog-publication-facts",
      "sourceContextNames": ["catalog"],
      "ownedTables": [
        "channels_catalog_item_category_facts",
        "channels_external_product_reference_facts",
        "channels_external_catalog_item_reference_facts"
      ],
      "requiredDuringBootstrap": true,
      "resetStrategy": "replay-only"
    },
    {
      "projectionName": "channel-inventory-publication-facts",
      "sourceContextNames": ["inventory"],
      "ownedTables": ["channels_inventory_item_facts", "channels_inventory_hold_facts"],
      "requiredDuringBootstrap": true,
      "resetStrategy": "replay-only"
    },
    {
      "projectionName": "channel-owned-publication-state",
      "sourceContextNames": ["channels"],
      "ownedTables": [
        "channels_connection_facts",
        "channels_connection_publication_settings",
        "channels_channel_mappings",
        "channels_channel_listing_links",
        "channels_listing_reconciliation_runs",
        "channels_channel_publication_operations"
      ],
      "requiredDuringBootstrap": true,
      "resetStrategy": "replay-only"
    },
    {
      "projectionName": "channel-listing-desired-state-reaction",
      "handlerKind": "reaction",
      "sourceContextNames": ["marketplace", "catalog", "inventory", "channels"],
      "ownedTables": [],
      "sideEffectOnly": true,
      "requiredDuringBootstrap": false,
      "resetStrategy": "replay-only"
    },
    {
      "projectionName": "channel-outbound-operation-enqueue",
      "handlerKind": "reaction",
      "sourceContextNames": ["channels"],
      "ownedTables": [],
      "sideEffectOnly": true,
      "requiredDuringBootstrap": false,
      "resetStrategy": "replay-only"
    },
    {
      "projectionName": "tcgplayer-csv-projection",
      "sourceContextNames": ["channels"],
      "ownedTables": [
        "channel_export_schema_pins",
        "channel_inventory_snapshots",
        "channel_inventory_snapshot_rows",
        "channel_sync_runs",
        "channel_sync_run_rows"
      ],
      "requiredDuringBootstrap": false,
      "resetStrategy": "truncate-owned-tables"
    }
  ],
  "apiDeployables": ["platform-api"],
  "apiRuntimeProfiles": ["proof", "public"],
  "apiMounts": [
    {
      "mountPath": "/api/channels",
      "kind": "primary",
      "requiresAuth": true
    }
  ],
  "workerRuntimeProfiles": ["proof", "public"],
  "deployableContributions": [
