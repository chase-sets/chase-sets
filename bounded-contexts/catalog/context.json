  "directoryIntent": {
    "blueprints": {
      "classification": "slice",
      "purpose": "Own blueprints feature behavior, read models, and UI contracts for the catalog context.",
      "expectedConsumers": ["Internal catalog module composition"]
    },
    "catalog-items": {
      "classification": "slice",
      "purpose": "Own catalog-items feature behavior, read models, and UI contracts for the catalog context.",
      "expectedConsumers": ["Internal catalog module composition"]
    },
    "categories": {
      "classification": "slice",
      "purpose": "Own categories feature behavior, read models, and UI contracts for the catalog context.",
      "expectedConsumers": ["Internal catalog module composition"]
    },
    "components": {
      "classification": "slice",
      "purpose": "Own components feature behavior, read models, and UI contracts for the catalog context.",
      "expectedConsumers": ["Internal catalog module composition"]
    },
    "dimensions": {
      "classification": "slice",
      "purpose": "Own dimensions feature behavior, read models, and UI contracts for the catalog context.",
      "expectedConsumers": ["Internal catalog module composition"]
    },
    "fields": {
      "classification": "slice",
      "purpose": "Own fields feature behavior, read models, and UI contracts for the catalog context.",
      "expectedConsumers": ["Internal catalog module composition"]
    },
    "display-templates": {
      "classification": "slice",
      "purpose": "Own Catalog display title and subtitle template policy so display identity derives from Fields, Reference Records, Categories, Blueprints, and scoped overrides.",
      "expectedConsumers": ["catalog-items", "source-observations", "Internal catalog module composition"]
    },
    "product-measures": {
      "classification": "slice",
      "purpose": "Own Catalog product measurement profiles and overrides that provide shipping-aware physical facts to downstream contexts.",
      "expectedConsumers": [
        "Internal catalog module composition",
        "Ordering product measure projections",
        "Fulfillment package planning projections"
      ]
    },
    "source-observations": {
      "classification": "slice",
      "purpose": "Own provider source observations, review workflow, and promotion of candidate provider facts into canonical Catalog Items.",
      "expectedConsumers": ["Internal catalog module composition"]
    },
    "reference-data": {
      "classification": "slice",
      "purpose": "Own reference types and reference records that attach rich reusable facts to catalog item field values.",
      "expectedConsumers": ["Internal catalog module composition"]
    },
    "authoring-support": {
      "classification": "support",
      "purpose": "Provide reusable authoring-support assets shared by catalog-owned features and composition seams.",
      "expectedConsumers": [
        "blueprints",
        "catalog-items",
        "categories",
        "components",
        "dimensions",
        "display-templates",
        "fields",
        "product-measures",
        "reference-data",
        "source-observations"
      ]
    },
    "client-support": {
      "classification": "support",
      "purpose": "Provide reusable client-support assets shared by catalog-owned features and composition seams.",
      "expectedConsumers": [
        "blueprints",
        "catalog-items",
        "categories",
        "components",
        "dimensions",
        "display-templates",
        "fields",
        "product-measures",
        "reference-data",
        "source-observations"
      ]
    },
    "projection-support": {
      "classification": "support",
      "purpose": "Provide reusable projection-support assets shared by catalog-owned features and composition seams.",
      "expectedConsumers": [
        "blueprints",
        "catalog-items",
        "categories",
        "components",
        "dimensions",
        "display-templates",
        "fields",
        "reference-data",
        "source-observations"
      ]
    },
    "realtime-support": {
      "classification": "support",
      "purpose": "Provide Catalog-owned SSE topic contracts and projection patch factories for admin projection refresh outside deployables.",
      "expectedConsumers": ["projection-support", "routes", "Deployable realtime composition for Catalog"]
    },
    "request-support": {
      "classification": "support",
      "purpose": "Provide reusable request parsing and context-local API client assets shared by catalog-owned features and composition seams.",
      "expectedConsumers": ["Multiple catalog slices", "Deployable composition for catalog"],
      "crossCuttingRuntimeComposition": true
    },
    "route-support": {
      "classification": "support",
      "purpose": "Provide admin integrations route loader/action modules that orchestrate Catalog source observation workflows without mixing route adapters into shell support.",
      "expectedConsumers": ["routes"]
    },
    "runtime-support": {
      "classification": "support",
      "purpose": "Provide reusable runtime-support assets shared by catalog-owned features and composition seams.",
      "expectedConsumers": [
        "blueprints",
        "catalog-items",
        "categories",
        "components",
        "dimensions",
        "display-templates",
        "fields",
        "reference-data",
        "source-observations"
      ]
    },
    "shell-support": {
      "classification": "support",
      "purpose": "Provide reusable shell-support assets shared by catalog-owned features and admin shell composition.",
      "expectedConsumers": [
        "blueprints",
        "catalog-items",
        "categories",
        "components",
        "dimensions",
        "display-templates",
        "fields",
        "reference-data",
        "source-observations"
      ]
    },
    "routes": {
      "classification": "routes",
      "purpose": "Expose catalog-owned route modules consumed by generated deployable adapters.",
      "expectedConsumers": ["Generated deployable route adapters"]
    },
    "seed-support": {
      "classification": "support",
      "purpose": "Provide reusable seed-support assets shared by catalog-owned features and composition seams.",
      "expectedConsumers": [
        "blueprints",
        "catalog-items",
        "categories",
        "components",
        "dimensions",
        "display-templates",
        "fields",
        "product-measures",
        "reference-data"
      ],
      "crossCuttingRuntimeComposition": true
    }
  }
