{
  "contextName": "catalog",
  "packageName": "@chase-sets/catalog",
  "ownedNouns": [
    "catalog-item",
    "category",
    "blueprint",
    "field",
    "component",
    "dimension",
    "display-template",
    "product-measure-profile",
    "reference-type",
    "reference-record"
  ],
  "streamPrefix": "catalog.",
  "apiBasePath": "/api/catalog",
  "slices": [
    "blueprints",
    "catalog-items",
    "categories",
    "components",
    "dimensions",
    "display-templates",
    "fields",
    "product-measures",
    "reference-data",
    "source-observations"
  ],
  "allowedSupportDirectories": [
    "authoring-support",
    "client-support",
    "projection-support",
    "realtime-support",
    "request-support",
    "route-support",
    "runtime-support",
    "seed-support",
    "shell-support"
  ],
  "publicExports": [".", "./context", "./routes/*", "./server", "./web"],
  "allowedContextDependencies": [],
  "seedRequirements": [],
  "hostPorts": [
    {
      "portName": "catalogAssetStorage",
      "providedBy": "admin-support-api, platform-api",
      "purpose": "Stores Catalog-owned provider asset bytes and returns public URLs for Source Observation promotion."
    },
    {
      "portName": "sourceObservationTelemetry",
      "providedBy": "admin-support-api, platform-api, admin-support-worker, platform-worker",
      "purpose": "Emits bounded Catalog Integration Control Plane telemetry for provider option queries, integration jobs, and bulk review work units."
    }
  ],
  "apiDeployables": ["admin-support-api", "platform-api"],
  "runtimeDeployables": ["admin-support-worker", "platform-worker"],
  "apiMounts": [
    {
      "mountPath": "/api/catalog",
      "kind": "primary",
      "requiresAuth": true
    }
  ],
  "projectionGroups": [
    {
      "projectionName": "catalog-source-observation-projection",
      "sourceContextNames": ["catalog"],
      "ownedTables": ["catalog_source_observations"],
      "requiredDuringBootstrap": false,
      "resetStrategy": "truncate-owned-tables"
    }
  ],
