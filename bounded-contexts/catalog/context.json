{
  "contextName": "catalog",
  "packageName": "@chase-sets/catalog",
  "ownedNouns": [
    "catalog-item",
    "category",
    "blueprint",
    "field",
    "component",
    "dimension"
  ],
  "streamPrefix": "catalog.",
  "apiBasePath": "/api/catalog",
  "slices": [
    "authoring"
  ],
  "allowedSupportDirectories": [
    "request-support",
    "shell-support"
  ],
  "publicExports": [
    ".",
    "./seed-support/*",
    "./routes/*",
    "./server",
    "./web"
  ],
  "allowedContextDependencies": [],
  "seedRequirements": [],
  "hostPorts": [],
  "apiDeployables": [
    "catalog-api"
  ],
  "runtimeDeployables": [
    "catalog-api",
    "inventory-api",
    "marketplace-api"
  ],
  "apiMounts": [
    {
      "mountPath": "/api/catalog",
      "kind": "primary",
      "requiresAuth": true,
      "drainProjectorsOnWrite": false
    }
  ],
  "deployableContributions": [
    {
      "deployable": "catalog-admin",
      "routes": [
        {
          "routeId": "blueprints",
          "routePath": "blueprints",
          "fileExport": "./routes/admin/blueprints",
          "routeType": "route",
          "sourceContext": "catalog"
        },
        {
          "routeId": "blueprints-detail",
          "routePath": "blueprints/:id",
          "fileExport": "./routes/admin/blueprints-detail",
          "routeType": "route",
          "sourceContext": "catalog"
        },
        {
          "routeId": "catalog-items",
          "routePath": "catalog-items",
          "fileExport": "./routes/admin/catalog-items",
          "routeType": "route",
          "sourceContext": "catalog"
        },
        {
          "routeId": "catalog-items-detail",
          "routePath": "catalog-items/:id",
          "fileExport": "./routes/admin/catalog-items-detail",
          "routeType": "route",
          "sourceContext": "catalog"
        },
        {
          "routeId": "categories",
          "routePath": "categories",
          "fileExport": "./routes/admin/categories",
          "routeType": "route",
          "sourceContext": "catalog"
        },
        {
          "routeId": "categories-detail",
          "routePath": "categories/:id",
          "fileExport": "./routes/admin/categories-detail",
          "routeType": "route",
          "sourceContext": "catalog"
        },
        {
          "routeId": "components",
          "routePath": "components",
          "fileExport": "./routes/admin/components",
          "routeType": "route",
          "sourceContext": "catalog"
        },
        {
          "routeId": "components-detail",
          "routePath": "components/:id",
          "fileExport": "./routes/admin/components-detail",
          "routeType": "route",
          "sourceContext": "catalog"
        },
        {
          "routeId": "dimensions",
          "routePath": "dimensions",
          "fileExport": "./routes/admin/dimensions",
          "routeType": "route",
          "sourceContext": "catalog"
        },
        {
          "routeId": "dimensions-detail",
          "routePath": "dimensions/:id",
          "fileExport": "./routes/admin/dimensions-detail",
          "routeType": "route",
          "sourceContext": "catalog"
        },
        {
          "routeId": "fields",
          "routePath": "fields",
          "fileExport": "./routes/admin/fields",
          "routeType": "route",
          "sourceContext": "catalog"
        },
        {
          "routeId": "fields-detail",
          "routePath": "fields/:id",
          "fileExport": "./routes/admin/fields-detail",
          "routeType": "route",
          "sourceContext": "catalog"
        }
      ]
    }
  ],
  "shellContributions": [
    {
      "deployable": "catalog-admin",
      "slot": "primary-nav",
      "key": "dimensions",
      "label": "Dimensions",
      "icon": "spark",
      "href": "/dimensions",
      "order": 10,
      "visibility": "signed-in",
      "requiredPermissions": []
    },
    {
      "deployable": "catalog-admin",
      "slot": "primary-nav",
      "key": "fields",
      "label": "Fields",
      "icon": "edit",
      "href": "/fields",
      "order": 20,
      "visibility": "signed-in",
      "requiredPermissions": []
    },
    {
      "deployable": "catalog-admin",
      "slot": "primary-nav",
      "key": "components",
      "label": "Components",
      "icon": "package",
      "href": "/components",
      "order": 30,
      "visibility": "signed-in",
      "requiredPermissions": []
    },
    {
      "deployable": "catalog-admin",
      "slot": "primary-nav",
      "key": "blueprints",
      "label": "Blueprints",
      "icon": "copy",
      "href": "/blueprints",
      "order": 40,
      "visibility": "signed-in",
      "requiredPermissions": []
    },
    {
      "deployable": "catalog-admin",
      "slot": "primary-nav",
      "key": "categories",
      "label": "Categories",
      "icon": "filter",
      "href": "/categories",
      "order": 50,
      "visibility": "signed-in",
      "requiredPermissions": []
    },
    {
      "deployable": "catalog-admin",
      "slot": "primary-nav",
      "key": "catalog-items",
      "label": "Catalog Items",
      "icon": "dashboard",
      "href": "/catalog-items",
      "order": 60,
      "visibility": "signed-in",
      "requiredPermissions": []
    }
  ],
  "directoryIntent": {
    "authoring": {
      "classification": "slice",
      "purpose": "Own authoring feature behavior, read models, and UI contracts for the catalog context.",
      "allowedWhen": "Always; slice directories are the default root shape for implemented context features.",
      "expectedConsumers": [
        "Internal catalog module composition"
      ]
    },
    "request-support": {
      "classification": "support",
      "purpose": "Provide reusable request-support assets shared by multiple catalog slices.",
      "allowedWhen": "Allowed only when capability cannot stay inside one slice and cross-slice reuse is explicit.",
      "expectedConsumers": [
        "Multiple catalog slices",
        "Deployable composition for catalog"
      ],
      "justification": "request-support centralizes reusable context-local composition that should not duplicate across slices.",
      "createdFor": "Multi-slice catalog workflows that need shared runtime helpers.",
      "sunsetWhen": "Remove when all consumers can move the behavior back into slice-local modules."
    },
    "shell-support": {
      "classification": "support",
      "purpose": "Provide reusable shell-support assets shared by multiple catalog slices.",
      "allowedWhen": "Allowed only when capability cannot stay inside one slice and cross-slice reuse is explicit.",
      "expectedConsumers": [
        "Multiple catalog slices",
        "Deployable composition for catalog"
      ],
      "justification": "shell-support centralizes reusable context-local composition that should not duplicate across slices.",
      "createdFor": "Multi-slice catalog workflows that need shared runtime helpers.",
      "sunsetWhen": "Remove when all consumers can move the behavior back into slice-local modules."
    },
    "routes": {
      "classification": "routes",
      "purpose": "Expose catalog-owned route modules consumed by generated deployable adapters.",
      "allowedWhen": "Required whenever the context contributes routes to any deployable.",
      "expectedConsumers": [
        "Generated deployable route adapters"
      ]
    }
  }
}

