{
  "contextName": "catalog",
  "packageName": "@chase-sets/catalog",
  "ownedNouns": [
    "catalog-item",
    "category",
    "blueprint",
    "field",
    "component",
    "dimension",
    "display-template",
    "product-measure-profile",
    "reference-type",
    "reference-record"
