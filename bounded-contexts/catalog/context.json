  "streamPrefix": "catalog.",
  "apiBasePath": "/api/catalog",
  "slices": [
    "alias-equivalence",
    "blueprints",
    "catalog-items",
    "categories",
    "components",
    "dimensions",
    "display-templates",
    "fields",
    "product-measures",
    "reference-data",
