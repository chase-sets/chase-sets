    "fields": {
      "classification": "slice",
      "purpose": "Own fields feature behavior, read models, and UI contracts for the catalog context.",
      "expectedConsumers": ["Internal catalog module composition"]
    },
    "display-templates": {
      "classification": "slice",
      "purpose": "Own Catalog display title and subtitle template policy so display identity derives from Fields, Reference Records, Categories, Blueprints, and scoped overrides.",
      "expectedConsumers": ["catalog-items", "source-observations", "Internal catalog module composition"]
    },
    "product-measures": {
      "classification": "slice",
      "purpose": "Own Catalog product measurement profiles and overrides that provide shipping-aware physical facts to downstream contexts.",
      "expectedConsumers": [
        "Internal catalog module composition",
        "Ordering product measure projections",
        "Fulfillment package planning projections"
      ]
    },
    "source-observations": {
      "classification": "slice",
      "purpose": "Own provider source observations, review workflow, and promotion of candidate provider facts into canonical Catalog Items.",
      "expectedConsumers": ["Internal catalog module composition"]
    },
    "reference-data": {
      "classification": "slice",
      "purpose": "Own reference types and reference records that attach rich reusable facts to catalog item field values.",
      "expectedConsumers": ["Internal catalog module composition"]
    },
    "authoring-support": {
      "classification": "support",
      "purpose": "Provide reusable authoring-support assets shared by catalog-owned features and composition seams.",
      "expectedConsumers": [
        "blueprints",
        "catalog-items",
        "categories",
        "components",
        "dimensions",
        "display-templates",
        "fields",
        "product-measures",
        "reference-data",
        "source-observations"
      ]
    },
    "client-support": {
      "classification": "support",
      "purpose": "Provide reusable client-support assets shared by catalog-owned features and composition seams.",
      "expectedConsumers": [
        "blueprints",
