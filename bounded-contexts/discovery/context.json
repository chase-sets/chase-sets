{
  "contextName": "discovery",
  "packageName": "@chase-sets/discovery",
  "ownedNouns": [
    "search",
    "browse",
    "item-detail"
  ],
  "streamPrefix": "discovery.",
  "apiBasePath": "/api/marketplace",
  "slices": [
    "categories",
    "item-detail",
    "search"
  ],
  "allowedSupportDirectories": [
    "client-support",
    "item-support",
    "market-support",
    "request-support",
    "runtime-support",
    "shell-support"
  ],
  "publicExports": [
    ".",
    "./context",
    "./routes/*",
    "./server",
    "./web"
  ],
  "allowedContextDependencies": [
    "@chase-sets/catalog",
    "@chase-sets/marketplace",
    "@chase-sets/ordering"
  ],
  "seedRequirements": [],
  "eventSubscriptions": [
    {
      "sourceContextName": "catalog",
      "projectionName": "discovery-category-projection",
      "subscriptionVersion": 1,
      "projectorNames": [
        "discovery-category-projection"
      ],
      "eventTypes": [
        "catalog.category.created",
        "catalog.category.revised",
        "catalog.category.published",
        "catalog.category.deprecated",
        "catalog.category.archived",
        "catalog.catalog-item.created",
        "catalog.catalog-item.blueprint-assigned",
        "catalog.catalog-item.field-value-set",
        "catalog.catalog-item.field-value-cleared",
        "catalog.catalog-item.category-assigned",
        "catalog.catalog-item.category-removed",
        "catalog.catalog-item.published",
        "catalog.catalog-item.metadata-revised",
        "catalog.catalog-item.tags-set",
        "catalog.catalog-item.image-urls-set",
        "catalog.catalog-item.retired",
        "catalog.catalog-item.archived",
        "catalog.blueprint.created",
        "catalog.blueprint.revised",
        "catalog.blueprint.dimensions-set",
        "catalog.blueprint.product-resolution-rules-set",
        "catalog.blueprint.published",
        "catalog.field.created",
        "catalog.field.configured",
        "catalog.dimension.created",
        "catalog.dimension.revised",
        "catalog.dimension.option-added",
        "catalog.dimension.option-revised"
      ],
      "order": 10
    },
    {
      "sourceContextName": "catalog",
      "projectionName": "discovery-search-item-projection",
      "subscriptionVersion": 1,
      "projectorNames": [
        "discovery-search-item-projection"
      ],
      "eventTypes": [
        "catalog.category.created",
        "catalog.category.revised",
        "catalog.category.published",
        "catalog.category.deprecated",
        "catalog.category.archived",
        "catalog.catalog-item.created",
        "catalog.catalog-item.blueprint-assigned",
        "catalog.catalog-item.field-value-set",
        "catalog.catalog-item.field-value-cleared",
        "catalog.catalog-item.category-assigned",
        "catalog.catalog-item.category-removed",
        "catalog.catalog-item.published",
        "catalog.catalog-item.metadata-revised",
        "catalog.catalog-item.tags-set",
        "catalog.catalog-item.image-urls-set",
        "catalog.catalog-item.retired",
        "catalog.catalog-item.archived",
        "catalog.blueprint.created",
        "catalog.blueprint.revised",
        "catalog.blueprint.dimensions-set",
        "catalog.blueprint.product-resolution-rules-set",
        "catalog.blueprint.published",
        "catalog.field.created",
        "catalog.field.configured",
        "catalog.dimension.created",
        "catalog.dimension.revised",
        "catalog.dimension.option-added",
        "catalog.dimension.option-revised"
      ],
      "order": 10
    },
    {
      "sourceContextName": "catalog",
      "projectionName": "discovery-item-detail-projection",
      "subscriptionVersion": 1,
      "projectorNames": [
        "discovery-item-detail-projection"
      ],
      "eventTypes": [
        "catalog.category.created",
        "catalog.category.revised",
        "catalog.category.published",
        "catalog.category.deprecated",
        "catalog.category.archived",
        "catalog.catalog-item.created",
        "catalog.catalog-item.blueprint-assigned",
        "catalog.catalog-item.field-value-set",
        "catalog.catalog-item.field-value-cleared",
        "catalog.catalog-item.category-assigned",
        "catalog.catalog-item.category-removed",
        "catalog.catalog-item.published",
        "catalog.catalog-item.metadata-revised",
        "catalog.catalog-item.tags-set",
        "catalog.catalog-item.image-urls-set",
        "catalog.catalog-item.retired",
        "catalog.catalog-item.archived",
        "catalog.blueprint.created",
        "catalog.blueprint.revised",
        "catalog.blueprint.dimensions-set",
        "catalog.blueprint.product-resolution-rules-set",
        "catalog.blueprint.published",
        "catalog.field.created",
        "catalog.field.configured",
        "catalog.dimension.created",
        "catalog.dimension.revised",
        "catalog.dimension.option-added",
        "catalog.dimension.option-revised"
      ],
      "order": 10
    },
    {
      "sourceContextName": "identity",
      "projectionName": "discovery-market-projection",
      "subscriptionVersion": 1,
      "projectorNames": [
        "discovery-market-projection"
      ],
      "eventTypes": [
        "identity.account.created",
        "identity.account.profile-updated",
        "identity.account.suspended",
        "identity.account.reactivated",
        "identity.account.closed"
      ],
      "order": 20
    },
    {
      "sourceContextName": "marketplace",
      "projectionName": "discovery-market-projection",
      "subscriptionVersion": 1,
      "projectorNames": [
        "discovery-market-projection"
      ],
      "eventTypes": [
        "marketplace.listing.created",
        "marketplace.listing.price-updated",
        "marketplace.listing.quantity-cap-updated",
        "marketplace.listing.published",
        "marketplace.listing.paused",
        "marketplace.listing.withdrawn",
        "marketplace.offer.submitted",
        "marketplace.offer.accepted"
      ],
      "order": 30
    }
  ],
  "projectionGroups": [
    {
      "projectionName": "discovery-category-projection",
      "sourceContextNames": [
        "catalog"
      ],
      "ownedTables": [
        "discovery_category_catalog_categories",
        "discovery_category_catalog_items",
        "discovery_categories"
      ],
      "requiredDuringBootstrap": true
    },
    {
      "projectionName": "discovery-search-item-projection",
      "sourceContextNames": [
        "catalog"
      ],
      "ownedTables": [
        "discovery_search_catalog_items",
        "discovery_search_catalog_blueprints",
        "discovery_search_catalog_categories",
        "discovery_search_items"
      ],
      "requiredDuringBootstrap": true
    },
    {
      "projectionName": "discovery-item-detail-projection",
      "sourceContextNames": [
        "catalog"
      ],
      "ownedTables": [
        "discovery_item_detail_catalog_items",
        "discovery_item_detail_catalog_blueprints",
        "discovery_item_detail_catalog_categories",
        "discovery_item_detail_catalog_fields",
        "discovery_item_detail_catalog_dimensions",
        "discovery_item_detail_catalog_dimension_options",
        "discovery_item_detail_pages"
      ],
      "requiredDuringBootstrap": true
    },
    {
      "projectionName": "discovery-market-projection",
      "sourceContextNames": [
        "identity",
        "marketplace"
      ],
      "ownedTables": [
        "discovery_market_accounts",
        "discovery_market_listings",
        "discovery_market_offers"
      ],
      "requiredDuringBootstrap": true
    }
  ],
  "hostPorts": [],
  "apiDeployables": [
    "platform-api"
  ],
  "apiMounts": [
    {
      "mountPath": "/api/marketplace",
      "kind": "primary",
      "requiresAuth": true,
      "drainProjectorsOnWrite": false
    }
  ],
  "deployableContributions": [
    {
      "deployable": "marketplace-web",
      "routes": [
        {
          "routeId": "item-detail",
          "routePath": "items/:id",
          "fileExport": "./routes/item-detail",
          "routeType": "route",
          "sourceContext": "discovery"
        },
        {
          "routeId": "search",
          "routePath": "search",
          "fileExport": "./routes/search",
          "routeType": "route",
          "sourceContext": "discovery"
        }
      ]
    }
  ],
  "shellContributions": [
    {
      "deployable": "marketplace-web",
      "slot": "top-nav",
      "key": "search",
      "label": "Browse",
      "icon": "search",
      "href": "/search",
      "order": 10,
      "visibility": "always",
      "requiredPermissions": []
    },
    {
      "deployable": "marketplace-web",
      "slot": "bottom-nav",
      "key": "search",
      "label": "Browse",
      "icon": "search",
      "href": "/search",
      "order": 10,
      "visibility": "always",
      "requiredPermissions": []
    }
  ],
  "directoryIntent": {
    "categories": {
      "classification": "slice",
      "purpose": "Own categories feature behavior, read models, and UI contracts for the discovery context.",
      "allowedWhen": "Always; slice directories are the default root shape for implemented context features.",
      "expectedConsumers": [
        "Internal discovery module composition"
      ]
    },
    "item-detail": {
      "classification": "slice",
      "purpose": "Own item-detail feature behavior, read models, and UI contracts for the discovery context.",
      "allowedWhen": "Always; slice directories are the default root shape for implemented context features.",
      "expectedConsumers": [
        "Internal discovery module composition"
      ]
    },
    "search": {
      "classification": "slice",
      "purpose": "Own search feature behavior, read models, and UI contracts for the discovery context.",
      "allowedWhen": "Always; slice directories are the default root shape for implemented context features.",
      "expectedConsumers": [
        "Internal discovery module composition"
      ]
    },
    "client-support": {
      "classification": "support",
      "purpose": "Provide reusable client-support assets shared by discovery-owned features and composition seams.",
      "allowedWhen": "Allowed only when capability cannot stay inside one feature and cross-feature reuse is explicit.",
      "expectedConsumers": [
        "item-detail",
        "search"
      ],
      "justification": "client-support centralizes context-local composition that should not duplicate across features.",
      "createdFor": "discovery workflows that span multiple features or public entrypoints.",
      "sunsetWhen": "Remove when all consumers can move the behavior back into feature-local modules."
    },
    "item-support": {
      "classification": "support",
      "purpose": "Provide reusable item-support assets shared by discovery-owned features and composition seams.",
      "allowedWhen": "Allowed only when capability cannot stay inside one feature and cross-feature reuse is explicit.",
      "expectedConsumers": [
        "item-detail",
        "search"
      ],
      "justification": "item-support centralizes context-local composition that should not duplicate across features.",
      "createdFor": "discovery workflows that span multiple features or public entrypoints.",
      "sunsetWhen": "Remove when all consumers can move the behavior back into feature-local modules."
    },
    "market-support": {
      "classification": "support",
      "purpose": "Provide reusable market-support assets shared by discovery-owned features and composition seams.",
      "allowedWhen": "Allowed only when capability cannot stay inside one feature and cross-feature reuse is explicit.",
      "expectedConsumers": [
        "item-detail",
        "search"
      ],
      "justification": "market-support centralizes context-local composition that should not duplicate across features.",
      "createdFor": "discovery workflows that span multiple features or public entrypoints.",
      "sunsetWhen": "Remove when all consumers can move the behavior back into feature-local modules."
    },
    "request-support": {
      "classification": "support",
      "purpose": "Provide reusable request-support assets shared by discovery-owned features and composition seams.",
      "allowedWhen": "Allowed only when capability cannot stay inside one feature and cross-feature reuse is explicit.",
      "expectedConsumers": [
        "Multiple discovery slices",
        "Deployable composition for discovery"
      ],
      "justification": "request-support centralizes context-local composition that should not duplicate across features.",
      "createdFor": "discovery workflows that span multiple features or public entrypoints.",
      "sunsetWhen": "Remove when all consumers can move the behavior back into feature-local modules.",
      "crossCuttingRuntimeComposition": true
    },
    "runtime-support": {
      "classification": "support",
      "purpose": "Provide reusable runtime-support assets shared by discovery-owned features and composition seams.",
      "allowedWhen": "Allowed only when capability cannot stay inside one feature and cross-feature reuse is explicit.",
      "expectedConsumers": [
        "categories",
        "item-detail",
        "search"
      ],
      "justification": "runtime-support centralizes context-local composition that should not duplicate across features.",
      "createdFor": "discovery workflows that span multiple features or public entrypoints.",
      "sunsetWhen": "Remove when all consumers can move the behavior back into feature-local modules."
    },
    "shell-support": {
      "classification": "support",
      "purpose": "Provide reusable shell-support assets shared by discovery-owned features and composition seams.",
      "allowedWhen": "Allowed only when capability cannot stay inside one feature and cross-feature reuse is explicit.",
      "expectedConsumers": [
        "Deployable composition for discovery"
      ],
      "justification": "shell-support centralizes context-local composition that should not duplicate across features.",
      "createdFor": "discovery workflows that span multiple features or public entrypoints.",
      "sunsetWhen": "Remove when all consumers can move the behavior back into feature-local modules."
    },
    "routes": {
      "classification": "routes",
      "purpose": "Expose discovery-owned route modules consumed by generated deployable adapters.",
      "allowedWhen": "Required whenever the context contributes routes to any deployable.",
      "expectedConsumers": [
        "Generated deployable route adapters"
      ]
    }
  }
}
