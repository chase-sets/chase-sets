  "hostPorts": [
    {
      "portName": "notificationOutbox",
      "providedBy": "platform-worker",
      "purpose": "Durable notification outbox consumed by Product Alert match projectors and dispatched through channel adapters."
    }
  ],
  "apiDeployables": ["platform-api"],
  "apiMounts": [
    {
      "mountPath": "/api/marketplace",
      "kind": "primary",
      "requiresAuth": true
    }
  ],
  "readAfterWriteRouteInventory": [
    {
      "id": "discovery.item-detail-checkout-handoff",
      "owner": "discovery",
      "risk": "important",
      "source": {
        "routeId": "item-detail",
        "actions": ["Add item detail product intent to Checkout"],
        "command": "Checkout handoff from Discovery item detail"
      },
      "destination": {
        "routeId": "item-detail",
        "transientRecovery": "Discovery item detail helper use is a Checkout handoff token carrier, not a Discovery read-model destination."
      },
      "exception": {
        "status": "not-post-write-read",
        "owner": "discovery",
        "reviewBy": "2026-07-31",
        "reason": "The post-write destination is Checkout-owned and tracked by Checkout freshness entries; Discovery does not read its own just-written projection here.",
        "helperUses": ["appendFreshWriteToken"],
        "files": ["bounded-contexts/discovery/support/route-support/item-detail/action.ts"]
      }
    }
  ],
  "mutationConsistencyInventory": [
    {
      "id": "discovery.item-detail-rail-analytics-capture",
      "owner": "discovery",
      "risk": "informational",
      "strategy": "non-user-visible",
      "surfaces": ["route-action:deployables/marketplace/app/routes/item-detail-rail-analytics.ts"],
      "exception": {
        "owner": "discovery",
        "reviewBy": "2026-09-30",
        "issue": "#1819",
        "reason": "Discovery owns the item-detail rail analytics vocabulary and documents the marketplace deployable bridge as observability-only capture in bounded-contexts/discovery/docs/item-detail-rail-analytics.md. deployables/marketplace/app/root.test.tsx proves the route accepts only bounded analytics labels, rejects unsupported/private labels, returns 204, and no user-visible route read depends on the ping."
      }
    }
  ],
  "deployableContributions": [
    {
      "deployable": "marketplace-web",
      "routes": [
        {
          "routeId": "account-product-alerts",
          "routePath": "account/product-alerts",
          "fileExport": "./routes/account-product-alerts",
