      "sourceContextNames": ["identity", "marketplace"],
      "ownedTables": [
        "discovery_market_accounts",
        "discovery_market_account_reviews",
        "discovery_market_listings",
        "discovery_offer_demand_matches"
      ],
      "requiredDuringBootstrap": true,
      "resetStrategy": "replay-only"
    },
