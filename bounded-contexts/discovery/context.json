{
  "contextName": "discovery",
  "packageName": "@chase-sets/discovery",
  "ownedNouns": ["search", "browse", "item-detail", "product-alert"],
  "streamPrefix": "discovery.",
  "apiBasePath": "/api/marketplace",
  "slices": ["categories", "item-detail", "product-alerts", "search"],
  "allowedSupportDirectories": [
    "client-support",
    "item-support",
    "market-support",
    "realtime-support",
    "request-support",
    "runtime-support",
    "shell-support",
    "ucp-support"
  ],
  "publicExports": [".", "./context", "./routes/*", "./server", "./web"],
  "allowedContextDependencies": [
    "@chase-sets/catalog",
    "@chase-sets/checkout",
    "@chase-sets/inventory",
    "@chase-sets/marketplace",
    "@chase-sets/notifications"
  ],
  "seedRequirements": [],
  "eventSubscriptions": [
    {
      "sourceContextName": "discovery",
      "projectionName": "discovery-product-alert-page-projection",
      "subscriptionVersion": 1,
      "eventTypes": [
        "discovery.product-alert.created",
        "discovery.product-alert.paused",
        "discovery.product-alert.resumed",
        "discovery.product-alert.deleted"
      ],
      "order": 5,
      "projectionHandlerSetNames": ["discovery-product-alert-page-projection"]
    },
    {
      "sourceContextName": "catalog",
      "projectionName": "discovery-category-projection",
      "subscriptionVersion": 1,
      "eventTypes": [
        "catalog.category.created",
        "catalog.category.revised",
        "catalog.category.published",
        "catalog.category.deprecated",
        "catalog.category.archived",
        "catalog.catalog-item.created",
        "catalog.catalog-item.blueprint-assigned",
        "catalog.catalog-item.field-value-set",
        "catalog.catalog-item.field-value-cleared",
        "catalog.catalog-item.category-assigned",
        "catalog.catalog-item.category-removed",
        "catalog.catalog-item.published",
        "catalog.catalog-item.metadata-revised",
        "catalog.catalog-item.tags-set",
        "catalog.catalog-item.image-urls-set",
        "catalog.catalog-item.product-asset-sets-set",
        "catalog.catalog-item.image-fallback-set",
        "catalog.catalog-item.image-fallback-cleared",
        "catalog.catalog-item.retired",
        "catalog.catalog-item.archived",
        "catalog.blueprint.created",
        "catalog.blueprint.revised",
        "catalog.blueprint.dimensions-set",
        "catalog.blueprint.product-resolution-rules-set",
        "catalog.blueprint.published",
        "catalog.field.created",
        "catalog.field.configured",
        "catalog.dimension.created",
        "catalog.dimension.revised",
        "catalog.dimension.option-added",
        "catalog.dimension.option-revised",
        "catalog.dimension.options-reordered"
      ],
      "order": 10,
      "projectionHandlerSetNames": ["discovery-category-projection"]
    },
    {
      "sourceContextName": "catalog",
      "projectionName": "discovery-search-item-projection",
      "subscriptionVersion": 2,
      "eventTypes": [
        "catalog.category.created",
        "catalog.category.revised",
        "catalog.category.published",
        "catalog.category.deprecated",
        "catalog.category.archived",
        "catalog.catalog-item.created",
        "catalog.catalog-item.blueprint-assigned",
        "catalog.catalog-item.field-value-set",
        "catalog.catalog-item.field-value-cleared",
        "catalog.catalog-item.category-assigned",
        "catalog.catalog-item.category-removed",
        "catalog.catalog-item.published",
        "catalog.catalog-item.metadata-revised",
        "catalog.catalog-item.tags-set",
        "catalog.catalog-item.image-urls-set",
        "catalog.catalog-item.product-asset-sets-set",
        "catalog.catalog-item.image-fallback-set",
        "catalog.catalog-item.image-fallback-cleared",
        "catalog.catalog-item.retired",
        "catalog.catalog-item.archived",
        "catalog.blueprint.created",
        "catalog.blueprint.revised",
        "catalog.blueprint.dimensions-set",
        "catalog.blueprint.product-resolution-rules-set",
        "catalog.blueprint.published",
        "catalog.field.created",
        "catalog.field.configured",
        "catalog.reference-record.created",
        "catalog.reference-record.revised",
        "catalog.reference-record.published",
        "catalog.reference-record.deprecated",
        "catalog.reference-record.archived",
        "catalog.dimension.created",
        "catalog.dimension.revised",
        "catalog.dimension.option-added",
        "catalog.dimension.option-revised",
        "catalog.dimension.options-reordered"
      ],
      "order": 10,
      "projectionHandlerSetNames": ["discovery-search-item-projection"]
    },
    {
      "sourceContextName": "catalog",
      "projectionName": "discovery-item-detail-projection",
      "subscriptionVersion": 1,
      "eventTypes": [
        "catalog.category.created",
        "catalog.category.revised",
        "catalog.category.published",
        "catalog.category.deprecated",
        "catalog.category.archived",
        "catalog.catalog-item.created",
        "catalog.catalog-item.blueprint-assigned",
        "catalog.catalog-item.field-value-set",
        "catalog.catalog-item.field-value-cleared",
        "catalog.catalog-item.category-assigned",
        "catalog.catalog-item.category-removed",
        "catalog.catalog-item.published",
        "catalog.catalog-item.metadata-revised",
        "catalog.catalog-item.tags-set",
        "catalog.catalog-item.image-urls-set",
        "catalog.catalog-item.product-asset-sets-set",
        "catalog.catalog-item.image-fallback-set",
        "catalog.catalog-item.image-fallback-cleared",
        "catalog.catalog-item.retired",
        "catalog.catalog-item.archived",
        "catalog.blueprint.created",
        "catalog.blueprint.revised",
        "catalog.blueprint.dimensions-set",
        "catalog.blueprint.product-resolution-rules-set",
        "catalog.blueprint.published",
        "catalog.field.created",
        "catalog.field.configured",
        "catalog.reference-record.created",
        "catalog.reference-record.revised",
        "catalog.reference-record.published",
        "catalog.reference-record.deprecated",
        "catalog.reference-record.archived",
        "catalog.dimension.created",
        "catalog.dimension.revised",
        "catalog.dimension.option-added",
        "catalog.dimension.option-revised",
        "catalog.dimension.options-reordered"
      ],
      "order": 10,
      "projectionHandlerSetNames": ["discovery-item-detail-projection"]
    },
    {
      "sourceContextName": "identity",
      "projectionName": "discovery-market-projection",
      "subscriptionVersion": 1,
      "eventTypes": [
        "identity.account.created",
        "identity.account.profile-updated",
        "identity.account.suspended",
        "identity.account.reactivated",
        "identity.account.closed"
      ],
      "order": 20,
      "projectionHandlerSetNames": ["discovery-market-projection"]
    },
    {
      "sourceContextName": "marketplace",
      "projectionName": "discovery-market-projection",
      "subscriptionVersion": 1,
      "eventTypes": [
        "marketplace.listing.created",
        "marketplace.listing.price-updated",
        "marketplace.listing.quantity-cap-updated",
        "marketplace.listing.purchase-limits-updated",
        "marketplace.listing.published",
        "marketplace.listing.paused",
        "marketplace.listing.withdrawn",
        "marketplace.seller-listing-availability.disabled",
        "marketplace.seller-listing-availability.enabled",
        "marketplace.offer.submitted",
        "marketplace.offer.accepted"
      ],
      "order": 30,
      "projectionHandlerSetNames": ["discovery-market-projection"]
    },
    {
      "sourceContextName": "marketplace",
      "projectionName": "discovery-product-alert-notification-projection",
      "subscriptionVersion": 1,
      "eventTypes": [
        "marketplace.listing.created",
        "marketplace.listing.price-updated",
        "marketplace.listing.quantity-cap-updated",
        "marketplace.listing.published",
        "marketplace.listing.paused",
        "marketplace.listing.withdrawn",
        "marketplace.offer.submitted",
        "marketplace.offer.accepted"
      ],
      "order": 35,
      "projectionHandlerSetNames": ["discovery-product-alert-notification-projection"]
    },
    {
      "sourceContextName": "reputation",
      "projectionName": "discovery-market-projection",
      "subscriptionVersion": 1,
      "eventTypes": ["reputation.review.submitted", "reputation.review.updated", "reputation.review.withdrawn"],
      "order": 40,
      "projectionHandlerSetNames": ["discovery-market-projection"]
    }
  ],
  "projectionGroups": [
    {
      "projectionName": "discovery-category-projection",
      "sourceContextNames": ["catalog"],
      "ownedTables": [
        "discovery_category_catalog_categories",
        "discovery_category_catalog_items",
        "discovery_categories"
      ],
      "requiredDuringBootstrap": true
    },
    {
      "projectionName": "discovery-search-item-projection",
      "sourceContextNames": ["catalog"],
      "ownedTables": [
        "discovery_search_catalog_items",
        "discovery_search_catalog_blueprints",
        "discovery_search_catalog_categories",
        "discovery_search_catalog_reference_records",
        "discovery_search_items"
      ],
      "requiredDuringBootstrap": true
    },
    {
      "projectionName": "discovery-item-detail-projection",
      "sourceContextNames": ["catalog"],
      "ownedTables": [
        "discovery_item_detail_catalog_items",
        "discovery_item_detail_catalog_blueprints",
        "discovery_item_detail_catalog_categories",
        "discovery_item_detail_catalog_fields",
        "discovery_item_detail_catalog_reference_records",
        "discovery_item_detail_catalog_dimensions",
        "discovery_item_detail_catalog_dimension_options",
        "discovery_item_detail_pages"
      ],
      "requiredDuringBootstrap": true
    },
    {
      "projectionName": "discovery-market-projection",
      "sourceContextNames": ["identity", "marketplace", "reputation"],
      "ownedTables": [
        "discovery_market_accounts",
        "discovery_market_account_reviews",
        "discovery_market_listings",
        "discovery_offer_demand_matches"
      ],
      "requiredDuringBootstrap": true
    },
    {
      "projectionName": "discovery-product-alert-page-projection",
      "sourceContextNames": ["discovery"],
      "ownedTables": ["discovery_product_alert_pages"],
      "requiredDuringBootstrap": true
    },
    {
      "projectionName": "discovery-product-alert-notification-projection",
      "sourceContextNames": ["marketplace"],
      "ownedTables": ["discovery_product_alert_market_activity", "discovery_product_alert_match_notifications"],
      "requiredDuringBootstrap": true
    }
  ],
  "hostPorts": [
    {
      "portName": "notificationOutbox",
      "providedBy": "platform-worker",
      "purpose": "Durable notification outbox consumed by Product Alert match projectors and dispatched through channel adapters."
    }
  ],
  "apiDeployables": ["platform-api"],
  "apiMounts": [
    {
      "mountPath": "/api/marketplace",
      "kind": "primary",
      "requiresAuth": true
    }
  ],
  "deployableContributions": [
    {
      "deployable": "marketplace-web",
      "routes": [
        {
          "routeId": "account-product-alerts",
          "routePath": "account/product-alerts",
          "fileExport": "./routes/account-product-alerts",
          "routeType": "route",
          "sourceContext": "discovery"
        },
        {
          "routeId": "category",
          "routePath": "categories/:categorySlug",
          "fileExport": "./routes/search",
          "routeType": "route",
          "sourceContext": "discovery"
        },
        {
          "routeId": "item-detail",
          "routePath": "items/:id",
          "fileExport": "./routes/item-detail",
          "routeType": "route",
          "sourceContext": "discovery"
        },
        {
          "routeId": "public-listing",
          "routePath": "listings/:listingSlug",
          "fileExport": "./routes/public-listing",
          "routeType": "route",
          "sourceContext": "discovery"
        },
        {
          "routeId": "public-account",
          "routePath": "accounts/:accountSlug",
          "fileExport": "./routes/public-account",
          "routeType": "route",
          "sourceContext": "discovery"
        },
        {
          "routeId": "search",
          "routePath": "search",
          "fileExport": "./routes/search",
          "routeType": "route",
          "sourceContext": "discovery"
        }
      ]
    }
  ],
  "shellContributions": [
    {
      "deployable": "marketplace-web",
      "slot": "top-nav",
      "key": "search",
      "label": "Browse",
      "icon": "search",
      "href": "/search",
      "order": 10,
      "visibility": "always",
      "requiredPermissions": []
    },
    {
      "deployable": "marketplace-web",
      "slot": "bottom-nav",
      "key": "search",
      "label": "Browse",
      "icon": "search",
      "href": "/search",
      "order": 10,
      "visibility": "always",
      "requiredPermissions": []
    }
  ],
  "directoryIntent": {
    "categories": {
      "classification": "slice",
      "purpose": "Own categories feature behavior, read models, and UI contracts for the discovery context.",
      "allowedWhen": "Always; slice directories are the default root shape for implemented context features.",
      "expectedConsumers": ["Internal discovery module composition"]
    },
    "item-detail": {
      "classification": "slice",
      "purpose": "Own item-detail feature behavior, read models, and UI contracts for the discovery context.",
      "allowedWhen": "Always; slice directories are the default root shape for implemented context features.",
      "expectedConsumers": ["Internal discovery module composition"]
    },
    "search": {
      "classification": "slice",
      "purpose": "Own search feature behavior, read models, and UI contracts for the discovery context.",
      "allowedWhen": "Always; slice directories are the default root shape for implemented context features.",
      "expectedConsumers": ["Internal discovery module composition"]
    },
    "product-alerts": {
      "classification": "slice",
      "purpose": "Own product-alerts behavior, read models, notification matching, APIs, and account UI for selected marketplace Products.",
      "allowedWhen": "Always; slice directories are the default root shape for implemented context features.",
      "expectedConsumers": ["Internal discovery module composition"]
    },
    "client-support": {
      "classification": "support",
      "purpose": "Provide reusable client-support assets shared by discovery-owned features and composition seams.",
      "allowedWhen": "Allowed only when capability cannot stay inside one feature and cross-feature reuse is explicit.",
      "expectedConsumers": ["item-detail", "search"],
      "justification": "client-support centralizes context-local composition that should not duplicate across features.",
      "createdFor": "discovery workflows that span multiple features or public entrypoints.",
      "sunsetWhen": "Remove when all consumers can move the behavior back into feature-local modules."
    },
    "item-support": {
      "classification": "support",
      "purpose": "Provide reusable item-support assets shared by discovery-owned features and composition seams.",
      "allowedWhen": "Allowed only when capability cannot stay inside one feature and cross-feature reuse is explicit.",
      "expectedConsumers": ["item-detail", "search"],
      "justification": "item-support centralizes context-local composition that should not duplicate across features.",
      "createdFor": "discovery workflows that span multiple features or public entrypoints.",
      "sunsetWhen": "Remove when all consumers can move the behavior back into feature-local modules."
    },
    "market-support": {
      "classification": "support",
      "purpose": "Provide reusable market-support assets shared by discovery-owned features and composition seams.",
      "allowedWhen": "Allowed only when capability cannot stay inside one feature and cross-feature reuse is explicit.",
      "expectedConsumers": ["item-detail", "search"],
      "justification": "market-support centralizes context-local composition that should not duplicate across features.",
      "createdFor": "discovery workflows that span multiple features or public entrypoints.",
      "sunsetWhen": "Remove when all consumers can move the behavior back into feature-local modules."
    },
    "request-support": {
      "classification": "support",
      "purpose": "Provide reusable request-support assets shared by discovery-owned features and composition seams.",
      "allowedWhen": "Allowed only when capability cannot stay inside one feature and cross-feature reuse is explicit.",
      "expectedConsumers": ["Multiple discovery slices", "Deployable composition for discovery"],
      "justification": "request-support centralizes context-local composition that should not duplicate across features.",
      "createdFor": "discovery workflows that span multiple features or public entrypoints.",
      "sunsetWhen": "Remove when all consumers can move the behavior back into feature-local modules.",
      "crossCuttingRuntimeComposition": true
    },
    "realtime-support": {
      "classification": "support",
      "purpose": "Provide discovery-owned realtime topic contracts and registration metadata.",
      "allowedWhen": "Allowed for SSE topic contracts shared by discovery projectors, routes, and platform composition.",
      "expectedConsumers": ["Multiple discovery slices", "Deployable composition for discovery"],
      "justification": "realtime-support keeps discovery topic ownership in the discovery bounded context instead of deployables.",
      "createdFor": "SSE projection patch routing and topic construction for discovery marketplace surfaces.",
      "sunsetWhen": "Remove when discovery no longer publishes or consumes realtime projection patches."
    },
    "runtime-support": {
      "classification": "support",
      "purpose": "Provide reusable runtime-support assets shared by discovery-owned features and composition seams.",
      "allowedWhen": "Allowed only when capability cannot stay inside one feature and cross-feature reuse is explicit.",
      "expectedConsumers": ["categories", "item-detail", "product-alerts", "search"],
      "justification": "runtime-support centralizes context-local composition that should not duplicate across features.",
      "createdFor": "discovery workflows that span multiple features or public entrypoints.",
      "sunsetWhen": "Remove when all consumers can move the behavior back into feature-local modules."
    },
    "shell-support": {
      "classification": "support",
      "purpose": "Provide reusable shell-support assets shared by discovery-owned features and composition seams.",
      "allowedWhen": "Allowed only when capability cannot stay inside one feature and cross-feature reuse is explicit.",
      "expectedConsumers": ["Deployable composition for discovery"],
      "justification": "shell-support centralizes context-local composition that should not duplicate across features.",
      "createdFor": "discovery workflows that span multiple features or public entrypoints.",
      "sunsetWhen": "Remove when all consumers can move the behavior back into feature-local modules."
    },
    "ucp-support": {
      "classification": "support",
      "purpose": "Provide Discovery-owned Universal Commerce Protocol catalog adapters for public marketplace search and lookup.",
      "allowedWhen": "Allowed for standards-facing protocol adapters that map UCP catalog operations to Discovery-owned read models.",
      "expectedConsumers": ["platform-api UCP route composition"],
      "justification": "ucp-support keeps catalog/search protocol mapping inside Discovery instead of deployables or a generic UCP bounded context.",
      "createdFor": "UCP catalog search and lookup over Discovery read models.",
      "sunsetWhen": "Remove when UCP catalog adapters move into generated context-owned transport composition."
    },
    "routes": {
      "classification": "routes",
      "purpose": "Expose discovery-owned route modules consumed by generated deployable adapters.",
      "allowedWhen": "Required whenever the context contributes routes to any deployable.",
      "expectedConsumers": ["Generated deployable route adapters"]
    }
  },
  "runtimeDeployables": ["platform-worker"]
}
