  "directoryIntent": {
    "categories": {
      "classification": "slice",
      "purpose": "Own categories feature behavior, read models, and UI contracts for the discovery context.",
      "expectedConsumers": ["Internal discovery module composition"]
    },
    "item-detail": {
      "classification": "slice",
      "purpose": "Own item-detail feature behavior, read models, and UI contracts for the discovery context.",
      "expectedConsumers": ["Internal discovery module composition"]
    },
    "google-shopping-operations": {
      "classification": "slice",
      "purpose": "Own Discovery Google Shopping operator diagnostics for feed readiness without exposing provider secrets.",
      "expectedConsumers": ["Admin operations route", "Google Shopping operators"]
    },
    "search": {
      "classification": "slice",
      "purpose": "Own search feature behavior, read models, and UI contracts for the discovery context.",
      "expectedConsumers": ["Internal discovery module composition"]
    },
    "product-alerts": {
      "classification": "slice",
      "purpose": "Own product-alerts behavior, read models, notification matching, APIs, and account UI for selected marketplace Products.",
      "expectedConsumers": ["Internal discovery module composition"]
    },
    "client-support": {
      "classification": "support",
      "purpose": "Provide reusable client-support assets shared by discovery-owned features and composition seams.",
      "expectedConsumers": ["google-shopping-operations", "item-detail", "search"]
    },
    "item-support": {
      "classification": "support",
      "purpose": "Provide reusable item-support assets shared by discovery-owned features and composition seams.",
      "expectedConsumers": ["item-detail", "search"]
    },
    "market-support": {
      "classification": "support",
      "purpose": "Provide reusable market-support assets shared by discovery-owned features and composition seams.",
      "expectedConsumers": ["item-detail", "search"]
    },
    "request-support": {
      "classification": "support",
      "purpose": "Provide reusable request parsing and context-local API client assets shared by discovery-owned features and composition seams.",
      "expectedConsumers": ["Multiple discovery slices", "Deployable composition for discovery"],
      "crossCuttingRuntimeComposition": true
    },
    "route-support": {
      "classification": "support",
      "purpose": "Provide item-detail route loader/action modules that compose Discovery item reads with Marketplace, Inventory, and Checkout server clients.",
      "expectedConsumers": ["routes"]
    },
    "realtime-support": {
      "classification": "support",
      "purpose": "Provide Discovery-owned SSE topic contracts and registration metadata shared by projectors, routes, and platform composition.",
      "expectedConsumers": ["Multiple discovery slices", "Deployable composition for discovery"]
    },
    "runtime-support": {
      "classification": "support",
      "purpose": "Provide reusable runtime-support assets shared by discovery-owned features and composition seams.",
      "expectedConsumers": ["categories", "item-detail", "product-alerts", "search"]
    },
    "shell-support": {
      "classification": "support",
      "purpose": "Provide reusable shell-support assets shared by discovery-owned features and composition seams.",
      "expectedConsumers": ["Deployable composition for discovery"]
    },
    "ui-support": {
      "classification": "support",
      "purpose": "Expose browser-safe Discovery UI contracts for item-detail action rail analytics through stable context web exports.",
      "expectedConsumers": ["Deployable composition for discovery"]
    },
    "ucp-support": {
      "classification": "support",
      "purpose": "Provide Discovery-owned UCP catalog search and lookup adapters over Discovery read models instead of deployable protocol mapping.",
      "expectedConsumers": ["platform-api UCP route composition"]
    },
    "routes": {
      "classification": "routes",
      "purpose": "Expose discovery-owned route modules consumed by generated deployable adapters.",
      "expectedConsumers": ["Generated deployable route adapters"]
    }
  },
  "runtimeDeployables": ["platform-worker"]
}
