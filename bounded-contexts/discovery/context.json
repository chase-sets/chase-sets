{
  "contextName": "discovery",
  "packageName": "@chase-sets/discovery",
  "ownedNouns": [
    "search",
    "browse",
    "item-detail"
  ],
  "streamPrefix": "discovery.",
  "apiBasePath": "/api/marketplace",
  "slices": [
    "categories",
    "items"
  ],
  "allowedSupportDirectories": [
    "shell",
    "tests"
  ],
  "publicExports": [
    ".",
    "./client",
    "./routes/*",
    "./web"
  ],
  "allowedContextDependencies": [
    "@chase-sets/marketplace",
    "@chase-sets/ordering"
  ],
  "requiredPorts": [],
  "apiDeployables": [
    "marketplace-api"
  ],
  "apiMounts": [
    {
      "mountPath": "/api/marketplace",
      "kind": "primary",
      "requiresAuth": true,
      "drainProjectorsOnWrite": false
    }
  ],
  "deployableContributions": [
    {
      "deployable": "marketplace",
      "routes": [
        { "routeId": "item-detail", "routePath": "items/:id", "fileExport": "./routes/item-detail", "routeType": "route", "sourceContext": "discovery" },
        { "routeId": "search", "routePath": "search", "fileExport": "./routes/search", "routeType": "route", "sourceContext": "discovery" }
      ]
    }
  ]
}
