{
  "contextName": "discovery",
  "packageName": "@chase-sets/discovery",
  "ownedNouns": [
    "search",
    "browse",
    "item-detail"
  ],
  "streamPrefix": "discovery.",
  "apiBasePath": "/api/marketplace",
  "slices": [
    "categories",
    "items"
  ],
  "allowedSupportDirectories": [
    "shell-support",
    "request-support",
    "tests"
  ],
  "publicExports": [
    ".",
    "./routes/*",
    "./server",
    "./web"
  ],
  "allowedContextDependencies": [
    "@chase-sets/catalog",
    "@chase-sets/marketplace",
    "@chase-sets/ordering"
  ],
  "requiredPorts": [],
  "integrationCapabilities": [],
  "seedRequirements": [],
  "apiRequirements": [],
  "hostPorts": [],
  "apiDeployables": [
    "marketplace-api"
  ],
  "apiMounts": [
    {
      "mountPath": "/api/marketplace",
      "kind": "primary",
      "requiresAuth": true,
      "drainProjectorsOnWrite": false
    }
  ],
  "deployableContributions": [
    {
      "deployable": "marketplace",
      "routes": [
        {
          "routeId": "item-detail",
          "routePath": "items/:id",
          "fileExport": "./routes/item-detail",
          "routeType": "route",
          "sourceContext": "discovery"
        },
        {
          "routeId": "search",
          "routePath": "search",
          "fileExport": "./routes/search",
          "routeType": "route",
          "sourceContext": "discovery"
        }
      ]
    }
  ],
  "shellContributions": [
    {
      "deployable": "marketplace",
      "slot": "top-nav",
      "key": "search",
      "label": "Browse",
      "icon": "search",
      "href": "/search",
      "order": 10,
      "visibility": "always",
      "requiredPermissions": []
    },
    {
      "deployable": "marketplace",
      "slot": "bottom-nav",
      "key": "search",
      "label": "Browse",
      "icon": "search",
      "href": "/search",
      "order": 10,
      "visibility": "always",
      "requiredPermissions": []
    }
  ]
}
