      "projectionName": "discovery-google-shopping-feed-row-projection",
      "sourceContextNames": ["catalog"],
      "ownedTables": ["discovery_google_shopping_feed_rows", "discovery_google_shopping_incremental_sync_requests"],
      "requiredDuringBootstrap": true,
      "resetStrategy": "replay-only"
    },
    {
      "projectionName": "discovery-product-alert-page-projection",
      "sourceContextNames": ["discovery"],
      "ownedTables": ["discovery_product_alert_pages"],
      "requiredDuringBootstrap": true,
      "resetStrategy": "replay-only"
