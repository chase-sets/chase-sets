{
  "name": "@chase-sets/discovery",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "chaseSets": {
    "testProfile": "db"
  },
  "scripts": {
    "test": "vitest run --config ./tests/vitest.config.mjs",
    "test:watch": "vitest --config ./tests/vitest.config.mjs",
    "test:fast": "vitest run --config ./tests/vitest.config.mjs --exclude tests/acceptance/marketplace-search.test.ts --exclude tests/search-relevance.db.test.ts --exclude tests/seller-away-capacity-messaging.db.test.ts",
    "test:unit": "vitest run --config ./tests/vitest.config.mjs --exclude tests/acceptance/marketplace-search.test.ts --exclude tests/search-relevance.db.test.ts --exclude tests/projection-row-identity.test.ts --exclude tests/seller-away-capacity-messaging.db.test.ts",
    "test:db": "vitest run --config ./tests/vitest.config.mjs tests/acceptance/marketplace-search.test.ts tests/search-relevance.db.test.ts tests/projection-row-identity.test.ts tests/seller-away-capacity-messaging.db.test.ts",
    "test:relevance": "vitest run --config ./tests/vitest.config.mjs tests/search-relevance.db.test.ts"
  },
  "exports": {
    ".": "./index.ts",
    "./context": "./context.json",
    "./routes/*": "./routes/*.tsx",
    "./server": "./server.ts",
    "./web": "./web.ts"
  },
  "types": "./index.ts",
  "dependencies": {
    "@chase-sets/bounded-context-module": "workspace:*",
    "@chase-sets/bounded-context-runtime": "workspace:*",
    "@chase-sets/auth-context": "workspace:*",
    "@chase-sets/checkout": "workspace:*",
    "@chase-sets/customer-feedback": "workspace:*",
    "@chase-sets/design-system": "workspace:*",
    "@chase-sets/event-core": "workspace:*",
    "@chase-sets/event-core-postgres": "workspace:*",
    "@chase-sets/http": "workspace:*",
    "@chase-sets/inventory": "workspace:*",
    "@chase-sets/localization": "workspace:*",
    "@chase-sets/marketplace": "workspace:*",
    "@chase-sets/notification-outbox": "workspace:*",
    "@chase-sets/outbound-messaging": "workspace:*",
    "@chase-sets/platform-runtime": "workspace:*",
    "@chase-sets/pricing": "workspace:*",
    "@chase-sets/primitives": "workspace:*",
    "hono": "^4.12.12"
  },
  "devDependencies": {
    "@chase-sets/bounded-context-runtime": "workspace:*",
    "@chase-sets/catalog": "workspace:*",
    "@chase-sets/commercial-terms": "workspace:*",
    "@chase-sets/identity": "workspace:*",
    "@chase-sets/ordering": "workspace:*"
  }
}
