{
  "contextName": "customer-feedback",
  "packageName": "@chase-sets/customer-feedback",
  "localeCatalogs": ["contracts/localization/locales/en/customer-feedback.ts"],
  "ownedNouns": [
    "customer-satisfaction",
    "csat-survey",
    "survey-version",
    "csat-invitation",
    "csat-response",
    "workflow-outcome-code",
    "outcome-fact",
    "sampling-policy",
    "response-rate",
    "csat-analytics-fact",
    "legacy-experience-rating",
    "feedback-case",
    "feedback-case-disposition",
    "feedback-case-follow-up",
    "feedback-attention",
    "triage-sla",
    "staff-attention-digest",
    "feedback-privacy-policy",
    "feedback-redaction",
    "feedback-privacy-hold",
    "sensitive-feedback-export"
  ],
  "streamPrefix": "customer-feedback.",
  "apiBasePath": "/api/customer-feedback",
  "slices": ["csat", "cases", "attention", "privacy"],
  "allowedSupportDirectories": ["runtime-support"],
  "publicExports": [".", "./context", "./routes/*", "./server"],
  "allowedContextDependencies": [],
  "seedRequirements": [],
  "eventReactions": [
    {
      "sourceContextName": "customer-feedback",
      "reactionName": "customer-feedback-feedback-case-opening",
      "subscriptionVersion": 1,
      "filterToEventTypes": true,
      "eventTypes": ["customer-feedback.survey.submitted", "customer-feedback.response.redacted"],
      "order": 10,
      "reactionHandlerSetNames": ["customer-feedback-feedback-case-opening"],
      "idempotencyPolicy": "idempotent-command-dispatch",
      "retryPolicy": "retry-from-last-checkpoint",
      "failurePolicy": "surface-as-reaction-failure"
    },
    {
      "sourceContextName": "notifications",
      "reactionName": "customer-feedback-notification-delivery-recording",
      "subscriptionVersion": 1,
      "filterToEventTypes": true,
      "eventTypes": ["notifications.customer-feedback.delivery-reported"],
      "order": 20,
      "reactionHandlerSetNames": ["customer-feedback-notification-delivery-recording"],
      "idempotencyPolicy": "idempotent-command-dispatch",
      "retryPolicy": "retry-from-last-checkpoint",
      "failurePolicy": "surface-as-reaction-failure"
    }
  ],
  "projectionGroups": [
    {
      "projectionName": "customer-feedback-csat-invitation-projection",
      "sourceContextNames": ["customer-feedback"],
      "ownedTables": ["customer_feedback_csat_invitations", "customer_feedback_response_privacy_audit"],
      "requiredDuringBootstrap": false,
      "resetStrategy": "truncate-owned-tables"
    },
    {
      "projectionName": "customer-feedback-csat-analytics-projection",
      "sourceContextNames": ["customer-feedback"],
      "ownedTables": ["customer_feedback_csat_analytics_facts"],
      "requiredDuringBootstrap": false,
      "resetStrategy": "truncate-owned-tables"
    },
    {
      "projectionName": "customer-feedback-feedback-case-opening",
      "handlerKind": "reaction",
      "sourceContextNames": ["customer-feedback"],
      "ownedTables": [],
      "requiredDuringBootstrap": false,
      "resetStrategy": "replay-only"
    },
    {
      "projectionName": "customer-feedback-feedback-case-projection",
      "sourceContextNames": ["customer-feedback"],
      "ownedTables": ["customer_feedback_feedback_cases", "customer_feedback_feedback_case_timeline"],
      "requiredDuringBootstrap": false,
      "resetStrategy": "truncate-owned-tables"
    },
    {
      "projectionName": "customer-feedback-case-attention-projection",
      "sourceContextNames": ["customer-feedback"],
      "ownedTables": ["customer_feedback_case_attention", "customer_feedback_attention_digest_runs"],
      "requiredDuringBootstrap": false,
      "resetStrategy": "truncate-owned-tables"
    },
    {
      "projectionName": "customer-feedback-notification-delivery-recording",
      "handlerKind": "reaction",
      "sideEffectOnly": true,
      "sourceContextNames": ["notifications"],
      "ownedTables": [],
      "requiredDuringBootstrap": false,
      "resetStrategy": "replay-only"
    },
    {
      "projectionName": "platform-policy-document-projection",
      "sourceContextNames": ["customer-feedback"],
      "ownedTables": ["platform_policy_documents", "platform_policy_document_history"],
      "requiredDuringBootstrap": false,
      "resetStrategy": "truncate-owned-tables"
    }
  ],
  "hostPorts": [],
  "apiDeployables": ["platform-api"],
  "apiRuntimeProfiles": ["proof", "public"],
  "apiMounts": [
    {
      "mountPath": "/api/customer-feedback",
      "kind": "primary",
      "requiresAuth": true
    }
  ],
  "mutationConsistencyInventory": [
    {
      "id": "customer-feedback.privacy-command-snapshots",
      "owner": "customer-feedback",
      "risk": "important",
      "strategy": "snapshot-return",
      "surfaces": [
        "api-route:bounded-contexts/customer-feedback/features/privacy/api/route.ts:POST /privacy/responses/:invitationId/redactions",
        "api-route:bounded-contexts/customer-feedback/features/privacy/api/route.ts:POST /privacy/responses/:invitationId/holds",
        "api-route:bounded-contexts/customer-feedback/features/privacy/api/route.ts:POST /privacy/responses/:invitationId/holds/:holdId/release",
        "api-route:bounded-contexts/customer-feedback/features/privacy/api/route.ts:POST /privacy/retention/runs"
      ],
      "visibleDestination": {
        "description": "Privacy commands return the committed aggregate privacy state, and retention commands return the durable run cursor and counters written by that request."
      },
      "proof": {
        "authoritativeResponse": "Redaction and hold routes return state produced by the event-store command result; retention returns the persisted run snapshot after its bounded batch update.",
        "tests": [
          "bounded-contexts/customer-feedback/features/csat/domain/invitation-decider.test.ts proves committed redaction and hold state, replay, and idempotency.",
          "bounded-contexts/customer-feedback/features/privacy/api/runtime.test.ts proves preview, execution, durable cursor counters, holds, and concurrent-run exclusion."
        ]
      }
    },
    {
      "id": "customer-feedback.case-attention-command-snapshots",
      "owner": "customer-feedback",
      "risk": "important",
      "strategy": "snapshot-return",
      "surfaces": [
        "api-route:bounded-contexts/customer-feedback/features/attention/api/route.ts:POST /cases/:caseId/follow-up",
        "api-route:bounded-contexts/customer-feedback/features/attention/api/route.ts:POST /cases/:caseId/reopen"
      ],
      "visibleDestination": {
        "description": "Customer Feedback case actions return the committed case snapshot used to reconcile operator follow-up and attention state."
      },
      "proof": {
        "authoritativeResponse": "The event-sourced command handler returns state after the append commits, and the route exposes only the bounded operational snapshot.",
        "tests": [
          "bounded-contexts/customer-feedback/features/attention/api/route.test.ts proves notify/manage authorization and committed snapshot responses."
        ]
      }
    }
  ],
  "deployableContributions": [
    {
      "deployable": "admin-web",
      "routes": [
        {
          "routeId": "customer-feedback-attention",
          "routePath": "customer-feedback/attention",
          "fileExport": "./routes/admin/attention",
          "routeType": "route",
          "sourceContext": "customer-feedback",
          "section": "support"
        }
      ]
    }
  ],
  "shellContributions": [
    {
      "deployable": "admin-web",
      "slot": "primary-nav",
      "key": "customer-feedback-attention",
      "label": "Customer Feedback",
      "icon": "message",
      "href": "/customer-feedback/attention",
      "section": "support",
      "order": 20,
      "visibility": "signed-in",
      "requiredPermissions": ["support.view"]
    }
  ],
  "directoryIntent": {
    "csat": {
      "classification": "slice",
      "purpose": "Own the versioned transactional-CSAT contract and invitation lifecycle: survey identity, the workflow/outcome allow-list, outcome-fact redemption, eligibility, sampling, suppression, expiry, single-use recording and submission, the invitation query projection, replayable analytics facts, metrics, and legacy classification.",
      "expectedConsumers": [
        "Internal customer-feedback module composition",
        "Customer Feedback invitation, recording, and analytics leaves"
      ]
    },
    "cases": {
      "classification": "slice",
      "purpose": "Own the attributed, event-sourced feedback case lifecycle opened from immutable CSAT responses, including triage, ownership, priority, disposition, linked work, consented follow-up, closure, and reopen.",
      "expectedConsumers": [
        "Customer Feedback case opening reaction",
        "Future Customer Feedback operator queue and detail surfaces"
      ]
    },
    "attention": {
      "classification": "slice",
      "purpose": "Own low-score attention classification, triage SLA aging, breach visibility, and bounded staff digest inputs.",
      "expectedConsumers": ["Customer Feedback operator attention surface", "Notifications staff digest integration"]
    },
    "privacy": {
      "classification": "slice",
      "purpose": "Own the versioned privacy classification, response redaction and hold behavior, consent applicability, sensitive access/export audit, artifact expiry, and bounded retention execution.",
      "expectedConsumers": ["Customer Feedback privacy APIs", "Customer Feedback retention operations"]
    },
    "runtime-support": {
      "classification": "support",
      "purpose": "Provide CSAT invitation event-store, wake notification, schema, and runtime service composition for the aggregate and projections.",
      "expectedConsumers": ["Root customer-feedback module composition"]
    },
    "routes": {
      "classification": "routes",
      "purpose": "Reserve Customer Feedback route metadata for the future csat invitation, survey, and operator page route contributions.",
      "expectedConsumers": ["Future generated deployable route adapters"]
    }
  },
  "runtimeDeployables": ["platform-worker"],
  "workerRuntimeProfiles": ["proof", "public"]
}
