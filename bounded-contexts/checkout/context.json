        "apiContextName": "checkout",
        "apiRoutePath": "/account/sell-list",
        "readModelTables": ["checkout_sell_list_line_pages", "checkout_sell_list_confirmation_pages"],
        "transientRecovery": "Sell List add/remove and readiness forms submit through the account Sell List action, which redirects with a Checkout commit receipt; the account Sell List loader waits on line and confirmation projections, while seller checkout start revalidates checkout.sell-list-readiness.v1 before continuing."
      },
      "proof": {
        "tests": [
