        "tests": [
          "bounded-contexts/checkout/features/cart/ui/cart-page.test.tsx",
          "bounded-contexts/checkout/routes/account-cart-route.test.ts"
        ]
      }
    },
    {
      "id": "checkout.sell-list-api-command-snapshots",
      "owner": "checkout",
      "risk": "important",
      "strategy": "snapshot-return",
      "surfaces": [
