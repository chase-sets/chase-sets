    {
      "id": "checkout.cart-self-refresh-fresh-read-forms",
      "owner": "checkout",
      "risk": "important",
      "strategy": "fresh-read",
      "surfaces": ["post-form:bounded-contexts/checkout/features/cart/ui/add-to-cart-section.tsx:H2df726441e2a#1"],
      "visibleDestination": {
        "routeId": "account-cart",
        "apiContextName": "checkout",
        "apiRoutePath": "/account/cart",
        "readModelTables": ["checkout_cart_line_pages"],
        "transientRecovery": "Buy Cart non-quantity forms submit through the account cart action, which redirects with a Checkout commit receipt; the account cart loader waits on checkout_cart_line_pages and shows temporary cart recovery for valid fresh-write projection lag."
      },
