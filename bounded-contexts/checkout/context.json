{
  "contextName": "checkout",
  "packageName": "@chase-sets/checkout",
  "ownedNouns": ["cart", "sell list", "checkout session"],
  "streamPrefix": "checkout.",
  "apiBasePath": "/api/marketplace",
  "slices": ["cart", "sell-list", "sessions", "support-lookup"],
  "allowedSupportDirectories": ["request-support", "route-support", "runtime-support", "seed-support", "ucp-support"],
  "publicExports": [".", "./context", "./routes/*", "./seed-support/*", "./server"],
  "allowedContextDependencies": [
    "@chase-sets/auth",
    "@chase-sets/identity",
    "@chase-sets/marketplace",
    "@chase-sets/ordering",
    "@chase-sets/payments",
    "@chase-sets/settlement"
  ],
  "seedRequirements": ["catalog", "identity", "inventory", "marketplace"],
  "eventSubscriptions": [
    {
      "sourceContextName": "catalog",
      "projectionName": "checkout-catalog-item-projection",
      "subscriptionVersion": 1,
      "eventTypes": [
        "catalog.catalog-item.created",
        "catalog.catalog-item.blueprint-assigned",
        "catalog.catalog-item.metadata-revised",
        "catalog.catalog-item.published",
        "catalog.catalog-item.retired",
        "catalog.catalog-item.archived",
        "catalog.blueprint.created",
        "catalog.blueprint.revised",
        "catalog.blueprint.dimensions-set",
        "catalog.blueprint.product-resolution-rules-set",
        "catalog.blueprint.published",
        "catalog.dimension.created",
        "catalog.dimension.revised",
        "catalog.dimension.option-added",
        "catalog.dimension.option-revised"
      ],
      "order": 10,
      "projectionHandlerSetNames": ["checkout.catalog-projection"]
    }
  ],
  "projectionGroups": [
    {
      "projectionName": "checkout.cart-projection",
      "sourceContextNames": ["checkout"],
      "ownedTables": ["checkout_cart_line_pages"],
      "requiredDuringBootstrap": false,
      "resetStrategy": "truncate-owned-tables"
    },
    {
      "projectionName": "checkout.sell-list-projection",
      "sourceContextNames": ["checkout"],
      "ownedTables": ["checkout_sell_list_line_pages", "checkout_sell_list_confirmation_pages"],
      "requiredDuringBootstrap": false,
      "resetStrategy": "truncate-owned-tables"
    },
    {
      "projectionName": "checkout.session-projection",
      "sourceContextNames": ["checkout"],
      "ownedTables": ["checkout_session_pages"],
      "requiredDuringBootstrap": false,
      "resetStrategy": "truncate-owned-tables"
    },
    {
      "projectionName": "checkout-catalog-item-projection",
      "sourceContextNames": ["catalog"],
      "ownedTables": [
        "checkout_catalog_items",
        "checkout_catalog_blueprints",
        "checkout_catalog_dimensions",
        "checkout_catalog_dimension_options"
      ],
      "requiredDuringBootstrap": true,
      "resetStrategy": "replay-only"
    }
  ],
  "apiDeployables": ["platform-api"],
  "sourceRuntimeDeployables": ["platform-api"],
  "apiMounts": [
    {
      "mountPath": "/api/marketplace",
      "kind": "primary",
      "requiresAuth": true,
      "readFreshnessRoutes": [
        {
          "routePath": "/account/cart",
          "methods": ["GET", "HEAD"],
          "dependencies": [
            {
              "readModelTable": "checkout_cart_line_pages"
            }
          ]
        },
        {
          "routePath": "/account/sell-list",
          "methods": ["GET", "HEAD"],
          "dependencies": [
            {
              "readModelTable": "checkout_sell_list_line_pages"
            },
            {
              "readModelTable": "checkout_sell_list_confirmation_pages"
            }
          ]
        },
        {
          "routePath": "/account/checkout-sessions/:sessionId",
          "methods": ["GET", "HEAD"],
          "dependencies": [
            {
              "readModelTable": "checkout_session_pages"
            }
          ]
        }
      ]
    }
  ],
  "readAfterWriteRouteInventory": [
    {
      "id": "checkout.session-start-to-detail",
      "owner": "checkout",
      "risk": "critical",
      "source": {
        "routeId": "buy-checkout-readiness",
        "actions": ["Start account checkout session", "Start guest Buy Now checkout session"],
        "command": "StartCheckoutSession",
        "helperUses": ["appendFreshWriteToken"]
      },
      "destination": {
        "routeId": "buy-checkout-session",
        "apiContextName": "checkout",
        "apiRoutePath": "/account/checkout-sessions/:sessionId",
        "readModelTables": ["checkout_session_pages"],
        "helperUses": ["loadFreshlyWrittenResource"],
        "transientRecovery": "Checkout session loader converts fresh-write 404, projection_freshness_timeout, and bounded gateway/service timeouts into temporary checkout recovery UI that actively revalidates on a bounded schedule until the session is pay-ready or the fresh-write token expires, then degrades to manual recovery."
      }
    },
    {
      "id": "checkout.session-payment-handoff",
      "owner": "checkout",
      "risk": "critical",
      "source": {
        "routeId": "buy-checkout-session",
        "actions": ["Confirm checkout", "Continue to payment"],
        "command": "ConfirmCheckoutSession",
        "helperUses": ["appendFreshWriteToken"]
      },
      "destination": {
        "routeId": "buy-checkout-confirmation",
        "apiContextName": "checkout",
        "apiRoutePath": "/account/checkout-sessions/:sessionId",
        "readModelTables": ["checkout_session_pages"],
        "helperUses": ["loadFreshlyWrittenResource"],
        "transientRecovery": "Checkout confirmation reads the freshly confirmed checkout session before exposing the payment continuation. Payment detail freshness remains owned by Payments when the buyer follows the preserved fresh-write payment link."
      }
    },
    {
      "id": "checkout.session-self-refresh",
      "owner": "checkout",
      "risk": "critical",
      "source": {
        "routeId": "buy-checkout-session",
        "actions": ["Refresh checkout preview", "Update checkout review state"],
        "command": "Checkout session review commands",
        "helperUses": ["appendFreshWriteToken", "appendFreshWriteTokenFromSources"]
      },
      "destination": {
        "routeId": "buy-checkout-session",
        "apiContextName": "checkout",
        "apiRoutePath": "/account/checkout-sessions/:sessionId",
        "readModelTables": ["checkout_session_pages"],
        "helperUses": ["loadFreshlyWrittenResource"],
        "transientRecovery": "Checkout session self-refresh uses exact checkout-session-page freshness and Checkout temporary recovery UI with bounded active revalidation until pay-ready or fresh-write token expiry."
      }
    },
    {
      "id": "checkout.session-offer-handoff",
      "owner": "checkout",
      "risk": "important",
      "source": {
        "routeId": "buy-checkout-session",
        "actions": ["Submit offer intent"],
        "command": "ConfirmCheckoutSession",
        "helperUses": ["appendFreshWriteToken"]
      },
      "destination": {
        "routeId": "account-offer-submitted",
        "transientRecovery": "Marketplace submitted-offer detail owns exact offer-page freshness and bounded fresh-write not-found retry."
      },
      "exception": {
        "status": "accepted",
        "owner": "checkout",
        "reviewBy": "2026-07-31",
        "issue": "#1809",
        "reason": "Checkout only originates the cross-context offer handoff; exact destination freshness is owned by marketplace.submitted-offer-detail in the Marketplace context."
      }
    },
    {
      "id": "checkout.cart-self-refresh",
      "owner": "checkout",
      "risk": "important",
      "source": {
        "routeId": "account-cart",
        "actions": ["Update account cart"],
        "command": "Checkout cart commands",
        "helperUses": ["appendFreshWriteToken"]
      },
      "destination": {
        "routeId": "account-cart",
        "apiContextName": "checkout",
        "apiRoutePath": "/account/cart",
        "readModelTables": ["checkout_cart_line_pages"],
        "helperUses": ["loadFreshlyWrittenResource"],
        "transientRecovery": "Account cart self-refresh uses the fresh-read strategy: it waits on the exact checkout cart line page projection and converts valid afterWrite projection timeouts into temporary cart recovery while missing, malformed, or expired receipts stay on the permanent API error path."
      }
    },
    {
      "id": "checkout.sell-list-self-refresh",
      "owner": "checkout",
      "risk": "important",
      "source": {
        "routeId": "account-sell-list",
        "actions": ["Update account sell list"],
        "command": "Checkout sell-list commands",
        "helperUses": ["appendFreshWriteToken"]
      },
      "destination": {
        "routeId": "account-sell-list",
        "apiContextName": "checkout",
        "apiRoutePath": "/account/sell-list",
        "readModelTables": ["checkout_sell_list_line_pages", "checkout_sell_list_confirmation_pages"],
        "helperUses": ["loadFreshlyWrittenResource"],
        "transientRecovery": "Account Sell List self-refresh uses the fresh-read strategy: it waits on exact sell-list line and confirmation page projections and converts valid afterWrite projection timeouts into temporary Sell List recovery while missing, malformed, or expired receipts stay on the permanent API error path."
      }
    },
    {
      "id": "checkout.guest-sell-list-to-checkout",
      "owner": "checkout",
      "risk": "important",
      "source": {
        "routeId": "account-sell-list",
        "actions": ["Start guest seller checkout from Sell List readiness"],
        "command": "CreateGuestSellListReadiness",
        "helperUses": ["appendFreshWriteToken"]
      },
      "destination": {
        "routeId": "sell-checkout-session",
        "transientRecovery": "Guest sell checkout revalidates checkout.sell-list-readiness.v1 from the anonymous Sell List and fails closed to Sell List readiness recovery; no label, payout, sale, settlement, notification, or account-history side effects are attempted in this slice."
      },
      "exception": {
        "status": "accepted",
        "owner": "checkout",
        "reviewBy": "2026-07-31",
        "issue": "#1809",
        "reason": "Guest sell checkout revalidates anonymous Sell List readiness through the existing guest Sell List API and needs bounded audit classification before seller runtime orchestration remediation."
      }
    }
  ],
  "mutationConsistencyInventory": [
    {
      "id": "checkout.cart-quantity-optimistic-correction",
      "owner": "checkout",
      "risk": "important",
      "strategy": "optimistic-with-correction",
      "surfaces": [
        "fetcher-submit:bounded-contexts/checkout/features/cart/ui/cart-page.tsx:H7f1ccc11975d#1",
        "route-action:bounded-contexts/checkout/routes/account-cart.tsx"
      ],
      "visibleDestination": {
        "routeId": "account-cart",
        "description": "Buy Cart quantity controls update visible quantity, line total, subtotal, and cart count immediately, then reconcile to the authoritative cart loader state."
      },
      "proof": {
        "correction": "The control submits absolute target quantities with optimisticStrategy=optimistic-with-correction and correctionSource=fresh-read:loader-revalidation; per-line writes are serialized and coalesced, fresh loader quantity clears the optimistic override, and route-owned errors roll back to loader truth.",
        "tests": [
          "bounded-contexts/checkout/features/cart/ui/optimistic-correction.test.tsx",
          "bounded-contexts/checkout/features/cart/ui/cart-page.test.tsx",
          "bounded-contexts/checkout/routes/account-cart-route.test.ts"
        ]
      }
    },
    {
      "id": "checkout.cart-non-quantity-form-migration",
      "owner": "checkout",
      "risk": "important",
      "strategy": "migration",
      "surfaces": [
        "post-form:bounded-contexts/checkout/features/cart/ui/cart-page.tsx:H2df726441e2a#2",
        "post-form:bounded-contexts/checkout/features/cart/ui/cart-page.tsx:H2df726441e2a#3",
        "post-form:bounded-contexts/checkout/features/cart/ui/cart-page.tsx:H2df726441e2a#4"
      ],
      "exception": {
        "owner": "checkout",
        "issue": "#1809",
        "reviewBy": "2026-07-31",
        "reason": "Lock listing, remove line, and checkout-readiness forms were reclassified only because the cart page split nested forms while preserving existing behavior; full non-quantity cart mutation strategy audit remains in the #1809 baseline."
      }
    }
  ],
  "deployableContributions": [
    {
      "deployable": "marketplace-web",
      "routes": [
        {
          "routeId": "account-cart",
          "routePath": "account/cart",
          "fileExport": "./routes/account-cart",
          "routeType": "route",
          "sourceContext": "checkout"
        },
        {
          "routeId": "account-sell-list",
          "routePath": "account/sell-list",
          "fileExport": "./routes/account-sell-list",
          "routeType": "route",
          "sourceContext": "checkout"
        },
        {
          "routeId": "sell-checkout-session",
          "routePath": "checkout/sell/session/:sessionId",
          "fileExport": "./routes/sell-checkout-session",
          "routeType": "route",
          "sourceContext": "checkout"
        },
        {
          "routeId": "sell-checkout-confirmation",
          "routePath": "checkout/sell/session/:sessionId/confirmation",
          "fileExport": "./routes/sell-checkout-confirmation",
          "routeType": "route",
          "sourceContext": "checkout"
        },
        {
          "routeId": "buy-checkout-readiness",
          "routePath": "checkout/buy/readiness",
          "fileExport": "./routes/checkout-start",
          "routeType": "route",
          "sourceContext": "checkout"
        },
        {
          "routeId": "buy-checkout-session",
          "routePath": "checkout/buy/session/:sessionId",
          "fileExport": "./routes/checkout-session",
          "routeType": "route",
          "sourceContext": "checkout"
        },
        {
          "routeId": "buy-checkout-confirmation",
          "routePath": "checkout/buy/session/:sessionId/confirmation",
          "fileExport": "./routes/buy-checkout-confirmation",
          "routeType": "route",
          "sourceContext": "checkout"
        }
      ]
    }
  ],
  "shellContributions": [
    {
      "deployable": "marketplace-web",
      "slot": "top-nav",
      "key": "sell-list",
      "label": "Sell List",
      "icon": "store",
      "href": "/account/sell-list",
      "order": 111,
      "visibility": "signed-in",
      "requiredPermissions": []
    },
    {
      "deployable": "marketplace-web",
      "slot": "top-nav",
      "key": "cart",
      "label": "Buy Cart",
      "icon": "cart",
      "href": "/account/cart",
      "order": 110,
      "visibility": "signed-in",
      "requiredPermissions": []
    },
    {
      "deployable": "marketplace-web",
      "slot": "bottom-nav",
      "key": "sell-list",
      "label": "Sell List",
      "icon": "store",
      "href": "/account/sell-list",
      "order": 111,
      "visibility": "signed-in",
      "requiredPermissions": []
    },
    {
      "deployable": "marketplace-web",
      "slot": "bottom-nav",
      "key": "cart",
      "label": "Buy Cart",
      "icon": "cart",
      "href": "/account/cart",
      "order": 110,
      "visibility": "signed-in",
      "requiredPermissions": []
    }
  ],
  "directoryIntent": {
    "cart": {
      "classification": "slice",
      "purpose": "Own long-lived buy cart intent before an active checkout session starts.",
      "expectedConsumers": ["Internal checkout module composition"]
    },
    "sell-list": {
      "classification": "slice",
      "purpose": "Own seller checkout intent before selected offers or product-level Smart Match lines become sale commitments.",
      "expectedConsumers": ["Internal checkout module composition", "Discovery item detail sell actions"]
    },
    "sessions": {
      "classification": "slice",
      "purpose": "Own checkout session lifecycle, review state, selected shipping, and orchestration status.",
      "expectedConsumers": ["Internal checkout module composition"]
    },
    "support-lookup": {
      "classification": "slice",
      "purpose": "Own support-safe lookup of Checkout-owned pending and committed checkout facts.",
      "expectedConsumers": ["Internal checkout module composition"]
    },
    "request-support": {
      "classification": "support",
      "purpose": "Provide checkout request API clients and Checkout-owned Ordering/Payments confirmation adapters for routes and external purchase-intent entry points.",
      "expectedConsumers": ["cart", "sell-list", "sessions"],
      "crossCuttingRuntimeComposition": true
    },
    "route-support": {
      "classification": "support",
      "purpose": "Provide checkout route loader/action modules for buy checkout and sell checkout route adapters.",
      "expectedConsumers": ["routes"]
    },
    "runtime-support": {
      "classification": "support",
      "purpose": "Provide checkout runtime service and schema composition until runtime composition can be generated.",
      "expectedConsumers": ["cart", "sell-list", "sessions"]
    },
    "seed-support": {
      "classification": "support",
      "purpose": "Publish deterministic checkout session seed ids for checkout-owned cart and started-session development data.",
      "expectedConsumers": ["Tests and development seed orchestration"]
    },
    "ucp-support": {
      "classification": "support",
      "purpose": "Provide Checkout-owned UCP adapters for AI-agent checkout operations without moving buyer authorization or session lifecycle rules into deployables.",
      "expectedConsumers": ["platform-api UCP composition"]
    },
    "routes": {
      "classification": "routes",
      "purpose": "Expose checkout-owned route modules consumed by generated deployable adapters.",
      "expectedConsumers": ["Generated deployable route adapters"]
    }
  },
  "hostPorts": [
    {
      "portName": "checkoutObservabilityTelemetry",
      "providedBy": "platform-api",
      "purpose": "Emits bounded, redacted Milestone #17 Checkout observability events through the platform observability runtime."
    }
  ],
  "runtimeDeployables": ["platform-worker"]
}
