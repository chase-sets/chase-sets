      },
      "proof": {
        "authoritativeResponse": "The Sell List API responds from command results without waiting for list projections; confirmation returns the command-owned confirmation snapshot and idempotent duplicate posts return the existing confirmation snapshot without replaying marketplace handoff.",
        "tests": [
          "bounded-contexts/checkout/features/sell-list/api/route.test.ts",
          "bounded-contexts/checkout/features/sell-list/api/runtime.test.ts",
          "bounded-contexts/checkout/routes/sell-checkout-session-route.test.ts"
