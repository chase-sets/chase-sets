{
  "contextName": "fulfillment",
  "packageName": "@chase-sets/fulfillment",
  "ownedNouns": ["shipment", "return-shipment"],
  "streamPrefix": "fulfillment.",
  "apiBasePath": "/api/marketplace",
  "slices": ["shipments", "return-shipments"],
  "allowedSupportDirectories": ["request-support", "runtime-support", "seed-support"],
  "publicExports": [".", "./context", "./routes/*", "./seed-support/*", "./server"],
  "allowedContextDependencies": ["@chase-sets/customer-feedback", "@chase-sets/identity"],
  "seedRequirements": ["identity", "payments", "ordering"],
  "eventSubscriptions": [
    {
      "sourceContextName": "identity",
      "projectionName": "fulfillment-account-projection",
      "subscriptionVersion": 1,
      "eventTypes": [
        "identity.account.created",
        "identity.account.profile-updated",
        "identity.account.suspended",
        "identity.account.reactivated",
        "identity.account.closed"
      ],
      "order": 10,
      "projectionHandlerSetNames": ["fulfillment-account-projection"]
    },
    {
      "sourceContextName": "ordering",
      "projectionName": "fulfillment-order-source-projection",
      "subscriptionVersion": 1,
      "eventTypes": [
        "ordering.order.created",
        "ordering.order.pending-payment-recorded",
        "ordering.order.cancelled",
        "ordering.order.ready-for-fulfillment-recorded"
      ],
      "order": 20,
      "projectionHandlerSetNames": ["fulfillment-order-source-projection"]
    },
    {
      "sourceContextName": "payments",
      "projectionName": "fulfillment-payment-fraud-source-projection",
      "subscriptionVersion": 1,
      "eventTypes": [
        "payments.payment-fraud-warning-received",
        "payments.payment-fraud-review-opened",
        "payments.payment-fraud-review-closed"
      ],
      "order": 30,
      "projectionHandlerSetNames": ["fulfillment-payment-fraud-source-projection"]
    },
    {
      "sourceContextName": "platform-operations",
      "projectionName": "fulfillment-support-return-source-projection",
      "subscriptionVersion": 1,
      "eventTypes": [
        "support.support-request.opened",
        "support.support-request.affected-line-items-recorded",
        "support.support-request.remedy-authorized.v1"
      ],
      "order": 40,
      "projectionHandlerSetNames": ["fulfillment-support-return-source-projection"]
    }
  ],
  "projectionGroups": [
    {
      "projectionName": "fulfillment-account-projection",
      "sourceContextNames": ["identity"],
      "ownedTables": ["fulfillment_account_pages"],
      "requiredDuringBootstrap": true,
      "resetStrategy": "replay-only"
    },
    {
      "projectionName": "fulfillment-order-source-projection",
      "sourceContextNames": ["ordering"],
      "ownedTables": ["fulfillment_order_sources", "fulfillment_order_source_lines"],
      "requiredDuringBootstrap": true,
      "resetStrategy": "replay-only"
    },
    {
      "projectionName": "fulfillment-payment-fraud-source-projection",
      "sourceContextNames": ["payments"],
      "ownedTables": ["fulfillment_payment_fraud_review_holds"],
      "requiredDuringBootstrap": true,
      "resetStrategy": "replay-only"
    },
    {
      "projectionName": "fulfillment-support-return-source-projection",
      "sourceContextNames": ["platform-operations"],
      "ownedTables": ["fulfillment_support_return_sources", "fulfillment_support_return_remedy_sources"],
      "requiredDuringBootstrap": true,
      "resetStrategy": "replay-only"
    },
    {
      "projectionName": "fulfillment-shipment-projection",
      "sourceContextNames": ["fulfillment"],
      "ownedTables": [
        "fulfillment_shipment_pages",
        "fulfillment_shipment_line_pages",
        "fulfillment_shipment_exception_pages",
        "fulfillment_label_address_override_audit_pages",
        "fulfillment_postage_label_operations",
        "fulfillment_postage_provider_events"
      ],
      "requiredDuringBootstrap": false,
      "resetStrategy": "replay-only"
    },
    {
      "projectionName": "fulfillment-return-shipment-projection",
      "sourceContextNames": ["fulfillment"],
      "ownedTables": [
        "fulfillment_return_shipment_customer_pages",
        "fulfillment_return_shipment_operator_pages",
        "fulfillment_unidentified_return_package_pages",
        "fulfillment_return_shipment_provider_events"
      ],
      "requiredDuringBootstrap": false,
      "resetStrategy": "replay-only"
    }
  ],
  "hostPorts": [
    {
      "portName": "postageLabelProvider",
      "providedBy": "platform-api",
      "purpose": "Supplies the configured USPS-compatible postage provider so fulfillment can purchase, void, and test labels without owning deployable environment configuration."
    },
    {
      "portName": "postageWebhookGateway",
      "providedBy": "platform-api",
      "purpose": "Verifies and normalizes postage provider webhook payloads before fulfillment records provider events and advances shipment state."
    },
    {
      "portName": "notificationOutbox",
      "providedBy": "platform-worker",
      "purpose": "Durable outbound notification outbox consumed only by shipment event projectors."
    }
  ],
  "mcpCapabilities": {
    "tools": [
      { "name": "fulfillment.list-shipments", "ownerSlice": "shipments" },
      { "name": "fulfillment.get-tracking", "ownerSlice": "shipments" },
      { "name": "fulfillment.purchase-label", "ownerSlice": "shipments" },
      { "name": "fulfillment.advance-shipment", "ownerSlice": "shipments" },
      { "name": "fulfillment.dispatch-shipment", "ownerSlice": "shipments" },
      { "name": "fulfillment.raise-shipment-exception", "ownerSlice": "shipments" },
      { "name": "fulfillment.void-label", "ownerSlice": "shipments" }
    ],
    "resources": [
      {
        "uriTemplate": "chase-sets://fulfillment/{accountId}/shipments/{shipmentId}",
        "ownerSlice": "shipments"
      }
    ]
  },
  "apiDeployables": ["platform-api"],
  "apiMounts": [
    {
      "mountPath": "/api/marketplace",
      "kind": "primary",
      "requiresAuth": true,
      "readFreshnessRoutes": [
        {
          "routePath": "/account/sales/shipments/:id",
          "methods": ["GET", "HEAD"],
          "dependencies": [
            {
              "readModelTable": "fulfillment_shipment_pages"
            },
            {
              "readModelTable": "fulfillment_shipment_line_pages"
            },
            {
              "readModelTable": "fulfillment_shipment_exception_pages"
            },
            {
              "readModelTable": "fulfillment_label_address_override_audit_pages"
            },
            {
              "readModelTable": "fulfillment_postage_label_operations"
            },
            {
              "readModelTable": "fulfillment_postage_provider_events"
            }
          ]
        }
      ]
    },
    {
      "mountPath": "/api/fulfillment/provider",
      "kind": "additional",
      "requiresAuth": false
    }
  ],
  "readAfterWriteRouteInventory": [
    {
      "id": "fulfillment.seller-shipment-self-refresh",
      "owner": "fulfillment",
      "risk": "important",
      "freshnessSlo": {
        "flowClass": "important-self-refresh",
        "p95Ms": 2500,
        "p99Ms": 5000
      },
      "source": {
        "routeIds": ["account-sale-shipment", "account-sale-shipment-packing"],
        "actions": [
          "Start packing",
          "Complete packing",
          "Purchase or void label",
          "Dispatch shipment",
          "Record delivery, return, or exception"
        ],
        "command": "Fulfillment shipment commands",
        "helperUses": ["navigateAfterWrite"]
      },
      "destination": {
        "routeIds": ["account-sale-shipment", "account-sale-shipment-packing"],
        "apiContextName": "fulfillment",
        "apiRoutePath": "/account/sales/shipments/:id",
        "readModelTables": [
          "fulfillment_shipment_pages",
          "fulfillment_shipment_line_pages",
          "fulfillment_shipment_exception_pages",
          "fulfillment_label_address_override_audit_pages",
          "fulfillment_postage_label_operations",
          "fulfillment_postage_provider_events"
        ],
        "transientRecovery": {
          "kinds": "refreshable-catching-up",
          "behavior": "Seller shipment redirects carry the Fulfillment command receipt as afterWrite; seller shipment loaders forward the receipt to the Fulfillment API freshness gate and render temporary shipment recovery copy for fresh 404 or projection_freshness_timeout responses."
        }
      }
    }
  ],
  "mutationConsistencyInventory": [
    {
      "id": "fulfillment.shipment-command-snapshots",
      "owner": "fulfillment",
      "risk": "important",
      "strategy": "snapshot-return",
      "surfaces": [
        "api-route:bounded-contexts/fulfillment/features/shipments/api/route.ts:POST /postage/webhooks",
        "api-route:bounded-contexts/fulfillment/features/shipments/api/route.ts:POST /sales/shipments/:id/deliver",
        "api-route:bounded-contexts/fulfillment/features/shipments/api/route.ts:POST /sales/shipments/:id/dispatch",
        "api-route:bounded-contexts/fulfillment/features/shipments/api/route.ts:POST /sales/shipments/:id/exception",
        "api-route:bounded-contexts/fulfillment/features/shipments/api/route.ts:POST /sales/shipments/:id/label",
        "api-route:bounded-contexts/fulfillment/features/shipments/api/route.ts:POST /sales/shipments/:id/label/purchase",
        "api-route:bounded-contexts/fulfillment/features/shipments/api/route.ts:POST /sales/shipments/:id/label/void",
        "api-route:bounded-contexts/fulfillment/features/shipments/api/route.ts:POST /sales/shipments/:id/pack",
        "api-route:bounded-contexts/fulfillment/features/shipments/api/route.ts:POST /sales/shipments/:id/packing/lines/:lineId",
        "api-route:bounded-contexts/fulfillment/features/shipments/api/route.ts:POST /sales/shipments/:id/packing/start",
        "api-route:bounded-contexts/fulfillment/features/shipments/api/route.ts:POST /sales/shipments/:id/return"
      ],
      "visibleDestination": {
        "description": "Shipment lifecycle, packing, label, provider webhook, tracking, return, and exception API writes return Fulfillment-owned command snapshots with shipment id, aggregate version, committed status or provider processing result, and line/tracking fields where the command owns them."
      },
      "proof": {
        "authoritativeResponse": "bounded-contexts/fulfillment/features/shipments/api/route.ts builds each mutation response from the Fulfillment shipment command result before any projection read; platform API commit receipt headers attach to those responses when mounted.",
        "tests": ["bounded-contexts/fulfillment/features/shipments/api/route.test.ts"]
      }
    },
    {
      "id": "fulfillment.seller-shipment-detail-fresh-read",
      "owner": "fulfillment",
      "risk": "important",
      "strategy": "fresh-read",
      "surfaces": [
        "post-form:bounded-contexts/fulfillment/features/shipments/ui/shipment-detail-page.tsx:H2df726441e2a#1",
        "post-form:bounded-contexts/fulfillment/features/shipments/ui/shipment-detail-page.tsx:H2df726441e2a#2",
        "post-form:bounded-contexts/fulfillment/features/shipments/ui/shipment-detail-page.tsx:H2df726441e2a#3",
        "post-form:bounded-contexts/fulfillment/features/shipments/ui/shipment-detail-page.tsx:H2df726441e2a#4",
        "post-form:bounded-contexts/fulfillment/features/shipments/ui/shipment-detail-page.tsx:H2df726441e2a#5",
        "post-form:bounded-contexts/fulfillment/features/shipments/ui/shipment-detail-page.tsx:H2df726441e2a#6",
        "post-form:bounded-contexts/fulfillment/features/shipments/ui/shipment-detail-page.tsx:H2df726441e2a#7",
        "route-action:bounded-contexts/fulfillment/routes/marketplace/account-sale-shipment.tsx"
      ],
      "visibleDestination": {
        "routeId": "account-sale-shipment",
        "apiContextName": "fulfillment",
        "apiRoutePath": "/account/sales/shipments/:id",
        "readModelTables": [
          "fulfillment_shipment_pages",
          "fulfillment_shipment_line_pages",
          "fulfillment_shipment_exception_pages",
          "fulfillment_label_address_override_audit_pages",
          "fulfillment_postage_label_operations",
          "fulfillment_postage_provider_events"
        ],
        "transientRecovery": {
          "kinds": "refreshable-catching-up",
          "behavior": "Seller shipment detail redirects carry the Fulfillment command receipt as afterWrite; the loader forwards the receipt to the Fulfillment API freshness gate and renders temporary shipment update recovery for fresh 404 or projection_freshness_timeout responses."
        }
      },
      "proof": {
        "tests": [
          "bounded-contexts/fulfillment/routes/marketplace/account-sale-shipment-route.test.ts",
          "bounded-contexts/fulfillment/features/shipments/ui/packing-slip-page.test.tsx"
        ]
      }
    },
    {
      "id": "fulfillment.seller-shipment-packing-fresh-read",
      "owner": "fulfillment",
      "risk": "important",
      "strategy": "fresh-read",
      "surfaces": [
        "post-form:bounded-contexts/fulfillment/features/shipments/ui/shipment-packing-page.tsx:H2df726441e2a#1",
        "post-form:bounded-contexts/fulfillment/features/shipments/ui/shipment-packing-page.tsx:Ha72c19094e96#1"
      ],
      "visibleDestination": {
        "routeId": "account-sale-shipment-packing",
        "apiContextName": "fulfillment",
        "apiRoutePath": "/account/sales/shipments/:id",
        "readModelTables": [
          "fulfillment_shipment_pages",
          "fulfillment_shipment_line_pages",
          "fulfillment_shipment_exception_pages",
          "fulfillment_label_address_override_audit_pages",
          "fulfillment_postage_label_operations",
          "fulfillment_postage_provider_events"
        ],
        "transientRecovery": {
          "kinds": "refreshable-catching-up",
          "behavior": "Packing start and complete redirects carry the Fulfillment command receipt as afterWrite; seller shipment loaders forward the receipt and show temporary shipment recovery while the packing projection catches up."
        }
      },
      "proof": {
        "tests": [
          "bounded-contexts/fulfillment/routes/marketplace/account-sale-shipment-packing-route.test.ts",
          "bounded-contexts/fulfillment/features/shipments/ui/packing-slip-page.test.tsx"
        ]
      }
    },
    {
      "id": "fulfillment.packing-line-optimistic-correction",
      "owner": "fulfillment",
      "risk": "important",
      "strategy": "optimistic-with-correction",
      "surfaces": ["route-action:bounded-contexts/fulfillment/routes/marketplace/account-sale-shipment-packing.tsx"],
      "visibleDestination": {
        "routeId": "account-sale-shipment-packing",
        "description": "Packing line quantity controls update the visible packed count immediately, serialize each line's newest write with a per-line request sequence, reconcile to the command snapshot, and roll back only the latest failed write."
      },
      "proof": {
        "correction": "shipment-packing-page.tsx applies the requested packed quantity optimistically, ignores stale command responses for superseded per-line requests, reconciles to the returned line confirmedQuantity snapshot, rolls back failed latest writes, and keeps complete-packing disabled while writes are in flight.",
        "tests": [
          "bounded-contexts/fulfillment/features/shipments/ui/shipment-packing-optimistic-correction.test.tsx",
          "bounded-contexts/fulfillment/routes/marketplace/account-sale-shipment-packing-route.test.ts"
        ]
      }
    },
    {
      "id": "fulfillment.return-intake-command-snapshots",
      "owner": "fulfillment",
      "risk": "important",
      "strategy": "snapshot-return",
      "surfaces": [
        "api-client:bounded-contexts/fulfillment/client.ts:POST Hf450f96a7d7f#1",
        "api-route:bounded-contexts/fulfillment/features/return-shipments/api/route.ts:POST /:returnShipmentId/complete",
        "api-route:bounded-contexts/fulfillment/features/return-shipments/api/route.ts:POST /:returnShipmentId/corrections",
        "api-route:bounded-contexts/fulfillment/features/return-shipments/api/route.ts:POST /evidence",
        "api-route:bounded-contexts/fulfillment/features/return-shipments/api/route.ts:POST /unidentified",
        "api-route:bounded-contexts/fulfillment/features/return-shipments/api/route.ts:POST /unidentified/:unidentifiedPackageId/reconcile",
        "post-form:bounded-contexts/fulfillment/features/return-shipments/ui/facility-intake-page.tsx:H1abed2c1c746#1",
        "post-form:bounded-contexts/fulfillment/features/return-shipments/ui/facility-intake-page.tsx:H1abed2c1c746#2",
        "post-form:bounded-contexts/fulfillment/features/return-shipments/ui/facility-intake-page.tsx:H1abed2c1c746#3",
        "post-form:bounded-contexts/fulfillment/features/return-shipments/ui/facility-intake-page.tsx:H1abed2c1c746#4",
        "route-action:bounded-contexts/fulfillment/routes/admin/return-intake.tsx"
      ],
      "visibleDestination": {
        "description": "Facility intake writes return authoritative attachment, aggregate-version, duplicate, custody, correction, or reconciliation results. The workstation derives its success state from that command response and treats projection-backed queues as refreshable operational context."
      },
      "proof": {
        "authoritativeResponse": "The intake API builds mutation responses from private object-storage writes or aggregate command results. The admin action redirects only after those responses succeed, carries the authoritative outcome as its result state, and renders stale conflicts without claiming completion.",
        "tests": [
          "bounded-contexts/fulfillment/features/return-shipments/api/route.test.ts",
          "bounded-contexts/fulfillment/features/return-shipments/ui/facility-intake-page.test.tsx"
        ]
      }
    },
    {
      "id": "fulfillment.command-center-shipment-actions",
      "owner": "fulfillment",
      "risk": "important",
      "strategy": "snapshot-return",
      "surfaces": [
        "post-form:bounded-contexts/fulfillment/features/shipments/ui/fulfillment-command-center-page.tsx:H1abed2c1c746#1",
        "post-form:bounded-contexts/fulfillment/features/shipments/ui/fulfillment-command-center-page.tsx:H1abed2c1c746#2",
        "post-form:bounded-contexts/fulfillment/features/shipments/ui/fulfillment-command-center-page.tsx:H1abed2c1c746#3",
        "route-action:bounded-contexts/fulfillment/routes/marketplace/account-sale-shipments.tsx"
      ],
      "visibleDestination": {
        "description": "The fulfillment command center dispatches each named shipment action to the seller shipment command endpoints, which return authoritative command snapshots with shipment id and aggregate version. The work-ordered queue re-derives from those snapshots on reload and is treated as refreshable operational context, not a claimed inline read."
      },
      "proof": {
        "authoritativeResponse": "runShipmentCommandCenterAction gates each action through the shipment-action state machine, then calls the seller shipment command endpoints whose responses are built from the Fulfillment command result before any projection read; the route redirects only after those authoritative responses succeed and surfaces command errors without claiming completion.",
        "tests": [
          "bounded-contexts/fulfillment/features/shipments/domain/shipment-action.test.ts",
          "bounded-contexts/fulfillment/features/shipments/ui/fulfillment-command-center-page.test.tsx"
        ]
      }
    }
  ],
