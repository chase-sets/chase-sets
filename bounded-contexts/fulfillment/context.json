{
  "contextName": "fulfillment",
  "packageName": "@chase-sets/fulfillment",
  "ownedNouns": ["shipment"],
  "streamPrefix": "fulfillment.",
  "apiBasePath": "/api/marketplace",
  "slices": ["shipments"],
  "allowedSupportDirectories": ["request-support", "runtime-support", "seed-support"],
  "publicExports": [".", "./context", "./routes/*", "./seed-support/*", "./server"],
  "allowedContextDependencies": ["@chase-sets/identity"],
  "seedRequirements": ["identity", "payments", "ordering"],
  "eventSubscriptions": [
    {
      "sourceContextName": "identity",
      "projectionName": "fulfillment-account-projection",
      "subscriptionVersion": 1,
      "eventTypes": [
        "identity.account.created",
        "identity.account.profile-updated",
        "identity.account.suspended",
        "identity.account.reactivated",
        "identity.account.closed"
      ],
      "order": 10,
      "projectionHandlerSetNames": ["fulfillment-account-projection"]
    },
    {
      "sourceContextName": "ordering",
      "projectionName": "fulfillment-order-source-projection",
      "subscriptionVersion": 1,
      "eventTypes": [
        "ordering.order.created",
        "ordering.order.pending-payment-recorded",
        "ordering.order.cancelled",
        "ordering.order.ready-for-fulfillment-recorded"
      ],
      "order": 20,
      "projectionHandlerSetNames": ["fulfillment-order-source-projection"]
    }
  ],
  "projectionGroups": [
    {
      "projectionName": "fulfillment-account-projection",
      "sourceContextNames": ["identity"],
      "ownedTables": ["fulfillment_account_pages"],
      "requiredDuringBootstrap": true,
      "resetStrategy": "replay-only"
    },
    {
      "projectionName": "fulfillment-order-source-projection",
      "sourceContextNames": ["ordering"],
      "ownedTables": ["fulfillment_order_sources", "fulfillment_order_source_lines"],
      "requiredDuringBootstrap": true,
      "resetStrategy": "replay-only"
    }
  ],
  "hostPorts": [
    {
      "portName": "postageLabelProvider",
      "providedBy": "platform-api",
      "purpose": "Supplies the configured USPS-compatible postage provider so fulfillment can purchase, void, and test labels without owning deployable environment configuration."
    },
    {
      "portName": "postageWebhookGateway",
      "providedBy": "platform-api",
      "purpose": "Verifies and normalizes postage provider webhook payloads before fulfillment records provider events and advances shipment state."
    },
    {
      "portName": "transactionalEmailOutbox",
      "providedBy": "platform-worker",
      "purpose": "Durable transactional email outbox consumed only by shipment event projectors."
    }
  ],
  "apiDeployables": ["platform-api"],
  "sourceRuntimeDeployables": ["admin-support-api", "admin-support-worker"],
  "apiMounts": [
    {
      "mountPath": "/api/marketplace",
      "kind": "primary",
      "requiresAuth": true
    },
    {
      "mountPath": "/api/fulfillment/provider",
      "kind": "additional",
      "requiresAuth": false
    }
  ],
  "deployableContributions": [
    {
      "deployable": "marketplace-web",
      "routes": [
        {
          "routeId": "account-sale-shipment-packing-slips",
          "routePath": "account/sales/shipments/packing-slips",
          "fileExport": "./routes/marketplace/account-sale-shipment-packing-slips",
          "routeType": "route",
          "placement": "root",
          "sourceContext": "fulfillment"
        },
        {
          "routeId": "account-sale-shipment-packing",
          "routePath": "account/sales/shipments/:shipmentId/packing",
          "fileExport": "./routes/marketplace/account-sale-shipment-packing",
          "routeType": "route",
          "sourceContext": "fulfillment"
        },
        {
          "routeId": "account-shipment",
          "routePath": "account/shipments/:shipmentId",
          "fileExport": "./routes/marketplace/account-shipment",
          "routeType": "route",
          "sourceContext": "fulfillment"
        },
        {
          "routeId": "account-shipments",
          "routePath": "account/shipments",
          "fileExport": "./routes/marketplace/account-shipments",
          "routeType": "route",
          "sourceContext": "fulfillment"
        },
        {
          "routeId": "account-sale-shipment",
          "routePath": "account/sales/shipments/:shipmentId",
          "fileExport": "./routes/marketplace/account-sale-shipment",
          "routeType": "route",
          "sourceContext": "fulfillment"
        },
        {
          "routeId": "account-sale-shipments",
          "routePath": "account/sales/shipments",
          "fileExport": "./routes/marketplace/account-sale-shipments",
          "routeType": "route",
          "sourceContext": "fulfillment"
        }
      ]
    }
  ],
  "shellContributions": [
    {
      "deployable": "marketplace-web",
      "slot": "top-nav",
      "key": "shipments",
      "label": "Shipments",
      "icon": "package",
      "href": "/account/shipments",
      "order": 150,
      "visibility": "signed-in",
      "requiredPermissions": ["fulfillment.view"]
    },
    {
      "deployable": "marketplace-web",
      "slot": "bottom-nav",
      "key": "shipments",
      "label": "Shipments",
      "icon": "package",
      "href": "/account/shipments",
      "order": 150,
      "visibility": "signed-in",
      "requiredPermissions": ["fulfillment.view"]
    },
    {
      "deployable": "marketplace-web",
      "slot": "top-nav",
      "key": "sale-shipments",
      "label": "Sale shipments",
      "icon": "truck",
      "href": "/account/sales/shipments",
      "order": 155,
      "visibility": "signed-in",
      "requiredPermissions": ["fulfillment.view"]
    },
    {
      "deployable": "marketplace-web",
      "slot": "bottom-nav",
      "key": "sale-shipments",
      "label": "Sale shipments",
      "icon": "truck",
      "href": "/account/sales/shipments",
      "order": 155,
      "visibility": "signed-in",
      "requiredPermissions": ["fulfillment.view"]
    }
  ],
  "directoryIntent": {
    "shipments": {
      "classification": "slice",
      "purpose": "Own shipments feature behavior, read models, and UI contracts for the fulfillment context.",
      "allowedWhen": "Always; slice directories are the default root shape for implemented context features.",
      "expectedConsumers": ["Internal fulfillment module composition"]
    },
    "request-support": {
      "classification": "support",
      "purpose": "Provide reusable request-support assets shared by fulfillment-owned features and composition seams.",
      "allowedWhen": "Allowed only when capability cannot stay inside one feature and cross-feature reuse is explicit.",
      "expectedConsumers": ["Multiple fulfillment slices", "Deployable composition for fulfillment"],
      "justification": "request-support centralizes context-local composition that should not duplicate across features.",
      "createdFor": "fulfillment workflows that span multiple features or public entrypoints.",
      "sunsetWhen": "Remove when all consumers can move the behavior back into feature-local modules.",
      "crossCuttingRuntimeComposition": true
    },
    "runtime-support": {
      "classification": "support",
      "purpose": "Provide reusable runtime-support assets shared by fulfillment-owned features and composition seams.",
      "allowedWhen": "Allowed only when capability cannot stay inside one feature and cross-feature reuse is explicit.",
      "expectedConsumers": ["shipments"],
      "justification": "runtime-support centralizes context-local composition that should not duplicate across features.",
      "createdFor": "fulfillment workflows that span multiple features or public entrypoints.",
      "sunsetWhen": "Remove when all consumers can move the behavior back into feature-local modules."
    },
    "seed-support": {
      "classification": "support",
      "purpose": "Provide reusable seed-support assets shared by fulfillment-owned features and composition seams.",
      "allowedWhen": "Allowed only when capability cannot stay inside one feature and cross-feature reuse is explicit.",
      "expectedConsumers": ["Multiple fulfillment slices", "Deployable composition for fulfillment"],
      "justification": "seed-support centralizes context-local composition that should not duplicate across features.",
      "createdFor": "fulfillment workflows that span multiple features or public entrypoints.",
      "sunsetWhen": "Remove when all consumers can move the behavior back into feature-local modules.",
      "crossCuttingRuntimeComposition": true
    },
    "routes": {
      "classification": "routes",
      "purpose": "Expose fulfillment-owned route modules consumed by generated deployable adapters.",
      "allowedWhen": "Required whenever the context contributes routes to any deployable.",
      "expectedConsumers": ["Generated deployable route adapters"]
    }
  },
  "runtimeDeployables": ["platform-worker"]
}
