{
  "contextName": "fulfillment",
  "packageName": "@chase-sets/fulfillment",
  "ownedNouns": [
    "shipment"
  ],
  "streamPrefix": "fulfillment.",
  "apiBasePath": "/api/marketplace",
  "slices": [
    "shipments"
  ],
  "allowedSupportDirectories": [
    "seed-support",
    "tests"
  ],
  "publicExports": [
    ".",
    "./client",
    "./integration",
    "./routes/*",
    "./seed-support/*",
    "./server",
    "./web"
  ],
  "allowedContextDependencies": [],
  "requiredPorts": [],
  "integrationCapabilities": [],
  "apiRequirements": [],
  "hostPorts": [],
  "apiDeployables": [
    "marketplace-api"
  ],
  "apiMounts": [
    {
      "mountPath": "/api/marketplace",
      "kind": "primary",
      "requiresAuth": true,
      "drainProjectorsOnWrite": true
    }
  ],
  "deployableContributions": [
    {
      "deployable": "marketplace",
      "routes": [
        { "routeId": "account-fulfillment", "routePath": "account/fulfillment", "fileExport": "./routes/marketplace/account-fulfillment", "routeType": "route", "sourceContext": "fulfillment" },
        { "routeId": "account-fulfillment-shipment", "routePath": "account/fulfillment/:shipmentId", "fileExport": "./routes/marketplace/account-fulfillment-shipment", "routeType": "route", "sourceContext": "fulfillment" },
        { "routeId": "account-shipment", "routePath": "account/shipments/:shipmentId", "fileExport": "./routes/marketplace/account-shipment", "routeType": "route", "sourceContext": "fulfillment" },
        { "routeId": "account-shipments", "routePath": "account/shipments", "fileExport": "./routes/marketplace/account-shipments", "routeType": "route", "sourceContext": "fulfillment" }
      ]
    }
  ],
  "shellContributions": [
    { "deployable": "marketplace", "slot": "top-nav", "key": "shipments", "label": "Shipments", "icon": "package", "href": "/account/shipments", "order": 150, "visibility": "signed-in", "requiredPermissions": ["fulfillment.view"] },
    { "deployable": "marketplace", "slot": "top-nav", "key": "fulfillment", "label": "Fulfillment", "icon": "package", "href": "/account/fulfillment", "order": 180, "visibility": "signed-in", "requiredPermissions": ["fulfillment.view", "fulfillment.manage"] },
    { "deployable": "marketplace", "slot": "bottom-nav", "key": "shipments", "label": "Shipments", "icon": "package", "href": "/account/shipments", "order": 150, "visibility": "signed-in", "requiredPermissions": ["fulfillment.view"] },
    { "deployable": "marketplace", "slot": "bottom-nav", "key": "fulfillment", "label": "Fulfillment", "icon": "package", "href": "/account/fulfillment", "order": 180, "visibility": "signed-in", "requiredPermissions": ["fulfillment.view", "fulfillment.manage"] }
  ]
}
