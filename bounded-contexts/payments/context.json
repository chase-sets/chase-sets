{
  "contextName": "payments",
  "packageName": "@chase-sets/payments",
  "ownedNouns": ["payment", "refund"],
  "streamPrefix": "payments.",
  "apiBasePath": "/api/marketplace",
  "slices": ["payments", "refunds"],
  "allowedSupportDirectories": ["request-support", "runtime-support", "seed-support", "ucp-support"],
  "publicExports": [".", "./context", "./routes/*", "./seed-support/*", "./server"],
  "allowedContextDependencies": ["@chase-sets/auth", "@chase-sets/ordering", "@chase-sets/platform-operations"],
  "seedRequirements": ["identity", "marketplace", "ordering"],
  "eventSubscriptions": [
    {
      "sourceContextName": "ordering",
      "projectionName": "payments-order-input-projection",
      "subscriptionVersion": 3,
      "eventTypes": [
        "ordering.order.created",
        "ordering.order.pending-payment-recorded",
        "ordering.order.cancelled",
        "ordering.order.ready-for-fulfillment-recorded"
      ],
      "order": 10,
      "projectionHandlerSetNames": ["payments-order-input-projection"]
    },
    {
      "sourceContextName": "fulfillment",
      "projectionName": "payments-fulfillment-dispute-evidence-source-projection",
      "subscriptionVersion": 1,
      "eventTypes": [
        "fulfillment.shipment.created",
        "fulfillment.shipment.label-attached",
        "fulfillment.shipment.dispatched",
        "fulfillment.shipment.delivered",
        "fulfillment.shipment.cancelled",
        "fulfillment.shipment.returned"
      ],
      "order": 11,
      "projectionHandlerSetNames": ["payments-fulfillment-dispute-evidence-source-projection"]
    },
    {
      "sourceContextName": "platform-operations",
      "projectionName": "payments-support-refund-effect",
      "subscriptionVersion": 1,
      "eventTypes": [
        "support.support-request.resolved",
        "support.support-request.return-delivered",
        "support.support-request.return-condition-disputed",
        "support.support-request.return-refund-released"
      ],
      "order": 70,
      "projectionHandlerSetNames": ["payments-support-refund-effect"]
    },
    {
      "sourceContextName": "ordering",
      "projectionName": "payments-order-cancellation-refund-effect",
      "subscriptionVersion": 1,
      "eventTypes": ["ordering.order.cancelled"],
      "order": 20,
      "projectionHandlerSetNames": ["payments-order-cancellation-refund-effect"]
    },
    {
      "sourceContextName": "identity",
      "projectionName": "payments-account-risk-source-projection",
      "subscriptionVersion": 1,
      "eventTypes": ["identity.account.badge-assigned", "identity.account.badge-removed"],
      "order": 30,
      "projectionHandlerSetNames": ["payments-account-risk-source-projection"]
    },
    {
      "sourceContextName": "payments",
      "projectionName": "payments-order-cancellation-refund-effect",
      "subscriptionVersion": 1,
      "eventTypes": ["payments.payment-captured"],
      "order": 21,
      "projectionHandlerSetNames": ["payments-order-cancellation-refund-effect"]
    },
    {
      "sourceContextName": "payments",
      "projectionName": "payments-account-risk-source-projection",
      "subscriptionVersion": 1,
      "eventTypes": [
        "payments.payment-fraud-warning-received",
        "payments.payment-fraud-review-opened",
        "payments.payment-fraud-review-closed"
      ],
      "order": 31,
      "projectionHandlerSetNames": ["payments-account-risk-source-projection"]
    }
  ],
  "eventReactions": [
    {
      "sourceContextName": "payments",
      "reactionName": "payments-dispute-evidence-submission",
      "subscriptionVersion": 1,
      "eventTypes": ["payments.payment-disputed"],
      "order": 32,
      "reactionHandlerSetNames": ["payments-dispute-evidence-submission"],
      "idempotencyPolicy": "idempotent-command-dispatch",
      "retryPolicy": "retry-from-last-checkpoint",
      "failurePolicy": "surface-as-reaction-failure"
    }
  ],
  "projectionGroups": [
    {
      "projectionName": "payments-order-input-projection",
      "sourceContextNames": ["ordering"],
      "ownedTables": ["payments_order_inputs"],
      "requiredDuringBootstrap": true,
      "resetStrategy": "replay-only"
    },
    {
      "projectionName": "payments-fulfillment-dispute-evidence-source-projection",
      "sourceContextNames": ["fulfillment"],
      "ownedTables": ["payments_fulfillment_dispute_evidence_sources"],
      "requiredDuringBootstrap": false,
      "resetStrategy": "replay-only"
    },
    {
      "projectionName": "payments-support-refund-effect",
      "sourceContextNames": ["platform-operations"],
      "ownedTables": ["payments_support_refund_effects"],
      "requiredDuringBootstrap": false,
      "resetStrategy": "replay-only"
    },
    {
      "projectionName": "payments-order-cancellation-refund-effect",
      "sourceContextNames": ["ordering", "payments"],
      "ownedTables": ["payments_order_cancellation_refund_effects"],
      "requiredDuringBootstrap": false,
      "resetStrategy": "replay-only"
    },
    {
      "projectionName": "payments-payment-projection",
      "sourceContextNames": ["payments"],
      "ownedTables": ["payments_payment_orders", "payments_payment_pages"],
      "requiredDuringBootstrap": false,
      "resetStrategy": "truncate-owned-tables"
    },
    {
      "projectionName": "payments-account-risk-source-projection",
      "sourceContextNames": ["identity", "payments"],
      "ownedTables": ["payments_account_risk_sources"],
      "requiredDuringBootstrap": false,
      "resetStrategy": "replay-only"
    },
    {
      "projectionName": "payments-dispute-evidence-submission",
      "handlerKind": "reaction",
      "sourceContextNames": ["payments"],
      "ownedTables": [],
      "requiredDuringBootstrap": false,
      "resetStrategy": "replay-only"
    },
    {
      "projectionName": "payments-fraud-alert-projection",
      "sourceContextNames": ["payments"],
      "ownedTables": ["notification_outbox"],
      "requiredDuringBootstrap": false,
      "resetStrategy": "replay-only"
    }
  ],
  "hostPorts": [
    {
      "portName": "processorGateway",
      "providedBy": "platform-api",
      "purpose": "Create and observe external payment processor intents from the API host."
    },
    {
      "portName": "webhookTelemetry",
      "providedBy": "platform-api",
      "purpose": "Record support-safe Stripe webhook failure classes, retry decisions, and provider event references."
    },
    {
      "portName": "balanceCreditResolver",
      "providedBy": "settlement",
      "purpose": "Apply available settlement wallet balance as checkout credit without Payments querying Settlement storage."
    },
    {
      "portName": "checkoutProcessingFeePolicyResolver",
      "providedBy": "commercial-terms",
      "purpose": "Resolve the runtime-configurable checkout processing-fee policy at quote time without Payments querying Commercial Terms storage."
    },
    {
      "portName": "notificationOutbox",
      "providedBy": "platform-worker",
      "purpose": "Durable outbound notification outbox consumed only by payment and refund event projectors."
    }
  ],
  "apiDeployables": ["platform-api"],
  "apiMounts": [
    {
      "mountPath": "/api/marketplace",
      "kind": "primary",
      "requiresAuth": true,
      "readFreshnessRoutes": [
        {
          "routePath": "/account/payments/:id",
          "methods": ["GET", "HEAD"],
          "dependencies": [
            {
              "readModelTable": "payments_payment_pages"
            }
          ]
        },
        {
          "routePath": "/account/checkout/status",
          "methods": ["GET", "HEAD"],
          "dependencies": [
            {
              "readModelTable": "payments_order_inputs"
            }
          ]
        }
      ]
    },
    {
      "mountPath": "/api/payments/provider",
      "kind": "additional",
      "requiresAuth": false
    }
  ],
  "mcpCapabilities": {
    "tools": [
      { "name": "payments.start-payment-method-setup", "ownerSlice": "payments" },
      { "name": "payments.confirm-payment-method-setup", "ownerSlice": "payments" },
      { "name": "payments.get-payment", "ownerSlice": "payments" },
      { "name": "payments.get-refund-status", "ownerSlice": "refunds" }
    ],
    "resources": [{ "uriTemplate": "chase-sets://payments/{accountId}/payments/{paymentId}", "ownerSlice": "payments" }]
  },
  "readAfterWriteRouteInventory": [
    {
      "id": "payments.create-to-detail",
      "owner": "payments",
      "risk": "critical",
      "freshnessSlo": {
        "flowClass": "critical-customer-handoff",
        "p95Ms": 1000,
        "p99Ms": 2250
      },
      "source": {
        "routeId": "account-payment-new",
        "actions": ["Create account payment"],
        "command": "Payments payment creation command",
        "helperUses": ["navigateAfterWriteWithPlatformPostWriteToken"]
      },
      "destination": {
        "routeId": "account-payment",
        "apiContextName": "payments",
        "apiRoutePath": "/account/payments/:id",
        "readModelTables": ["payments_payment_pages"],
        "helperUses": ["loadAfterWrite"],
        "transientRecovery": {
          "kinds": "refreshable-catching-up",
          "behavior": "Payment detail uses exact Payments payment-page freshness and shared fresh-write transient recovery."
        }
      }
    },
    {
      "id": "payments.checkout-status-order-input-fresh-read",
      "owner": "payments",
      "risk": "critical",
      "freshnessSlo": {
        "flowClass": "critical-customer-handoff",
        "p95Ms": 1000,
        "p99Ms": 2250
      },
      "source": {
        "routeId": "buy-checkout-session",
        "actions": ["Create checkout orders before payment start"],
        "command": "Ordering checkout order creation command"
      },
      "destination": {
        "routeIds": ["account-payment", "checkout-payment"],
        "apiContextName": "payments",
        "apiRoutePath": "/account/checkout/status",
        "readModelTables": ["payments_order_inputs"],
        "transientRecovery": {
          "kinds": "refreshable-catching-up",
          "behavior": "Checkout payment start preflights Payments checkout status with the Ordering write receipt so payments_order_inputs catches up before creating the payment."
        }
      },
      "proof": {
        "tests": [
          "bounded-contexts/checkout/support/request-support/checkout-confirmation.test.ts",
          "bounded-contexts/payments/support/request-support/api-client.test.ts"
        ]
      }
    },
    {
      "id": "payments.detail-self-refresh",
      "owner": "payments",
      "risk": "important",
      "freshnessSlo": {
        "flowClass": "important-self-refresh",
        "p95Ms": 2500,
        "p99Ms": 5000
      },
      "source": {
        "routeId": "account-payment",
        "actions": ["Refresh or continue payment detail after payment command"],
        "command": "Payments detail commands",
        "helperUses": ["navigateAfterWriteWithPlatformPostWriteToken", "loadAfterWrite"]
      },
      "destination": {
        "routeId": "account-payment",
        "apiContextName": "payments",
        "apiRoutePath": "/account/payments/:id",
        "readModelTables": ["payments_payment_pages"],
        "helperUses": ["loadAfterWrite"],
        "transientRecovery": {
          "kinds": "refreshable-catching-up",
          "behavior": "Payment detail self-refresh uses exact Payments payment-page freshness and shared fresh-write transient recovery."
        }
      }
    }
  ],
  "mutationConsistencyInventory": [
    {
      "id": "payments.payment-command-snapshots",
      "owner": "payments",
      "risk": "critical",
      "strategy": "snapshot-return",
      "surfaces": [
        "api-route:bounded-contexts/payments/features/payments/api/route.ts:POST /checkout/recover",
        "api-route:bounded-contexts/payments/features/payments/api/route.ts:POST /payments"
      ],
      "visibleDestination": {
        "description": "Payment creation and recovery API calls return the Payments-owned payment detail snapshot and command receipt used by browser routes to continue into payment detail."
      },
      "proof": {
        "authoritativeResponse": "The Payments runtime builds the returned payment detail from the same command path that creates the processor payment session; the platform API attaches the Payments commit receipt headers to the response.",
        "tests": [
          "bounded-contexts/payments/features/payments/api/route.test.ts",
          "bounded-contexts/payments/tests/account-payment-new-route.test.tsx",
          "bounded-contexts/payments/tests/guest-payment-claim-action.test.ts"
        ]
      }
    },
    {
      "id": "payments.create-to-detail-fresh-read",
      "owner": "payments",
      "risk": "critical",
      "strategy": "fresh-read",
      "surfaces": [
        "post-form:bounded-contexts/payments/routes/marketplace/account-payment-new.tsx:H2a1272bf8c6b#1",
        "route-action:bounded-contexts/payments/routes/marketplace/account-payment-new.tsx"
      ],
      "visibleDestination": {
        "routeId": "account-payment",
        "apiContextName": "payments",
        "apiRoutePath": "/account/payments/:id",
        "readModelTables": ["payments_payment_pages"],
        "transientRecovery": {
          "kinds": "refreshable-catching-up",
          "behavior": "Payment creation redirects carry the Payments command receipt as afterWrite; payment detail waits on payments_payment_pages and renders preparing-payment recovery while the receipt is fresh."
        }
      },
      "proof": {
        "tests": [
          "bounded-contexts/payments/tests/account-payment-new-route.test.tsx",
          "bounded-contexts/payments/tests/guest-payment-claim-action.test.ts"
        ]
      }
    },
    {
      "id": "payments.detail-retry-fresh-read",
      "owner": "payments",
      "risk": "critical",
      "strategy": "fresh-read",
      "surfaces": [
        "post-form:bounded-contexts/payments/features/payments/ui/account-payment/account-payment-page.tsx:Hb08a81ecfd73#1",
        "route-action:bounded-contexts/payments/routes/marketplace/account-payment.tsx"
      ],
      "visibleDestination": {
        "routeId": "account-payment",
        "apiContextName": "payments",
        "apiRoutePath": "/account/payments/:id",
        "readModelTables": ["payments_payment_pages"],
        "transientRecovery": {
          "kinds": "refreshable-catching-up",
          "behavior": "Guest payment retry redirects carry the recovered Payments command receipt as afterWrite; payment detail waits on payments_payment_pages and keeps fresh 404 or projection timeout as temporary recovery."
        }
      },
      "proof": {
        "tests": ["bounded-contexts/payments/tests/guest-payment-claim-action.test.ts"]
      }
    },
    {
      "id": "payments.guest-claim-command-snapshots",
      "owner": "payments",
      "risk": "important",
      "strategy": "snapshot-return",
      "surfaces": [
        "post-form:bounded-contexts/payments/routes/marketplace/account-payment.tsx:H02130cc2df9a#1",
        "post-form:bounded-contexts/payments/routes/marketplace/account-payment.tsx:Hb08a81ecfd73#1",
        "post-form:bounded-contexts/payments/routes/marketplace/account-payment.tsx:Hb08a81ecfd73#2"
      ],
      "visibleDestination": {
        "description": "Guest claim forms on the payment detail page return Auth-owned inline token/session snapshots or browser-auth redirects; they do not mutate Payments state or rely on realtime payment correction."
      },
      "proof": {
        "authoritativeResponse": "The route action reads the current payment before claim commands, then returns the Auth command result directly as action data or a browser authentication response without re-reading a Payments projection.",
        "tests": ["bounded-contexts/payments/tests/guest-payment-claim-action.test.ts"]
      }
    },
    {
      "id": "payments.method-api-snapshots",
      "owner": "payments",
      "risk": "important",
      "strategy": "snapshot-return",
      "surfaces": [
        "api-route:bounded-contexts/payments/features/payments/api/route.ts:POST /payment-methods/:instrumentId/default",
        "api-route:bounded-contexts/payments/features/payments/api/route.ts:POST /payment-methods/:instrumentId/remove",
        "api-route:bounded-contexts/payments/features/payments/api/route.ts:POST /payment-methods/reconcile",
        "api-route:bounded-contexts/payments/features/payments/api/route.ts:POST /payment-methods/setup-sessions",
        "api-route:bounded-contexts/payments/features/payments/api/route.ts:POST /payment-methods/setup-sessions/:processorSetupReference/reconcile"
      ],
      "visibleDestination": {
        "description": "Saved payment setup, default, removal, and reconciliation responses return sanitized Payments-owned setup or saved-method snapshots directly from command-owned storage."
      },
      "proof": {
        "authoritativeResponse": "The API serializes only user-visible setup and saved-method fields from Payments-owned rows after the provider/setup command completes; reconcile also returns the authoritative saved-method list snapshot.",
        "tests": ["bounded-contexts/payments/features/payments/api/route.test.ts"]
      }
    },
    {
      "id": "payments.method-route-snapshots",
      "owner": "payments",
      "risk": "important",
      "strategy": "snapshot-return",
      "surfaces": [
        "post-form:bounded-contexts/payments/routes/marketplace/account-payment-methods.tsx:Hb08a81ecfd73#1",
        "post-form:bounded-contexts/payments/routes/marketplace/account-payment-methods.tsx:Hb08a81ecfd73#2",
        "post-form:bounded-contexts/payments/routes/marketplace/account-payment-methods.tsx:Hb08a81ecfd73#3",
        "post-form:bounded-contexts/payments/routes/marketplace/account-payment-methods.tsx:Hb08a81ecfd73#4",
        "post-form:bounded-contexts/payments/routes/marketplace/account-payment-methods.tsx:Hb08a81ecfd73#5",
        "route-action:bounded-contexts/payments/routes/marketplace/account-payment-methods.tsx"
      ],
      "visibleDestination": {
        "description": "The saved payment methods route renders action-returned Payments snapshots for default, remove, setup reconciliation, and reconcile results instead of depending on realtime or a stale loader after mutation."
      },
      "proof": {
        "authoritativeResponse": "The route action returns the sanitized saved-method list from Payments immediately after the mutation, and the component prefers that action snapshot over stale loader data.",
        "tests": ["bounded-contexts/payments/tests/account-payment-methods-route.test.tsx"]
      }
    },
    {
      "id": "payments.provider-webhook-internal",
      "owner": "payments",
      "risk": "internal",
      "strategy": "non-user-visible",
      "surfaces": ["api-route:bounded-contexts/payments/features/payments/api/route.ts:POST /webhooks"],
      "exception": {
        "owner": "payments",
        "reason": "As of 2026-06-15 this is a provider-to-server webhook endpoint with no browser-visible destination; account payment and method pages read through their own GET/fresh-read or setup reconciliation paths.",
        "reviewBy": "2026-09-30",
        "issue": "#1828"
      }
    }
  ],
  "deployableContributions": [
    {
      "deployable": "marketplace-web",
      "routes": [
        {
          "routeId": "account-payment",
          "routePath": "account/payments/:paymentId",
          "fileExport": "./routes/marketplace/account-payment",
          "routeType": "route",
          "sourceContext": "payments"
        },
        {
          "routeId": "account-payment-new",
          "routePath": "account/payments/new",
          "fileExport": "./routes/marketplace/account-payment-new",
          "routeType": "route",
          "sourceContext": "payments"
        },
        {
          "routeId": "account-payment-methods",
          "routePath": "account/payment-methods",
          "fileExport": "./routes/marketplace/account-payment-methods",
          "routeType": "route",
          "sourceContext": "payments"
        },
        {
          "routeId": "checkout-payment",
          "routePath": "checkout/payments/:paymentId",
          "fileExport": "./routes/marketplace/checkout-payment",
          "routeType": "route",
          "sourceContext": "payments"
        }
      ]
    }
  ],
  "shellContributions": [],
  "directoryIntent": {
    "payments": {
      "classification": "slice",
      "purpose": "Own payments feature behavior, read models, and UI contracts for the payments context.",
      "expectedConsumers": ["Internal payments module composition"]
    },
    "refunds": {
      "classification": "slice",
      "purpose": "Own refunds feature behavior, read models, and UI contracts for the payments context.",
      "expectedConsumers": ["Internal payments module composition"]
    },
    "request-support": {
      "classification": "support",
      "purpose": "Provide reusable request-support assets shared by payments-owned features and composition seams.",
      "expectedConsumers": ["Multiple payments slices", "Deployable composition for payments"],
      "crossCuttingRuntimeComposition": true
    },
    "runtime-support": {
      "classification": "support",
      "purpose": "Provide reusable runtime-support assets shared by payments-owned features and composition seams.",
      "expectedConsumers": ["payments", "refunds"]
    },
    "seed-support": {
      "classification": "support",
      "purpose": "Provide reusable seed-support assets shared by payments-owned features and composition seams.",
      "expectedConsumers": ["Multiple payments slices", "Deployable composition for payments"],
      "crossCuttingRuntimeComposition": true
    },
    "ucp-support": {
      "classification": "support",
      "purpose": "Provide Payments-owned UCP payment-handler declarations and AP2 guarded-completion decisions coordinated by Checkout sessions.",
      "expectedConsumers": ["Checkout UCP completion adapter", "Platform UCP route composition"]
    },
    "routes": {
      "classification": "routes",
      "purpose": "Expose payments-owned route modules consumed by generated deployable adapters.",
      "expectedConsumers": ["Generated deployable route adapters"]
    }
  },
  "runtimeDeployables": ["platform-worker"],
  "apiRuntimeProfiles": ["proof", "public"],
  "workerRuntimeProfiles": ["proof", "public"]
}
