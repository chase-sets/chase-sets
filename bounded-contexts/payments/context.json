{
  "contextName": "payments",
  "packageName": "@chase-sets/payments",
  "ownedNouns": [
    "payment",
    "refund"
  ],
  "streamPrefix": "payments.",
  "apiBasePath": "/api/marketplace",
  "slices": [
    "payments",
    "refunds"
  ],
  "allowedSupportDirectories": [
    "tests"
  ],
  "publicExports": [
    ".",
    "./client",
    "./routes/*",
    "./web"
  ],
  "allowedContextDependencies": [
    "@chase-sets/ordering"
  ],
  "requiredPorts": [
    "processorGateway",
    "getOrderSnapshot"
  ],
  "apiDeployables": [
    "marketplace-api"
  ],
  "apiMounts": [
    {
      "mountPath": "/api/marketplace",
      "kind": "primary",
      "requiresAuth": true,
      "drainProjectorsOnWrite": true
    },
    {
      "mountPath": "/api/payments/stripe",
      "kind": "additional",
      "requiresAuth": false,
      "drainProjectorsOnWrite": true
    }
  ],
  "deployableContributions": [
    {
      "deployable": "marketplace",
      "routes": [
        { "routeId": "account-payment", "routePath": "account/payments/:paymentId", "fileExport": "./routes/marketplace/account-payment", "routeType": "route", "sourceContext": "payments" },
        { "routeId": "account-payment-new", "routePath": "account/payments/new", "fileExport": "./routes/marketplace/account-payment-new", "routeType": "route", "sourceContext": "payments" }
      ]
    }
  ]
}
