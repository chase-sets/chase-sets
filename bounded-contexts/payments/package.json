{
  "name": "@chase-sets/payments",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "chaseSets": {
    "testProfile": "db"
  },
  "scripts": {
    "typecheck": "tsc -p ./tests/tsconfig.json --noEmit",
    "test": "vitest run --config ./tests/vitest.config.mjs",
    "test:fast": "vitest run --config ./tests/vitest.config.mjs --exclude tests/seed.test.ts"
  },
  "exports": {
    ".": "./index.ts",
    "./context": "./context.json",
    "./routes/*": "./routes/*.tsx",
    "./seed-support/*": "./support/seed-support/*.ts",
    "./server": "./server.ts"
  },
  "types": "./index.ts",
  "dependencies": {
    "@chase-sets/auth": "workspace:*",
    "@chase-sets/auth-context": "workspace:*",
    "@chase-sets/bounded-context-module": "workspace:*",
    "@chase-sets/bounded-context-runtime": "workspace:*",
    "@chase-sets/checkout": "workspace:*",
    "@chase-sets/design-system": "workspace:*",
    "@chase-sets/event-core": "workspace:*",
    "@chase-sets/event-core-postgres": "workspace:*",
    "@chase-sets/experience": "workspace:*",
    "@chase-sets/http": "workspace:*",
    "@chase-sets/identity": "workspace:*",
    "@chase-sets/localization": "workspace:*",
    "@chase-sets/marketplace": "workspace:*",
    "@chase-sets/ordering": "workspace:*",
    "@chase-sets/payment-processing": "workspace:*",
    "@chase-sets/payment-processing-testing": "workspace:*",
    "@chase-sets/platform-runtime": "workspace:*",
    "@chase-sets/primitives": "workspace:*",
    "@chase-sets/provider-webhook-inbox": "workspace:*",
    "@chase-sets/ucp": "workspace:*",
    "hono": "^4.12.12"
