{
  "schemaVersion": "canary-prometheus-queries/v1",
  "signals": [
    {
      "name": "app-platform-deployment-phase",
      "owner": "infrastructure/deployment-workflow",
      "source": "Prometheus DigitalOcean App Platform deployment phase gauge",
      "currentState": "available-now",
      "baselineQuery": "max(chase_sets_app_platform_deployment_active{environment=\"production\",release!=\"canary\"})",
      "canaryQuery": "max(chase_sets_app_platform_deployment_active{environment=\"production\",release=\"canary\"})",
      "maxIncrease": 0,
      "threshold": "canary deployment phase must match active baseline"
    },
    {
      "name": "route-error-rate",
      "owner": "platform-runtime/route-owner",
      "source": "Prometheus HTTP 5xx rate by route, host, and release cohort",
      "currentState": "needs-instrumentation",
      "baselineQuery": "sum(rate(http_requests_total{environment=\"production\",status=~\"5..\",release!=\"canary\"}[15m]))",
      "canaryQuery": "sum(rate(http_requests_total{environment=\"production\",status=~\"5..\",release=\"canary\"}[15m]))",
      "maxIncrease": 0.005,
      "threshold": "canary <= baseline + 0.005 errors/second"
    },
    {
      "name": "route-latency-p95",
      "owner": "platform-runtime/route-owner",
      "source": "Prometheus HTTP request duration histogram by route, host, and release cohort",
      "currentState": "needs-instrumentation",
      "baselineQuery": "histogram_quantile(0.95, sum(rate(http_request_duration_milliseconds_bucket{environment=\"production\",release!=\"canary\"}[15m])) by (le))",
      "canaryQuery": "histogram_quantile(0.95, sum(rate(http_request_duration_milliseconds_bucket{environment=\"production\",release=\"canary\"}[15m])) by (le))",
      "maxIncrease": 50,
      "threshold": "canary p95 <= baseline p95 + 50ms"
    },
    {
      "name": "checkout-order-payment-errors",
      "owner": "checkout/ordering/payments",
      "source": "Prometheus checkout command, order, payment, and provider-health failure counters",
      "currentState": "needs-instrumentation",
      "baselineQuery": "sum(rate(chase_sets_checkout_payment_failures_total{environment=\"production\",release!=\"canary\"}[15m]))",
      "canaryQuery": "sum(rate(chase_sets_checkout_payment_failures_total{environment=\"production\",release=\"canary\"}[15m]))",
      "maxIncrease": 0,
      "threshold": "canary checkout/payment failures must not exceed baseline"
    },
    {
      "name": "settlement-payout-errors",
      "owner": "settlement",
      "source": "Prometheus settlement operation failures for payout setup, readiness, and provider reconciliation",
      "currentState": "available-now",
      "baselineQuery": "sum(rate(chase_sets_settlement_operations_total{environment=\"production\",release!=\"canary\",kind=~\"payout-setup-session-failed|payout-account-management-session-failed|payout-readiness-refresh-failed|payout-readiness-webhook-ignored|payout-request-blocked-by-setup|payout-failed|money-movement-webhook-ignored\"}[15m]))",
      "canaryQuery": "sum(rate(chase_sets_settlement_operations_total{environment=\"production\",release=\"canary\",kind=~\"payout-setup-session-failed|payout-account-management-session-failed|payout-readiness-refresh-failed|payout-readiness-webhook-ignored|payout-request-blocked-by-setup|payout-failed|money-movement-webhook-ignored\"}[15m]))",
      "maxIncrease": 0,
      "threshold": "canary settlement payout/setup failures must not exceed baseline"
    }
  ]
}
