{
  "contextName": "platform-operations",
  "packageName": "@chase-sets/platform-operations",
  "ownedNouns": [
    "projection-operation",
    "platform-operation-attention",
    "feature-rollout",
    "release-lock",
    "sales-performance-kpi",
    "fulfillment-latency-kpi",
    "conversion-order-kpi",
    "dashboard-read-model",
    "platform-feedback",
    "platform-feedback-prompt",
    "support-request"
  ],
  "streamPrefix": "platform-operations.",
  "apiBasePath": "/api/platform",
  "slices": [
    "projection-operations",
    "release-controls",
    "release-dashboard",
    "insights-dashboards",
    "platform-feedback",
    "support-requests"
  ],
  "allowedSupportDirectories": ["request-support", "runtime-support", "seed-support"],
  "publicExports": [".", "./context", "./routes/*", "./seed-support/*", "./server"],
  "allowedContextDependencies": [],
  "seedRequirements": ["identity", "ordering", "fulfillment", "payments", "settlement"],
  "eventSubscriptions": [
    {
      "sourceContextName": "ordering",
      "projectionName": "support-order-source-projection",
      "subscriptionVersion": 1,
      "eventTypes": [
        "ordering.order.created",
        "ordering.order.cancelled",
        "ordering.order.ready-for-fulfillment-recorded"
      ],
      "order": 70,
      "projectionHandlerSetNames": ["support-order-source-projection"]
    },
    {
      "sourceContextName": "fulfillment",
      "projectionName": "support-shipment-source-projection",
      "subscriptionVersion": 1,
      "eventTypes": [
        "fulfillment.shipment.created",
        "fulfillment.shipment.dispatched",
        "fulfillment.shipment.delivered",
        "fulfillment.shipment.returned",
        "fulfillment.shipment.exception-raised"
      ],
      "order": 80,
      "projectionHandlerSetNames": ["support-shipment-source-projection"]
    }
  ],
  "projectionGroups": [
    {
      "projectionName": "support-order-source-projection",
      "sourceContextNames": ["ordering"],
      "ownedTables": ["support_order_sources"],
      "requiredDuringBootstrap": true,
      "resetStrategy": "replay-only"
    },
    {
      "projectionName": "support-shipment-source-projection",
      "sourceContextNames": ["fulfillment"],
      "ownedTables": ["support_shipment_sources"],
      "requiredDuringBootstrap": true,
      "resetStrategy": "replay-only"
    }
  ],
  "hostPorts": [
    {
      "portName": "notificationOutbox",
      "providedBy": "platform-worker",
      "purpose": "Durable outbound notification outbox consumed only by support request event projectors."
    }
  ],
  "apiDeployables": ["admin-support-api", "platform-api"],
  "apiMounts": [
    {
      "mountPath": "/api/platform",
      "kind": "primary",
      "requiresAuth": true
    },
    {
      "mountPath": "/api/experience",
      "kind": "additional",
      "requiresAuth": true
    },
    {
      "mountPath": "/api/marketplace",
      "kind": "additional",
      "requiresAuth": true
    }
  ],
  "deployableContributions": [
    {
      "deployable": "marketplace-web",
      "routes": [
        {
          "routeId": "account-support",
          "routePath": "account/support",
          "fileExport": "./routes/marketplace/account-support",
          "routeType": "route",
          "sourceContext": "platform-operations"
        }
      ]
    },
    {
      "deployable": "admin-web",
      "routes": [
        {
          "routeId": "support-requests",
          "routePath": "requests",
          "fileExport": "./routes/admin/requests",
          "routeType": "route",
          "sourceContext": "platform-operations",
          "section": "support"
        },
        {
          "routeId": "support-requests-detail",
          "routePath": "requests/:id",
          "fileExport": "./routes/admin/request-detail",
          "routeType": "route",
          "sourceContext": "platform-operations",
          "section": "support"
        },
        {
          "routeId": "platform-feedback",
          "routePath": "platform-feedback",
          "fileExport": "./routes/admin/platform-feedback",
          "routeType": "route",
          "sourceContext": "platform-operations",
          "section": "support"
        },
        {
          "routeId": "platform-feedback-detail",
          "routePath": "platform-feedback/:id",
          "fileExport": "./routes/admin/platform-feedback-detail",
          "routeType": "route",
          "sourceContext": "platform-operations",
          "section": "support"
        },
        {
          "routeId": "projection-operations",
          "routePath": "projections",
          "fileExport": "./routes/admin/projection-operations",
          "routeType": "route",
          "sourceContext": "platform-operations",
          "section": "platform"
        },
        {
          "routeId": "release-controls",
          "routePath": "release-controls",
          "fileExport": "./routes/admin/release-controls",
          "routeType": "route",
          "sourceContext": "platform-operations",
          "section": "platform"
        },
        {
          "routeId": "release-dashboard",
          "routePath": "release-dashboard",
          "fileExport": "./routes/admin/release-dashboard",
          "routeType": "route",
          "sourceContext": "platform-operations",
          "section": "platform"
        }
      ]
    }
  ],
  "shellContributions": [
    {
      "deployable": "marketplace-web",
      "slot": "top-nav",
      "key": "support",
      "label": "Support",
      "icon": "help",
      "href": "/account/support",
      "order": 200,
      "visibility": "signed-in",
      "requiredPermissions": ["support.view"]
    },
    {
      "deployable": "marketplace-web",
      "slot": "bottom-nav",
      "key": "support",
      "label": "Support",
      "icon": "help",
      "href": "/account/support",
      "order": 200,
      "visibility": "signed-in",
      "requiredPermissions": ["support.view"]
    },
    {
      "deployable": "admin-web",
      "slot": "primary-nav",
      "key": "support-requests",
      "label": "Support",
      "icon": "help",
      "href": "/requests",
      "section": "support",
      "order": 5,
      "visibility": "signed-in",
      "requiredPermissions": ["support.manage"]
    },
    {
      "deployable": "admin-web",
      "slot": "primary-nav",
      "key": "platform-feedback",
      "label": "Platform Feedback",
      "icon": "message",
      "href": "/platform-feedback",
      "section": "support",
      "order": 20,
      "visibility": "signed-in",
      "requiredPermissions": ["platform-feedback.view"]
    },
    {
      "deployable": "admin-web",
      "slot": "primary-nav",
      "key": "projection-operations",
      "label": "Projection Operations",
      "icon": "refreshCcw",
      "href": "/projections",
      "section": "platform",
      "order": 10,
      "visibility": "signed-in",
      "requiredPermissions": ["security.manage"]
    },
    {
      "deployable": "admin-web",
      "slot": "primary-nav",
      "key": "release-dashboard",
      "label": "Release Dashboard",
      "icon": "chart",
      "href": "/release-dashboard",
      "section": "platform",
      "order": 20,
      "visibility": "signed-in",
      "requiredPermissions": ["security.manage"]
    },
    {
      "deployable": "admin-web",
      "slot": "primary-nav",
      "key": "release-controls",
      "label": "Release Controls",
      "icon": "settings",
      "href": "/release-controls",
      "section": "platform",
      "order": 25,
      "visibility": "signed-in",
      "requiredPermissions": ["security.manage"]
    }
  ],
  "directoryIntent": {
    "projection-operations": {
      "classification": "slice",
      "purpose": "Own projection-operations operator workflow, UI contracts, and admin console language for Platform Operations.",
      "expectedConsumers": ["Internal platform-operations module composition", "Admin web route contribution"]
    },
    "release-controls": {
      "classification": "slice",
      "purpose": "Own Platform Operations release-lock, feature-rollout evaluation, and kill-switch policy for cross-context platform capabilities.",
      "expectedConsumers": [
        "Production deployment workflow checks",
        "Bounded-context capability guards",
        "Admin operations controls"
      ]
    },
    "release-dashboard": {
      "classification": "slice",
      "purpose": "Own Platform Operations release health, production currency, canary status, and release-dashboard language.",
      "expectedConsumers": ["Admin web route contribution", "Release process operators"]
    },
    "insights-dashboards": {
      "classification": "slice",
      "purpose": "Own platform-operations analytical dashboard contracts, KPI projection behavior, and reporting query language.",
      "expectedConsumers": ["Internal platform-operations module composition", "Future operator reporting surfaces"]
    },
    "platform-feedback": {
      "classification": "slice",
      "purpose": "Own platform-feedback behavior, read models, UI contracts, and admin review surfaces.",
      "expectedConsumers": [
        "Internal platform-operations module composition",
        "Marketplace contextual feedback prompts"
      ]
    },
    "support-requests": {
      "classification": "slice",
      "purpose": "Own support-request workflow behavior, read models, API contracts, marketplace-facing support terminology, and operator queue UI.",
      "expectedConsumers": [
        "Internal platform-operations module composition",
        "Marketplace account support route",
        "Admin support operations route"
      ]
    },
    "request-support": {
      "classification": "support",
      "purpose": "Provide Platform Operations request API clients shared by platform-feedback and support-requests route modules and prompt UI.",
      "expectedConsumers": ["platform-feedback"],
      "crossCuttingRuntimeComposition": true
    },
    "seed-support": {
      "classification": "support",
      "purpose": "Provide deterministic platform-feedback and support-request seed identifiers for bootstrap and tests.",
      "expectedConsumers": ["platform-feedback", "support-requests", "Deployable composition for platform-operations"],
      "crossCuttingRuntimeComposition": true
    },
    "runtime-support": {
      "classification": "support",
      "purpose": "Provide Platform Operations event-store-backed runtime services for release-controls policy API composition.",
      "expectedConsumers": ["Root platform-operations composition"]
    },
    "routes": {
      "classification": "routes",
      "purpose": "Expose platform-operations route modules consumed by generated deployable adapters.",
      "expectedConsumers": ["Generated deployable route adapters"]
    }
  },
  "runtimeDeployables": ["admin-support-worker", "platform-worker"]
}
