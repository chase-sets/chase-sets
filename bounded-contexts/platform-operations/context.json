{
  "contextName": "platform-operations",
  "packageName": "@chase-sets/platform-operations",
  "ownedNouns": [
    "projection-operation",
    "platform-operation-attention",
    "sales-performance-kpi",
    "fulfillment-latency-kpi",
    "conversion-order-kpi",
    "dashboard-read-model",
    "platform-feedback",
    "platform-feedback-prompt",
    "reported-content",
    "risk-alert",
    "support-request"
  ],
  "streamPrefix": "platform-operations.",
  "apiBasePath": "/api/platform",
  "slices": [
    "projection-operations",
    "insights-dashboards",
    "platform-feedback",
    "reported-content",
    "risk-alerts",
    "support-requests"
  ],
  "allowedSupportDirectories": ["request-support", "runtime-support", "seed-support"],
  "publicExports": [".", "./context", "./routes/*", "./seed-support/*", "./server"],
  "allowedContextDependencies": [],
  "seedRequirements": ["identity", "ordering", "fulfillment", "payments", "settlement"],
  "eventSubscriptions": [
    {
      "sourceContextName": "marketplace",
      "projectionName": "reported-content-queue-projection",
      "subscriptionVersion": 1,
      "sourceContextMount": "when-mounted",
      "eventTypes": ["marketplace.report.submitted", "marketplace.listing.auto-unlisted"],
      "order": 60,
      "projectionHandlerSetNames": ["reported-content-queue-projection"]
    },
    {
      "sourceContextName": "platform-operations",
      "projectionName": "reported-content-queue-projection",
      "subscriptionVersion": 1,
      "eventTypes": ["platform-operations.reported-content.action-recorded"],
      "order": 61,
      "projectionHandlerSetNames": ["reported-content-queue-projection"]
    },
    {
      "sourceContextName": "identity",
      "projectionName": "risk-alert-queue-projection",
      "subscriptionVersion": 1,
      "eventTypes": ["identity.account.created"],
      "order": 62,
      "projectionHandlerSetNames": ["risk-alert-queue-projection"]
    },
    {
      "sourceContextName": "marketplace",
      "projectionName": "risk-alert-queue-projection",
      "subscriptionVersion": 1,
      "sourceContextMount": "when-mounted",
      "eventTypes": ["marketplace.listing.created", "marketplace.review.submitted"],
      "order": 63,
      "projectionHandlerSetNames": ["risk-alert-queue-projection"]
    },
    {
      "sourceContextName": "payments",
      "projectionName": "risk-alert-queue-projection",
      "subscriptionVersion": 1,
      "sourceContextMount": "when-mounted",
      "eventTypes": ["payments.payment-created", "payments.payment-disputed"],
      "order": 64,
      "projectionHandlerSetNames": ["risk-alert-queue-projection"]
    },
    {
      "sourceContextName": "platform-operations",
      "projectionName": "risk-alert-queue-projection",
      "subscriptionVersion": 1,
      "eventTypes": ["platform-operations.risk-alert.action-recorded"],
      "order": 65,
      "projectionHandlerSetNames": ["risk-alert-queue-projection"]
    },
    {
      "sourceContextName": "ordering",
      "projectionName": "support-order-source-projection",
      "subscriptionVersion": 1,
      "eventTypes": [
        "ordering.order.created",
        "ordering.order.cancelled",
        "ordering.order.ready-for-fulfillment-recorded"
      ],
      "order": 70,
      "projectionHandlerSetNames": ["support-order-source-projection"]
    },
    {
      "sourceContextName": "fulfillment",
      "projectionName": "support-shipment-source-projection",
      "subscriptionVersion": 1,
      "eventTypes": [
        "fulfillment.shipment.created",
        "fulfillment.shipment.dispatched",
        "fulfillment.shipment.delivered",
        "fulfillment.shipment.returned",
        "fulfillment.shipment.exception-raised"
      ],
      "order": 80,
      "projectionHandlerSetNames": ["support-shipment-source-projection"]
    }
  ],
  "projectionGroups": [
    {
      "projectionName": "experience-platform-feedback-projection",
      "sourceContextNames": ["platform-operations"],
      "ownedTables": ["experience_platform_feedback_pages", "experience_platform_feedback_prompt_pages"],
      "requiredDuringBootstrap": true,
      "resetStrategy": "replay-only"
    },
    {
      "projectionName": "reported-content-queue-projection",
      "sourceContextNames": ["marketplace", "platform-operations"],
      "optionalSourceContextNames": ["marketplace"],
      "ownedTables": ["platform_operations_reported_content_queue_pages"],
      "requiredDuringBootstrap": true,
      "resetStrategy": "replay-only"
    },
    {
      "projectionName": "risk-alert-queue-projection",
      "sourceContextNames": ["identity", "marketplace", "payments", "platform-operations"],
      "optionalSourceContextNames": ["marketplace", "payments"],
      "ownedTables": [
        "platform_operations_risk_alert_account_sources",
        "platform_operations_risk_alert_velocity_sources",
        "platform_operations_risk_alert_queue_pages"
      ],
      "requiredDuringBootstrap": true,
      "resetStrategy": "replay-only"
    },
    {
      "projectionName": "support-order-source-projection",
      "sourceContextNames": ["ordering"],
      "ownedTables": ["support_order_sources"],
      "requiredDuringBootstrap": true,
      "resetStrategy": "replay-only"
    },
    {
      "projectionName": "support-shipment-source-projection",
      "sourceContextNames": ["fulfillment"],
      "ownedTables": ["support_shipment_sources"],
      "requiredDuringBootstrap": true,
      "resetStrategy": "replay-only"
    }
  ],
  "readAfterWriteRouteInventory": [
    {
      "id": "platform-operations.platform-feedback-detail-fresh-read",
      "owner": "platform-operations",
      "risk": "important",
      "freshnessSlo": {
        "flowClass": "important-self-refresh",
        "p95Ms": 2500,
        "p99Ms": 5000
      },
      "source": {
        "routeId": "platform-feedback-detail",
        "actions": ["Mark reviewed", "Archive", "Record note"],
        "command": "Platform feedback lifecycle commands",
        "helperUses": ["navigateAfterWrite"]
      },
      "destination": {
        "routeId": "platform-feedback-detail",
        "apiContextName": "platform-operations",
        "apiRoutePath": "/platform-feedback/:id",
        "readModelTables": ["experience_platform_feedback_pages"],
        "transientRecovery": {
          "kinds": "refreshable-catching-up",
          "behavior": "Platform feedback detail redirects carry the Platform Operations command receipt so the detail loader reads after the platform feedback projection catches up."
        }
      },
      "proof": {
        "tests": ["bounded-contexts/platform-operations/tests/mutation-consistency-route-actions.test.ts"]
      }
    },
    {
      "id": "platform-operations.platform-feedback-list-fresh-read",
      "owner": "platform-operations",
      "risk": "important",
      "freshnessSlo": {
        "flowClass": "important-self-refresh",
        "p95Ms": 2500,
        "p99Ms": 5000
      },
      "source": {
        "routeId": "platform-feedback",
        "actions": ["Mark selected reviewed", "Archive selected"],
        "command": "Platform feedback bulk lifecycle commands",
        "helperUses": ["navigateAfterWrite"]
      },
      "destination": {
        "routeId": "platform-feedback",
        "apiContextName": "platform-operations",
        "apiRoutePath": "/platform-feedback",
        "readModelTables": ["experience_platform_feedback_pages"],
        "transientRecovery": {
          "kinds": "refreshable-catching-up",
          "behavior": "Platform feedback queue redirects carry the Platform Operations command receipt so list and metric reads happen after the platform feedback projection catches up."
        }
      },
      "proof": {
        "tests": ["bounded-contexts/platform-operations/tests/mutation-consistency-route-actions.test.ts"]
      }
    }
  ],
  "hostPorts": [
    {
      "portName": "notificationOutbox",
      "providedBy": "platform-worker",
      "purpose": "Durable outbound notification outbox consumed only by support request event projectors."
    }
  ],
  "apiDeployables": ["platform-api"],
  "apiMounts": [
    {
      "mountPath": "/api/platform",
      "kind": "primary",
      "requiresAuth": true
    },
    {
      "mountPath": "/api/experience",
      "kind": "additional",
      "requiresAuth": true,
      "readFreshnessRoutes": [
        {
          "routePath": "/platform-feedback",
          "methods": ["GET", "HEAD"],
          "dependencies": [
            {
              "readModelTable": "experience_platform_feedback_pages"
            }
          ]
        },
        {
          "routePath": "/platform-feedback/:id",
          "methods": ["GET", "HEAD"],
          "dependencies": [
            {
              "readModelTable": "experience_platform_feedback_pages"
            }
          ]
        }
      ]
    },
    {
      "mountPath": "/api/marketplace",
      "kind": "additional",
      "requiresAuth": true
    }
  ],
