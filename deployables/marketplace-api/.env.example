CATALOG_DATABASE_URL=postgresql://catalog:catalog@localhost:5432/catalog
DISCOVERY_DATABASE_URL=postgresql://catalog:catalog@localhost:5432/discovery
FULFILLMENT_DATABASE_URL=postgresql://catalog:catalog@localhost:5432/fulfillment
IDENTITY_DATABASE_URL=postgresql://catalog:catalog@localhost:5432/identity
INVENTORY_DATABASE_URL=postgresql://catalog:catalog@localhost:5432/inventory
MARKETPLACE_DATABASE_URL=postgresql://catalog:catalog@localhost:5432/marketplace
ORDERING_DATABASE_URL=postgresql://catalog:catalog@localhost:5432/ordering
PAYMENTS_DATABASE_URL=postgresql://catalog:catalog@localhost:5432/payments
PRICING_DATABASE_URL=postgresql://catalog:catalog@localhost:5432/pricing
REPUTATION_DATABASE_URL=postgresql://catalog:catalog@localhost:5432/reputation
SETTLEMENT_DATABASE_URL=postgresql://catalog:catalog@localhost:5432/settlement
IDENTITY_API_BASE_URL=http://localhost:6181
PORT=6182
# Stripe is optional for local startup. If any Stripe value is missing, the API falls back to the fake payment processor.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
# `npm run dev` now starts the Stripe Docker listener automatically when Stripe keys are configured. Run `npm run stripe:listen` manually if you want the listener in a separate terminal.
# STRIPE_API_BASE_URL=https://api.stripe.com
