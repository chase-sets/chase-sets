DATABASE_URL=postgresql://catalog:catalog@localhost:5432/catalog
PORT=6182
# Stripe is optional for local startup. If any Stripe value is missing, the API falls back to the fake payment processor.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
# `npm run dev` now starts the Stripe Docker listener automatically when Stripe keys are configured. Run `npm run stripe:listen` manually if you want the listener in a separate terminal.
# STRIPE_API_BASE_URL=https://api.stripe.com
