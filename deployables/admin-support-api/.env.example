DATABASE_URL=postgresql://postgres:postgres@localhost:5432/chase_sets
PLATFORM_CONTROL_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/chase_sets
PORT=6192
DATABASE_POOL_MAX=10
DATABASE_POOL_IDLE_TIMEOUT_MS=30000
DATABASE_POOL_CONNECTION_TIMEOUT_MS=5000
PLATFORM_INTERNAL_AUTH_SECRET=dev-platform-internal-auth-secret
ADMIN_REGISTRATION_ENABLED=false
PLATFORM_ADMIN_EMAIL=admin@chasesets.test
PLATFORM_ADMIN_PASSWORD=change-me-in-production
PLATFORM_ADMIN_DISPLAY_NAME=Platform Admin
PLATFORM_ADMIN_ACCOUNT_NAME=Chase Sets Platform
OBSERVABILITY_ENABLED=true
OTEL_SERVICE_NAME=admin-support-api
OTEL_SERVICE_VERSION=0.1.0
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_TRACES_SAMPLER=parentbased_traceidratio
OTEL_TRACES_SAMPLER_ARG=1.0
DEPLOYMENT_ENVIRONMENT=local
LOG_LEVEL=info
LOG_FILE_PATH=../../artifacts/observability/admin-support-api.jsonl
CATALOG_ASSET_STORAGE_KIND=filesystem
CATALOG_ASSET_LOCAL_ROOT=../../artifacts/catalog-assets/admin-support-api
