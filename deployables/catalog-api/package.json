    "seed": "tsx --env-file=.env src/seed.ts"
  },
  "dependencies": {
    "hono": "^4.12.5",
    "@hono/node-server": "^1.19.11",
    "pg": "^8.20.0"
  },
  "devDependencies": {
    "@types/pg": "^8.18.0",
    "tsx": "^4.21.0",
    "vitest": "^4.0.18"
  }
}
