{
  "name": "@chase-sets/catalog-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/main.ts",
    "start": "tsx --env-file=.env src/main.ts",
    "typecheck": "tsc -p ./tsconfig.json --noEmit",
