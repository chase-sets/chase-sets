{
  "name": "@chase-sets/app-platform-worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "chaseSets": {
    "testProfile": "db"
  },
  "scripts": {
    "bootstrap": "tsx --env-file=.env.example --env-file-if-exists=.env.local src/bootstrap.ts",
    "dev": "tsx watch --env-file=.env.example --env-file-if-exists=.env.local src/main.ts",
    "start": "tsx --env-file=.env.example --env-file-if-exists=.env.local src/main.ts",
    "typecheck": "tsc -p ./tsconfig.json --noEmit",
    "test": "vitest run --config ./vitest.config.ts",
    "test:fast": "vitest run --config ./vitest.config.ts",
    "test:watch": "vitest --config ./vitest.config.ts"
  },
  "dependencies": {
    "@chase-sets/auth": "workspace:*",
    "@chase-sets/bounded-context-runtime": "workspace:*",
    "@chase-sets/communications-email": "workspace:*",
    "@chase-sets/easypost-postage": "workspace:*",
    "@chase-sets/event-core-postgres": "workspace:*",
    "@chase-sets/fulfillment": "workspace:*",
    "@chase-sets/identity": "workspace:*",
    "@chase-sets/money-movement-testing": "workspace:*",
    "@chase-sets/notification-outbox": "workspace:*",
    "@chase-sets/notifications": "workspace:*",
    "@chase-sets/observability": "workspace:*",
    "@chase-sets/payment-processing-testing": "workspace:*",
    "@chase-sets/payments": "workspace:*",
    "@chase-sets/platform-runtime": "workspace:*",
    "@chase-sets/postage-labels-testing": "workspace:*",
    "@chase-sets/settlement": "workspace:*",
    "@chase-sets/stripe-connect": "workspace:*",
    "@chase-sets/stripe-payments": "workspace:*",
    "@chase-sets/support": "workspace:*",
    "@chase-sets/transactional-email-outbox": "workspace:*",
    "@chase-sets/web-notifications": "workspace:*",
    "@hono/node-server": "^1.19.13",
    "hono": "^4.12.12",
    "pg": "^8.20.0"
  },
  "devDependencies": {
    "@types/pg": "^8.20.0",
    "tsx": "^4.21.0",
    "vitest": "^4.1.4"
  }
}
