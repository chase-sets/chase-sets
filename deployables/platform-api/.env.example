DATABASE_URL=postgresql://postgres:postgres@localhost:5432/chase_sets
PORT=6182
# Stripe is optional for local startup. If any Stripe value is missing, the API falls back to the fake payment processor.
# Stripe Connect money movement uses STRIPE_SECRET_KEY and STRIPE_WEBHOOK_SECRET;
# onboarding links also need HTTPS return and refresh URLs when enabled.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
# STRIPE_CONNECT_RETURN_URL=https://example.test/account/payouts
# STRIPE_CONNECT_REFRESH_URL=https://example.test/account/payouts/setup
# STRIPE_API_BASE_URL=https://api.stripe.com
