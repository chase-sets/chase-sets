SCRYDEX_API_KEY=
SCRYDEX_TEAM_ID=
TCGPLAYER_AUTOMATION_USER_AGENT=
TCGPLAYER_AUTOMATION_REQUEST_DELAY_MS=250
TCGPLAYER_AUTOMATION_RATE_LIMIT_COOLDOWN_MS=30000
TCGPLAYER_AUTOMATION_MAX_CONCURRENT_REQUESTS=2
TCGPLAYER_AUTOMATION_ADAPTIVE_ENABLED=true
TCGPLAYER_AUTOMATION_MIN_REQUEST_DELAY_MS=250
TCGPLAYER_AUTOMATION_MAX_REQUEST_DELAY_MS=30000
TCGPLAYER_AUTOMATION_LEARNED_MIN_DELAY_MS=250
TCGPLAYER_AUTOMATION_ADAPTIVE_INCREASE_MULTIPLIER=2
TCGPLAYER_AUTOMATION_ADAPTIVE_FLOOR_STEP_MS=100
TCGPLAYER_AUTOMATION_ADAPTIVE_DECREASE_AMOUNT_MS=100
TCGPLAYER_AUTOMATION_ADAPTIVE_SUCCESS_THRESHOLD=10
TCGPLAYER_AUTOMATION_DOMAIN_CONFIG_JSON=
TCGPLAYER_AUTOMATION_MAX_RETRIES=3
CATALOG_INTEGRATION_CONTROL_PLANE_MODE=open
CATALOG_INTEGRATION_PROVIDER_API_EMERGENCY_STOP=
CATALOG_INTEGRATION_PROVIDER_OPTION_QUERIES=open
CATALOG_INTEGRATION_IMPORTS_DISABLED=
CATALOG_INTEGRATION_PROMOTION_DISABLED=
CATALOG_INTEGRATION_REAPPLY_DISABLED=
CATALOG_INTEGRATION_ACTIVATION_MODE=open
DISCOVERY_SEARCH_EMBEDDINGS=enabled
DISCOVERY_SEARCH_RESCUE=enabled
DISCOVERY_SEARCH_HYBRID=off
DISCOVERY_QUERY_EMBEDDING_CACHE_MAX_ENTRIES=1000
DISCOVERY_QUERY_EMBEDDING_CACHE_TTL_MS=900000
VOYAGE_API_KEY=
VOYAGE_EMBEDDING_MODEL=voyage-4-lite
VOYAGE_EMBEDDING_BATCH_SIZE=128
VOYAGE_EMBEDDING_TIMEOUT_MS=15000
