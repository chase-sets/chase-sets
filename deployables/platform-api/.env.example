DATABASE_URL=postgresql://postgres:postgres@localhost:5432/chase_sets
PLATFORM_CONTROL_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/chase_sets
# Use a direct/session-compatible URL here when DATABASE_URL_* uses transaction pooling.
PLATFORM_WORK_SIGNAL_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/chase_sets
PORT=6182
DATABASE_POOL_MAX=10
DATABASE_POOL_IDLE_TIMEOUT_MS=30000
DATABASE_POOL_CONNECTION_TIMEOUT_MS=5000
REALTIME_STREAM_LIMITER=postgres
REALTIME_STREAM_LEASE_TTL_MS=30000
REALTIME_STREAM_LEASE_RENEW_INTERVAL_MS=10000
OBSERVABILITY_ENABLED=true
OTEL_SERVICE_NAME=platform-api
OTEL_SERVICE_VERSION=0.1.0
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_TRACES_SAMPLER=parentbased_traceidratio
OTEL_TRACES_SAMPLER_ARG=1.0
DEPLOYMENT_ENVIRONMENT=local
TAX_PROVIDER_BACKED_QUOTES_REQUIRED=false
LOG_LEVEL=info
LOG_FILE_PATH=../../artifacts/observability/platform-api.jsonl
# OTEL_RESOURCE_ATTRIBUTES=team=marketplace,region=local
CATALOG_ASSET_STORAGE_KIND=filesystem
CATALOG_ASSET_LOCAL_ROOT=../../artifacts/catalog-assets/platform-api
# CATALOG_ASSET_PUBLIC_BASE_URL=http://localhost:6182/catalog-assets
# Shared environments should use DigitalOcean Spaces-compatible S3.
# CATALOG_ASSET_STORAGE_KIND=s3
# CATALOG_ASSET_S3_BUCKET=chase-sets-preview-catalog-assets
# CATALOG_ASSET_S3_REGION=nyc3
# CATALOG_ASSET_S3_ENDPOINT=https://nyc3.digitaloceanspaces.com
# CATALOG_ASSET_PUBLIC_BASE_URL=https://assets.preview.chasesets.com
# CATALOG_ASSET_S3_ACCESS_KEY_ID=
# CATALOG_ASSET_S3_SECRET_ACCESS_KEY=
MARKETPLACE_LISTING_PHOTO_STORAGE_KIND=filesystem
MARKETPLACE_LISTING_PHOTO_LOCAL_ROOT=../../artifacts/marketplace-listing-photos/platform-api
# MARKETPLACE_LISTING_PHOTO_PUBLIC_BASE_URL=http://localhost:6182/marketplace-listing-photos
# Shared environments should use DigitalOcean Spaces-compatible S3.
# MARKETPLACE_LISTING_PHOTO_STORAGE_KIND=s3
# MARKETPLACE_LISTING_PHOTO_S3_BUCKET=chase-sets-preview-listing-photos
# MARKETPLACE_LISTING_PHOTO_S3_REGION=nyc3
# MARKETPLACE_LISTING_PHOTO_S3_ENDPOINT=https://nyc3.digitaloceanspaces.com
# MARKETPLACE_LISTING_PHOTO_PUBLIC_BASE_URL=https://listing-photos.preview.chasesets.com
# MARKETPLACE_LISTING_PHOTO_S3_ACCESS_KEY_ID=
# MARKETPLACE_LISTING_PHOTO_S3_SECRET_ACCESS_KEY=
# Stripe is optional for local startup. If any Stripe value is missing, the API falls back to fake providers.
# Payments and Connect use separate webhook secrets in production. Local stripe:listen can write both sandbox secrets.
# Connect payout setup and account management use embedded Account Sessions.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CONNECT_WEBHOOK_SECRET=
STRIPE_CONNECT_ACCOUNTS_API=v2
# STRIPE_API_BASE_URL=https://api.stripe.com
# UCP AP2 merchant authorization signing is optional locally and required before advertising production AP2 headless completion.
# Generate an EC private JWK, keep it secret, and publish only public previous keys during rotation.
# UCP_BUSINESS_SIGNING_KEY_ID=merchant-2026
# UCP_BUSINESS_SIGNING_ALG=ES256
# UCP_BUSINESS_SIGNING_PRIVATE_JWK={"kty":"EC","crv":"P-256","x":"...","y":"...","d":"..."}
# UCP_BUSINESS_SIGNING_PREVIOUS_PUBLIC_JWKS=[]
# USPS labels use the sandbox provider unless EasyPost is configured.
EASYPOST_API_KEY=
EASYPOST_WEBHOOK_SECRET=
EASYPOST_MODE=test
# EASYPOST_API_BASE_URL=https://api.easypost.com/v2
# Social login providers are optional locally. Configure each provider as a complete client id/secret pair.
GOOGLE_SOCIAL_LOGIN_CLIENT_ID=
GOOGLE_SOCIAL_LOGIN_CLIENT_SECRET=
ADMIN_GOOGLE_WORKSPACE_HOSTED_DOMAINS=
FACEBOOK_SOCIAL_LOGIN_CLIENT_ID=
FACEBOOK_SOCIAL_LOGIN_CLIENT_SECRET=
MOBILE_MESSAGING_PROVIDER=noop
TWILIO_AUTH_TOKEN=
TWILIO_WEBHOOK_SIGNATURE_REQUIRED=true
TCGPLAYER_AUTOMATION_TCG_AUTH_COOKIE=
SCRYDEX_API_KEY=
SCRYDEX_TEAM_ID=
TCGPLAYER_AUTOMATION_USER_AGENT=
TCGPLAYER_AUTOMATION_REQUEST_DELAY_MS=250
TCGPLAYER_AUTOMATION_RATE_LIMIT_COOLDOWN_MS=30000
TCGPLAYER_AUTOMATION_MAX_CONCURRENT_REQUESTS=2
TCGPLAYER_AUTOMATION_ADAPTIVE_ENABLED=true
TCGPLAYER_AUTOMATION_MIN_REQUEST_DELAY_MS=250
TCGPLAYER_AUTOMATION_MAX_REQUEST_DELAY_MS=30000
TCGPLAYER_AUTOMATION_LEARNED_MIN_DELAY_MS=250
TCGPLAYER_AUTOMATION_DOMAIN_CONFIG_JSON=
TCGPLAYER_AUTOMATION_MAX_RETRIES=3
CATALOG_INTEGRATION_CONTROL_PLANE_MODE=open
CATALOG_INTEGRATION_PROVIDER_API_EMERGENCY_STOP=
CATALOG_INTEGRATION_PROVIDER_OPTION_QUERIES=open
CATALOG_INTEGRATION_IMPORTS_DISABLED=
CATALOG_INTEGRATION_PROMOTION_DISABLED=
CATALOG_INTEGRATION_REAPPLY_DISABLED=
CATALOG_INTEGRATION_ACTIVATION_MODE=open
