DATABASE_URL=postgresql://postgres:postgres@localhost:5432/chase_sets
PLATFORM_CONTROL_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/chase_sets
# Use a direct/session-compatible URL here when DATABASE_URL_* uses transaction pooling.
PLATFORM_WORK_SIGNAL_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/chase_sets
# Must match every service that calls platform API internal routes.
PLATFORM_INTERNAL_AUTH_SECRET=dev-platform-internal-auth-secret
# landing | proof | public
CHASE_SETS_RUNTIME_PROFILE=public
# Opt in only when the app receives requests from a trusted reverse proxy.
# CHASE_SETS_TRUST_FORWARDED_HEADERS=true
# Shared staging keeps rate limits active while allowing deployed smoke's synthetic account burst.
# CHASE_SETS_RATE_LIMIT_AUTH_REGISTER_IP_MAX=30
# critical-bootstrap,catalog-integration-bootstrap,scenario-seed,representative-commerce-state
PLATFORM_DATA_PROFILES=
# Optional direct/session-compatible per-context waiter URLs for LISTEN-backed latency hints.
# DATABASE_URL_CATALOG_WAITER=postgresql://postgres:postgres@localhost:5432/chase_sets
# DATABASE_URL_DISCOVERY_WAITER=postgresql://postgres:postgres@localhost:5432/chase_sets
# DATABASE_URL_INVENTORY_WAITER=postgresql://postgres:postgres@localhost:5432/chase_sets
# DATABASE_URL_MARKETPLACE_WAITER=postgresql://postgres:postgres@localhost:5432/chase_sets
PORT=6182
DATABASE_POOL_MAX=10
DATABASE_POOL_IDLE_TIMEOUT_MS=30000
DATABASE_POOL_CONNECTION_TIMEOUT_MS=5000
# Realtime SSE and post-write freshness tuning.
REALTIME_BATCH_SIZE=100
REALTIME_POLL_INTERVAL_MS=1000
REALTIME_HEARTBEAT_INTERVAL_MS=15000
REALTIME_RETENTION_PRUNE_INTERVAL_MS=60000
REALTIME_BACKGROUND_MAINTENANCE_ENABLED=true
REALTIME_WAKE_SIGNAL_ENABLED=true
REALTIME_MAX_CONSECUTIVE_FULL_BATCHES=3
REALTIME_MAX_TOPICS_PER_STREAM=16
REALTIME_MAX_ACTIVE_STREAMS=1000
REALTIME_MAX_ACTIVE_STREAMS_PER_CONNECTION_KEY=6
REALTIME_CURSOR_SIGNING_SECRET=
REALTIME_PREVIOUS_CURSOR_SIGNING_SECRETS=
REALTIME_STREAM_LIMITER=postgres
REALTIME_STREAM_LEASE_TTL_MS=30000
REALTIME_STREAM_LEASE_RENEW_INTERVAL_MS=10000
# REALTIME_STREAM_LIMITER=redis # postgres | redis | local
# REALTIME_REDIS_URL=redis://localhost:6379
# REDIS_URL=redis://localhost:6379
REALTIME_REDIS_NAMESPACE=
REALTIME_REDIS_LEASE_TTL_SECONDS=60
READ_CONSISTENCY_TIMEOUT_MS=2500
READ_CONSISTENCY_POLL_INTERVAL_MS=75
READ_CONSISTENCY_EXACT_DEPENDENCY_MODE=enabled
READ_CONSISTENCY_ROUTE_TUNING_JSON=[]
READ_CONSISTENCY_WAKE_BEFORE_WAIT_ENABLED=false
READ_CONSISTENCY_READINESS_NOTIFICATIONS_ENABLED=false
PROJECTION_INLINE_APPLY_ENABLED=false
MCP_MAX_CONCURRENT_TOOL_CALLS=100
MCP_MAX_CONCURRENT_TOOL_CALLS_PER_PRINCIPAL=8
MCP_MAX_CONCURRENT_WRITE_TOOL_CALLS_PER_PRINCIPAL=2
MCP_MAX_CONCURRENT_EXTERNAL_PROVIDER_TOOL_CALLS_PER_PRINCIPAL=2
AGENT_GRANT_WRITE_RATE_LIMIT_MAX=60
AGENT_GRANT_WRITE_RATE_LIMIT_WINDOW_MS=60000
AGENT_GRANT_WRITE_RATE_LIMIT_DISABLED=false
AGENT_GRANT_SPEND_CAP_CENTS=50000
AGENT_GRANT_SPEND_CAP_WINDOW_MS=86400000
AGENT_GRANT_SPEND_CAP_DISABLED=false
OBSERVABILITY_ENABLED=true
OTEL_SERVICE_NAME=platform-api
OTEL_SERVICE_VERSION=0.1.0
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_TRACES_SAMPLER=parentbased_traceidratio
OTEL_TRACES_SAMPLER_ARG=1.0
DEPLOYMENT_ENVIRONMENT=local
TAX_PROVIDER_BACKED_QUOTES_REQUIRED=false
ADMIN_REGISTRATION_ENABLED=false
# invitation | open
REGISTRATION_ADMISSION_MODE=open
# enforce | log-only
REGISTRATION_DISPOSABLE_EMAIL_MODE=log-only
# Comma-separated disposable email domains to screen during registration.
REGISTRATION_DISPOSABLE_EMAIL_DOMAINS=
# Security lifetimes (issue #4292): env-tier by design, never admin-editable.
# Values are milliseconds; each is bounds-checked at boot -- see
# bounded-contexts/auth/docs/security-lifetimes.md. Defaults below equal the
# pre-#4292 compiled constants.
# AUTH_SESSION_TTL_MS=1209600000
# AUTH_ACCOUNT_SELECTION_TTL_MS=600000
# AUTH_MAGIC_LINK_TTL_MS=900000
# AUTH_CHALLENGE_TTL_MS=600000
# AUTH_SOCIAL_LOGIN_STATE_TTL_MS=600000
# AUTH_GUEST_CHECKOUT_TTL_MS=86400000
# UCP_OAUTH_ACCESS_TOKEN_TTL_MS=3600000
# UCP_OAUTH_REFRESH_TOKEN_TTL_MS=2592000000
# UCP_OAUTH_AUTHORIZATION_CODE_TTL_MS=300000
LOG_LEVEL=info
LOG_FILE_PATH=../../artifacts/observability/platform-api.jsonl
# OTEL_RESOURCE_ATTRIBUTES=team=marketplace,region=local
CATALOG_ASSET_STORAGE_KIND=filesystem
CATALOG_ASSET_LOCAL_ROOT=../../artifacts/catalog-assets/platform-api
# CATALOG_ASSET_PUBLIC_BASE_URL=http://localhost:6182/catalog-assets
# Shared environments should use DigitalOcean Spaces-compatible S3.
# CATALOG_ASSET_STORAGE_KIND=s3
# CATALOG_ASSET_S3_BUCKET=chase-sets-preview-catalog-assets
# CATALOG_ASSET_S3_REGION=nyc3
# CATALOG_ASSET_S3_ENDPOINT=https://nyc3.digitaloceanspaces.com
# CATALOG_ASSET_PUBLIC_BASE_URL=https://assets.preview.chasesets.com
# CATALOG_ASSET_S3_ACCESS_KEY_ID=
# CATALOG_ASSET_S3_SECRET_ACCESS_KEY=
# CATALOG_ASSET_S3_FORCE_PATH_STYLE=false
MARKETPLACE_LISTING_PHOTO_STORAGE_KIND=filesystem
MARKETPLACE_LISTING_PHOTO_LOCAL_ROOT=../../artifacts/marketplace-listing-photos/platform-api
# MARKETPLACE_LISTING_PHOTO_PUBLIC_BASE_URL=http://localhost:6182/marketplace-listing-photos
# Shared environments should use DigitalOcean Spaces-compatible S3.
# MARKETPLACE_LISTING_PHOTO_STORAGE_KIND=s3
# MARKETPLACE_LISTING_PHOTO_S3_BUCKET=chase-sets-preview-listing-photos
# MARKETPLACE_LISTING_PHOTO_S3_REGION=nyc3
# MARKETPLACE_LISTING_PHOTO_S3_ENDPOINT=https://nyc3.digitaloceanspaces.com
# MARKETPLACE_LISTING_PHOTO_PUBLIC_BASE_URL=https://listing-photos.preview.chasesets.com
# MARKETPLACE_LISTING_PHOTO_S3_ACCESS_KEY_ID=
# MARKETPLACE_LISTING_PHOTO_S3_SECRET_ACCESS_KEY=
# MARKETPLACE_LISTING_PHOTO_S3_FORCE_PATH_STYLE=false
# Stripe is optional for local startup. If any Stripe value is missing, the API falls back to fake providers.
# Payments and Connect use separate webhook secrets in production. Local stripe:listen can write both sandbox secrets.
# Connect payout setup and account management use embedded Account Sessions.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CONNECT_WEBHOOK_SECRET=
STRIPE_WEBHOOK_SECRET_PREVIOUS=
STRIPE_CONNECT_WEBHOOK_SECRET_PREVIOUS=
STRIPE_CONNECT_ACCOUNTS_API=v2
# STRIPE_API_BASE_URL=https://api.stripe.com
# UCP AP2 merchant authorization signing is optional locally and required before advertising production AP2 headless completion.
# Generate an EC private JWK, keep it secret, and publish only public previous keys during rotation.
# UCP_BUSINESS_SIGNING_KEY_ID=merchant-2026
# UCP_BUSINESS_SIGNING_ALG=ES256
# UCP_BUSINESS_SIGNING_PRIVATE_JWK={"kty":"EC","crv":"P-256","x":"...","y":"...","d":"..."}
# UCP_BUSINESS_SIGNING_PREVIOUS_PUBLIC_JWKS=[]
# AP2 direct-mode completion requires this complete verifier pair plus merchant signing and Stripe SPT support.
# UCP_AP2_VERIFIER_URL=https://ap2-verifier.example/verify
# UCP_AP2_VERIFIER_AUTH_TOKEN=
UCP_AP2_VERIFIER_TIMEOUT_MS=5000
UCP_SIGNATURE_CREATED_FRESHNESS_WINDOW_MS=300000
# USPS labels use the sandbox provider unless EasyPost is configured.
EASYPOST_API_KEY=
EASYPOST_WEBHOOK_SECRET=
EASYPOST_MODE=test
# EASYPOST_API_BASE_URL=https://api.easypost.com/v2
# Social login providers are optional locally. Configure each provider as a complete client id/secret pair.
GOOGLE_SOCIAL_LOGIN_CLIENT_ID=
GOOGLE_SOCIAL_LOGIN_CLIENT_SECRET=
ADMIN_GOOGLE_WORKSPACE_HOSTED_DOMAINS=
FACEBOOK_SOCIAL_LOGIN_CLIENT_ID=
FACEBOOK_SOCIAL_LOGIN_CLIENT_SECRET=
MOBILE_MESSAGING_PROVIDER=noop
TWILIO_AUTH_TOKEN=
TWILIO_WEBHOOK_SIGNATURE_REQUIRED=true
# Optional local bootstrap admin account. Configure email/password together.
PLATFORM_ADMIN_EMAIL=
PLATFORM_ADMIN_PASSWORD=
PLATFORM_ADMIN_DISPLAY_NAME=Platform Admin
PLATFORM_ADMIN_ACCOUNT_NAME=Chase Sets Platform
# Preview-only superuser URL for the disposable in-cluster Postgres. Bootstrap
# uses it to create per-context preview databases/users. Set only when
# DEPLOYMENT_ENVIRONMENT=preview.
PLATFORM_PREVIEW_POSTGRES_ADMIN_URL=
