DATABASE_URL=postgresql://postgres:postgres@localhost:5432/chase_sets
PLATFORM_CONTROL_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/chase_sets
PORT=6182
DATABASE_POOL_MAX=10
DATABASE_POOL_IDLE_TIMEOUT_MS=30000
DATABASE_POOL_CONNECTION_TIMEOUT_MS=5000
REALTIME_STREAM_LIMITER=postgres
REALTIME_STREAM_LEASE_TTL_MS=30000
REALTIME_STREAM_LEASE_RENEW_INTERVAL_MS=10000
OBSERVABILITY_ENABLED=true
OTEL_SERVICE_NAME=platform-api
OTEL_SERVICE_VERSION=0.1.0
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_TRACES_SAMPLER=parentbased_traceidratio
OTEL_TRACES_SAMPLER_ARG=1.0
DEPLOYMENT_ENVIRONMENT=local
LOG_LEVEL=info
LOG_FILE_PATH=../../artifacts/observability/platform-api.jsonl
# OTEL_RESOURCE_ATTRIBUTES=team=marketplace,region=local
CATALOG_ASSET_STORAGE_KIND=filesystem
CATALOG_ASSET_LOCAL_ROOT=../../artifacts/catalog-assets/platform-api
# CATALOG_ASSET_PUBLIC_BASE_URL=http://localhost:6182/catalog-assets
# Shared environments should use DigitalOcean Spaces-compatible S3.
# CATALOG_ASSET_STORAGE_KIND=s3
# CATALOG_ASSET_S3_BUCKET=chase-sets-catalog-assets
# CATALOG_ASSET_S3_REGION=nyc3
# CATALOG_ASSET_S3_ENDPOINT=https://nyc3.digitaloceanspaces.com
# CATALOG_ASSET_PUBLIC_BASE_URL=https://assets.chasesets.com
# CATALOG_ASSET_S3_ACCESS_KEY_ID=
# CATALOG_ASSET_S3_SECRET_ACCESS_KEY=
# Stripe is optional for local startup. If any Stripe value is missing, the API falls back to the fake payment processor.
# Stripe Connect money movement uses STRIPE_SECRET_KEY and STRIPE_WEBHOOK_SECRET;
# onboarding links also need HTTPS return and refresh URLs when enabled.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
# STRIPE_CONNECT_RETURN_URL=https://example.test/account/payouts
# STRIPE_CONNECT_REFRESH_URL=https://example.test/account/payouts/setup
# STRIPE_API_BASE_URL=https://api.stripe.com
# USPS labels use the sandbox provider unless EasyPost is configured.
EASYPOST_API_KEY=
EASYPOST_MODE=test
# EASYPOST_API_BASE_URL=https://api.easypost.com/v2
# Social login providers are optional locally. Configure each provider as a complete client id/secret pair.
GOOGLE_SOCIAL_LOGIN_CLIENT_ID=
GOOGLE_SOCIAL_LOGIN_CLIENT_SECRET=
FACEBOOK_SOCIAL_LOGIN_CLIENT_ID=
FACEBOOK_SOCIAL_LOGIN_CLIENT_SECRET=
MOBILE_MESSAGING_PROVIDER=noop
TWILIO_AUTH_TOKEN=
TWILIO_WEBHOOK_SIGNATURE_REQUIRED=true
