{
  "name": "@chase-sets/app-platform-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "chaseSets": {
    "testProfile": "db"
  },
  "scripts": {
    "admin-qa-actor-fixtures": "tsx --env-file=.env.example --env-file-if-exists=.env.local src/admin-qa-actor-fixtures.ts",
    "admin-qa-actor-fixtures:production": "tsx src/admin-qa-actor-fixtures.ts",
    "bootstrap": "tsx --env-file=.env.example --env-file-if-exists=.env.local src/bootstrap.ts",
    "bootstrap:production": "tsx src/bootstrap.ts",
    "dev": "tsx watch --env-file=.env.example --env-file-if-exists=.env.local src/main.ts",
    "representative-commerce-state": "tsx --env-file=.env.example --env-file-if-exists=.env.local src/representative-commerce-state.ts",
    "representative-commerce-state:production": "tsx src/representative-commerce-state.ts",
    "start": "tsx --env-file=.env.example --env-file-if-exists=.env.local src/main.ts",
    "start:production": "tsx src/main.ts",
    "typecheck": "tsc -p ./tsconfig.json --noEmit",
    "test": "vitest run --config ./vitest.config.ts",
    "test:fast": "vitest run --config ./vitest.config.ts --exclude __tests__/bootstrap-scenario.db.test.ts --exclude __tests__/bootstrap-production-reconciliation.db.test.ts --exclude __tests__/bootstrap-lock-contention.db.test.ts --exclude __tests__/catalog-seed-aggregate-state.db.test.ts --exclude __tests__/authoritative-seed-resume.db.test.ts --exclude __tests__/inventory-seed-resume.db.test.ts",
    "test:watch": "vitest --config ./vitest.config.ts",
    "test:unit": "vitest run --config ./vitest.config.ts --exclude __tests__/bootstrap-scenario.db.test.ts --exclude __tests__/bootstrap-production-reconciliation.db.test.ts --exclude __tests__/bootstrap-lock-contention.db.test.ts --exclude __tests__/catalog-seed-aggregate-state.db.test.ts --exclude __tests__/authoritative-seed-resume.db.test.ts --exclude __tests__/inventory-seed-resume.db.test.ts",
    "test:db": "node ./scripts/check-bootstrap-db-enrollment.mjs && vitest run --config ./vitest.config.ts __tests__/bootstrap-scenario.db.test.ts __tests__/bootstrap-production-reconciliation.db.test.ts __tests__/bootstrap-lock-contention.db.test.ts __tests__/catalog-seed-aggregate-state.db.test.ts __tests__/authoritative-seed-resume.db.test.ts __tests__/inventory-seed-resume.db.test.ts --maxWorkers=3"
  },
  "dependencies": {
    "@chase-sets/auth": "workspace:*",
    "@chase-sets/auth-context": "workspace:*",
    "@chase-sets/bounded-context-runtime": "workspace:*",
    "@chase-sets/catalog": "workspace:*",
    "@chase-sets/catalog-seed": "workspace:*",
    "@chase-sets/checkout": "workspace:*",
    "@chase-sets/collections": "workspace:*",
    "@chase-sets/customer-feedback": "workspace:*",
    "@chase-sets/commercial-terms": "workspace:*",
    "@chase-sets/discovery": "workspace:*",
    "@chase-sets/easypost-postage": "workspace:*",
    "@chase-sets/event-core": "workspace:*",
    "@chase-sets/event-core-postgres": "workspace:*",
    "@chase-sets/fulfillment": "workspace:*",
    "@chase-sets/http": "workspace:*",
    "@chase-sets/identity": "workspace:*",
    "@chase-sets/inventory": "workspace:*",
    "@chase-sets/marketplace": "workspace:*",
    "@chase-sets/money-movement": "workspace:*",
    "@chase-sets/notifications": "workspace:*",
    "@chase-sets/object-storage": "workspace:*",
    "@chase-sets/observability": "workspace:*",
    "@chase-sets/ordering": "workspace:*",
    "@chase-sets/payment-processing": "workspace:*",
    "@chase-sets/payments": "workspace:*",
    "@chase-sets/platform-operations": "workspace:*",
    "@chase-sets/platform-runtime": "workspace:*",
    "@chase-sets/postage-labels": "workspace:*",
    "@chase-sets/pricing": "workspace:*",
    "@chase-sets/primitives": "workspace:*",
    "@chase-sets/public-presence": "workspace:*",
    "@chase-sets/ses-email": "workspace:*",
    "@chase-sets/settlement": "workspace:*",
    "@chase-sets/stripe-connect": "workspace:*",
    "@chase-sets/stripe-config": "workspace:*",
    "@chase-sets/stripe-payments": "workspace:*",
    "@chase-sets/typescript-compiler-api": "workspace:*",
    "@hono/node-server": "^1.19.13",
    "hono": "^4.12.12",
    "pg": "^8.20.0",
    "redis": "^5.12.1",
    "tsx": "^4.21.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "1.29.0",
    "@types/pg": "^8.20.0",
    "vitest": "^4.1.4"
  }
}
