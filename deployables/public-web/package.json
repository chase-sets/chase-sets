{
  "name": "@chase-sets/app-public-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "react-router dev",
    "prebuild": "pnpm --filter @chase-sets/public-presence run compile:help-articles && pnpm --filter @chase-sets/public-presence run compile:developer-articles",
    "build": "node ../../scripts/react-router-build.mjs",
    "start": "react-router-serve ./build/server/index.js",
    "typecheck": "tsc -p ./tsconfig.json --noEmit",
    "test": "vitest run --config ./vitest.config.ts"
  },
  "dependencies": {
    "@chase-sets/commercial-terms": "workspace:*",
    "@chase-sets/design-system": "workspace:*",
    "@chase-sets/observability": "workspace:*",
    "@chase-sets/platform-runtime": "workspace:*",
    "@chase-sets/pricing": "workspace:*",
    "@chase-sets/public-presence": "workspace:*",
    "@react-router/node": "7.14.0",
    "@react-router/serve": "7.14.0",
    "isbot": "^5",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-router": "^7.14.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.2.2",
    "@vitejs/plugin-react": "^6.0.1",
    "tailwindcss": "^4.2.2",
    "typescript": "^7.0.0",
    "vite": "^8.0.8",
    "vitest": "^4.1.4"
  }
}
