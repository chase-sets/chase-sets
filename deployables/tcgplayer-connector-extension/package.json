{
  "name": "@chase-sets/app-tcgplayer-connector-extension",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build --mode connector-local --configLoader runner",
    "build:handoff": "node ../../scripts/build-connector-extension-handoff.mjs",
    "typecheck": "tsc -p ./tsconfig.json --noEmit",
    "test": "vitest run --config ./vitest.config.ts",
    "test:watch": "vitest --config ./vitest.config.ts",
    "test:chromium": "vite build --mode connector-local --configLoader runner && playwright test --config ./playwright.config.ts",
    "pairing-drill:staging": "node --import tsx ../../scripts/connector-pairing-drill-staging.mjs"
  },
  "dependencies": {
    "@chase-sets/channels": "workspace:*",
    "@chase-sets/platform-runtime": "workspace:*"
  },
  "devDependencies": {
    "fake-indexeddb": "^6.2.4",
    "@playwright/test": "^1.60.0",
    "@types/chrome": "^0.1.36",
    "@types/node": "^24.19.1",
    "fflate": "^0.8.3",
    "typescript": "^7.0.0",
    "vite": "^8.0.0",
    "vitest": "^4.0.18"
  }
}
